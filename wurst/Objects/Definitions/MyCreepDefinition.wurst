package MyCreepDefinition

import UnitObjEditing
import ObjectIds
import MyItemDefinition
import MyColors
import ItemDrops
import RespawnCreeps
import DS_DataCompileTime
import public DamageTypes

// ----------------------------------------------------------------------------

// All creeps in the left rooms.
public constant real RESPAWN_TIME_NORMAL_CREEPS = 1
// From nerubian queen to doom guard.
public constant real RESPAWN_TIME_ELITE_CREEPS  = 5
// Footman, captain
public constant real RESPAWN_TIME_GOLD_FARM     = 1
// Scary scream
public constant real RESPAWN_TIME_GOLD_FARM2    = 3
// Revenant
public constant real RESPAWN_TIME_GOLD_FARM3    = 10
// Frosty snowman, and other bosses.
public constant real RESPAWN_TIME_BOSSES        = 30

// 20% to drop 1 item from the list.
public constant int  DROP_CHANCE_NORMAL_CREEPS = 20

public constant int  DROP_CHANCE_ELITE_CREEPS_NORMAL = 25
public constant int  DROP_CHANCE_ELITE_CREEPS_RARE   = 10

// ----------------------------------------------------------------------------

module ModuleUnitDefinition
    private let stdTargetsAllowed = commaList("ground", "structure", "debris", "ward", "enemy", "neutral")

    constant string name
    constant int lvl
    protected string dropsDescription = ""
    private string targetsAllowed = stdTargetsAllowed
    private bool isRanged1 = false
    private bool isRanged2 = false
    private ItemDropTableBase dropTable = null
    protected UnitOrBuildingOrHeroDefinition u

// ----------------------------------------------------------------------------
// ----------------------------------------------------------------------------

    function setGoldBounty(int goldAwarded)
        setGoldBounty(goldAwarded - 1, 1, 0)

    function setGoldBounty(int min, int max)
        let bountyBase = min - 1
        setGoldBounty(bountyBase, 1, max - bountyBase)

    function setGoldBounty(int goldAwarded, int numberOfDice, int sidesPerDice)
        // Bounty = BountyBase + GetRandomInt( NumDice, NumDice*SidesDie )
        // GetRandomInt returns random number in range including borders.
        // MinBounty = BountyBase + NumDice
        // MaxBounty = BountyBase + NumDice*SidesDie
        u.setGoldBountyAwardedBase(goldAwarded)
        u.setGoldBountyAwardedNumberofDice(numberOfDice)
        u.setGoldBountyAwardedSidesperDie(sidesPerDice)
    
// ----------------------------------------------------------------------------

    function setHp(int hp, real hpReg)
        u.setHitPointsMaximumBase(hp)
        u.setHitPointsRegenerationRate(hpReg)
        
    function setHpRel(int hp, real hpRegRelative)
        u.setHitPointsMaximumBase(hp)
        u.setHitPointsRegenerationRate(hp*hpRegRelative)
        
    function setMp(int mp, real mpReg)
        u.setManaMaximum(mp)
        u.setManaInitialAmount(mp)
        u.setManaRegeneration(mpReg)

    function addItemDropTable(ItemDropTableBase dropTable)
        this.dropTable = dropTable
        u.newId.addDropTable(dropTable)

    function addRespawnTime(real timeToRespawn)
        u.newId.addRespawnTime(timeToRespawn)

    private function addTp(int tpItemId, string icon)
        new MyItemDefinitionBase(tpItemId)
        ..setGoldCost(0)
        ..setInterfaceIcon(icon)
        ..setActivelyUsed(true)
        ..setNumberofCharges(1)
        ..setPerishable(true)
        ..setStockReplenishInterval(5)
        ..setStockStartDelay(3)
        ..setUseAutomaticallyWhenAcquired(true)
        ..setName("Creep tp " + name)
        ..setTooltipBasic("Tp to" + name + " [Level {0}]".format(lvl.toString()).setColor(colAbilityLevel))
        ..setTooltipExtended("Teleports you to the {0}.\n\n".format(name) +
        dropTable.getDescription())

    function addRes(resType resType, real value)
        u.newId.addUnitBaseRes(resType, value)
        
    function addPen(penType penType, real value)
        u.newId.addUnitBasePen(penType, value)

    function addBlockFlat(blockType blockType, real value)
        u.newId.addUnitBaseDamageBlock(blockType, value)

    function addBlockChance(blockType blockType, real chance, real value)
        u.newId.addUnitBaseChanceBlock(blockType, chance, value)

// ----------------------------------------------------------------------------
// ----------------------------------------------------------------------------

    function setAttackDamage1(int value)
        setAttackDamage1(value - 1, 1, 0)

    function setAttackDamage1(int min, int max)
        let dmgBase = min - 1
        setAttackDamage1(dmgBase, 1, max - dmgBase)

    function setAttackDamage1(int dmgBase, int numberOfDice, int sidesPerDice)
        u.setAttack1DamageBase(dmgBase)
        u.setAttack1DamageNumberofDice(numberOfDice)
        u.setAttack1DamageSidesperDie(sidesPerDice)

// ----------------------------------------------------------------------------

    function setAttackDamage2(int value)
        setAttackDamage2(value - 1, 1, 0)

    function setAttackDamage2(int min, int max)
        let dmgBase = min - 1
        setAttackDamage2(dmgBase, 1, max - dmgBase)

    function setAttackDamage2(int dmgBase, int numberOfDice, int sidesPerDice)
        u.setAttack2DamageBase(dmgBase)
        u.setAttack2DamageNumberofDice(numberOfDice)
        u.setAttack2DamageSidesperDie(sidesPerDice)

// ----------------------------------------------------------------------------
// ----------------------------------------------------------------------------

    function setRangedAttack1(int range)
        isRanged1 = true
        u.setAttack1Range(range)
        u.setAttack1ProjectileHomingEnabled(true)
        u.setAttack1WeaponType(WeaponType.Missile)
        targetsAllowed += ",air"
        u.setAttack1TargetsAllowed(targetsAllowed)

    function setMeleeAttack1()
        isRanged1 = false
        u.setAttack1Range(100)
        u.setAttack1ProjectileArc(0.00)
        u.setAttack1ProjectileArt("None")
        u.setAttack1ProjectileHomingEnabled(false)
        u.setAttack1WeaponType(WeaponType.Normal)
        u.setAttack1TargetsAllowed(targetsAllowed)

    function setAoe1(int fullDmgRange, int mediumDmgRange, int smallDmgRange)
        u.setAttack1AreaofEffectFullDamage(fullDmgRange)
        u.setAttack1AreaofEffectMediumDamage(mediumDmgRange)
        u.setAttack1AreaofEffectSmallDamage(smallDmgRange)
        u.setAttack1AreaofEffectTargets(targetsAllowed)
        if (isRanged1)
            u.setAttack1WeaponType(WeaponType.MissileSplash)

// ----------------------------------------------------------------------------

    function setRangedAttack2(int range)
        isRanged2 = true
        u.setAttack2Range(range)
        u.setAttack2ProjectileHomingEnabled(true)
        u.setAttack2WeaponType(WeaponType.Missile)
        targetsAllowed += ",air"
        u.setAttack2TargetsAllowed(targetsAllowed)

    function setMeleeAttack2()
        isRanged2 = false
        u.setAttack2Range(100)
        u.setAttack2ProjectileArc(0.00)
        u.setAttack2ProjectileArt("None")
        u.setAttack2ProjectileHomingEnabled(false)
        u.setAttack2WeaponType(WeaponType.Normal)
        u.setAttack2TargetsAllowed(targetsAllowed)

    function setAoe2(int fullDmgRange, int mediumDmgRange, int smallDmgRange)
        u.setAttack2AreaofEffectFullDamage(fullDmgRange)
        u.setAttack2AreaofEffectMediumDamage(mediumDmgRange)
        u.setAttack2AreaofEffectSmallDamage(smallDmgRange)
        u.setAttack2AreaofEffectTargets(targetsAllowed)
        if (isRanged2)
            u.setAttack2WeaponType(WeaponType.MissileSplash)

// ----------------------------------------------------------------------------
// ----------------------------------------------------------------------------

    function setBloodAttackType1()
        u.setAttack1AttackType(AttackType.Magic)

    function setChaosAttackType1()
        u.setAttack1AttackType(AttackType.Chaos)
        
    function setBloodAttackType2()
        u.setAttack2AttackType(AttackType.Magic)

    function setChaosAttackType2()
        u.setAttack2AttackType(AttackType.Chaos)

    function setGroundUnit()
        u.setTargetedAs(commaList("ground"))
        u.setMovementType(MovementType.Foot)
        u.setMovementHeight(0.00)
        u.setMovementHeightMinimum(0.00)
        
    function setStructure()
        u.setTargetedAs(commaList("structure"))
        u.setMovementType(MovementType.None)
        u.setArmorType(ArmorType.Fortified)
        u.setSpeedBase(0)
        u.setTurnRate(0.00)

    function setAirUnit(real moveHeight, real moveHeightMin)
        u.setTargetedAs(commaList("air"))
        u.setMovementType(MovementType.Fly)
        u.setMovementHeight(moveHeight)
        u.setMovementHeightMinimum(moveHeightMin)

// ----------------------------------------------------------------------------
// ----------------------------------------------------------------------------

    protected function initBase()
        setGroundUnit()
        u.setNormalAbilities("")
        u.setCanDropItemsOnDeath(true)

        setupAttack1()
        disableAttack2()
        setupMovement()

        u.setSleeps(false)
        u.setSightRadiusDay(1400)
        u.setSightRadiusNight(800)

        u.setLumberCost(0)
        u.setGoldCost(0)
        u.setFoodCost(0)
        
        u.setDefenseBase(0)
        u.setDefenseUpgradeBonus(0)
        u.setArmorType(ArmorType.Large)
        u.setHitPointsRegenerationType("always")

        setMp(0, 0.0)
        
        u.setName(name)
    
// ----------------------------------------------------------------------------

    private function setupMovement()
        u.setSpeedBase(270)
        u.setSpeedMaximum(0)
        u.setSpeedMinimum(0)
        u.setTurnRate(0.50)
        u.setCollisionSize(32.00)
        u.setCanFlee(true)
        
// ----------------------------------------------------------------------------

    private function setupAttack1()
        u.setAttacksEnabled(1)
        u.setMinimumAttackRange(0)
        u.setAcquisitionRange(800.00)

        u.setAttack1DamageSpillDistance(0.00)
        u.setAttack1DamageSpillRadius(0.00)
        u.setAttack1MaximumNumberofTargets(1)
        u.setAttack1AreaofEffectFullDamage(0)
        u.setAttack1AreaofEffectMediumDamage(0)
        u.setAttack1AreaofEffectSmallDamage(0)
        
        u.setAttack1AttackType(AttackType.Normal)
        u.setAttack1AreaofEffectTargets("")

    function setupAttack2()
        u.setAttacksEnabled(2)

        u.setAttack2DamageSpillDistance(0.00)
        u.setAttack2DamageSpillRadius(0.00)
        u.setAttack2MaximumNumberofTargets(1)
        u.setAttack2AreaofEffectFullDamage(0)
        u.setAttack2AreaofEffectMediumDamage(0)
        u.setAttack2AreaofEffectSmallDamage(0)
        
        u.setAttack2AttackType(AttackType.Normal)
        u.setAttack2AreaofEffectTargets("")
    
    private function disableAttack2()
        u.setAttack2CooldownTime(0.00)
        u.setAttack2DamageBase(0)
        u.setAttack2DamageNumberofDice(0)
        u.setAttack2DamageSidesperDie(0)
        u.setAttack2Range(0)
        u.setAttack2ProjectileArc(0.00)
        u.setAttack2ProjectileArt("None")
        u.setAttack2ProjectileHomingEnabled(false)
        u.setAttack2WeaponType(WeaponType.None)
        u.setAttack2DamageSpillDistance(0.00)
        u.setAttack2DamageSpillRadius(0.00)
        u.setAttack2MaximumNumberofTargets(1)
        u.setAttack2AreaofEffectFullDamage(0)
        u.setAttack2AreaofEffectMediumDamage(0)
        u.setAttack2AreaofEffectSmallDamage(0)
        u.setAttack2AnimationBackswingPoint(0.000)
        u.setAttack2AnimationDamagePoint(0.000)
        u.setAttack2AttackType(AttackType.Normal)
        u.setAttack2TargetsAllowed(commaList(""))
        u.setAttack2AreaofEffectTargets(commaList(""))

// ----------------------------------------------------------------------------
// ----------------------------------------------------------------------------

public class MyCreepDefinition extends UnitDefinition
    use ModuleUnitDefinition

    construct(int newId, string name, int lvl, int baseId)
        super(newId, baseId)
        this.u = this
        this.name = name
        this.lvl  = lvl
        initBase()
        setLevel(lvl)

// ----------------------------------------------------------------------------

public class EnemyHeroDefinition extends HeroDefinition
    use ModuleUnitDefinition

    construct(int newId, string name, int lvl, int baseId)
        super(newId, baseId)
        this.u = this
        this.name = name
        this.lvl  = lvl
        initBase()
        setLevel(lvl)

    function setStatsBase(int str, int agi, int intel)
        setStartingStrength(str)
        setStartingAgility(agi)
        setStartingIntelligence(intel)
        
        setStrengthPerLevel(0)
        setAgilityPerLevel(0)
        setIntelligencePerLevel(0)

// ----------------------------------------------------------------------------
// ----------------------------------------------------------------------------