public class Color
    int R
    int G
    int B

    construct(int R, int G, int B)
        this.R = R
        this.G = G
        this.B = B

    function setColor(ItemDefinition itemDef)
        itemDef.setTintingColor1Red(R)
        itemDef.setTintingColor2Green(G)
        itemDef.setTintingColor3Blue(B)

public let colItemL1 = new Color(137, 218, 128) // Green
public let colItemL2 = new Color(77, 151, 223)  // Blue
public let colItemL3 = new Color(229, 136, 72)  // Orange
public let colItemL4 = new Color(239, 102, 86)  // Red
public let colItemL5 = new Color(199, 104, 250) // Purple

public function string.setColor(string color) returns string
    return color + this + colRst

