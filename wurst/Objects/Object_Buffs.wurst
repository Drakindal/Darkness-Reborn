package Object_Buffs

import BuffIds
import BuffObjEditing
import MyBuffIds
import Icons
import Abilities
import MyHeroAbilityDefinition

init


@compiletime function buffs()
    new BuffDefinition(BUFF_ITEM_BASH, BuffIds.stunned)
    ..setIcon(Icons.bTNStun)
    ..register("Stunned",
    "This unit is stunned for a while.")

@compiletime function gen()

    new BuffDefinition(CREEP_BUFF_23, BuffIds.stunned)
    ..setTooltipNormal(1, "Recently hit by Naga Sea Witch Q")
    ..setTooltipNormalExtended(1, "Recently hit by Naga Sea Witch Q")
    ..setArtTarget(1, ".mdl")
    ..setArtSpecial(1, ".mdl")
    ..setIconNormal(1, Icons.bTNStun)
    
    new BuffDefinition(CREEP_BUFF_26, BuffIds.stunned)
    ..setArtTarget(1, Abilities.freezingBreathTargetArt)