package BossesTowers

import UnitObjEditing
import MyUnitIds
import UnitIds
import ObjectIds
import MyCreepDefinition
import ItemDrops
import MyItemIds

@compiletime function defineCreeps()
    new MyCreepDefinition(CREEP_BOSS_TOWER_L1, "Tidal Guardian", 0, UnitIds.tidalguardian)
    ..setNormalAbilities(commaList('Abgs'))

    ..setScalingValue(1.50)
    ..setSelectionScale(4.00)

    ..setRangedAttack1(900)
    ..setAttack1CooldownTime(1.00)
    ..setAttack1DamageBase(1995)
    ..setAttack1DamageNumberofDice(5)
    ..setAttack1DamageSidesperDie(9)
    ..setAttack1ProjectileArc(0.15)
    ..setAttack1ProjectileArt("Abilities\\Weapons\\FarseerMissile\\FarseerMissile.mdl")
    ..setAttack1AnimationBackswingPoint(0.700)
    ..setAttack1AnimationDamagePoint(0.600)
    ..setAttack1AttackType(AttackType.Magic)
    
    ..setStructure()
    ..setCollisionSize(100.00)
    
    ..setGoldBounty(25000, 29000)
    ..setHpRel(335000, 0.01)
    ..addRes(resType.Physical, 0.90)
    ..addRes(resType.Magical,  0.90)
    ..addBlockFlat(blockType.PostResistances, 2100)

    ..addItemDropTable(new ItemDropTable()..populate(ITEM_SPHERE_OF_CHAOS))

// ----------------------------------------------------------------------------

    new MyCreepDefinition(CREEP_BOSS_TOWER_L2, "Corrupted Ancient Protector I", 0, UnitIds.corruptedancientprotector)
