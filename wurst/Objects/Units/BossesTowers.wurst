    ..setAttack1DamageBase(2995)
    ..setAttack1DamageNumberofDice(5)
    ..setAttack1DamageSidesperDie(9)
    ..setAttack1ProjectileArc(0.15)
    ..setAttack1ProjectileArt("Abilities\\Weapons\\AncientProtectorMissile\\AncientProtectorMissile.mdl")
    ..setAoe1(400, 500, 700)
    ..setAttack1AnimationBackswingPoint(0.500)
    ..setAttack1AnimationDamagePoint(0.500)
    ..setAttack1AttackType(AttackType.Magic)
    
    ..setStructure()
    ..setCollisionSize(130.00)
    
