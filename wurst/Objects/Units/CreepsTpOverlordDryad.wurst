package CreepsTpOverlordDryad

import UnitObjEditing
import MyUnitIds
import UnitIds
import ObjectIds
import MyCreepDefinition

// ----------------------------------------------------------------------------

@compiletime function defineCreeps()
    new MyCreepDefinition(CREEP_ELITE_OVERLORD, "Overlord", 2, UnitIds.overlord)
    ..setScalingValue(1.50)
    ..setSelectionScale(1.50)

    ..setMeleeAttack1()
    ..setAttack1CooldownTime(0.50)
    ..setAttackDamage1(280, 420)
    ..setAttack1AnimationBackswingPoint(0.300)
    ..setAttack1AnimationDamagePoint(0.400)    
    ..setChaosAttackType1()

    ..setSpeedBase(320)
    ..setTurnRate(0.60)
    ..setArmorType(ArmorType.Fortified)
    
    ..setGoldBounty(280, 320)
    ..setHpRel(8200, 0.08)
    ..addRes(resType.Physical, 0.70)
    ..addRes(resType.Magical,  0.60)
    ..addBlockFlat(blockType.PostResistances, 450)
    
// ----------------------------------------------------------------------------

    new MyCreepDefinition(CREEP_ELITE_DRYAD, "Dryad", 15, UnitIds.dryad)
    ..setNormalAbilities(commaList('Aadm', 'Aspo', 'Ault'))

    ..setScalingValue(2.00)
    ..setSelectionScale(2.00)

    ..setRangedAttack1(1100)
    ..setAttack1CooldownTime(0.10)
    ..setAttackDamage1(650, 820)
    ..setAttack1ProjectileArc(0.15)
    ..setAttack1ProjectileArt("Abilities\\Weapons\\Dryadmissile\\Dryadmissile.mdl")
    ..setAttack1ProjectileHomingEnabled(false)
    ..setAttack1AnimationBackswingPoint(0.700)
    ..setAttack1AnimationDamagePoint(0.300)
    ..setAttack1AttackType(AttackType.Magic)
    
    ..setSpeedBase(350)
    
    ..setGoldBounty(720, 1360)
    ..setHpRel(15200, 0.04)
    ..addRes(resType.Physical, 0.80)
    ..addRes(resType.Magical,  0.85)
    ..addBlockFlat(blockType.PostResistances, 650)

// ----------------------------------------------------------------------------