package BossesDragons

import UnitObjEditing
import MyUnitIds
import UnitIds
import ObjectIds
import MyCreepDefinition
import MyAbilityIds
import ItemDrops
import MyItemIds

@compiletime function defineCreeps()
    new MyCreepDefinition(CREEP_BOSS_DRAGON_L1, "GhostDragon I", 50, UnitIds.azuredragon)
    ..setNormalAbilities(commaList('Afrz', 'Afrb'))
    ..setScalingValue(1.50)
    ..setSelectionScale(2.00)

    ..setRangedAttack1(500)
    ..setAttack1CooldownTime(0.50)
    ..setAttackDamage1(820, 1150)
    ..setAttack1ProjectileArc(0.10)
    ..setAttack1ProjectileArt("Abilities\\Weapons\\FrostWyrmMissile\\FrostWyrmMissile.mdl")
    ..setAttack1DamageSpillDistance(400.00)
    ..setAttack1DamageSpillRadius(400.00)
    ..setAttack1AnimationBackswingPoint(0.550)
    ..setAttack1AnimationDamagePoint(0.500)
    ..setAoe1(200, 300, 400)
    ..setAttack1AttackType(AttackType.Magic)
    
    ..setAirUnit(240, 90)
    ..setCollisionSize(8.00)
    ..setArmorType(ArmorType.Divine)

    ..setGoldBounty(7500, 11500)
    ..setHpRel(55000, 0.04)
    ..setMp(6000, 1.5)
    ..addRes(resType.Physical, 0.90)
    ..addRes(resType.Magical,  0.90)
    ..addBlockFlat(blockType.PostResistances, 640)
    
    ..addItemDropTable(new ItemDropTableMultiple()
    ..addDropTable(new ItemDropTable()..populate(
        ITEM_DRAGON_BONE,
        ITEM_DRAGON_SKIN
    ))
    ..addDropTable(new ItemDropTable(3)..populate(
        ITEM_TOME_OF_HEALTH_L1,
        ITEM_TOME_OF_AGILITY_L1,
        ITEM_TOME_OF_INTELLIGENCE_L1,
        ITEM_TOME_OF_STRENGTH_L1,
        ITEM_TOME_OF_KNOWLEDGE_L1
    ))
    )

