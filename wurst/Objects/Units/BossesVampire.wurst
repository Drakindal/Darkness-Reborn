package BossesVampire

import UnitObjEditing
import MyUnitIds
import UnitIds
import ObjectIds
import MyCreepDefinition
import MyAbilityIds
import AbilityIds
import ItemDrops
import MyItemIds

@compiletime function defineCreeps()
    new EnemyHeroDefinition(CREEP_BOSS_DREADLORD, "Dreadlord", 80, UnitIds.dreadlord)
    ..setNormalAbilities(commaList(CREEP_ABILITY_3, CREEP_ABILITY_10, 'A0NL', CREEP_ABILITY_1, 'A0NS', 'A0NN', AbilityIds.inventory))

    ..setStatsBase(900, 860, 740)

    ..setScalingValue(1.50)
    ..setSelectionScale(1.50)


    ..setAttack1CooldownTime(1.00)
    ..setAttackDamage1(2000, 4200)
    ..setAttack1AnimationBackswingPoint(0.550)
    ..setAttack1AnimationDamagePoint(0.550)
    ..setAttack1AttackType(AttackType.Magic)

    ..setSpeedBase(450)
    ..setArmorType(ArmorType.Fortified)
    
    ..setGoldBounty(35000, 96000)
    ..setHpRel(865000, 0.05)
    ..setMp(1000, 1)
    ..addRes(resType.Physical, 0.95)
    ..addRes(resType.Magical,  0.90)
    ..addBlockFlat(blockType.PostResistances, 3400)

    ..addItemDropTable(new ItemDropTableMultiple()
    ..addDropTable(new ItemDropTable(5)..populate(
        ITEM_RUBY_FRAGMENTS_L1
    ))
    ..addDropTable(new ItemDropTable()..populate(
        ITEM_PERFECT_HIPPOPUS
    ))
    ..addDropTable(new ItemDropTable()..populate(
        ITEM_SCOURGE_BONE_CHIMES
    ))
    ..addDropTable(new ItemDropTable(3)..populate(
        ITEM_TOME_OF_AGILITY_L1,
        ITEM_TOME_OF_INTELLIGENCE_L1,
        ITEM_TOME_OF_STRENGTH_L1,
        ITEM_TOME_OF_KNOWLEDGE_L1,
        ITEM_TOME_OF_KNOWLEDGE_L2,
        ITEM_TOME_OF_KNOWLEDGE_L3
    ))
    )

// ----------------------------------------------------------------------------

    new EnemyHeroDefinition(CREEP_BOSS_VAMPIRE, "Vampire", 80, UnitIds.dreadlord)
    ..setNormalAbilities(commaList('A0NL', CREEP_ABILITY_1, CREEP_ABILITY_3, 'A0NS', AbilityIds.inventory, 'A0NN'))

    ..setStatsBase(1320, 1150, 1200)

    ..setScalingValue(1.60)
    ..setSelectionScale(1.90)

    ..setAttack1CooldownTime(0.80)
    ..setAttackDamage1(3120, 6540)
    ..setAttack1AnimationBackswingPoint(0.550)
    ..setAttack1AnimationDamagePoint(0.550)
    ..setAttack1AttackType(AttackType.Magic)
    
    ..setSpeedBase(430)
    ..setArmorType(ArmorType.Fortified)
    
    ..setGoldBounty(165000, 282000)
    ..setHpRel(1235000, 0.08)
    ..setMp(1000, 1)
    ..addRes(resType.Physical, 0.99)
    ..addRes(resType.Magical,  0.96)
    ..addBlockFlat(blockType.PostResistances, 8700)

    ..addItemDropTable(new ItemDropTableMultiple()
    ..addDropTable(new ItemDropTable()..populate(
        ITEM_PERFECT_RUBYSTONE
    ))
    ..addDropTable(new ItemDropTable()..populate(
        ITEM_PERFECT_CARNELIAN
    ))
    ..addDropTable(new ItemDropTable()..populate(
        ITEM_SKULL_OF_MALGANIS
    ))
    ..addDropTable(new ItemDropTable(4)..populate(
        ITEM_TOME_OF_AGILITY_L1,
        ITEM_TOME_OF_INTELLIGENCE_L1,
        ITEM_TOME_OF_STRENGTH_L1,
        ITEM_TOME_OF_KNOWLEDGE_L1,
        ITEM_TOME_OF_KNOWLEDGE_L2,
        ITEM_TOME_OF_KNOWLEDGE_L3
    ))
    )

// ----------------------------------------------------------------------------
