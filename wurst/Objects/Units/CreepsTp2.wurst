package CreepsTp2

import UnitObjEditing
import MyUnitIds
import UnitIds
import ObjectIds
import MyCreepDefinition
import Units
import ItemDrops
import MyItemIds

// ----------------------------------------------------------------------------

@compiletime function defineCreeps()
    new MyCreepDefinition(CREEP_LEFT_BROOD_MOTHER, "Brood Mother", 18, UnitIds.broodmother)
    ..setNormalAbilities(commaList('A093', 'ACen'))
    
    ..setScalingValue(1.50)
    ..setSelectionScale(1.50)

    ..setMeleeAttack1()
    ..setAttack1CooldownTime(1.25)
    ..setAttackDamage1(246, 296)
    ..setAttack1AnimationBackswingPoint(0.300)
    ..setAttack1AnimationDamagePoint(0.500)
    
    ..setSpeedBase(320)

    ..setGoldBounty(245, 310)
    ..setHpRel(5855, 0.04)
    ..addRes(resType.Physical, 0.35)
    ..addRes(resType.Magical,  0.30)
    ..addBlockFlat(blockType.PostResistances, 35)
    ..addBlockChance(blockType.PostResistances, 0.16, 90)
    
    ..addRespawnTime(RESPAWN_TIME_NORMAL_CREEPS)
    ..addItemDropTable(new ItemDropTableChance(DROP_CHANCE_NORMAL_CREEPS)..populate(
        ITEM_GEM_OF_POISON,
        ITEM_MOON_ARMOR
    ))

// ----------------------------------------------------------------------------

    new MyCreepDefinition(CREEP_LEFT_GRANITE_GOLEM, "Granite Golem", 18, UnitIds.granitegolem)
    ..setNormalAbilities(commaList('ACtb', 'ACtc'))
    
    ..setScalingValue(1.50)
    ..setSelectionScale(3.00)

    ..setMeleeAttack1()
    ..setAttack1Range(128)
    ..setAttack1CooldownTime(1.55)
    ..setAttackDamage1(276, 415)
    ..setAttack1DamageNumberofDice(1)
    ..setAttack1DamageSidesperDie(8)
    ..setAttack1ProjectileArt("Abilities\\Weapons\\AncientProtectorMissile\\AncientProtectorMissile.mdl")
    ..setAttack1AnimationBackswingPoint(0.300)
    ..setAttack1AnimationDamagePoint(0.300)
    ..setChaosAttackType1()

    ..setSpeedBase(270)
    ..setCollisionSize(48.00)
    ..setArmorType(ArmorType.Fortified)

    ..setGoldBounty(355, 480)
    ..setHpRel(5000, 0.01)
    ..setMp(600, 1.5)
    ..addRes(resType.Physical, 0.80)
    ..addRes(resType.Magical,  0.65)
    ..addBlockFlat(blockType.PostResistances, 150)
    ..addBlockChance(blockType.PostResistances, 0.05, 1200)
    
    ..addRespawnTime(RESPAWN_TIME_NORMAL_CREEPS)
    ..addItemDropTable(new ItemDropTableChance(DROP_CHANCE_NORMAL_CREEPS)..populate(
        ITEM_AMULET_OF_RECALL,
        ITEM_GHOUL_FRENZY
    ))

