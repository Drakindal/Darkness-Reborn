package BossesSeaElems

import UnitObjEditing
import MyUnitIds
import UnitIds
import ObjectIds
import MyCreepDefinition
import MyAbilityIds
import MyItemIds
import ItemDrops

@compiletime function defineCreeps()
    new MyCreepDefinition(CREEP_BOSS_SEA_ELEMENTAL_L1, "Sea Elemental I", 50, UnitIds.seaelemental)
    ..setNormalAbilities(commaList(CREEP_ABILITY_5, 'ACbh', 'A0ZJ'))

    ..setScalingValue(2.00)
    ..setSelectionScale(3.00)

    ..setRangedAttack1(1250)
    ..setAttack1CooldownTime(0.20)
    ..setAttackDamage1(8755, 14950)
    ..setAttack1ProjectileArc(0.15)
    ..setAttack1ProjectileArt("Abilities\\Weapons\\SeaElementalMissile\\SeaElementalMissile.mdl")
    ..setAttack1ProjectileHomingEnabled(false)
    ..setAttack1AnimationBackswingPoint(0.470)
    ..setAttack1AnimationDamagePoint(0.530)   
    ..setChaosAttackType1()

    ..setSpeedBase(220)
    ..setMovementType(MovementType.Amphipic)
    ..setArmorType(ArmorType.Hero)
    
    ..setGoldBounty(168000, 326000)
    ..setHpRel(2850000, 0.02)
    ..setMp(45000, 1)
    
    ..addItemDropTable(new ItemDropTableMultiple()
    ..addDropTable(new ItemDropTable()..populate(
        ITEM_PERFECT_PEARL,
        ITEM_PERFECT_GARNET,
        ITEM_BULION
    ))
    ..addDropTable(new ItemDropTable()..populate(
        ITEM_TOME_OF_KNOWLEDGE_L3
    ))
    ..addDropTable(new ItemDropTable(8)..populate(
        ITEM_TOME_OF_AGILITY_L1,
        ITEM_TOME_OF_INTELLIGENCE_L1,
        ITEM_TOME_OF_STRENGTH_L1,
        ITEM_TOME_OF_KNOWLEDGE_L1
    ))
    )

// ----------------------------------------------------------------------------

    new MyCreepDefinition(CREEP_BOSS_SEA_ELEMENTAL_L2, "Sea Elemental II", 50, UnitIds.seaelemental)
    ..setNormalAbilities(commaList(CREEP_ABILITY_5, 'ACbh', 'A0ZJ'))

    ..setScalingValue(2.50)
    ..setSelectionScale(3.00)

    ..setRangedAttack1(1350)
    ..setAttack1CooldownTime(0.10)
    ..setAttackDamage1(11250, 18400)
    ..setAttack1ProjectileArc(0.15)
    ..setAttack1ProjectileArt("Abilities\\Weapons\\SeaElementalMissile\\SeaElementalMissile.mdl")
    ..setAttack1ProjectileHomingEnabled(false)
    ..setAttack1AnimationBackswingPoint(0.470)
    ..setAttack1AnimationDamagePoint(0.530)    
    ..setChaosAttackType1()
    
    ..setSpeedBase(220)
    ..setMovementType(MovementType.Amphipic)
    ..setArmorType(ArmorType.Hero)
    
    ..setGoldBounty(368000, 826000)
    ..setHpRel(5850000, 0.025)
    ..setMp(45000, 1)

    ..addItemDropTable(new ItemDropTableMultiple()
    ..addDropTable(new ItemDropTable()..populate(
        ITEM_PERFECT_PEARL,
        ITEM_PERFECT_SAPPHIRE,
        ITEM_PERFECT_AMETHYST,
        ITEM_PERFECT_GARNET,
        ITEM_PERFECT_TOPAZ
    ))
    ..addDropTable(new ItemDropTable()..populate(
        ITEM_FROST_SHIELD
    ))
    ..addDropTable(new ItemDropTable()..populate(
        ITEM_BULION
    ))
    ..addDropTable(new ItemDropTable(2)..populate(
        ITEM_TOME_OF_KNOWLEDGE_L3
    ))
    ..addDropTable(new ItemDropTable(10)..populate(
        ITEM_TOME_OF_AGILITY_L1,
        ITEM_TOME_OF_INTELLIGENCE_L1,
        ITEM_TOME_OF_STRENGTH_L1,
        ITEM_TOME_OF_KNOWLEDGE_L1
    ))
    )

// ----------------------------------------------------------------------------

    new MyCreepDefinition(CREEP_BOSS_SEA_ELEMENTAL_L3, "Sea Elemental III", 50, UnitIds.seaelemental)
