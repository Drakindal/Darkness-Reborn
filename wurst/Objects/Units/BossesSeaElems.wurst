    ))
    )

// ----------------------------------------------------------------------------

    new MyCreepDefinition(CREEP_BOSS_DRAGON_TURTLE, "Dragon Turtle", 50, UnitIds.dragonturtle)
    ..setNormalAbilities(commaList('ANth', 'Ansk', 'wtex', 'A0ZJ', 'A0ZI'))

    ..setScalingValue(2.00)
    ..setSelectionScale(5.00)
    
    ..setMeleeAttack1()
    ..setAttack1CooldownTime(1.00)
    ..setAttackDamage1(36300, 75400)
    ..setAttack1WeaponType(WeaponType.Missile)
    ..setAttack1AnimationBackswingPoint(0.300)
    ..setAttack1AnimationDamagePoint(0.700)
    ..setAttack1AttackType(AttackType.Magic)
    
    ..setTurnRate(0.60)
    ..setMovementType(MovementType.Amphipic)
    ..setCollisionSize(76.00)
    ..setArmorType(ArmorType.Hero)

    ..setGoldBounty(2862000, 4962000)
    ..setHpRel(15177000, 0.033)
    ..setMp(65000, 1)
    
    ..addItemDropTable(new ItemDropTableMultiple()
    ..addDropTable(new ItemDropTable(2)..populate(
        ITEM_PERFECT_PEARL,
        ITEM_PERFECT_SAPPHIRE,
        ITEM_WATER_SCROLL,
        ITEM_FROST_SHIELD,
        ITEM_CRONUS_HAND
    ))
    ..addDropTable(new ItemDropTable()..populate(
        ITEM_CRONUS_HAND
    ))
    ..addDropTable(new ItemDropTable()..populate(
        ITEM_PERFECT_RUBYSTONE
    ))
    ..addDropTable(new ItemDropTable(3)..populate(
        ITEM_BULION
    ))
    ..addDropTable(new ItemDropTable(4)..populate(
        ITEM_TOME_OF_KNOWLEDGE_L3
    ))
    ..addDropTable(new ItemDropTable(16)..populate(
        ITEM_TOME_OF_AGILITY_L1,
        ITEM_TOME_OF_INTELLIGENCE_L1,
        ITEM_TOME_OF_STRENGTH_L1,
        ITEM_TOME_OF_KNOWLEDGE_L1
    ))
    )

