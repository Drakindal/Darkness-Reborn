package CreepsTpElite

import UnitObjEditing
import MyUnitIds
import UnitIds
import ObjectIds
import MyCreepDefinition
import MyAbilityIds
import ItemDrops
import MyItemIds

// ----------------------------------------------------------------------------

@compiletime function defineCreeps()
    new MyCreepDefinition(CREEP_ELITE_NERUBIAN_QUEEN, "Nerubian Queen", 25, UnitIds.nerubianqueen)

    ..setScalingValue(2.00)
    ..setSelectionScale(2.00)

    ..setRangedAttack1(700)
    ..setAttack1CooldownTime(0.50)
    ..setAttackDamage1(720, 1640)
    ..setAttack1ProjectileArc(0.15)
    ..setAttack1ProjectileArt("Abilities\\Weapons\\CryptFiendMissile\\CryptFiendMissile.mdl")
    ..setAttack1ProjectileHomingEnabled(false)
    ..setAttack1AnimationBackswingPoint(0.360)
    ..setAttack1AnimationDamagePoint(0.640)
    ..setChaosAttackType1()

    ..setSpeedBase(320)
    ..setCollisionSize(48.00)

    ..setGoldBounty(1500, 2500)
    ..setHpRel(65000, 0.01)
    ..setMp(50000, 1.25)
    ..addRes(resType.Physical, 0.80)
    ..addRes(resType.Magical,  0.75)
    ..addBlockFlat(blockType.PostResistances, 560)

    ..addRespawnTime(RESPAWN_TIME_ELITE_CREEPS)
    ..addItemDropTable(new ItemDropTableChance(DROP_CHANCE_ELITE_CREEPS_NORMAL)..populate(
        ITEM_SPHERE_OF_WATER,
        ITEM_ESSENCE_OF_ASZUNE,
        ITEM_SPHERE_OF_FIRE
    ))
    
// ----------------------------------------------------------------------------

    new MyCreepDefinition(CREEP_ELITE_HYDRALISK, "Hydralisk", 25, UnitIds.hydralisk)
    ..setModelFile("HydraliskREVISED.mdx")

    ..setScalingValue(2.50)
    ..setSelectionScale(2.00)

    ..setRangedAttack1(400)
    ..setAttack1CooldownTime(0.20)
    ..setAttackDamage1(1200, 2300)
    ..setAttack1ProjectileArt("Abilities\\Weapons\\HydraliskImpact\\HydraliskImpact.mdl")
    ..setAttack1WeaponType(WeaponType.Instant)
    ..setAttack1AnimationBackswingPoint(0.700)
    ..setAttack1AnimationDamagePoint(0.300)
    ..setChaosAttackType1()

    ..setTurnRate(0.60)

    ..setGoldBounty(1700, 2700)
    ..setHpRel(85000, 0.01)
    ..addRes(resType.Physical, 0.80)
    ..addRes(resType.Magical,  0.85)
    ..addBlockFlat(blockType.PostResistances, 660)
    
    ..addRespawnTime(RESPAWN_TIME_ELITE_CREEPS)
    ..addItemDropTable(new ItemDropTableMultiple()
    ..addDropTable(new ItemDropTableChance(DROP_CHANCE_ELITE_CREEPS_NORMAL)..populate(
        ITEM_CRYSTAL_SWORD,
        ITEM_ESSENCE_OF_ASZUNE,
        ITEM_SPHERE_OF_FIRE,
        ITEM_DREAM_SWORD
    ))
    ..addDropTable(new ItemDropTableChance(DROP_CHANCE_ELITE_CREEPS_RARE)..populate(
        ITEM_LAZARUS_BELT
    ))
    )

// ----------------------------------------------------------------------------

