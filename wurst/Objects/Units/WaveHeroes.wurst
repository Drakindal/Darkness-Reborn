package WaveHeroes

import UnitObjEditing
import MyUnitIds
import UnitIds
import ObjectIds
import MyCreepDefinition
import MyAbilityIds

// ----------------------------------------------------------------------------

@compiletime function defineUnits()
    new MyCreepDefinition(WAVE_HERO_0, "Ysera", 50, UnitIds.greendragon)
    ..setNormalAbilities(commaList('A0ZK', CREEP_ABILITY_101))

    ..setScalingValue(2.50)
    ..setSelectionScale(2.25)

    ..setRangedAttack1(1000)
    ..setAttack1CooldownTime(0.40)
    ..setAttackDamage1(2620, 3450)
    ..setAttack1ProjectileArc(0.00)
    ..setAttack1ProjectileArt("Abilities\\Spells\\Undead\\AnimateDead\\AnimateDeadTarget.mdl")
    ..setAttack1ProjectileHomingEnabled(false)
    ..setAoe1(600, 800, 1100)
    ..setAttack1AnimationBackswingPoint(0.250)
    ..setAttack1AnimationDamagePoint(0.250)
    ..setAttack1AttackType(AttackType.Magic)
    
    ..setAirUnit(330, 90)
    ..setSpeedBase(400)
    ..setTurnRate(0.10)
    ..setCollisionSize(48.00)
    ..setArmorType(ArmorType.Divine)
    
    ..setGoldBounty(35200, 46800)
    ..setHpRel(525000, 0.006)
    ..setMp(46000, 10)
    ..addRes(resType.Physical, 0.99)
    ..addRes(resType.Magical,  0.95)
    ..addBlockFlat(blockType.PostResistances, 4200)

// ----------------------------------------------------------------------------

