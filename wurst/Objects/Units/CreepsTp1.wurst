package CreepsTp1

import UnitObjEditing
import MyUnitIds
import UnitIds
import ObjectIds
import MyItemIds
import MyCreepDefinition
import ItemDrops

// ----------------------------------------------------------------------------

@compiletime function defineCreeps()
    new MyCreepDefinition(CREEP_LEFT_SPIDER, "Spider", 4, UnitIds.spider)
    ..setNormalAbilities(commaList('Apoi'))
    
    ..setScalingValue(0.50)
    ..setSelectionScale(1.10)

    ..setMeleeAttack1()
    ..setAttack1CooldownTime(1.35)
    ..setAttackDamage1(25, 35)
    ..setAttack1AnimationBackswingPoint(0.300)
    ..setAttack1AnimationDamagePoint(0.500)

    ..setGoldBounty(35, 41)
    ..setHp(350, 5)
    ..addRes(resType.Physical, 0.08)
    ..addRes(resType.Magical,  0.06)
    ..addBlockFlat(blockType.PostResistances, 8)

    ..addRespawnTime(RESPAWN_TIME_NORMAL_CREEPS)
    ..addItemDropTable(new ItemDropTableChance(DROP_CHANCE_NORMAL_CREEPS)..populate(
        ITEM_RUSTY_MINING_PICK,
        ITEM_GAUNTLETS_OF_OGRE_STRENGTH,
        ITEM_WIRTS_LEG
    ))
    
// ----------------------------------------------------------------------------

    new MyCreepDefinition(CREEP_LEFT_MUD_GOLEM, "Mud Golem", 6, UnitIds.mudgolem)
    ..setNormalAbilities(commaList('ACsw'))
    
    ..setScalingValue(0.60)
    ..setSelectionScale(1.75)

    ..setMeleeAttack1()
    ..setAttack1CooldownTime(1.7)
    ..setAttackDamage1(28, 62)
    ..setAttack1AnimationBackswingPoint(0.300)
    ..setAttack1AnimationDamagePoint(0.300)
    
    ..setSpeedBase(240)
    ..setCollisionSize(31.00)
    ..setArmorType(ArmorType.Fortified)
    
    ..setGoldBounty(42, 54)
    ..setHp(480, 0)
    ..setMp(300, 0.75)
    ..addRes(resType.Physical, 0.40)
    ..addRes(resType.Magical,  0.15)
    ..addBlockFlat(blockType.PostResistances, 25)
    
    ..addRespawnTime(RESPAWN_TIME_NORMAL_CREEPS)
    ..addItemDropTable(new ItemDropTableChance(DROP_CHANCE_NORMAL_CREEPS)..populate(
        ITEM_DIAMOND_OF_SUMMONING,
        ITEM_SLIPPERS_OF_AGILITY,
        ITEM_MANTLE_OF_INTELLIGENCE
    ))

