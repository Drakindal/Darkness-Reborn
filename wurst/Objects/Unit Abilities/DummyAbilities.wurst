package DummyAbilities

import MyAbilityIds
import AbilityObjEditing

@compiletime function dummyabils()
    new AbilityDefinitionMountainKingThunderBolt(ABILITY_DUMMY_STUN_5_SEC)
    ..setLevels(1)
    ..setDurationHero(1, 5)
    ..setDurationNormal(1, 5)
    ..setManaCost(1, 0)
    ..setDamage(1, 0)
    ..setCastRange(1, 9999)
    ..setCastingTime(1, 0)
    ..setCooldown(1, 0)
    ..setRequiredLevel(0)
    ..setRequirements("")
    ..setArtTarget(".mdl")
    ..setArtSpecial(".mdl")
    ..setArtEffect(".mdl")
    ..setArtCaster(".mdl")
    ..setMissileArt(".mdl")
    ..setMissileSpeed(9999)
