package LateGame4

import MyItemDefinition
import ItemObjEditing
import MyItemIds
import RecipeItems
import StatsType
import MyColors
import DebugVar

@compiletime function createItems()
    addItemInBoxForDebug = ADD_LATE_GAME_RECIPES
//I0EL
    new MyItemDefinition(ITEM_BULION)
    ..setInterfaceIcon("ReplaceableTextures\\CommandButtons\\BTNGold.blp")    
    ..setClassification("Artifact")
    ..setLumberCost(100)
    ..addStats(addMp(6000))
    ..addExtraDescription("Used to upgrade some type of item")
    ..addHotKey()
    ..register()

//I0CD
    new MyItemDefinition(ITEM_CRYSTAL_ARMOR)
    ..setInterfaceIcon("ReplaceableTextures\\CommandButtons\\BTN F (7).blp")
    ..setClassification("Campaign")
    ..setLumberCost(1100)
    ..setStockMaximum(2)
    ..setStockReplenishInterval(45)
    ..addStats(addStr(1200))
    ..addStats(addRes(resType.Physical, 0.10))
    ..addStats(addRes(resType.Magical, 0.10))
    ..addStats(addRes(resType.Universal, 0.20))
    ..addStats(addAbilityReturnDamageStats(8, 0.5, statsType.Str, customDamageType.PhysicalRanged))
    ..addHotKey()
    ..register()

//I0CC
    new MyItemDefinition(ITEM_CRYSTAL_DUAL_SWORD)
    ..setInterfaceIcon("ReplaceableTextures\\CommandButtons\\BTN F (2).blp")
    ..setClassification("Campaign")
    ..setGoldCost(50000)
    ..setLumberCost(700)
    ..setStockMaximum(2)
    ..setStockReplenishInterval(45)
    ..addStats(addDamage(1500))
    ..addStats(addAgi(690))
    ..addStats(addPen(penType.Physical, 0.05))
    ..addStats(addCrit(0.04, 60))
    ..addHotKey()
    ..register()

//I0CJ
    new MyItemDefinition(ITEM_CRYSTAL_KNIFE)
    ..setInterfaceIcon("ReplaceableTextures\\CommandButtons\\BTN F (9).blp")
    ..setClassification("Campaign")
    ..setScalingValue(0.50)
    ..setGoldCost(50000)
    ..setLumberCost(700)
    ..setStockMaximum(2)
    ..setStockReplenishInterval(45)
    ..addStats(addAllStats(600))
    ..addStats(addPen(penType.Physical, 0.20))
    ..addHotKey()
    ..register()

//I0CE
    new MyItemDefinition(ITEM_CRYSTAL_SPEAR)
    ..setInterfaceIcon("ReplaceableTextures\\CommandButtons\\BTN F (3).blp")
    ..setClassification("Campaign")
    ..setScalingValue(0.50)
    ..setGoldCost(50000)
    ..setLumberCost(700)
    ..addStats(addInt(1350))
    ..setStockMaximum(2)
    ..setStockReplenishInterval(45)
    ..addStats(addPen(penType.Magical, 0.10))
    ..addStats(addAbilityDealDamageStats(15, 0.15, statsType.Int, customDamageType.Magical))
    ..addHotKey()
    ..register()

//I0AX
    new MyItemWithRecipeDefinition(ITEM_DRAGON_WINGS, itemRecipeList, ITEM_RECIPE_DRAGON_WINGS,
    (MyItemDefinitionBase itemRecipe) -> itemRecipe
    ..setGoldCost(25000)
    )
    ..setInterfaceIcon("ReplaceableTextures\\CommandButtons\\BTNDragonWing.blp")
    ..setModelUsed("assets-wings effect\\DwingsStand.mdx")
    ..setClassification("Campaign")
    ..setScalingValue(0.80)
    ..addStats(addDamage(2500))
    ..addStats(addAllStats(200))
    ..addStats("Permanently changes your damage type to 'Blood' if picked up.".setColor("|c00ad1313"))
    ..addComponents(
    ITEM_DRAGON_BONE,
    ITEM_DRAGON_CLAW,
    ITEM_DRAGON_SKIN,
    ITEM_DRAGON_SPIRIT)
    ..addHotKey()
    ..register()
    
    addItemInBoxForDebug = false