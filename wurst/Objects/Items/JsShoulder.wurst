package JsShoulder

import MyItemDefinition
import ItemObjEditing
import MyItemIds
import Jacksmith_Q
import DebugVar

@compiletime function createItems()
    if (BUILD_JS_ITEMS)
    //I0AN
        new MyItemWithCraftInfoDefinition(ITEM_SOFT_SHOULDER, jackSmithRecipe, -1)
        ..setInterfaceIcon("ReplaceableTextures\\CommandButtons\\BTNSH_Armor_Upgrade_F.blp")
        ..setClassification("Purchasable")
        ..addStats(addRes(resType.Magical, 0.01))
        ..addStats(addRes(resType.Physical, 0.01))
        ..addStats(addAllStats(10))
        ..addStats(addHp(500))
        ..addComponents(
        ITEM_ANCIENT_FIGURINE,
        ITEM_BATTLE_STANDARD)
        ..register()

    //I0AO
        new MyItemWithCraftInfoDefinition(ITEM_HARD_SHOULDER, jackSmithRecipe, -1)
        ..setInterfaceIcon("ReplaceableTextures\\CommandButtons\\BTNSH_Armor_Upgrade_S.blp")
        ..setClassification("Purchasable")
        ..addStats(addRes(resType.Magical, 0.02))
        ..addStats(addRes(resType.Physical, 0.02))
        ..addStats(addAllStats(20))
        ..addStats(addHp(1000))
        ..addComponents(
        ITEM_SOFT_SHOULDER,
        ITEM_HALF_MOON_ARMOR)
        ..register()

    //I0AP
        new MyItemWithCraftInfoDefinition(ITEM_HEAVY_SHOULDER, jackSmithRecipe, -1)
        ..setInterfaceIcon("ReplaceableTextures\\CommandButtons\\BTNSH_Armor_Upgrade_T.blp")
        ..setClassification("Purchasable")
        ..addStats(addRes(resType.Magical, 0.04))
        ..addStats(addRes(resType.Physical, 0.04))
        ..addStats(addAllStats(50))
        ..addStats(addHp(2000))
        ..addComponents(
        ITEM_HARD_SHOULDER,
        ITEM_MOON_ARMOR,
        ITEM_BLOOD_GEM)
        ..register()

    //I0AQ
        new MyItemWithCraftInfoDefinition(ITEM_ROYAL_SHOULDER, jackSmithRecipe, -1)
        ..setInterfaceIcon("ReplaceableTextures\\CommandButtons\\BTNSH_Armor_Upgrade_Fo.blp")
        ..setClassification("Purchasable")
        ..addStats(addRes(resType.Magical, 0.07))
        ..addStats(addRes(resType.Physical, 0.07))
        ..addStats(addAllStats(100))
        ..addStats(addHp(4000))
        ..addComponents(
        ITEM_HEAVY_SHOULDER,
        ITEM_LIGHT_ARMOR)
        ..register()
        
        addItemInBoxForDebug = DEBUG
    //I0AW
        new MyItemWithCraftInfoDefinition(ITEM_NOBLESSE_SHOULDER, jackSmithRecipe, -1)
        ..setInterfaceIcon("ReplaceableTextures\\CommandButtons\\BTNHr.BLP")    
        ..setClassification("Purchasable")
        ..addStats(addRes(resType.Magical, 0.1))
        ..addStats(addRes(resType.Physical, 0.1))
        ..addStats(addAllStats(200))
        ..addStats(addHp(6000))
        ..addStats(addAbilityAvatarMagicImmune(30, 10, 2000))
        ..addComponents(
        ITEM_ROYAL_SHOULDER,
        ITEM_AVATAR_ARMOR)
        ..register()
        addItemInBoxForDebug = false