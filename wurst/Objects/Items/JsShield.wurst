package JsShield

import MyItemDefinition
import ItemObjEditing
import MyItemIds
import Jacksmith_Q
import DebugVar

@compiletime function createItems()
    if (BUILD_JS_ITEMS)
        addItemInBoxForDebug = ADD_JS_T_ITEMS
    //I08M
        new MyItemDefinition(ITEM_FORGE_SHIELD_L1)
        ..setInterfaceIcon("ReplaceableTextures\\CommandButtons\\BTNArmorUPG2.BLP")    
        ..setClassification("Purchasable")
        ..addStats(addRes(resType.Magical, 0.01))
        ..addStats(addRes(resType.Physical, 0.01))
        ..addStats(addDamageBlock(blockType.PostResistances, 50))
        ..register()

    //I08N
        new MyItemDefinition(ITEM_FORGE_SHIELD_L2)
