package JsHelm

import MyItemDefinition
import ItemObjEditing
import MyItemIds
import Jacksmith_Q
import DebugVar

@compiletime function createItems()
    if (BUILD_JS_ITEMS)
        addItemInBoxForDebug = ADD_JS_T_ITEMS
    //I061
        new MyItemDefinition(ITEM_FORGE_HELM_L1)
        ..setInterfaceIcon("ReplaceableTextures\\CommandButtons\\BTNSteelPlateArmorHelmetFinal.blp")    
        ..setClassification("Purchasable")
        ..addStats(addHpReg(5))
        ..addStats(addRes(resType.Magical, 0.05))
        ..addStats(addRes(resType.Physical, 0.05))
        ..register()

    //I08A
        new MyItemDefinition(ITEM_FORGE_HELM_L2)
        ..setInterfaceIcon("ReplaceableTextures\\CommandButtons\\BTNSteelPlateArmorHelmetFinal.blp")    
        ..setClassification("Purchasable")
        ..addStats(addHpReg(15))
        ..addStats(addRes(resType.Magical, 0.1))
        ..addStats(addRes(resType.Physical, 0.1))
        ..register()

    //I08B
        new MyItemDefinition(ITEM_FORGE_HELM_L3)
        ..setInterfaceIcon("ReplaceableTextures\\CommandButtons\\BTNSteelPlateArmorHelmetFinal.blp")    
        ..setClassification("Purchasable")
        ..addStats(addHpReg(25))
        ..addStats(addRes(resType.Magical, 0.13))
        ..addStats(addRes(resType.Physical, 0.13))
        ..register()

    //I08C
        new MyItemDefinition(ITEM_FORGE_HELM_L4)
        ..setInterfaceIcon("ReplaceableTextures\\CommandButtons\\BTNSteelPlateArmorHelmetFinal.blp")    
        ..setClassification("Purchasable")
        ..addStats(addHpReg(45))
        ..addStats(addRes(resType.Magical, 0.2))
        ..addStats(addRes(resType.Physical, 0.2))
        ..register()
        addItemInBoxForDebug = false

    //I084
        new MyItemWithCraftInfoDefinition(ITEM_DREAD_HELM_L1, jackSmithRecipe, -1)
        ..setInterfaceIcon("ReplaceableTextures\\CommandButtons\\BTNWater Battle Helmet.blp")    
        ..setClassification("Purchasable")
        ..addStats(addHpReg(10))
        ..addStats(addRes(resType.Magical, 0.1))
        ..addStats(addRes(resType.Physical, 0.1))
        ..addComponents(
        ITEM_FORGE_HELM_L1,
        ITEM_RING_OF_REGENERATION)
        ..register()

    //I085
        new MyItemWithCraftInfoDefinition(ITEM_DREAD_HELM_L2, jackSmithRecipe, -1)
        ..setInterfaceIcon("ReplaceableTextures\\CommandButtons\\BTNWater Battle Helmet.blp")    
        ..setClassification("Purchasable")
        ..addStats(addHpReg(20))
        ..addStats(addRes(resType.Magical, 0.13))
        ..addStats(addRes(resType.Physical, 0.13))
        ..addComponents(
        ITEM_DREAD_HELM_L1,
        ITEM_BLADEBANE_ARMOR)
        ..register()

    //I087
        new MyItemWithCraftInfoDefinition(ITEM_DREAD_HELM_L3, jackSmithRecipe, -1)
        ..setInterfaceIcon("ReplaceableTextures\\CommandButtons\\BTNWater Battle Helmet.blp")    
        ..setClassification("Purchasable")
        ..addStats(addHpReg(50))
        ..addStats(addRes(resType.Magical, 0.15))
        ..addStats(addRes(resType.Physical, 0.15))
        ..addComponents(
        ITEM_DREAD_HELM_L2,
        ITEM_AMULET_OF_SPELL_SHIELD,
        ITEM_FORGE_HELM_L2)
        ..register()

    //I086
        new MyItemWithCraftInfoDefinition(ITEM_DREAD_HELM_L4, jackSmithRecipe, -1)
        ..setInterfaceIcon("ReplaceableTextures\\CommandButtons\\BTNWater Battle Helmet.blp")    
        ..setClassification("Purchasable")
        ..addStats(addHpReg(100))
        ..addStats(addRes(resType.Magical, 0.2))
        ..addStats(addRes(resType.Physical, 0.2))
        ..addComponents(
        ITEM_DREAD_HELM_L3,
        ITEM_BLOOD_GEM,
        ITEM_LIGHT_ARMOR)
        ..register()

    //I089
        new MyItemWithCraftInfoDefinition(ITEM_DREAD_HELM_L5, jackSmithRecipe, -1)
        ..setInterfaceIcon("ReplaceableTextures\\CommandButtons\\BTNWater Battle Helmet.blp")    
        ..setClassification("Purchasable")
        ..addStats(addHpReg(200))
        ..addStats(addRes(resType.Magical, 0.25))
        ..addStats(addRes(resType.Physical, 0.25))
        ..addComponents(
        ITEM_DREAD_HELM_L4,
        ITEM_FORGE_HELM_L3,
        ITEM_AVATAR_ARMOR)
        ..register()

        addItemInBoxForDebug = DEBUG
    //I088
        new MyItemWithCraftInfoDefinition(ITEM_BERSERKERS_HELM, jackSmithRecipe, -1)
        ..setInterfaceIcon("ReplaceableTextures\\CommandButtons\\BTNBerserkersHelm.blp")    
        ..setClassification("Campaign")
        ..addStats(addHpReg(300))
        ..addStats(addRes(resType.Universal, 0.3))
