@compiletime function horseUnits()
    new UnitDefinition(HORSE_UNIT_1, UnitIds.packhorse)
    ..setName("Weak Horse")
    ..setNormalAbilities(commaList(HORSE_INVENTORY_1))
    ..setScalingValue(1)
    ..setCollisionSize(0.0)
    ..setRace(Race.Commoner)
    ..setFoodCost(0)
    ..setArmorType(ArmorType.Medium)
    ..setIconGameInterface(Icons.bTNRiderlessHorse)
    ..setLumberCost(0)
    ..setSpeedBase(400)
    ..setGoldCost(250)
    ..setHitPointsMaximumBase(500)
    ..setHitPointsRegenerationRate(5.000)
    ..setHotkey("A")
    ..setDefenseBase(5)
    ..setTooltipBasic("Weak Horse")
    ..setTooltipExtended("A weak horse that can carry 4 items")

    new UnitDefinition(HORSE_UNIT_2, UnitIds.riderlesshorse)
    ..setName("Strong Horse")
    ..setNormalAbilities(commaList(HORSE_INVENTORY_2))
    ..setScalingValue(1)
    ..setCollisionSize(0.0)
    ..setRace(Race.Commoner)
    ..setFoodCost(0)
    ..setLumberCost(0)
    ..setArmorType(ArmorType.Medium)
    ..setHitPointsMaximumBase(1500)
    ..setHitPointsRegenerationRate(10.000)
    ..setIconGameInterface(Icons.bTNRiderlessHorse)
    ..setSpeedBase(522)
    ..setGoldCost(2000)
    ..setHotkey("S")
    ..setDefenseBase(5)
    ..setTooltipBasic("Strong Horse")
    ..setTooltipExtended("A strong horse that can carry 6 items")

