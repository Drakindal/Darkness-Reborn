package Tracker_Hero

import UnitIds
import ObjectIds
import MyUnitIds
import AbilityObjEditing
import MyUpgradesIds
import CommonDescriptions
import Icons
import Units
import MyHeroDefinition

@compiletime function defineHero()
    new MyHeroDefinition(HERO_TRACKER, UnitIds.sylvanuswindrunner)// Tracker (H047)
    ..setHeroAbilities(commaList('A0WF', 'A0WE', 'A0WG', 'A0WH', 'A0WI'))
    
    ..setPrimaryAttribute("Agility")
    ..setStatsBase(10, 19, 15)
    ..setStatsPerLvl(1.90, 1.50, 2.60)

    ..setScalingValue(1.15)
    
    ..setModelFile(Units.bansheeRanger1)
    ..setIconGameInterface(Icons.bTNBansheeRanger)
    ..setIconScoreScreen(Icons.bTNBansheeRanger)
    
    ..setRangedAttack(550)
    ..setAttack1CooldownTime(2.06)
    ..setAttack1DamageSidesperDie(6)
    ..setAcquisitionRange(650.00)
    ..setAttack1ProjectileArc(0.15)
    ..setAttack1ProjectileArt("Abilities\\Weapons\\MoonPriestessMissile\\MoonPriestessMissile.mdl")
    ..setAttack1AnimationBackswingPoint(0.580)
    ..setAttack1AnimationDamagePoint(0.700)
    
    ..setManaInitialAmount(200)
    
    ..setRequirements(commaList(heroPickBlocker, HERO_TRACKER_PICKED))
    ..setTurnRate(0.60)
    
    ..setName("Tracker")
    ..setTooltipBasic("|c00F7EC46Tracker|r")
    ..setTooltipExtended("|c00F7EC46Tracker|r\n"
    + "Roles: " + farmer + "\n\n"
    + "|c00EE0404Physical Damage|r: 3/5\n"
    + "|c0076ECF9Magical Damage|r: 4/5\n"
    + "|c00B0B0B0Defense|r: 1/5\n"
    + "|c00663300Utility|r: 3/5\n"
    + "|c0066FF66Healing|r: 2/5\n"
    + "Difficulty: 5/5\n")