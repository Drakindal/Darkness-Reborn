package DemonHunter_Hero

import UnitIds
import ObjectIds
import MyUnitIds
import AbilityObjEditing
import MyUpgradesIds
import CommonDescriptions
import MyHeroDefinition

@compiletime function defineHero()
    new MyHeroDefinition(HERO_DEMON_HUNTER, UnitIds.demonhunter)// Demon Hunter (E002)
    ..setHeroAbilities(commaList('A0RW', 'A0TK', 'A008', 'A0E6', 'A115'))
    
    ..setPrimaryAttribute("Agility")
    ..setStatsBase(19, 21, 16)
    ..setStatsPerLvl(2.40, 1.50, 2.10)
    
    ..setMeleeAttack()
    ..setAttack1CooldownTime(1.60)
    ..setAttack1DamageSidesperDie(9)
    ..setAttack1ProjectileArc(0.00)
    ..setAttack1ProjectileArt("Abilities\\Weapons\\DemonHunterMissile\\DemonHunterMissile.mdl")
    ..setAttack1AnimationBackswingPoint(0.600)
    ..setAttack1AnimationDamagePoint(0.300)
    
    ..setHitPointsRegenerationType("night")
    ..setHitPointsRegenerationRate(0.50)
    
    ..setRequirements(commaList(HERO_DEMON_HUNTER_PICKED))
    
    ..setName("Demon Hunter")
    ..setTooltipBasic("|c00F7EC46Demon Hunter|r")
    ..setTooltipExtended("|c00F7EC46Demon Hunter|r\n"
    + "Roles: " + farmer + "\n\n"
    + "|c00EE0404Physical Damage|r: 4/5\n"
    + "|c0076ECF9Magical Damage|r: 3/5\n"
    + "|c00B0B0B0Defense|r: 2/5\n"
    + "|c00663300Utility|r: 1/5\n"
    + "|c0066FF66Healing|r: 0/5\n"
    + "Difficulty: 2/5\n")