package DemonHunter_Abilities

import MyAbilityIds
import MyHeroAbilityDefinition
import MyUnitIds
import AbilityObjEditing
import MyColors
import CommonDescriptions

// ----------------------------------------------------------------------------

@compiletime function defineAbilities()

    new AbilityDefinitionFarseerChainLightning(DEMON_HUNTER_ABILITY_1)
    ..presetAreaofEffect(lvl -> 1.0)
    ..presetCooldown(lvl -> 21.0 - lvl)
    ..presetManaCost(lvl -> 80 + 20 * lvl)
    ..presetDamageperTarget(lvl -> 0.0)
    ..presetNumberofTargetsHit(lvl -> 1)
    ..presetDamageReductionperTarget(lvl -> 0.0)
    ..presetCastRange(lvl -> 650.0)
    ..setGeneralAbility(AbilityPosition.Q)
    ..register(HERO_DEMON_HUNTER, "Chain Flash".setColor(colAbilitiesDemonHunter), 
    "Demon Hunter channels his own power into his weapon striking an enemy with lightning and dealing {0} x Agility + {1} damage to all enemies within 500 range.",
    (string format) -> format.format("2 x (Skill Level)", "300 x (Skill Level)"),
    (string format, int lvl) -> format.format((2*lvl).toString(), (300*lvl).toString()))
    
// ----------------------------------------------------------------------------

    new AbilityDefinitionShadowHunterHex(DEMON_HUNTER_ABILITY_2)
    ..presetCooldown(lvl -> 12.0)
    ..setManaCost(1, 70)
    ..setManaCost(2, 80)
    ..setManaCost(3, 90)
    ..setManaCost(4, 100)
    ..setManaCost(5, 120)
    ..setManaCost(6, 140)
    ..setManaCost(7, 170)
    ..setManaCost(8, 200)
    ..setManaCost(9, 240)
    ..presetDuration(lvl -> 1.5 + 0.5*lvl)
    ..setGeneralAbility(AbilityPosition.W)
    ..register(HERO_DEMON_HUNTER, "Hex".setColor(colAbilitiesDemonHunter), 
    "Transforms an enemy into random animal for {0} seconds.",
    (string format) -> format.format("2 + 0.5 x (Skill Level - 1)"),
    (string format, int lvl) -> format.format((1.5 + 0.5*lvl).toString(1)))
    
// ----------------------------------------------------------------------------

constant real array[9] abi3_Evasion = [
    0.10,
    0.15,
    0.20,
    0.25,
    0.35,
    0.45,
    0.55,
    0.65,
    0.75
]

@compiletime function defineAbilities3()
    new AbilityDefinitionDemonHunterEvasion(DEMON_HUNTER_ABILITY_3)
    ..presetChancetoEvade(lvl -> abi3_Evasion[lvl-1])
    ..setGeneralAbility(AbilityPosition.E)
    ..register(HERO_DEMON_HUNTER, "Evasion".setColor(colAbilitiesDemonHunter),
    wordEvasion + "Gives the Demon Hunter a chance to avoid attacks.",
    (int lvl) -> wordEvasion + "{0}% evasion.".setColor(colEvasion).format((100*abi3_Evasion[lvl-1]).toString()))

// ----------------------------------------------------------------------------

constant int array[9] abi4_Agi = [
     30,
     45,
     60,
     75,
     90,
    105,
    120,
    135,
    150
]

@compiletime function defineAbilities4()
    new AbilityDefinitionAttributeModifierSkill(DEMON_HUNTER_ABILITY_4)
    ..presetStrengthBonus(lvl -> 5 + 5*lvl)
    ..presetAgilityBonus(lvl -> abi4_Agi[lvl-1])
    ..presetIntelligenceBonus(lvl -> 5 + 5*lvl)
    ..setIcon("ReplaceableTextures\\CommandButtons\\PAS_cr_CarA10.blp")
    ..setGeneralAbility(AbilityPosition.R)
    ..register(HERO_DEMON_HUNTER, "Demon Power".setColor(colAbilitiesDemonHunter), 
    "Demon Hunter releases his power after 25 times attack increasing his amount of Agility fold 10 times. Also he passively gets a large amount of Agility along with a small amount of Strength and Intelligence.",
    (int lvl) -> "+{0} Strength, +{1} Agility, +{2} Intelligence. Increased power lasts for {3} attacks.".format((5 + 5*lvl).toString(), abi4_Agi[lvl-1].toString(), (5 + 5*lvl).toString(), (lvl + 1).toString()))

// ----------------------------------------------------------------------------

constant real array[9] abi5_Range = [
      500,
     1000,
     2000,
     4000,
     5000,
    10000,
    16000,
    22000,
    32000
]

@compiletime function defineAbilities5()
    new AbilityDefinitionWardenBlink(DEMON_HUNTER_ABILITY_5)
    ..presetCooldown(lvl -> 21.0 - lvl)
    ..presetManaCost(lvl -> 50 + 50*lvl)
    ..presetMaximumRange(lvl -> abi5_Range[lvl-1])
    ..setAreaEffect("Grin Curse.mdx")
    ..setArtSpecial("Grin Curse.mdx")
    ..setGeneralAbility(AbilityPosition.T)
    ..register(HERO_DEMON_HUNTER, "Shadow Blink".setColor(colAbilitiesDemonHunter), 
    "Demon Hunter immediately moves through the shadows to another location.",
    (int lvl) -> "Blink: {0} range, cd {1} seconds.".format(abi5_Range[lvl-1].toString(), (21.0 - lvl).toString(0)))

// ----------------------------------------------------------------------------