package DemonHunter_Q

import ClosureForGroups
import Abilities
import ClosureTimers
import DamageTarget
import ClosureEvents
import MyAbilityIds

public function chainFlash()
    EventListener.onTargetCast(DEMON_HUNTER_ABILITY_1) (unit caster, unit target) ->
        let targetPos = target.getPos()
        let lvl = GetUnitAbilityLevel(caster, DEMON_HUNTER_ABILITY_1)
        let dmg = ((caster.getAgi(true)*lvl*2)+(lvl*300.))
        doAfter(0.5) -> 
            forUnitsInRange(targetPos, 300, true) (unit u) ->
                if caster.isEnemyOf(u) and u.isAlive()
                    u.setPos(targetPos)
                    flashEffect(Abilities.warStompCaster, targetPos)
                    caster.damageTargetCode(dmg, u, null, -1, customDamageType.Magical)