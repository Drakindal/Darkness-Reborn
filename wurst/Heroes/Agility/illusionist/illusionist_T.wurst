package illusionist_T

import ClosureEvents
import MyAbilityIds
import illusionist_Abilities
import DummyCaster
import Orders

public function illusionist_T_twinShadows()
    EventListener.onCast(ILLUSIONIST_ABILITY_5) (unit caster) ->
        let lvl = caster.getAbilityLevel(ILLUSIONIST_ABILITY_5)
        for int idx = 1 to illusionist_abi5_Images[lvl-1]
            new DummyCaster()
            ..owner(caster.getOwner())
            ..origin(caster.getPos())
            ..castTarget(ILLUSIONIST_ABILITY_5_DUMMY, lvl, OrderIds.wandOfIllusion, caster)