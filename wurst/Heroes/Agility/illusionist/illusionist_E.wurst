package illusionist_E

import Global_Variables
import DummyCaster
import ClosureTimers
import DamageEvent
import MyAbilityIds
import OrderIds
import RandomGen
import illusionist_Abilities

int limit = 0

public function juxtapose()
    DamageEvent.addListener(1) ->
        let src = DamageEvent.getSource()
        if (DamageEvent.getType() == ATTACK)
            let damtyp = DamageEvent.getDamageType()
            if (damtyp == DAMAGE_TYPE_NORMAL or damtyp == DAMAGE_TYPE_MAGIC)
                let lvl = src.getAbilityLevel(ILLUSIONIST_ABILITY_3)
                if checkChanceI(lvl)
                    if playerHero.has(src.getOwner())
                        if(limit < lvl * 0.25)
                            limit++
                            new DummyCaster()
                            ..owner(GetOwningPlayer(src))
                            ..origin(src.getPos())
                            ..castTarget(ILLUSIONIST_ABILITY_3_ILLUSION, lvl, OrderIds.wandOfIllusion, src)
                            let bonusAttack = (src.getBaseDamage(0) * (illusionist_abi3_DamageMult[lvl-1] - 1)).toInt()
                            src.setBaseDamage(bonusAttack + src.getBaseDamage(0), 0)
                            doAfter(6) -> 
                                src.setBaseDamage(src.getBaseDamage(0) - bonusAttack, 0)
                                limit--


// Illidan (Juxtapose) E
                