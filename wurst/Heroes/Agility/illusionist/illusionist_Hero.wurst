package illusionist_Hero

import UnitIds
import ObjectIds
import MyUnitIds
import AbilityObjEditing
import MyUpgradesIds
import CommonDescriptions
import MyHeroDefinition

@compiletime function defineHero()

    new MyHeroDefinition(HERO_ILLUSIONIST, UnitIds.illidan)// Illusionist (E005)
    ..setHeroAbilities(commaList('A0TQ', 'A0TN', 'A0S8', 'A0TO', 'A0TP'))
    
    ..setPrimaryAttribute("Agility")
    ..setStatsBase(21, 22, 16)
    ..setStatsPerLvl(2.40, 1.50, 2.10)
    
    ..setModelFile("Units\\Illusionist\\Salandria\\Salandria.mdx")
    ..setIconGameInterface("Units\\Illusionist\\BTNHeroSalandria\\BTNHeroSalandria.blp")
    ..setIconScoreScreen("Units\\Illusionist\\BTNHeroSalandria\\BTNHeroSalandria.blp")

    ..setMeleeAttack()
    ..setAttack1CooldownTime(1.90)
    ..setAttack1DamageSidesperDie(9)
    ..setAttack1ProjectileArc(0.00)
    ..setAttack1ProjectileArt("Abilities\\Weapons\\IllidanMissile\\IllidanMissile.mdl")
    ..setAttack1ProjectileHomingEnabled(true)
    ..setAttack1AnimationBackswingPoint(0.600)
    ..setAttack1AnimationDamagePoint(0.300)
    
    ..setHitPointsRegenerationRate(0.50)
    ..setHitPointsRegenerationType("night")
    ..setManaInitialAmount(200)
    
    ..setMovementType(MovementType.Amphipic)
    ..setRequirements(commaList(HERO_ILLUSIONIST_PICKED))
    
    ..setName("Illusionist")
    ..setProperNames(commaList("Illusionist"))
    ..setTooltipBasic("|c00F7EC46Illusionist|r")
    ..setTooltipExtended("|c00F7EC46Illusionist|r\n"
    + "Roles: " + farmer + "/" + stacker + "\n\n"
    + "|c00EE0404Physical Damage|r: 5/5\n"
    + "|c0076ECF9Magical Damage|r: 1/5\n"
    + "|c00B0B0B0Defense|r: 2/5\n"
    + "|c00663300Utility|r: 2/5\n"
    + "|c0066FF66Healing|r: 0/5\n"
    + "Difficulty: 2/5\n")