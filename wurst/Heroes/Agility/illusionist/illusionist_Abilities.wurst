@compiletime function defineAbilities2()
    new AbilityDefinitionBladeMasterMirrorImage(ILLUSIONIST_ABILITY_2)
    ..setGeneralAbility(AbilityPosition.W)
    ..setCooldown(1, 25.0)
    ..setCooldown(2, 25.0)
    ..setCooldown(3, 25.0)
    ..setCooldown(4, 25.0)
    ..setCooldown(5, 20.0)
    ..setCooldown(6, 20.0)
    ..setCooldown(7, 20.0)
    ..setCooldown(8, 20.0)
    ..setCooldown(9, 15.0)
    ..setManaCost(1, 120)
    ..setManaCost(2, 135)
    ..setManaCost(3, 150)
    ..setManaCost(4, 170)
    ..setManaCost(5, 190)
    ..setManaCost(6, 215)
    ..setManaCost(7, 240)
    ..setManaCost(8, 270)
    ..setManaCost(9, 315)
    ..presetDuration(lvl -> 15.0)
    ..presetNumberofImages(lvl -> abi2_Images[lvl - 1])
    ..presetDamageDealt(lvl -> abi2_DamageDealt[lvl - 1])
    ..presetDamageTaken(lvl -> abi2_DamageTaken[lvl - 1])
    ..setIcon("ReplaceableTextures\\CommandButtons\\BTNShadown (3).blp")
    ..register(HERO_ILLUSIONIST, "Dark Shadow".setColor(colAbilitiesIllusionist), 
    "Illusionist summons shadow illusions that distract enemies.",
    (int lvl) -> "Creates {0} illusions that deal {1}% damage and take {2}% damage.".format(abi2_Images[lvl - 1].toString(), (100*abi2_DamageDealt[lvl - 1]).toString(0), (100*abi2_DamageTaken[lvl - 1]).toString(0)))
    
