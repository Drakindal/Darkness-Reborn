constant int array[4] abi5_Images = [
    1,
    2,
    3,
    4
]

constant real array[4] abi5_DamageDealt = [
    0.90,
    1.10,
    1.60,
    2.25
]

constant real array[4] abi5_DamageTaken = [
    1.25,
    0.90,
    0.80,
    0.60
]

@compiletime function defineAbilities5()
    new AbilityDefinitionBladeMasterMirrorImage(ILLUSIONIST_ABILITY_5)
    ..setUltimateAbility()
    ..presetCooldown(lvl -> 60.0 - 8*(lvl-1))
    ..presetDuration(lvl -> 60.0 - 7*(lvl-1))
    ..presetManaCost(lvl -> 100 + 100*lvl)
    ..presetNumberofImages(lvl -> abi2_Images[lvl - 1])
    ..presetDamageDealt(lvl -> abi2_DamageDealt[lvl - 1])
    ..presetDamageTaken(lvl -> abi2_DamageTaken[lvl - 1])
    ..setOrderStringUseTurnOn(OrderIds.berserk.toRawCode())
    ..setIcon("ReplaceableTextures\\CommandButtons\\BTNShadown (4).blp")
    ..register(HERO_ILLUSIONIST, "Twin Shadows".setColor(colAbilitiesIllusionist), 
    "",
    (int lvl) -> "Summon {0} illusions that deal {1}% and receive {2}% damage, last {3} seconds (cd {4} seconds).".format(abi2_Images[lvl - 1].toString(), (100*abi2_DamageDealt[lvl - 1]).toString(), (100*abi2_DamageTaken[lvl - 1]).toString(), (60.0 - 8*(lvl-1)).toString(0), (60.0 - 7*(lvl-1)).toString()))
    

