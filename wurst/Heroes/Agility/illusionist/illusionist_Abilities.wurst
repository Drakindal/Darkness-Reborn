package illusionist_Abilities

import MyAbilityIds
import MyHeroAbilityDefinition
import MyUnitIds
import AbilityObjEditing
import ObjectIds
import MyColors
import Orders

// ----------------------------------------------------------------------------

constant real array[9] abi1_Damage = [
      200.0,
      350.0,
      550.0,
      800.0,
     1200.0,
     1800.0,
     2600.0,
     3800.0,
     6500.0
]

@compiletime function defineAbilities()

    // WIP. Add stats scaling.
    new AbilityDefinitionDreadlordCarrionSwarm(ILLUSIONIST_ABILITY_1)
    ..setGeneralAbility(AbilityPosition.Q)
    ..presetCooldown(lvl -> 21.0 - lvl)
    ..setManaCost(1, 80)
    ..setManaCost(2, 120)
    ..setManaCost(3, 160)
    ..setManaCost(4, 190)
    ..setManaCost(5, 215)
    ..setManaCost(6, 240)
    ..setManaCost(7, 270)
    ..setManaCost(8, 300)
    ..setManaCost(9, 360)
    ..presetDamage(lvl -> abi1_Damage[lvl - 1])
    ..presetMaxDamage(lvl -> 999999.0)
    ..setArtSpecial("")
    ..register(HERO_ILLUSIONIST, "Shadow Swarm".setColor(colAbilitiesIllusionist),
    "Create a stream of dark energy moving towards the enemies.",
    (int lvl) -> "Deals {0} damage per target.".format(abi1_Damage[lvl - 1].toString()))

// ----------------------------------------------------------------------------

