@compiletime function defineAbilities3()
    new AbilityDefinitionItemIllusion(ILLUSIONIST_ABILITY_3_ILLUSION)
    ..setLevels(9)
    ..presetTargetsAllowed(lvl -> commaList("ground", "structure", "debris", "air", "item", "ward"))
    ..presetDuration(lvl -> 6)
    ..presetDamageReceivedMultiplier(lvl -> abi3_DamageTaken[lvl - 1])
    ..presetDamageDealtofnormal(lvl -> abi3_DamageDealt[lvl - 1])

    new AbilityDefinitionMountainKingBash(ILLUSIONIST_ABILITY_3)
    ..setGeneralAbility(AbilityPosition.E)
    ..presetBuffs(lvl -> "B017")
    ..presetChancetoBash(lvl -> 0.0)
    ..presetDamageBonus(lvl -> 0.0)
    ..presetDuration(lvl -> 0.01)
    ..setIcon("ReplaceableTextures\\CommandButtons\\PASShadown (1).blp")
    ..register(HERO_ILLUSIONIST, "Juxtapose".setColor(colAbilitiesIllusionist), 
    "",
    (int lvl) -> "Shadow Dance has {0}% chance to create 1 illusion, that deals {1}% and takes {2}% damage, and to increase his base damage fold {3} times.".format(
        lvl.toString(),
        (100*abi3_DamageDealt[lvl - 1]).toString(0),
        (100*abi3_DamageTaken[lvl - 1]).toString(0),
        illusionist_abi3_DamageMult[lvl - 1].toString(1))
    )

// ----------------------------------------------------------------------------

    new AbilityDefinitionMoonPriestessTrueshotAura(ILLUSIONIST_ABILITY_4)
    ..setGeneralAbility(AbilityPosition.R)
    ..presetAreaofEffect(lvl -> 0.0)
    ..presetBuffs(lvl -> "")
    ..presetDamageBonus(lvl -> 0.0)
    ..setIcon("ReplaceableTextures\\CommandButtons\\PASShadown (2).blp")
    ..setArtTarget("")
    ..setTargetAttachmentPoint("")
    ..register(HERO_ILLUSIONIST, "Shadow Dancer".setColor(colAbilitiesIllusionist), 
    "",
    (int lvl) -> "Illusionist has a {0}% chance to absorb power of dying or disappearing illusion and obtain 2 Agility.".format((lvl*7).toString()))
    
