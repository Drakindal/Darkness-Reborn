package illusionist_Q

import ClosureForGroups
import Abilities
import ClosureTimers
import DamageTarget
import ClosureEvents
import MyAbilityIds

public function illusionist_Q_ShadowSwarm()
    EventListener.onPointCast(ILLUSIONIST_ABILITY_1) (unit caster, vec2 target) ->
        let lvl = GetUnitAbilityLevel(caster, ILLUSIONIST_ABILITY_1)
        let dmg = ((caster.getAgi(true)*lvl*2)+(lvl*300.))
        doAfter(0.5) ->
            forUnitsInRange(targetPos, 500, true) (unit u) ->
                if caster.isEnemyOf(u)
                    u.setPos(targetPos)
                    flashEffect(Abilities.warStompCaster, targetPos)
                    caster.damageTargetCode(dmg, u, null, -1, customDamageType.Magical)