package Blademaster_Hero

import UnitIds
import ObjectIds
import MyUnitIds
import AbilityObjEditing
import MyUpgradesIds
import CommonDescriptions
import MyHeroDefinition

@compiletime function defineHero()

    new MyHeroDefinition(HERO_BLADEMASTER, UnitIds.blademaster)// Blademaster (O000)
    ..setHeroAbilities(commaList('A07M', 'A07N', 'A07Q', 'A07O', 'A00Y'))
    
    ..setPrimaryAttribute("Agility")
    ..setStatsBase(18, 22, 16)
    ..setStatsPerLvl(2.00, 1.75, 2.25)
    
    ..setSelectionScale(1.25)

    ..setMeleeAttack()
    ..setAttack1CooldownTime(1.77)
    ..setAttack1DamageSidesperDie(9)
    ..setAttack1AnimationBackswingPoint(0.840)
    ..setAttack1AnimationDamagePoint(0.330)
    
    ..setTurnRate(0.60)
    ..setRequirements(commaList(HERO_BLADEMASTER_PICKED))
    
    ..setTooltipExtended(
    rolesList(roleFarmer),
    PhysDamage.v3,
    MagicDamage.v1,
    Defense.v1,
    Utility.v1,
    Healing.v0,
    Difficulty.v2)