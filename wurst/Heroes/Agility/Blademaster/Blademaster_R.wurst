package Blademaster_R

import ClosureTimers
import Abilities
import ClosureForGroups
import DamageTarget
import PauseAllocation
import ClosureEvents
import MyAbilityIds

function rampageCond() returns boolean
    return GetSpellAbilityId() == BLADEMASTER_ABILITY_4

function rampage2(unit caster, unit target)
    let lvl = GetUnitAbilityLevel(caster, BLADEMASTER_ABILITY_4)
    let dmg = caster.getAgi(true)*lvl*0.5 + 50*lvl
    let radius = 300.0 + 30*lvl
    doPeriodicallyCounted(0.3, 11) (CallbackCounted cb) ->
        forUnitsInRange(caster.getPos(), radius, true) (unit u) ->
            if caster.isEnemyOf(u)
                if not target.isAlive()
                    caster.unPauseUnitIndef()
                    caster.setInvulnerable(false)
                    target.unPauseUnitIndef()
                else
                    caster.setAnimation("attack")
                    flashEffect(Abilities.warStompCaster, target.getPos())
                    caster.damageTargetCode(dmg, target, null, -1, customDamageType.PhysicalMelee)
        if cb.isLast()
            caster.unPauseUnitIndef()
            caster.setInvulnerable(false)
            target.unPauseUnitIndef()
            caster.setPathing(true)

public function rampage()
    EventListener.onTargetCast(BLADEMASTER_ABILITY_4) (unit caster, unit target) ->
        doAfter(0.5) -> 
            caster.pauseIndef()
            caster.setInvulnerable(true)
            target.pauseIndef()
            SetUnitPathing(caster, false)
            doPeriodically(0.02) (CallbackPeriodic cb) ->
                let isAlive = target.isAlive()
                if (isAlive)
                    let posC = caster.getPos()
                    let posT = target.getPos()
                    let angle = posC.angleTo(posT)
                    let newPos = posC.polarOffset(angle, 7.)
                    caster..setPos(newPos).setFacing(angle)
                    let dist = newPos.distanceTo(posT)
                    if(dist <= 7.)
                        rampage2(caster, target)
                        destroy cb
                else
                    caster.unPauseUnitIndef()
                    caster.setInvulnerable(false)
                    destroy cb