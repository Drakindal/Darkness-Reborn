package Blademaster_Abilities

import MyAbilityIds
import MyHeroAbilityDefinition
import MyUnitIds
import AbilityObjEditing
import MyColors
import DebugVar

// ----------------------------------------------------------------------------

public constant real array[9] abi1_Damage = [
  150.0,
  340.0,
  620.0,
  960.0,
 1220.0,
 1840.0,
 2560.0,
 3600.0,
 6200.0
]

@compiletime function defineAbilities()
    if (BUILD_AGI_HEROES)
        // WIP Add stats scale.
        new AbilityDefinitionBladeMasterWindWalk(BLADEMASTER_ABILITY_1)
        ..setGeneralAbility(AbilityPosition.Q)
        ..presetCooldown(lvl -> 19.0 - lvl)
        ..presetManaCost(lvl -> 25 + 10 * lvl)
        ..presetDuration(lvl -> 8.0 + 2*lvl)
        ..presetTransitionTime(lvl -> 0.2)
        ..presetMovementSpeedIncrease(lvl -> 0.1*lvl)
        ..presetBackstabDamage(lvl -> true)
        ..presetBackstabDamage1(lvl -> abi1_Damage[lvl - 1])
        ..register(HERO_BLADEMASTER, "Wind Walk".setColor(colAbilitiesBlademaster), 
        "Allows the Blademaster to become invisible, and move faster for a set amount of time. When the Blademaster attacks a unit to break invisibility, he will deal bonus damage.",
        (int lvl) -> "+{0}% Movement speed, {1} damage. Duration {2} sec. Cd {3} sec.".format(
            (10*lvl).toString(),
            abi1_Damage[lvl - 1].toString(0),
            (8.0 + 2*lvl).toString(0),
            (19 - lvl).toString()
        ))
    
// ----------------------------------------------------------------------------

