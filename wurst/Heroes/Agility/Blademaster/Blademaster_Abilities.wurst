package Blademaster_Abilities

import MyAbilityIds
import MyHeroAbilityDefinition
import MyUnitIds
import AbilityObjEditing
import MyColors

// ----------------------------------------------------------------------------

constant real array[9] abi1_Damage = [
  200.0,
  600.0,
 1200.0,
 2000.0,
 3000.0,
 4000.0,
 6000.0,
 8000.0,
12000.0
]

@compiletime function defineAbilities()
    new AbilityDefinitionBladeMasterWindWalk(BLADEMASTER_ABILITY_1)
    ..presetCooldown(lvl -> 19.0 - lvl)
    ..presetManaCost(lvl -> 25 + 10 * lvl)
    ..presetDuration(lvl -> 8.0 + 2*lvl)
    ..presetTransitionTime(lvl -> 0.2)
    ..presetMovementSpeedIncrease(lvl -> 0.1*lvl)
    ..presetBackstabDamage1(lvl -> abi1_Damage[lvl - 1])
    ..setGeneralAbility(AbilityPosition.Q)
    ..register(HERO_BLADEMASTER, "Wind Walk".setColor(colAbilitiesBlademaster), 
    "Allows the Blademaster to become invisible, and move faster for a set amount of time. When the Blademaster attacks a unit to break invisibility, he will deal bonus damage.",
    (int lvl) -> "+{0}% Movementspeed, {1} damage, {2} second duration".format((10*lvl).toString(), abi1_Damage[lvl - 1].toString(0), (8.0 + 2*lvl).toString(0)))
    
// ----------------------------------------------------------------------------

constant int array[9] abi2_Images = [
    2,
    2,
    3,
    3,
    4,
    4,
    5,
    5,
    6
]

constant real array[9] abi2_DamageDealt = [
    0.25,
    0.50,
    0.25,
    0.50,
    0.25,
    0.50,
    0.50,
    0.60,
    0.60
]

constant real array[9] abi2_DamageTaken = [
    2.50,
    2.00,
    2.50,
    2.00,
    2.00,
    1.50,
    2.00,
    1.50,
    1.25
]

@compiletime function defineAbilities2()
    new AbilityDefinitionBladeMasterMirrorImage(BLADEMASTER_ABILITY_2)
    ..presetCooldown(lvl -> 30.0)
    ..presetManaCost(lvl -> 120 + 15 * lvl)
    ..presetNumberofImages(lvl -> abi2_Images[lvl - 1])
    ..presetDamageDealt(lvl -> abi2_DamageDealt[lvl - 1])
    ..presetDamageTaken(lvl -> abi2_DamageTaken[lvl - 1])
    ..presetDuration(lvl -> 30.0)
    ..setGeneralAbility(AbilityPosition.W)
    ..register(HERO_BLADEMASTER, "Mirror Image".setColor(colAbilitiesBlademaster), 
    "Confuses the enemy by creating illusions of the Blademaster and dispelling all magic from the Blademaster (cd 30 sec).",
    (int lvl) -> "Creates {0} illusions that deal {1}% damage and take {2}% damage.".format(abi2_Images[lvl - 1].toString(), (100*abi2_DamageDealt[lvl - 1]).toString(0), (100*abi2_DamageTaken[lvl - 1]).toString(0)))
    
// ----------------------------------------------------------------------------

    new AbilityDefinitionMountainKingThunderBolt(BLADEMASTER_ABILITY_3)
    ..presetBuffs(lvl -> "")
    ..setCooldown(1, 15)
    ..setCooldown(2, 15)
    ..setCooldown(3, 14)
    ..setCooldown(4, 14)
    ..setCooldown(5, 13)
    ..setCooldown(6, 13)
    ..setCooldown(7, 12)
    ..setCooldown(8, 12)
    ..setCooldown(9, 11)
    ..presetManaCost(lvl -> 50 + 20 * lvl)
    ..setDuration(1, 3.0)
    ..setDuration(2, 3.5)
    ..setDuration(3, 4.0)
    ..setDuration(4, 4.5)
    ..setDuration(6, 5.5)
    ..setDuration(7, 6.0)
    ..setDuration(8, 6.5)
    ..setDuration(9, 7.0)
    ..presetDamage(lvl -> 0.0)
    ..presetCastRange(lvl -> 900.0)
    ..presetTargetsAllowed(lvl -> getTargets(AbilityTargets.EnemiesAll))
    ..setMissileSpeed(9999)
    ..setMissileArt("")
    ..setAnimationNames("slam")
    ..setIcon("ReplaceableTextures\\PassiveButtons\\PASBTNLiquidFire.blp")
    ..setIconTurnOff("ReplaceableTextures\\CommandButtons\\BTNAdept 002.blp")
    ..setGeneralAbility(AbilityPosition.R)
    ..register(HERO_BLADEMASTER, "Rampage".setColor(colAbilitiesBlademaster), 
    "",
    (string format) -> "Blademaster quickly moves to his target, slashing it several times and stunning it for a duration. May hit other units in range of the target.",
    (string format, int lvl) -> "Blademaster moves to his target and slashes it {0} times, stunning for {1} seconds. Each hit deals {2} damage.".format((lvl + 2).toString(), "{0} + ({1} x Agility)".format((500*lvl).toString(), (0.5*lvl).toString(1))))
    
// ----------------------------------------------------------------------------

    new AbilityDefinitionBladeMasterCriticalStrike(BLADEMASTER_ABILITY_4)
    ..presetChancetoCriticalStrike(lvl -> 7.5 + 2.5*lvl)
    ..presetDamageMultiplier(lvl -> 3.0 + lvl)
    ..setGeneralAbility(AbilityPosition.E)
    ..register(HERO_BLADEMASTER, "Critical Strike".setColor(colAbilitiesBlademaster), 
    "Gives a chance that the Blademaster will do more damage on his attacks.",
    (int lvl) -> "{0}% chance to deal x{1} damage".format((7.5 + 2.5*lvl).toString(1), (3 + lvl).toString()))
    
// ----------------------------------------------------------------------------

    new AbilityDefinitionDreadlordCarrionSwarm(BLADEMASTER_ABILITY_5)
    ..presetAreaofEffect(lvl -> 0.0)
    ..presetCooldown(lvl -> 140.0 - 20 * lvl)
    ..presetManaCost(lvl -> 150 * lvl)
    ..presetDamage(lvl -> 0.0)
    ..presetMaxDamage(lvl -> 0.0)
    ..presetDistance(lvl -> 0.0)
    ..presetFinalArea(lvl -> 0.0)
    ..setMissileSpeed(0)
    ..presetCastRange(lvl -> 600.0)
    ..setIcon("ReplaceableTextures\\CommandButtons\\BTNWhirlwind.blp")
    ..setMissileArt("")
    ..setArtSpecial("")
    ..setUltimateAbility()
    ..register(HERO_BLADEMASTER, "Haste Slash".setColor(colAbilitiesBlademaster), 
    "Blademaster begins to spin rapidly at a target location, dealing damage and ending with a huge finishing burst of damage.",
    (int lvl) -> "Deals {0} x Agi + {1} damage per second and 4 more times at the end of the cast.".format((0.75*lvl).toString(2), (2000*lvl).toString()))