@compiletime function defineAbilities2()
    if (BUILD_AGI_HEROES)
        new AbilityDefinitionBladeMasterMirrorImage(BLADEMASTER_ABILITY_2)
        ..setGeneralAbility(AbilityPosition.W)
        ..presetCooldown(lvl -> 30.0)
        ..presetManaCost(lvl -> 120 + 15 * lvl)
        ..presetNumberofImages(lvl -> abi2_Images[lvl - 1])
        ..presetDamageDealt(lvl -> abi2_DamageDealt[lvl - 1])
        ..presetDamageTaken(lvl -> abi2_DamageTaken[lvl - 1])
        ..presetDuration(lvl -> 30.0)
        ..register(HERO_BLADEMASTER, "Mirror Image".setColor(colAbilitiesBlademaster), 
        "Confuses the enemy by creating illusions of the Blademaster and dispelling all magic from the Blademaster (cd 30 sec).",
        (int lvl) -> "Creates {0} illusions that deal {1}% damage and take {2}% damage.".format(
            abi2_Images[lvl - 1].toString(),
            (100*abi2_DamageDealt[lvl - 1]).toString(0),
            (100*abi2_DamageTaken[lvl - 1]).toString(0)
        ))
    
// ----------------------------------------------------------------------------

        new AbilityDefinitionBladeMasterCriticalStrike(BLADEMASTER_ABILITY_3)
        ..setGeneralAbility(AbilityPosition.E)
        ..presetChancetoCriticalStrike(lvl -> 7.5 + 2.5*lvl)
        ..presetDamageMultiplier(lvl -> 3.0 + lvl)
        ..register(HERO_BLADEMASTER, "Critical Strike".setColor(colAbilitiesBlademaster), 
        "Gives a chance that the Blademaster will do more damage on his attacks.",
        (int lvl) -> "{0}% chance to deal x{1} damage".format(
            (7.5 + 2.5*lvl).toString(1),
            (3 + lvl).toString()
        ))
    
// ----------------------------------------------------------------------------

        new AbilityDefinitionMountainKingThunderBolt(BLADEMASTER_ABILITY_4)
        ..setGeneralAbility(AbilityPosition.R)
        ..presetBuffs(lvl -> "")
        ..setCooldown(1, 15)
        ..setCooldown(2, 15)
        ..setCooldown(3, 14)
        ..setCooldown(4, 14)
        ..setCooldown(5, 13)
        ..setCooldown(6, 13)
        ..setCooldown(7, 12)
        ..setCooldown(8, 12)
        ..setCooldown(9, 11)
        ..presetManaCost(lvl -> 50 + 20 * lvl)
        ..presetDuration(lvl -> 0.5*lvl + 2)
        ..presetDamage(lvl -> 0.0)
        ..presetCastRange(lvl -> 900.0)
        ..presetTargetsAllowed(lvl -> getTargets(AbilityTargets.EnemiesAll))
        ..setMissileSpeed(9999)
        ..setMissileArt("")
        ..setAnimationNames("slam")
        ..setIcon("ReplaceableTextures\\PassiveButtons\\PASBTNLiquidFire.blp")
        ..setIconTurnOff("ReplaceableTextures\\CommandButtons\\BTNAdept 002.blp")
        ..register(HERO_BLADEMASTER, "Rampage".setColor(colAbilitiesBlademaster), 
        "Blademaster quickly moves to the target slashing it 11 times and stunning it. Also Blademaster deals the same amount of damage to all enemies around the target.",
        (int lvl) -> "Deals {0} + {1} x Agi damage in {2} range. Stun duration {3} sec.".format(
            (50*lvl).toString(),
            (0.5*lvl).toString(1),
            (300 + 30*lvl).toString(),
            (0.5*lvl + 2).toString()
        ))
        
// ----------------------------------------------------------------------------

        new AbilityDefinitionDreadlordCarrionSwarm(BLADEMASTER_ABILITY_5)
        ..setUltimateAbility()
        ..presetAreaofEffect(lvl -> 0.0)
        ..presetCooldown(lvl -> 140.0 - 20 * lvl)
        ..presetManaCost(lvl -> 150 * lvl)
        ..presetDamage(lvl -> 0.0)
        ..presetMaxDamage(lvl -> 0.0)
        ..presetDistance(lvl -> 0.0)
        ..presetFinalArea(lvl -> 0.0)
        ..setMissileSpeed(0)
        ..presetCastRange(lvl -> 600.0)
        ..setIcon("ReplaceableTextures\\CommandButtons\\BTNWhirlwind.blp")
        ..setMissileArt("")
        ..setArtSpecial("")
        ..register(HERO_BLADEMASTER, "Haste Slash".setColor(colAbilitiesBlademaster), 
        "Blademaster begins to spin rapidly at a target location, dealing damage for all units in 350 range and ending with a huge finishing burst of damage (x4 damage).",
        (int lvl) -> "Deals {0} x Agi + {1} damage every 0.3 sec within 3 sec.".format(
            (0.75*lvl).toString(2),
            (3000*lvl).toString()
        ))
        
