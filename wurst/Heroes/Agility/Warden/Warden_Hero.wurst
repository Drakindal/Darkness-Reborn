package Warden_Hero

import UnitIds
import ObjectIds
import MyUnitIds
import AbilityObjEditing
import MyUpgradesIds
import CommonDescriptions
import MyHeroDefinition

@compiletime function defineHero()
    new MyHeroDefinition(HERO_WARDEN, UnitIds.warden)// Warden (E013)
    ..setHeroAbilities(commaList('A002', 'A116', 'A0D8', 'A014', 'A00T'))
    
    
    ..setPrimaryAttribute("Agility")
    ..setStatsBase(18, 20, 16)
    ..setStatsPerLvl(2.40, 1.60, 2.00)
    
    ..setMeleeAttack()
    ..setAttack1CooldownTime(2.05)
    ..setAttack1DamageSidesperDie(9)
    ..setAcquisitionRange(650.00)
    ..setAttack1ProjectileArc(0.15)
    ..setAttack1ProjectileArt("Abilities\\Weapons\\WardenMissile\\WardenMissile.mdl")
    ..setAttack1AnimationBackswingPoint(0.700)
    ..setAttack1AnimationDamagePoint(0.300)
        
    ..setHitPointsRegenerationType("night")
    ..setHitPointsRegenerationRate(0.50)
    
    ..setTurnRate(0.40)
    ..setRequirements(commaList(HERO_WARDEN_PICKED))
    
    ..setName("Warden")
    ..setTooltipBasic("|c00F7EC46Warden|r")
    ..setTooltipExtended("|c00F7EC46Warden|r\n"
    + "Roles: " + farmer + "\n\n"
    + "|c00EE0404Physical Damage|r: 5/5\n"
    + "|c0076ECF9Magical Damage|r: 1/5\n"
    + "|c00B0B0B0Defense|r: 2/5\n"
    + "|c00663300Utility|r: 1/5\n"
    + "|c0066FF66Healing|r: 0/5\n"
    + "Difficulty: 2/5\n")