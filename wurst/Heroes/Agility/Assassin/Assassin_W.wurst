package Assassin_W

import ClosureTimers
import Abilities
import ClosureEvents
import PauseAllocation
import DamageTarget
import MyAbilityIds

public function quickSlash()
    EventListener.onTargetCast(ASSASSIN_ABILITY_2) (unit caster, unit target) ->
        let lvl = caster.getAbilityLevel(ASSASSIN_ABILITY_2)
        let dmg = caster.getAgi(true)*lvl.toReal()
        doAfter(0.35) -> 
            caster.pauseIndef()
            caster.setInvulnerable(true)
            target.pauseIndef()
            doPeriodicallyCounted(0.2, 3) (CallbackCounted cb) ->
                caster.setAnimation("attack")
                caster.damageTargetCode(dmg, target, null, -1, customDamageType.PhysicalMelee)
                flashEffect(Abilities.meatwagonMissile, target.getPos())
                if cb.isLast()
                    caster.unPauseUnitIndef()
                    target.unPauseUnitIndef()
                    caster.setInvulnerable(false)
