package Assassin_Hero

import UnitIds
import ObjectIds
import MyUnitIds
import MyAbilityIds
import AbilityObjEditing
import MyUpgradesIds
import CommonDescriptions
import MyHeroDefinition

// ----------------------------------------------------------------------------

@compiletime function defineHero()
    new MyHeroDefinition(HERO_ASSASSIN, UnitIds.blademaster)
    ..setHeroAbilities(commaList(ASSASSIN_ABILITY_1, ASSASSIN_ABILITY_2, ASSASSIN_ABILITY_3, ASSASSIN_ABILITY_4, ASSASSIN_ABILITY_5))
    
    ..setPrimaryAttribute("Agility")
    ..setStatsBase(14, 20, 16)
    ..setStatsPerLvl(1.70, 1.5, 1.80)

    ..setIconGameInterface("ReplaceableTextures\\CommandButtons\\BTNShadowWarrior.blp")
    ..setIconScoreScreen("ReplaceableTextures\\CommandButtons\\BTNShadowWarrior.blp")
    ..setModelFile("Units\\Assasin\\ShadowWarrior.mdx")
    
    ..setSelectionScale(1.25)

    ..setMeleeAttack()
    ..setAttack1CooldownTime(1.77)
    ..setAttack1DamageSidesperDie(9)
    ..setAttack1AnimationBackswingPoint(0.840)
    ..setAttack1AnimationDamagePoint(0.330)
    
    ..setTurnRate(0.60)
    ..setRequirements(commaList(HERO_ASSASSIN_PICKED))
    
    ..setTooltipExtended(
    rolesList(roleFarmer, roleStacker),
    PhysDamage.v5,
    MagicDamage.v0,
    Defense.v1,
    Utility.v4,
    Healing.v0,
    Difficulty.v4)
    
// ----------------------------------------------------------------------------