package Assassin_T

import Abilities
import ClosureTimers
import DamageTarget
import DamageCustomEvent
import MyAbilityIds
import StandardTextTags

bool once = true

public function lastKiller()
    DamageCustomEvent.addListener(2) ->
        let src = DamageCustomEvent.getSource()
        if src.isIllusion()
            skip
        else
            if DamageCustomEvent.getType() == ATTACK
                let damtyp = DamageCustomEvent.getDamageType()
                if damtyp == DAMAGE_TYPE_NORMAL or damtyp == DAMAGE_TYPE_MAGIC
                    if src.hasAbility(ASSASSIN_ABILITY_5)
                        if once
                            let target = DamageCustomEvent.getTarget()
                            once = false

                            let lvl = ((GetUnitAbilityLevel(src, ASSASSIN_ABILITY_5))*5) + 35
                            let dmg = src.getAgi(true)*lvl.toReal()

                            flashEffect(Abilities.meatwagonMissile, target.getPos()) 
                            src.damageTargetCode(dmg, target, null, -1, customDamageType.PhysicalMelee)

                            createCriticalStrikeTextTag(src, R2I(dmg*4))
                            ..setColor(colorA(255, 158, 41, 224))

                            doAfter(3) -> 
                                once = true