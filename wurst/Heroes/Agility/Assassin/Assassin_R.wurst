package Assassin_R

import MyUnitIds
import ClosureEvents
import MyAbilityIds

public function katarMastery()
    EventListener.add(EVENT_PLAYER_UNIT_DEATH) -> 
        let killer = GetKillingUnit()
        if(killer.getTypeId() == HERO_ASSASSIN and GetRandomInt(1, 100) < GetUnitAbilityLevel(GetKillingUnit(), ASSASSIN_ABILITY_4)*3)
            let lowDmg = killer.getBaseDamage(0)
            killer.setBaseDamage(lowDmg+3, 0)