package Assassin_R

import MyUnitIds
import ClosureEvents
import MyAbilityIds

public function katarMastery()
    EventListener.add(EVENT_PLAYER_UNIT_DEATH) -> 
        let killer = GetKillingUnit()
        if(killer.getTypeId() == HERO_ASSASSIN)
            let lvl = GetUnitAbilityLevel(killer, ASSASSIN_ABILITY_4)
            if (GetRandomInt(1, 100) < 3*lvl)
                killer.setBaseDamage(killer.getBaseDamage(0) + 3, 0)