package Assassin_Abilities

import MyAbilityIds
import MyHeroAbilityDefinition
import MyUnitIds
import CommonDescriptions
import MyColors
import BuffObjEditing
import BuffIds
import ChannelAbilityPreset
import Orders
    
// ----------------------------------------------------------------------------

@compiletime function assassinAbils()
    new BuffDefinition(ASSASSIN_BUFF_1, BuffIds.roar)
    ..setIconNormal(1, "ReplaceableTextures\\CommandButtons\\BTNASS1.blp")
    ..register("Shadow Walk".setColor(colAbilitiesAssassin),
    "Assassin moves ahead with lightning speed simultaneously causing damage to enemies.")

// ----------------------------------------------------------------------------

    // WIP. Armor reduction rework.
    new AbilityDefinitionBerserk(ASSASSIN_ABILITY_1)
    ..presetCooldown(lvl -> 11.0 - lvl)
    ..presetManaCost(lvl -> 10 + 20 * lvl)
    ..presetBuffs(lvl -> ASSASSIN_BUFF_1.toRawCode())
    ..presetMovementSpeedIncrease(lvl -> 0.2)
    ..presetAttackSpeedIncrease(lvl -> 0.0)
    ..presetDamageTakenIncrease(lvl -> 0.0)
    ..presetDuration(lvl -> 1.0)
    ..setAnimationNames("spell,slam")
    ..setIcon("ReplaceableTextures\\CommandButtons\\BTNASS1.blp")
    ..setGeneralAbility(AbilityPosition.Q)
    ..register(HERO_ASSASSIN, "Shadow Walk".setColor(colAbilitiesAssassin), 
    "Assassin moves ahead with lightning speed (+20% movement speed) simultaneously causing damage to enemies by 0.22 x (Level Skill) x Agility.",
    (int lvl) -> "Assassin deals {0} x Agility damage.".format((0.22*lvl).toString(2)))
    
    new ChannelAbilityPreset(ASSASSIN_ABILITY_2, 9, true)
    ..presetCooldown(lvl -> 16.0 - lvl)
    ..presetManaCost(lvl -> 80 + 20 * lvl)
    ..presetCastRange(lvl -> 200.0)
    ..presetFollowThroughTime(lvl -> 0.1)
    ..presetTargetTypes(Targettype.UNIT)
    ..presetOption(Option.UNIVERSALSPELL, true)
    ..presetTargetsAllowed(lvl -> getTargets(AbilityTargets.EnemiesAll))
    ..presetArtDuration(lvl -> 1.0)
    ..presetBaseOrderID(lvl -> OrderIds.chainlightning.toRawCode())
    ..setOrderStringUseTurnOn(OrderIds.chainlightning.toRawCode())
    ..setArtCaster("Blue Quick.mdx")
    ..setArtEffect("")
    ..setIcon("ReplaceableTextures\\CommandButtons\\BTNASS2.blp")
    ..setArtTarget("Abilities\\Spells\\Other\\Stampede\\StampedeMissileDeath.mdl")
    ..setTargetAttachmentPoint("overhead")
    ..setGeneralAbility(AbilityPosition.W)
    ..register(HERO_ASSASSIN, "Quick Slash".setColor(colAbilitiesAssassin), 
    "Immediately implement many owls guillotine with lightning speed up enemies, damage by {0} x Agility your enemies be marked subject to damage 3 times.",
    (string format) -> format.format("(Level Skill)"),
    (string format, int lvl) -> format.format(lvl.toString()))
    
// ----------------------------------------------------------------------------

constant real array[9] damageAura = [0.4, 0.6, 0.8, 1.0, 1.1, 1.2, 1.3, 1.4, 1.5]

@compiletime function assassinAbilsE()
    new BuffDefinition(ASSASSIN_BUFF_3, BuffIds.roar)
    ..setIconNormal(1, "ReplaceableTextures\\CommandButtons\\PASASS4.blp")
    ..register("Enchanted Weapon".setColor(colAbilitiesAssassin),
    "The Assassin's mastery of the blade allows him to deal more damage.")

    new AbilityDefinitionMoonPriestessTrueshotAura(ASSASSIN_ABILITY_3)
    ..presetDamageBonus(lvl -> damageAura[lvl - 1])
    ..presetAreaofEffect(lvl -> 1)
    ..presetBuffs(lvl -> ASSASSIN_BUFF_3.toRawCode())
    ..presetMeleeBonus(lvl -> true)
    ..presetRangedBonus(lvl -> false)
    ..presetFlatBonus(lvl -> false)
    ..presetTargetsAllowed(lvl -> commaList("Self","Vulnerable"))
    ..setIcon("ReplaceableTextures\\CommandButtons\\PASASS4.blp")
    ..setGeneralAbility(AbilityPosition.E)
    ..register(HERO_ASSASSIN, "Enhanced Weapon".setColor(colAbilitiesAssassin), 
    "The Assassin's mastery of the blade allows him to deal more damage.",
    (int lvl) -> "Assassin deals {0}% more damage.".format((100 * damageAura[lvl - 1]).toString(0)))

// ----------------------------------------------------------------------------

    new AbilityDefinitionBladeMasterCriticalStrike(ASSASSIN_ABILITY_4)
    ..presetBuffs(lvl -> "")
    ..presetChancetoCriticalStrike(lvl -> 4.0 * lvl)
    ..presetDamageMultiplier(lvl -> 6.0 + lvl)
    ..setIcon("ReplaceableTextures\\CommandButtons\\PASASS3.blp")
    ..setGeneralAbility(AbilityPosition.R)
    ..register(HERO_ASSASSIN, "Katar Mastery".setColor(colAbilitiesAssassin), 
    "The Assassin has a chance to critically strike his enemies.",
    (int lvl) -> "{0}% chance to deal x{1} damage.".format((4*lvl).toString(), (6+lvl).toString()))
    
// ----------------------------------------------------------------------------

    new AbilityDefinitionBashcreep(ASSASSIN_ABILITY_5)
    ..presetDurationHero(lvl -> 0)
    ..presetDurationNormal(lvl -> 0)
    ..presetDamageBonus(lvl -> 0)
    ..presetChancetoBash(lvl -> 0)
    ..setIcon("ReplaceableTextures\\CommandButtons\\BTNASS5.blp")
    ..setUltimateAbility()
    ..register(HERO_ASSASSIN, "Assassin's Way".setColor(colAbilitiesAssassin), 
    "Once every 3 seconds deals {0} x Agility damage to enemy.\n\n" +

    wordPassive + "50% to gain base damage when killing the target\n\n" +

    "3 damage for units below lvl 10\n" +
    "4 damage for units below lvl 20\n" +
    "5 damage for units below lvl 24\n\n" +

    "Bosses: 10 damage for bosses below lvl 25\n" +
    "20 damage for bosses below lvl 45\n" +
    "50 damage for bosses below level 70\n\n" +
    
    "{0} for each level of ability, you will gain quest.\n".format("Unique ability:".setColor(colAbilitiesAssassin)) +
    "First quest: kill 200 units - gain 500 damage\n" +
    "Second quest: kill 100 units above lvl 20 - gain 5% armor penetration\n" +
    "Third quest: kill 20 bosses - gain improved damage aura\n" +
    "Forth quest: kill lvl 90 or higher boss - gain 10% armor penetration\n\n" +

    wordNote + "You can type -quests to see Quest Track\n" +
    "The quests will be available when you reach the level of ability.",
    (string format) -> format.format("(35 + 5 x (Skill Level))"),
    (string format, int lvl) -> format.format((35 + 5*lvl).toString()))

// ----------------------------------------------------------------------------