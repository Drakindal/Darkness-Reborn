package ShadowOfVengeance_Q

import DummyCaster
import OrderIds
import MyAbilityIds
import DamageTarget
import ClosureEvents
import DamageEvent
import MyBuffIds

public function furyPeak()
    EventListener.onCast(SHADOW_OF_VENGEANCE_ABILITY_1) (unit caster) ->
        if caster.hasAbility(SHADOW_OF_VENGEANCE_BUFF_1)
            caster.removeAbility(SHADOW_OF_VENGEANCE_BUFF_1)
    DamageEvent.addListener(2) ->
        let src = DamageEvent.getSource()
        if src.isIllusion()
            skip
        else
            if (DamageEvent.getType() == ATTACK)
                let damtyp = DamageEvent.getDamageType()
                if (damtyp == DAMAGE_TYPE_NORMAL or damtyp == DAMAGE_TYPE_MAGIC)
                    if src.hasAbility(SHADOW_OF_VENGEANCE_BUFF_1)
                        let targ = DamageEvent.getTarget()
                        let missingHp = src.getMissingHP()
                        new DummyCaster()
                        ..owner(GetOwningPlayer(src))
                        ..origin(src.getPos())
                        ..castTarget(SHADOW_OF_VENGEANCE_ABILITY_1_DUMMY, 1, OrderIds.thunderbolt, targ)
                        src.damageTargetCode(missingHp, targ, null, -1, customDamageType.Magical)