constant real array[4] abi5_Duration = [
    20.0,
    35.0,
    45.0,
    30.0
]

constant real array[4] abi5_Cd = [
    180.0,
    150.0,
    110.0,
    60.0
]

public constant real array[4] shadow_of_vengeance_abi5_DamageMult = [
    0.8,
    1.0,
    1.5,
    2.2
]

@compiletime function defineAbilities5()
    if (BUILD_AGI_HEROES)
        new BuffDefinition(SHADOW_OF_VENGEANCE_BUFF_5, BuffIds.entanglingRoots)
        ..setIcon("ReplaceableTextures\\CommandButtons\\BTNV  (2).blp")
        ..setArtTarget("Gravitone.mdx")
        ..register("Black Hole".setColor(colAbilitiesShadowOfVengeance),
        "Black Hole.")
        
        new AbilityDefinitionRoar(SHADOW_OF_VENGEANCE_ABILITY_5)
        ..setUltimateAbility()
        ..presetAreaofEffect(lvl -> 500.0)
        ..presetBuffs(lvl -> SHADOW_OF_VENGEANCE_BUFF_5.toRawCode())
        ..presetCooldown(lvl -> abi5_Cd[lvl-1])
        ..presetDuration(lvl -> abi5_Duration[lvl-1])
        ..presetManaCost(lvl -> 130 + 30*lvl)
        ..presetDamageIncrease(lvl -> 0.0)
        ..presetTargetsAllowed(lvl -> getTargets(AbilityTargets.Self))
        ..setAnimationNames("")
        ..setArtCaster("")
        ..setIcon("ReplaceableTextures\\CommandButtons\\BTNV  (2).blp")
        ..register(HERO_SHADOW_OF_VENGEANCE, "Black Hole".setColor(colAbilitiesShadowOfVengeance),
        "Shadow Vengeance's hits will deal additional damage equal to an enemy's lost health. Cancels [Q] ability!",
        (int lvl) -> "Deals {0} x (enemy's lost health) damage. Duration {1} sec (cd {2} sec).".format(
            (100*shadow_of_vengeance_abi5_DamageMult[lvl-1]).toString(0),
            abi5_Duration[lvl-1].toString(0),
            abi5_Cd[lvl-1].toString(0)
        ))
    
