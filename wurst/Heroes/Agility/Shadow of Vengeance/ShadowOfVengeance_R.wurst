package ShadowOfVengeance_R

import DamageTarget
import DamageCustomEvent
import MyAbilityIds

public function gravitone()
    DamageCustomEvent.addListener(2) ->
        
        if (DamageCustomEvent.getType() == ATTACK)
            let damtyp = DamageCustomEvent.getDamageType()
            if (damtyp == DAMAGE_TYPE_NORMAL or damtyp == DAMAGE_TYPE_MAGIC)
                let src = DamageCustomEvent.getSource()
                let lvl = src.getAbilityLevel(SHADOW_OF_VENGEANCE_ABILITY_4)
                if GetRandomInt(1, 100) < (lvl*2+9)
                    let targ = DamageCustomEvent.getTarget()
                    let missingHp = src.getMissingHP()
                    src.damageTargetCode(missingHp + 175 * lvl, targ, null, -1, customDamageType.Magical)