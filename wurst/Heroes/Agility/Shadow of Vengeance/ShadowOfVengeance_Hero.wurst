package ShadowOfVengeance_Hero

import UnitIds
import ObjectIds
import MyUnitIds
import AbilityObjEditing
import MyUpgradesIds
import CommonDescriptions
import Icons
import Units
import MyHeroDefinition

@compiletime function defineHero()
    new MyHeroDefinition(HERO_SHADOW_OF_VENGEANCE, UnitIds.warden)// Shadow Vengeance (E00Z)
    ..setHeroAbilities(commaList('A0C3', 'A0B6', 'A0B4', 'A0CG', 'A0CE'))
    
    
    ..setPrimaryAttribute("Agility")
    ..setStatsBase(18, 20, 16)
    ..setStatsPerLvl(3.00, 1.60, 1.60)
    
    ..setScalingValue(0.80)
    ..setSelectionScale(1.40)

    ..setModelFile(Units.spiritOfVengeance)
    ..setIconGameInterface(Icons.bTNSpiritOfVengeance)
    ..setIconScoreScreen(Icons.bTNSpiritOfVengeance)
    
    ..setMeleeAttack()
    ..setAttack1CooldownTime(2.05)
    ..setAttack1DamageSidesperDie(9)
    ..setAttack1ProjectileArc(0.15)
    ..setAttack1ProjectileArt("Abilities\\Weapons\\WardenMissile\\WardenMissile.mdl")
    ..setAttack1AnimationBackswingPoint(0.700)
    ..setAttack1AnimationDamagePoint(0.300)
    
    ..setHitPointsRegenerationType("night")
    ..setHitPointsRegenerationRate(0.50)
    
    ..setTurnRate(0.40)
    ..setRequirements(commaList(HERO_SHADOW_OF_VENGEANCE_PICKED))
    
    ..setName("Shadow Vengeance")
    ..setTooltipBasic("|c00F7EC46Shadow Vengeance|r")
    ..setTooltipExtended("|c00F7EC46Shadow Vengeance|r\n"
    + "Roles: " + farmer + "\n\n"
    + "|c00EE0404Physical Damage|r: 1/5\n"
    + "|c0076ECF9Magical Damage|r: 5/5\n"
    + "|c00B0B0B0Defense|r: 3/5\n"
    + "|c00663300Utility|r: 4/5\n"
    + "|c0066FF66Healing|r: 0/5\n"
    + "Difficulty: 3/5\n")