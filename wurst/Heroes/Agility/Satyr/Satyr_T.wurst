package Satyr_T

import DummyCaster
import OrderIds
import ClosureEvents
import MyBuffIds
import MyAbilityIds

public function biteofDeath()
    EventListener.onCast(SATYR_ABILITY_5) (unit caster) ->
        let lvl = GetTriggerUnit().getAbilityLevel(SATYR_ABILITY_5)
        new DummyCaster()
        ..owner(GetOwningPlayer(GetTriggerUnit()))
        ..origin(GetTriggerUnit().getPos())
        ..castTarget(SATYR_BUFF_5, lvl, OrderIds.faeriefire, GetSpellTargetUnit())