package Satyr_Hero

import UnitIds
import ObjectIds
import MyUnitIds
import AbilityObjEditing
import MyUpgradesIds
import CommonDescriptions
import Icons
import Units
import MyHeroDefinition

@compiletime function defineHero()
    new MyHeroDefinition(HERO_SATYR, UnitIds.satyr)// Satyr (O00R)
    ..setHeroAbilities(commaList('A0RF', 'A0RV', 'A0RG', 'A0RE', 'A01K'))
    
    ..setPrimaryAttribute("Agility")
    ..setStatsBase(18, 22, 16)
    ..setStatsPerLvl(2.00, 1.75, 2.25)
    
    ..setScalingValue(1.50)
    ..setSelectionScale(1.25)

    ..setModelFile(Units.satyrTrickster1)
    ..setIconGameInterface(Icons.bTNSatyrTrickster)
    ..setIconScoreScreen(Icons.bTNSatyrTrickster)
    
    ..setMeleeAttack()
    ..setAttack1CooldownTime(1.97)
    ..setAttack1DamageSidesperDie(9)
    ..setAttack1AnimationBackswingPoint(0.840)
    ..setAttack1AnimationDamagePoint(0.330)
    
    ..setTurnRate(0.60)
    ..setRequirements(commaList(HERO_SATYR_PICKED))
    
    ..setName("Satyr")
    ..setTooltipBasic("|c00F7EC46Satyr|r")
    ..setTooltipExtended("|c00F7EC46Satyr|r\n"
    + "Roles: " + farmer + "/" + support + "\n\n"
    + "|c00EE0404Physical Damage|r: 3/5\n"
    + "|c0076ECF9Magical Damage|r: 2/5\n"
    + "|c00B0B0B0Defense|r: 1/5\n"
    + "|c00663300Utility|r: 4/5\n"
    + "|c0066FF66Healing|r: 0/5\n"
    + "Difficulty: 4/5\n")