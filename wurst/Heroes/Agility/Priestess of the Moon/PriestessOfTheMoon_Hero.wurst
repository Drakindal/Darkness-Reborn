package PriestessOfTheMoon_Hero

import UnitIds
import ObjectIds
import MyUnitIds
import MyAbilityIds
import AbilityObjEditing
import MyUpgradesIds
import CommonDescriptions
import MyHeroDefinition

// ----------------------------------------------------------------------------

@compiletime function defineHero()
    new MyHeroDefinition(HERO_PRIESTESS_OF_THE_MOON, UnitIds.priestessofthemoon)
    ..setHeroAbilities(commaList(PRIESTESS_ABILITY_1, PRIESTESS_ABILITY_2, PRIESTESS_ABILITY_3, PRIESTESS_ABILITY_4, PRIESTESS_ABILITY_5))
    
    ..setPrimaryAttribute("Agility")
    ..setStatsBase(18, 19, 15)
    ..setStatsPerLvl(1.90, 1.50, 2.60)
    
    ..setSelectionScale(2.25)

    ..setRangedAttack(600)
    ..setAttack1CooldownTime(1.70)
    ..setAttack1DamageSidesperDie(6)
    ..setAttack1ProjectileArc(0.15)
    ..setAttack1ProjectileArt("Abilities\\Weapons\\MoonPriestessMissile\\MoonPriestessMissile.mdl")
    ..setAttack1AnimationBackswingPoint(0.700)
    ..setAttack1AnimationDamagePoint(0.300)
    ..setAttack1AttackType(AttackType.Chaos)
    
    ..setHitPointsRegenerationType("night")
    ..setHitPointsRegenerationRate(0.50)
    
    ..setTurnRate(0.40)
    ..setMovementType(MovementType.Horse)
    ..setRequirements(commaList(HERO_PRIESTESS_OF_THE_MOON_PICKED))
    
    ..setTooltipExtended(
    rolesList(roleFarmer),
    PhysDamage.v5,
    MagicDamage.v2,
    Defense.v1,
    Utility.v4,
    Healing.v3,
    Difficulty.v2)
    
// ----------------------------------------------------------------------------

    new MyHeroDefinition(HERO_PRIESTESS_OF_THE_MOON_FORM, UnitIds.priestessofthemoon)
    ..setHeroAbilities(commaList(PRIESTESS_ABILITY_1, PRIESTESS_ABILITY_2, PRIESTESS_ABILITY_3, PRIESTESS_ABILITY_4, PRIESTESS_ABILITY_5))
    
    ..setPrimaryAttribute("Agility")
    ..setStatsBase(18, 19, 15)
    ..setStatsPerLvl(1.90, 1.50, 2.60)
    
    ..setSelectionScale(2.25)

    ..setRangedAttack(600)
    ..setAttack1CooldownTime(0.5)
    ..setAttack1DamageSidesperDie(6)
    ..setAttack1ProjectileArc(0.15)
    ..setAttack1ProjectileArt("Abilities\\Weapons\\MoonPriestessMissile\\MoonPriestessMissile.mdl")
    ..setAttack1AnimationBackswingPoint(0.700)
    ..setAttack1AnimationDamagePoint(0.300)
    ..setAttack1AttackType(AttackType.Chaos)

    ..setHitPointsRegenerationType("night")
    ..setHitPointsRegenerationRate(0.50)
    
    ..setTurnRate(0.40)
    ..setMovementType(MovementType.Horse)
    
    ..setTooltipExtended(
    rolesList(roleFarmer),
    PhysDamage.v5,
    MagicDamage.v2,
    Defense.v1,
    Utility.v4,
    Healing.v3,
    Difficulty.v2)
    
// ----------------------------------------------------------------------------