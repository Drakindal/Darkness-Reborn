package PriestessOfTheMoon_Hero

import UnitIds
import ObjectIds
import MyUnitIds
import MyAbilityIds
import AbilityObjEditing
import MyUpgradesIds
import CommonDescriptions
import MyHeroDefinition

@compiletime function defineHero()
    new MyHeroDefinition(HERO_PRIESTESS_OF_THE_MOON, UnitIds.priestessofthemoon)// Priestess of the Moon (E001)
    ..setHeroAbilities(commaList('A08A', 'A087', 'A089', 'A08C', PRIESTESS_ABILITY_5))
    
    ..setPrimaryAttribute("Agility")
    ..setStatsBase(18, 19, 15)
    ..setStatsPerLvl(1.90, 1.50, 2.60)
    
    ..setSelectionScale(2.25)

    ..setRangedAttack(600)
    ..setAttack1CooldownTime(1.70)
    ..setAttack1DamageSidesperDie(6)
    ..setAttack1ProjectileArc(0.15)
    ..setAttack1ProjectileArt("Abilities\\Weapons\\MoonPriestessMissile\\MoonPriestessMissile.mdl")
    ..setAttack1AnimationBackswingPoint(0.700)
    ..setAttack1AnimationDamagePoint(0.300)
    ..setAttack1AttackType(AttackType.Chaos)
    
    ..setHitPointsRegenerationType("night")
    ..setHitPointsRegenerationRate(0.50)
    
    ..setTurnRate(0.40)
    ..setMovementType(MovementType.Horse)
    ..setRequirements(commaList(HERO_PRIESTESS_OF_THE_MOON_PICKED))
    
    ..setName("Priestess of the Moon")
    ..setTooltipBasic("|c00F7EC46Priestess of the Moon|r")
    ..setTooltipExtended("|c00F7EC46Priestess of the Moon|r\n"
    + "Roles: " + farmer + "/" + support + "\n\n"
    + "|c00EE0404Physical Damage|r: 5/5\n"
    + "|c0076ECF9Magical Damage|r: 2/5\n"
    + "|c00B0B0B0Defense|r: 1/5\n"
    + "|c00663300Utility|r: 4/5\n"
    + "|c0066FF66Healing|r: 3/5\n"
    + "Difficulty: 2/5\n")
    

    new MyHeroDefinition(HERO_PRIESTESS_OF_THE_MOON_FORM, UnitIds.priestessofthemoon)// Priestess of the Moon (E001)
    ..setHeroAbilities(commaList('A08A', 'A087', 'A089', 'A08C', PRIESTESS_ABILITY_5))
    
    ..setPrimaryAttribute("Agility")
    ..setStatsBase(18, 19, 15)
    ..setStatsPerLvl(1.90, 1.50, 2.60)
    
    ..setSelectionScale(2.25)

    ..setRangedAttack(600)
    ..setAttack1CooldownTime(0.5)
    ..setAttack1DamageSidesperDie(6)
    ..setAttack1ProjectileArc(0.15)
    ..setAttack1ProjectileArt("Abilities\\Weapons\\MoonPriestessMissile\\MoonPriestessMissile.mdl")
    ..setAttack1AnimationBackswingPoint(0.700)
    ..setAttack1AnimationDamagePoint(0.300)
    ..setAttack1AttackType(AttackType.Chaos)

    ..setHitPointsRegenerationType("night")
    ..setHitPointsRegenerationRate(0.50)
    
    ..setTurnRate(0.40)
    ..setMovementType(MovementType.Horse)
    
    ..setName("Priestess of the Moon")
    ..setTooltipBasic("|c00F7EC46Priestess of the Moon|r")
    ..setTooltipExtended("|c00F7EC46Priestess of the Moon|r\n"
    + "Roles: " + farmer + "/" + support + "\n\n"
    + "|c00EE0404Physical Damage|r: 5/5\n"
    + "|c0076ECF9Magical Damage|r: 2/5\n"
    + "|c00B0B0B0Defense|r: 1/5\n"
    + "|c00663300Utility|r: 4/5\n"
    + "|c0066FF66Healing|r: 3/5\n"
    + "Difficulty: 2/5\n")