package DarkRanger_Hero

import UnitIds
import ObjectIds
import MyUnitIds
import MyAbilityIds
import MyHeroAbilityDefinition
import MyUnitIds
import AbilityObjEditing
import MyUpgradesIds
import CommonDescriptions
import MyHeroDefinition

@compiletime function defineHero()
    new MyHeroDefinition(HERO_DARK_RANGER, UnitIds.darkranger)// Dark Ranger (N004)
    ..setHeroAbilities(commaList(DARK_RANGER_ABILITY_1, DARK_RANGER_ABILITY_2, DARK_RANGER_ABILITY_3, DARK_RANGER_ABILITY_4,DARK_RANGER_ABILITY_55))
    
    ..setPrimaryAttribute("Agility")
    ..setStatsBase(18, 21, 15)
    ..setStatsPerLvl(1.90, 1.50, 2.60)
    
    ..setScalingValue(1.50)
    
    ..setRangedAttack(600)
    ..setAttack1CooldownTime(2.22)
    ..setAttack1DamageSidesperDie(6)
    ..setAttack1ProjectileArc(0.15)
    ..setAttack1ProjectileArt("Abilities\\Weapons\\Arrow\\ArrowMissile.mdl")
    ..setAttack1AnimationBackswingPoint(0.300)
    ..setAttack1AnimationDamagePoint(0.700)
    
    ..setHitPointsRegenerationType("blight")
    ..setHitPointsRegenerationRate(2.00)

    ..setTurnRate(0.60)
    ..setRequirements(commaList(HERO_DARK_RANGER_PICKED))
    
    ..setTooltipExtended(
    rolesList(roleFarmer),
    PhysDamage.v2,
    MagicDamage.v5,
    Defense.v2,
    Utility.v1,
    Healing.v3,
    Difficulty.v1)