package DarkRanger_Abilities

import MyAbilityIds
import MyHeroAbilityDefinition
import MyUnitIds
import AbilityObjEditing
import Abilities
import Icons
import OrderIds
import MyColors
import UnitIds
import ObjectIds
import DebugVar

// ----------------------------------------------------------------------------

@compiletime function darkRangerAbils()
    if (BUILD_AGI_HEROES)
        new UnitDefinition(DARK_RANGER_DUMMY_UNIT_1, UnitIds.archer)
        ..setName("Effect Dummy Unit")
        ..setModelFile("Units\\Creeps\\BansheeRanger\\BansheeRanger.mdl")
        ..setAttack1ProjectileArt(Abilities.arrowMissile1)
        ..setScalingValue(1)
        ..setUpgradesUsed("")
        ..setStructuresBuilt("")
        ..setManaRegeneration(0.1)
        ..setManaInitialAmount(1000)
        ..setManaMaximum(1000)
        ..setCollisionSize(0.0)
        ..setRace(Race.Commoner)
        ..setFoodCost(0)
        ..setArmorType(ArmorType.Divine)
        ..setIconGameInterface(Icons.bTNTemp)
        ..setSpeedBase(522)
        ..setAnimationBlendTimeseconds(0.0)
        ..setAnimationCastBackswing(0.0)
        ..setMaximumPitchAngledegrees(0.0)
        ..setMaximumRollAngledegrees(0.0)
        ..setArtSpecial("")
        ..setProjectileImpactZ(0.0)
        ..setProjectileLaunchZ(0.0)
        ..setNameEditorSuffix("(Basics)")
        ..setSightRadiusDay(1)
        ..setSightRadiusNight(1)
        ..setUnitClassification("")
        ..setPropulsionWindowdegrees(1.0)
        ..setTooltipBasic("")
        ..setAttacksEnabled(0)
        ..setAttack1AnimationBackswingPoint(0)
        ..setAttack1AnimationDamagePoint(0)
        ..setAttack1CooldownTime(0.3)
        ..setAttack1AttackType(AttackType.Unknown)
        ..setAttack1DamageBase(0)
        ..setAttack1DamageNumberofDice(1)
        ..setAttack1DamageSidesperDie(1)
        ..setAttack1ProjectileSpeed(INT_MAX)
        ..setAttack1Range(INT_MAX)
        ..setAttack1TargetsAllowed(getTargets(AbilityTargets.EnemiesAll))
        ..setAttack1WeaponSound(WeaponSound.Nothing)
        ..setAttack1WeaponType(WeaponType.Instant)
        ..setAcquisitionRange(INT_MAX.toReal())
        ..setNormalAbilities(commaList(AbilityIds.invulnerable, AbilityIds.locust))

        new AbilityDefinitionFaerieFire(DARK_RANGER_DUMMYABIL_1)
        ..setMissileArt(Abilities.arrowMissile1)
        ..setAnimationNames("spell,slam")
        ..setOrderStringActivate(OrderIds.thunderbolt.toString())
        ..setHeroAbility(false)
        ..setItemAbility(false)
        ..setLevels(1)
        ..setBuffs(1, "")
        ..setDurationHero(1, 0.01)
        ..setDurationNormal(1, 0.01)

        new AbilityDefinitionFaerieFire(DARK_RANGER_ABILITY_1)
        ..setGeneralAbility(AbilityPosition.Q)
        ..presetDuration(lvl -> 0.01)
        ..presetBuffs(lvl -> "")
        ..presetCastRange(lvl -> 700)
        ..presetCastingTime(lvl -> 0.3)
        ..presetCooldown(lvl -> 19.0 - lvl)
        ..presetManaCost(lvl -> 80 + 20*lvl)
        ..setArtCaster(Abilities.flareCaster)
        ..setAnimationNames("spell,slam")
        ..setMissileSpeed(9999)
        ..setIcon(Icons.bTNTrueShot)
        ..presetTargetsAllowed(lvl -> getTargets(AbilityTargets.EnemiesAll))
        ..register(HERO_DARK_RANGER, "Image Arrows".setColor(colAbilitiesDarkRanger), 
        "Creates 6 Illusions. Each Illusion shots an arrow that deals {0} x Agility.",
        (string format) -> format.format("0.6 x (Skill Level)"),
        (string format, int lvl) -> format.format((0.6*lvl).toString()))

// ----------------------------------------------------------------------------

        new AbilityDefinitionMoonPriestessSearingArrows(DARK_RANGER_ABILITY_2)
        ..setGeneralAbility(AbilityPosition.W)
        ..presetDuration(lvl -> 0.0)
        ..presetBuffs(lvl -> "")
        ..presetDamageBonus(lvl -> 0)
        ..presetCastRange(lvl -> 700)
        ..presetCastingTime(lvl -> 0.3)
        ..presetCooldown(lvl -> 0)
        ..presetManaCost(lvl -> 5 * lvl)
        ..setOrderStringUseTurnOn(OrderIds.flamingarrows.toString())
        ..setOrderStringTurnOff(OrderIds.flamingarrowstarg.toString())
        ..setOrderStringActivate(OrderIds.flamingarrows.toString())
        ..setOrderStringDeactivate(OrderIds.flamingarrowstarg.toString())
        ..setMissileArt(Abilities.blackArrowMissile)
        ..setAnimationNames("attack")
        ..setIcon("ReplaceableTextures\\CommandButtons\\ATCDemonArrow.blp")
        ..presetTargetsAllowed(lvl -> getTargets(AbilityTargets.EnemiesAll))
        ..setAutoCastingTooltip()
        ..register(HERO_DARK_RANGER, "Dark Arrow".setColor(colAbilitiesDarkRanger), 
        "Dark Ranger shoots an Arrow enhanced with Darkness. It deals {0} x Agility bonus damage and heals for {1} x Agility.",
        (string format) -> format.format("2 x (Skill Level)", "(Skill Level)"),
        (string format, int lvl) -> format.format((2*lvl).toString(), (lvl).toString()))

// ----------------------------------------------------------------------------

        new AbilityDefinitionChainLightningcreep(DARK_RANGER_ABILITY_3)
        ..setGeneralAbility(AbilityPosition.E)
        ..presetCastingTime(lvl -> 0.3)
        ..presetCooldown(lvl -> 19.0 - lvl)
        ..presetManaCost(lvl -> 70 + 30*lvl)
        ..presetDuration(lvl -> 0.0)
        ..setLightningEffects(Abilities.manaFlareBase)
        ..setAnimationNames("spell")
        ..setIconNormal(Icons.bTNManaBurn)
        ..setIconResearch(Icons.bTNManaBurn)
        ..setArtTarget(Abilities.manaFlareBoltImpact)
        ..setMissileSpeed(3000)
        ..presetBuffs(lvl -> "")
        ..presetNumberofTargetsHit(lvl -> 1)
        ..presetCastRange(lvl -> 700)
        ..presetTargetsAllowed(lvl -> getTargets(AbilityTargets.EnemiesNonStructuresMechUnits))
        ..register(HERO_DARK_RANGER, "Dark Drain".setColor(colAbilitiesDarkRanger), 
        "The Dark Ranger attacks the enemy with dark energy, dealing {0} x Agility damage and restoring her own MP equal to {1} x Agility.",
        (string format) -> format.format("2 x (Skill Level)", "(Skill Level)"),
        (string format, int lvl) -> format.format((2*lvl).toString(), (lvl).toString()))

// ----------------------------------------------------------------------------

        new AbilityDefinitionBerserk(DARK_RANGER_ABILITY_4)
        ..setGeneralAbility(AbilityPosition.R)
        ..presetCooldown(lvl -> 23.0 - lvl)
        ..presetManaCost(lvl -> 0)
        ..presetAreaofEffect(lvl -> 0.0)
        ..presetDamageTakenIncrease(lvl -> 0.0)
        ..presetAttackSpeedIncrease(lvl -> 0.0)
        ..presetMovementSpeedIncrease(lvl -> 0.0)
        ..presetDurationNormal(lvl -> 0.0)
        ..presetCastingTime(lvl -> 0.0)
        ..presetCastRange(lvl -> 0.0)
        ..presetBuffs(lvl -> "")
        ..presetDuration(lvl -> 0.0)
        ..setLightningEffects(Abilities.manaFlareBase)
        ..setAnimationNames("spell")
        ..setIcon("ReplaceableTextures\\CommandButtons\\BTNDrain.blp")
        ..setMissileSpeed(3000)
        ..register(HERO_DARK_RANGER, "Burst Energy".setColor(colAbilitiesDarkRanger), 
        "Instantly converts HP into MP. Sacrifices {0}% of current HP to get {1}% of remaining HP as MP.",
        (string format) -> format.format("4% x (Skill Level - 1)", "1% x (Skill Level)"),
        (string format, int lvl) -> format.format((4*lvl).toString(), (1*lvl).toString()))
        
// ----------------------------------------------------------------------------

        new AbilityDefinitionAttributeModifierSkill(DARK_RANGER_ABILITY_5)
        ..setUltimateAbility()
        ..presetBuffs(lvl -> "")
        ..setName("Silver Bow")
        ..setLightningEffects(Abilities.manaFlareBase)
        ..setAnimationNames("spell")
        ..setIcon("ReplaceableTextures\\CommandButtons\\PASSilverBow.blp")
        ..presetHideButton(lvl -> false)
        ..presetAgilityBonus(lvl -> 100 + 200*(lvl-1))
        ..presetIntelligenceBonus(lvl -> 50*lvl)
        ..presetStrengthBonus(lvl -> 0)
        ..register(HERO_DARK_RANGER, "Silver Bow".setColor(colAbilitiesDarkRanger), 
        "Increase Agility of hero Dark Ranger by {0} and intelligence by {1}",
        (string format) -> format.format("100 + 200 x (Skill Level - 1)", "50 x (Skill Level)"),
        (string format, int lvl) -> format.format((100 + 200*(lvl-1)).toString(), (50*lvl).toString()))
    
// ----------------------------------------------------------------------------