package Thief_T

import DamageTarget
import DamageCustomEvent
import MyAbilityIds

public function noCommand()
    DamageCustomEvent.addListener(2) ->
        let src = DamageCustomEvent.getSource()
        if src.isIllusion()
            skip
        else
            let targ = DamageCustomEvent.getTarget()
            if (DamageCustomEvent.getType() == ATTACK)
                let damtyp = DamageCustomEvent.getDamageType()
                if (damtyp == DAMAGE_TYPE_NORMAL or damtyp == DAMAGE_TYPE_MAGIC)
                    if GetRandomInt(0, 100) < src.getAbilityLevel(THIEF_ABILITY_5) * 2
                        let lvl = src.getAbilityLevel(THIEF_ABILITY_5)
                        src.resetCooldown()
                        if(lvl < 4)
                            let dmg = 10. * src.getAgi(true)
                            src.damageTargetCode(dmg, targ, null, -1, customDamageType.PhysicalMelee)
                        else
                            let dmg = 60. * src.getAgi(true)
                            src.damageTargetCode(dmg, targ, null, -1, customDamageType.PhysicalMelee)