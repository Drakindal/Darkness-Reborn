package Thief_W

import ClosureEvents
import MyUnitIds
import ClosureForGroups
import DamageTarget
import MyAbilityIds
import Thief_Abilities
import ClosureTimers
import MyOrderIds

public boolean isWindwalk

public function windwalk()
    EventListener.onCast(THIEF_ABILITY_2) (unit caster) ->
        let lvl = caster.getAbilityLevel(THIEF_ABILITY_2)

        let dummy = createUnit(THIEF_W_DUMMY_UNIT, caster.getPos())
        ..setTimedLife(thief_abi2_Duration[lvl-1])
        ..setOwner(caster.getOwner(), true)

        doPeriodicallyTimed(1.5, thief_abi2_Duration[lvl-1]) (CallbackCounted cb) ->
            if (dummy.isAlive())
                dummy.issueImmediateOrder(MyOrderIds.castTaunt)
        
        let agi = caster.getAgi(true)
        let range = 300.0 + 50*lvl
        forUnitsInRange(caster.getPos(), range, true) (unit u) ->
            if(u.isEnemyOf(caster))
                caster.damageTargetCode((3.0 * lvl * agi), u, null, -1, customDamageType.PhysicalMelee)