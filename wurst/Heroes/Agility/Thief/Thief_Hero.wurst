package Thief_Hero

import UnitIds
import ObjectIds
import MyUnitIds
import AbilityObjEditing
import MyUpgradesIds
import CommonDescriptions
import Icons
import Soundsets
import MyHeroDefinition

@compiletime function defineHero()
    new MyHeroDefinition(HERO_THIEF, UnitIds.blademaster)// Thief (O00V)
    ..setHeroAbilities(commaList('A0X5', 'A0XE', 'A0XF', 'A0XD', 'A0XG'))
    
    ..setPrimaryAttribute("Agility")
    ..setStatsBase(10, 18, 15)
    ..setStatsPerLvl(1.60, 2.75, 2.50)
    
    ..setScalingValue(1.20)
    ..setSelectionScale(1.25)
    ..setModelFile("Units\\Thief\\FelOrcAssassin.mdx")
    ..setIconGameInterface(Icons.bTNAssassin)
    ..setUnitSoundSet(Soundsets.assassin)

    ..setMeleeAttack()
    ..setAttack1CooldownTime(1.87)
    ..setAttack1DamageSidesperDie(9)
    ..setAttack1AnimationBackswingPoint(0.840)
    ..setAttack1AnimationDamagePoint(0.330)

    ..setHitPointsMaximumBase(40)
    ..setManaInitialAmount(180)
    
    ..setSpeedBase(320)
    ..setTurnRate(0.60)
    ..setRequirements(commaList(HERO_THIEF_PICKED))
    
    ..setName("Thief")
    ..setTooltipBasic("|c00F7EC46Thief|r")
    ..setTooltipExtended("|c00F7EC46Thief|r\n"
    + "Roles: " + gatherer + "/" + farmer + "\n\n"
    + "|c00EE0404Physical Damage|r: 2/5\n"
    + "|c0076ECF9Magical Damage|r: 2/5\n"
    + "|c00B0B0B0Defense|r: 1/5\n"
    + "|c00663300Utility|r: 5/5\n"
    + "|c0066FF66Healing|r: 0/5\n"
    + "Difficulty: 5/5\n")