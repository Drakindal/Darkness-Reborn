package Thief_Hero

import UnitIds
import ObjectIds
import MyUnitIds
import AbilityObjEditing
import MyUpgradesIds
import CommonDescriptions
import Icons
import Soundsets
import MyHeroDefinition
import MyAbilityIds

// ----------------------------------------------------------------------------

@compiletime function defineHero()
    new MyHeroDefinition(HERO_THIEF, UnitIds.blademaster)
    ..setHeroAbilities(commaList(THIEF_ABILITY_1, THIEF_ABILITY_2, THIEF_ABILITY_3, THIEF_ABILITY_4, THIEF_ABILITY_5))
    
    ..setPrimaryAttribute("Agility")
    ..setStatsBase(10, 18, 15)
    ..setStatsPerLvl(1.60, 2.75, 2.50)
    
    ..setScalingValue(1.20)
    ..setSelectionScale(1.25)
    ..setModelFile("Units\\Thief\\FelOrcAssassin.mdx")
    ..setIconGameInterface(Icons.bTNAssassin)
    ..setUnitSoundSet(Soundsets.assassin)

    ..setMeleeAttack()
    ..setAttack1CooldownTime(1.87)
    ..setAttack1DamageSidesperDie(9)
    ..setAttack1AnimationBackswingPoint(0.840)
    ..setAttack1AnimationDamagePoint(0.330)

    ..setHitPointsMaximumBase(40)
    ..setManaInitialAmount(180)
    
    ..setSpeedBase(320)
    ..setTurnRate(0.60)
    ..setRequirements(commaList(HERO_GATHERER_PICKED))
    
    ..setTooltipExtended(
    rolesList(roleFarmer),
    PhysDamage.v1,
    MagicDamage.v0,
    Defense.v1,
    Utility.v5,
    Healing.v0,
    Difficulty.v5)
    
// ----------------------------------------------------------------------------