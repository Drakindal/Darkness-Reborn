public function unit.registerHero()
    switch this.getTypeId()
        case HERO_TIME_WIZARD
            // Works fine if Time Wizard was re-picked.
            this.punishTimeAct()
        case HERO_TINKER
            tinkerHero = this
        case HERO_DEATH_KNIGHT
            deathKnightHero = this
            souls = 0
        case HERO_UTHER
            utherHero = this
        default
            skip
        
public function unit.repickHero()
    switch this.getTypeId()
        case HERO_TINKER
            tinkerHero = null
        case HERO_DEATH_KNIGHT
            deathKnightHero = null
        case HERO_UTHER
            utherHero = null
        default
            skip