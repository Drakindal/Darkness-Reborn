package PandarenMonk_Hero

import UnitIds
import ObjectIds
import MyUnitIds
import AbilityObjEditing
import MyUpgradesIds
import CommonDescriptions
import Icons
import Units
import MyHeroDefinition

@compiletime function defineHero()
    new MyHeroDefinition(HERO_PANDAREN_MONK, UnitIds.pandarenbrewmaster)// Pandaren Monk (O00Z)
    ..setHeroAbilities(commaList('A0ZH', 'A0Z3', 'A0Z5', 'A0Z9', 'A0ZM'))
    
    ..setPrimaryAttribute("Intelligence")
    ..setStatsBase(11, 15, 19)
    ..setStatsPerLvl(3.00, 1.50, 1.50)
    
    ..setScalingValue(0.75)
    ..setRequirements(commaList(heroPickBlocker,HERO_PANDAREN_MONK_PICKED))
    ..setModelFile(Units.stormPandarenBrewmaster)
    ..setIconGameInterface(Icons.bTNStormBrewMaster)
    ..setIconScoreScreen(Icons.bTNStormBrewMaster)
    
    ..setRangedAttack(600)
    ..setAttack1CooldownTime(2.28)
    ..setAttack1DamageSidesperDie(4)
    ..setAttack1ProjectileArc(0.15)
    ..setAttack1ProjectileArt("Abilities\\Weapons\\FarseerMissile\\FarseerMissile.mdl")
    ..setAttack1AnimationBackswingPoint(0.500)
    ..setAttack1AnimationDamagePoint(0.300)
    
    ..setTurnRate(0.40)
    ..setMovementType(MovementType.Horse)
    
    ..setName("Pandaren Monk")
    ..setTooltipBasic("|c00F7EC46Pandaren Monk|r")
    ..setTooltipExtended("|c00F7EC46Pandaren Monk|r\n"
    + "Roles: " + farmer + "/" + caster + "\n\n"
    + "|c00EE0404Physical Damage|r: 1/5\n"
    + "|c0076ECF9Magical Damage|r: 3/5\n"
    + "|c00B0B0B0Defense|r: 1/5\n"
    + "|c00663300Utility|r: 3/5\n"
    + "|c0066FF66Healing|r: 0/5\n"
    + "Difficulty: 3/5\n")