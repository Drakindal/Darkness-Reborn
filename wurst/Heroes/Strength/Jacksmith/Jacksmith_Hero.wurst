package Jacksmith_Hero

import UnitIds
import ObjectIds
import MyUnitIds
import AbilityObjEditing
import MyUpgradesIds
import CommonDescriptions
import Icons
import MyHeroDefinition
import MyAbilityIds

// ----------------------------------------------------------------------------

@compiletime function defineHero()
    new MyHeroDefinition(HERO_JACKSMITH, UnitIds.paladin)
    ..setHeroAbilities(commaList(JACKSMITH_ABILITY_1, JACKSMITH_ABILITY_2, JACKSMITH_ABILITY_3, JACKSMITH_ABILITY_4, JACKSMITH_ABILITY_5))
    
    ..setModelFile("Units\\Jacksmith\\IndustrialWorker.mdx")
    ..setIconGameInterface(Icons.bTNPeasant)

    ..setPrimaryAttribute("Strength")
    ..setStatsBase(22, 13, 17)
    ..setStatsPerLvl(2.70, 1.50, 1.80)
    
    ..setSelectionScale(1.25)

    ..setMeleeAttack1()
    ..setAttack1CooldownTime(2.00)
    ..setAttack1DamageSidesperDie(6)
    ..setAttack1AnimationBackswingPoint(0.567)
    ..setAttack1AnimationDamagePoint(0.433)

    ..setDefenseBase(2)

    ..setTurnRate(0.60)
    ..setRequirements(commaList(HERO_CRAFTER_PICKED))

    ..setTooltipExtended(
    rolesList(roleCrafter),
    PhysDamage.v1,
    MagicDamage.v0,
    Defense.v0,
    Utility.v5,
    Healing.v0,
    Difficulty.v5)
    
// ----------------------------------------------------------------------------