package Jacksmith_Hero

import UnitIds
import ObjectIds
import MyUnitIds
import AbilityObjEditing
import MyUpgradesIds
import CommonDescriptions
import Icons
import MyHeroDefinition

@compiletime function defineHero()
    new MyHeroDefinition(HERO_JACKSMITH, UnitIds.paladin)// JackSmith (H03O)
    ..setHeroAbilities(commaList('A0H3', 'A0DH', 'A0DE', 'A0DG', 'A0JR'))
    
    ..setModelFile("Units\\Jacksmith\\IndustrialWorker.mdx")
    ..setIconGameInterface(Icons.bTNPeasant)

    ..setPrimaryAttribute("Strength")
    ..setStatsBase(22, 13, 17)
    ..setStatsPerLvl(2.70, 1.50, 1.80)
    
    ..setSelectionScale(1.25)

    ..setMeleeAttack()
    ..setAttack1CooldownTime(2.00)
    ..setAttack1DamageSidesperDie(6)
    ..setAttack1AnimationBackswingPoint(0.567)
    ..setAttack1AnimationDamagePoint(0.433)

    ..setDefenseBase(2)

    ..setTurnRate(0.60)
    ..setRequirements(commaList(HERO_JACKSMITH_PICKED))

    ..setName("JackSmith")
    ..setTooltipBasic("|c00F7EC46Jacksmith|r")
    ..setTooltipExtended("|c00F7EC46Jacksmith|r\n"
    + "Roles: " + crafter + "\n\n"
    + "|c00EE0404Physical Damage|r: 1/5\n"
    + "|c0076ECF9Magical Damage|r: 0/5\n"
    + "|c00B0B0B0Defense|r: 2/5\n"
    + "|c00663300Utility|r: 5/5\n"
    + "|c0066FF66Healing|r: 0/5\n"
    + "Difficulty: 5/5\n")