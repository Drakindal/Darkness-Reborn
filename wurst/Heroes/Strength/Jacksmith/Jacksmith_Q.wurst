package Jacksmith_Q

import Recipes
import ClosureEvents
import MyAbilityIds

public let jackSmithRecipe = compiletime(new RecipeList())

public function forge()
    EventListener.onCast(JACKSMITH_ABILITY_1) (unit caster) ->
        let js = caster

        caster.checkRecipe(jackSmithRecipe)

        js.addEffect("Abilities\\Spells\\Other\\Charm\\CharmTarget.mdl", "chest")