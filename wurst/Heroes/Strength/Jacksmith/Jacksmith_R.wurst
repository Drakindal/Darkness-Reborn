package Jacksmith_R

import ClosureEvents
import DummyCaster
import OrderIds
import MyAbilityIds
import Recipes
import initlater Blacksmith
import MyUnitIds

public let blacksmithJackedList = compiletime(new RecipeList())

public function metalStrength()
    EventListener.onTargetCast(JACKSMITH_ABILITY_4) (unit caster, unit target) ->
        if (target.getTypeId() != BUILDING_TINKER_BLACKSMITH)
            printTimedToPlayer("You can only target Tinker's Blacksmith.", 10, caster.getOwner())
            caster.resetAbilityCooldown(JACKSMITH_ABILITY_4)
        else
            new DummyCaster()
            ..owner(GetOwningPlayer(caster))
            ..origin(caster.getPos())
            ..castTarget(JACKSMITH_ABILITY_4_DUMMY, 1, OrderIds.innerfire, target)

            checkBlacksmithRecipe(target)