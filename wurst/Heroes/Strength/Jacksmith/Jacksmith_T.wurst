package Jacksmith_T

import ClosureEvents
import DialogBox
import MyItemIds
import MyAbilityIds

function addItemLevelPicker(int abiLvl, JsCraftItemDialog d, int lvl, int itemId)
    printTimedToPlayer("abi = {0}, lvl = {1}".format(abiLvl.toString(), lvl.toCharsetString()), 5, d.js.getOwner())
    if (abiLvl >= lvl)
        let name = "Level " + lvl.toString()
        d.itemTypeBox.addButton(name) ->
            d.js.addItemById(itemId)
            d.itemTypeBox.display(d.js.getOwner(), false)
            destroy d

interface InitDialogFunc
    function run(JsCraftItemDialog d, int abiLvl)

class JsCraftItemDialog
    unit js
    string currItemName
    DialogBox forgeBox
    DialogBox itemTypeBox

    ondestroy
        destroy forgeBox
        if (itemTypeBox != null)
            destroy itemTypeBox
    
    construct(unit js)
        this.js = js
        forgeBox = new DialogBox("Select desired item")

        initDialog()
        
        forgeBox.addButton("Cancel") ->
            forgeBox.display(GetOwningPlayer(js), false)
            js.resetAbilityCooldown(JACKSMITH_ABILITY_5)
            destroy this

        forgeBox.display(GetOwningPlayer(js), true)

    function addItemType(InitDialogFunc func)
        let abilityLvl = js.getAbilityLevel(JACKSMITH_ABILITY_5)

        forgeBox.addButton(currItemName) ->
            forgeBox.display(GetOwningPlayer(js), false)

            itemTypeBox = new DialogBox("Select " + currItemName + " Level")
            
            func.run(this, abilityLvl)

            itemTypeBox.addButton("Cancel") ->
                itemTypeBox.display(GetOwningPlayer(js), false)
                forgeBox.display(GetOwningPlayer(js), true)
                destroy itemTypeBox
                itemTypeBox = null

            itemTypeBox.display(js.getOwner(), true)

    function initDialog()
        currItemName = "Armor"
        addItemType() (JsCraftItemDialog d, int abiLvl) ->
            addItemLevelPicker(abiLvl, d, 1, ITEM_FORGE_ARMOR_L1)
            addItemLevelPicker(abiLvl, d, 2, ITEM_FORGE_ARMOR_L2)
            addItemLevelPicker(abiLvl, d, 3, ITEM_FORGE_ARMOR_L3)
            addItemLevelPicker(abiLvl, d, 4, ITEM_FORGE_ARMOR_L4)
        
        currItemName = "Axe"
        addItemType() (JsCraftItemDialog d, int abiLvl) ->
            addItemLevelPicker(abiLvl, d, 1, ITEM_FORGE_AXE_L1)
            addItemLevelPicker(abiLvl, d, 2, ITEM_FORGE_AXE_L2)
            addItemLevelPicker(abiLvl, d, 3, ITEM_FORGE_AXE_L3)
            addItemLevelPicker(abiLvl, d, 4, ITEM_FORGE_AXE_L4)
        
        currItemName = "Blade"
        addItemType() (JsCraftItemDialog d, int abiLvl) ->
            addItemLevelPicker(abiLvl, d, 1, ITEM_FORGE_BLADE_L1)
            addItemLevelPicker(abiLvl, d, 2, ITEM_FORGE_BLADE_L2)
            addItemLevelPicker(abiLvl, d, 3, ITEM_FORGE_BLADE_L3)
            addItemLevelPicker(abiLvl, d, 4, ITEM_FORGE_BLADE_L4)
        
        currItemName = "Boots"
        addItemType() (JsCraftItemDialog d, int abiLvl) ->
            addItemLevelPicker(abiLvl, d, 1, ITEM_FORGE_BOOTS_L1)
            addItemLevelPicker(abiLvl, d, 2, ITEM_FORGE_BOOTS_L2)
            addItemLevelPicker(abiLvl, d, 3, ITEM_FORGE_BOOTS_L3)
            addItemLevelPicker(abiLvl, d, 4, ITEM_FORGE_BOOTS_L4)

        currItemName = "Gloves"
        addItemType() (JsCraftItemDialog d, int abiLvl) ->
            addItemLevelPicker(abiLvl, d, 1, ITEM_FORGE_GLOVES_L1)
            addItemLevelPicker(abiLvl, d, 2, ITEM_FORGE_GLOVES_L2)
            addItemLevelPicker(abiLvl, d, 3, ITEM_FORGE_GLOVES_L3)
            addItemLevelPicker(abiLvl, d, 4, ITEM_FORGE_GLOVES_L4)

        currItemName = "Helm"
        addItemType() (JsCraftItemDialog d, int abiLvl) ->
            addItemLevelPicker(abiLvl, d, 1, ITEM_FORGE_HELM_L1)
            addItemLevelPicker(abiLvl, d, 2, ITEM_FORGE_HELM_L2)
            addItemLevelPicker(abiLvl, d, 3, ITEM_FORGE_HELM_L3)
            addItemLevelPicker(abiLvl, d, 4, ITEM_FORGE_HELM_L4)
        
        currItemName = "Shield"
        addItemType() (JsCraftItemDialog d, int abiLvl) ->
            addItemLevelPicker(abiLvl, d, 1, ITEM_FORGE_SHIELD_L1)
            addItemLevelPicker(abiLvl, d, 2, ITEM_FORGE_SHIELD_L2)
            addItemLevelPicker(abiLvl, d, 3, ITEM_FORGE_SHIELD_L3)
            addItemLevelPicker(abiLvl, d, 4, ITEM_FORGE_SHIELD_L4)
        
        currItemName = "Staff"
        addItemType() (JsCraftItemDialog d, int abiLvl) ->
            addItemLevelPicker(abiLvl, d, 1, ITEM_FORGE_STAFF_L1)
            addItemLevelPicker(abiLvl, d, 2, ITEM_FORGE_STAFF_L2)
            addItemLevelPicker(abiLvl, d, 3, ITEM_FORGE_STAFF_L3)
            addItemLevelPicker(abiLvl, d, 4, ITEM_FORGE_STAFF_L4)

        currItemName = "Sword"
        addItemType() (JsCraftItemDialog d, int abiLvl) ->
            addItemLevelPicker(abiLvl, d, 1, ITEM_FORGE_SWORD_L1)
            addItemLevelPicker(abiLvl, d, 2, ITEM_FORGE_SWORD_L2)
            addItemLevelPicker(abiLvl, d, 3, ITEM_FORGE_SWORD_L3)
            addItemLevelPicker(abiLvl, d, 4, ITEM_FORGE_SWORD_L4)

public function forgeMaster()
    EventListener.onCast(JACKSMITH_ABILITY_5) (unit caster) ->
        new JsCraftItemDialog(caster)