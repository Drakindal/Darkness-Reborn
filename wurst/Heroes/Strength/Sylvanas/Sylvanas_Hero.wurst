package Sylvanas_Hero

import UnitIds
import ObjectIds
import MyUnitIds
import MyAbilityIds
import AbilityObjEditing
import MyUpgradesIds
import CommonDescriptions
import MyHeroDefinition

// ----------------------------------------------------------------------------

@compiletime function defineHero()
    new MyHeroDefinition(HERO_SYLVANAS, UnitIds.sylvanuswindrunner)
    ..setHeroAbilities(commaList(SYLVANAS_ABILITY_1, SYLVANAS_ABILITY_2, SYLVANAS_ABILITY_3, SYLVANAS_ABILITY_4, SYLVANAS_ABILITY_5))
    
    ..setPrimaryAttribute("Strength")
    ..setStatsBase(19, 18, 15)
    ..setStatsPerLvl(1.90, 1.50, 2.60)

    ..setScalingValue(1.10)
    
    ..setRangedAttack1(700)
    ..setAttack1CooldownTime(2.26)
    ..setAttack1DamageSidesperDie(6)
    ..setAttack1ProjectileArc(0.15)
    ..setAttack1ProjectileArt("Abilities\\Weapons\\MoonPriestessMissile\\MoonPriestessMissile.mdl")
    ..setAttack1AnimationBackswingPoint(0.580)
    ..setAttack1AnimationDamagePoint(0.700)
    
    ..setManaInitialAmount(200)
    
    ..setTurnRate(0.60)
    ..setRequirements(commaList(HERO_RANGER_PICKED))
    ..setUpgradesUsed(commaList(HERO_SYLVANAS_LONG_RANGE))
    
    ..setTooltipExtended(
    rolesList(roleFarmer),
    PhysDamage.v2,
    MagicDamage.v3,
    Defense.v2,
    Utility.v3,
    Healing.v0,
    Difficulty.v4)
    
// ----------------------------------------------------------------------------