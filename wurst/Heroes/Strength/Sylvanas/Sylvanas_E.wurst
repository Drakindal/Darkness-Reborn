package Sylvanas_E

import ClosureForGroups
import ClosureTimers
import Abilities
import ClosureEvents
import DamageTarget
import MyAbilityIds

public function poisonArrow()
    EventListener.onPointCast(SYLVANAS_ABILITY_3) (unit caster, vec2 target) ->
        let lvl = GetUnitAbilityLevel(caster, SYLVANAS_ABILITY_3)
        let amount = caster.getStr(true) * lvl * 2.
        doAfter(0.5) -> 
            forUnitsInRange(target, 400, true) (unit u) ->
                if caster.isEnemyOf(u) and u.isAlive()
                    caster.damageTargetCode(amount, u, null, -1, customDamageType.Magical)
                    flashEffect(Abilities.manaBurnTarget, target)