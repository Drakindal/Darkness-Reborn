constant real array[9] abi4_Damage = [
     1.0,
     3.0,
     5.0,
    10.0,
    15.0,
    20.0,
    30.0,
    40.0,
    50.0
]

@compiletime function defineAbilities4()
    // WIP armor increase.
    new AbilityDefinitionRoar(BEASTMASTER_ABILITY_4)
    ..setGeneralAbility(AbilityPosition.R)
    ..setRequiredLevel(10)
    ..presetAreaofEffect(lvl -> 800.0)
    ..presetBuffs(lvl -> BuffIds.roar.toString())
    ..presetCooldown(lvl -> 150.0 - 10*lvl)
    ..setManaCost(1, 350)
    ..setManaCost(2, 450)
    ..setManaCost(3, 550)
    ..setManaCost(4, 650)
    ..setManaCost(5, 850)
    ..setManaCost(6, 1050)
    ..setManaCost(7, 1250)
    ..setManaCost(8, 1450)
    ..setManaCost(9, 1500)
    ..presetDamageIncrease(lvl -> abi4_Damage[lvl-1])
    ..presetDefenseIncrease(lvl -> 0)
    ..presetLifeRegenerationRate(lvl -> 100)
    ..presetManaRegen(lvl -> 100)
    ..presetDuration(lvl -> 70.0)
    ..presetTargetsAllowed(lvl -> getTargets(AbilityTargets.Player))
    ..presetAreaofEffect(lvl -> 800.0)
    ..setIcon("ReplaceableTextures\\CommandButtons\\BTNBattleRoar.blp")
    ..register(HERO_BEASTMASTER, "Roar of Beastmaster".setColor(colAbilitiesBeastmaster), 
    "Beastmaster loudly roars making him and his beasts to become in range drastically increasing damage, hp and mana regeneration. Duration 70 sec.",
    (int lvl) -> "+{0}% damage. +100 Hp/s, +100 Mana Regeneration. Cd {1} sec".format(
        (100*abi4_Damage[lvl-1]).toString(),
        (150-10*lvl).toString()
    ))

// ----------------------------------------------------------------------------

public constant int array[5] beastmaster_abi5_Str = [
    0,
    1,
    1,
    2,
    2
]

@compiletime function defineAbilities5()
    new BuffDefinition(BEAST_MASTER_BUFF_5, BuffIds.battleRoar)
    ..setArtTarget(1, "")
    ..setIcon(Icons.bTNBeastMaster)
    ..register("Spirits of the Wild".setColor(colAbilitiesBeastmaster),
    "This unit has claimed his spirits, and has increased combat capabilities.")

    new AbilityDefinitionBattleRoar(BEASTMASTER_ABILITY_5)
    ..setUltimateAbility()
    ..setEffectSound("")
    ..presetEffects(lvl -> "")
    ..setArtCaster("")
    ..setArtEffect("")
    ..setArtSpecial("")
    ..setArtTarget("")
    ..presetBuffs(lvl -> BEAST_MASTER_BUFF_5.toRawCode())
    ..presetCooldown(lvl -> 200.0 - 20*lvl)
    ..setIcon(Icons.bTNBeastMaster)
    ..presetDefenseIncrease(lvl -> 0)
    ..presetLifeRegenerationRate(lvl -> 0)
    ..presetDuration(lvl -> 10.0 + 5*lvl)
    ..presetTargetsAllowed(lvl -> getTargets(AbilityTargets.Self))
    ..register(HERO_BEASTMASTER, "Spirits of the Wild".setColor(colAbilitiesBeastmaster), 
    wordPassive + "Every time your beast dies or disappears Beastmaster gets 1 spirit even if you haven't learnt this ability.\n" +
    wordPassive + "After Beastmaster learns this ability he will permanently get Str when he collects a spirit.\n" +
    wordActive + "Increases all stats depending of collected spirits amount.",
    (int lvl) -> "+{0} x Spirits Amount to All Stats. +{1} Str for a spirit. Duration {1} sec. Cd {2} sec.".format(
        ((lvl*2+5)).toString(),
        beastmaster_abi5_Str[lvl].toString(),
        (200 - 20*lvl).toString()
    ))

