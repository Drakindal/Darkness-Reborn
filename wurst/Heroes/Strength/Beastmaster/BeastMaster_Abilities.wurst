    ..presetSummonedUnitCount(lvl -> abi3_SummonsAmount[lvl-1])
    ..presetSummonedUnitType(lvl -> commaList(HAWK))
    ..register(HERO_BEASTMASTER, "Summon Falcons".setColor(colAbilitiesBeastmaster), 
