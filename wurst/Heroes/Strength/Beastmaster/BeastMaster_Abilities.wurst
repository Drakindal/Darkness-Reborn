@compiletime function defineAbilities2()
    new AbilityDefinitionBeastMasterSummonQuilbeast(BEASTMASTER_ABILITY_2)
    ..setGeneralAbility(AbilityPosition.W)
    ..presetDuration(lvl -> 70)
    ..presetCooldown(lvl -> 35)
    ..presetManaCost(lvl -> 75 + lvl*25)
    ..presetSummonedUnitCount(lvl -> abi2_SummonsAmount[lvl-1])
    ..presetSummonedUnitType(lvl -> commaList(QUILBEAST))
    ..register(HERO_BEASTMASTER, "Summon Quilbeasts".setColor(colAbilitiesBeastmaster), 
    "Summons Quilbeasts\n"+
    "Ability: Bloodrage (25% attackspeed)\n" + 
    "Health: {0} + 0.03 x max HP.\n" + 
    "Armor: ....\n" +
    "Damage: {1} + 0.4 x Str.\n" + 
    "Duration: 70 seconds.\n" +
    "Cooldown: 35 seconds.\n" +
    "Armor Penetration: {2}% of Beastmaster Armor Penetration.",
    (string format) -> format.format(
        "150 x Skill Level",
        "25 x Skill Level",
        "Complex "
    ),
    (string format, int lvl) -> format.format(
        (150*lvl).toString(),
        (25*lvl).toString(),
        (100*beastmaster_abi2_ArmorPen[lvl-1]).toString(0)
    ))

