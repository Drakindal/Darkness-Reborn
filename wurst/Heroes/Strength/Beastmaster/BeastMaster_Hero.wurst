package BeastMaster_Hero

import UnitIds
import ObjectIds
import MyUnitIds
import MyAbilityIds
import AbilityObjEditing
import MyUpgradesIds
import CommonDescriptions
import MyHeroDefinition

// ----------------------------------------------------------------------------

@compiletime function defineHero()
    new MyHeroDefinition(HERO_BEASTMASTER, UnitIds.beastmaster)
    ..setHeroAbilities(commaList(BEASTMASTER_ABILITY_1, BEASTMASTER_ABILITY_2, BEASTMASTER_ABILITY_3, BEASTMASTER_ABILITY_4, BEASTMASTER_ABILITY_5))
    
    ..setPrimaryAttribute("Strength")
    ..setStatsBase(22, 14, 15)
    ..setStatsPerLvl(2.90, 1.30, 1.80)
    
    ..setSelectionScale(2.00)

    ..setMeleeAttack1()
    ..setAttack1Range(128)
    ..setAttack1CooldownTime(2.20)
    ..setAttack1DamageSidesperDie(6)
    ..setAttack1AnimationBackswingPoint(0.700)
    ..setAttack1AnimationDamagePoint(0.300)
    
    ..setTurnRate(0.40)
    ..setRequirements(commaList(HERO_BEASTMASTER_PICKED))
    
    ..setTooltipExtended(
    rolesList(roleDefender, roleFarmer, roleSummoner, roleStacker),
    PhysDamage.v5,
    MagicDamage.v0,
    Defense.v3,
    Utility.v0,
    Healing.v0,
    Difficulty.v2)
    
// ----------------------------------------------------------------------------