package BeastMaster_Hero

import UnitIds
import ObjectIds
import MyUnitIds
import MyAbilityIds
import AbilityObjEditing
import MyUpgradesIds
import CommonDescriptions
import MyHeroDefinition

@compiletime function defineHero()
    new MyHeroDefinition(HERO_BEASTMASTER, UnitIds.beastmaster)// Beastmaster (N003)
    
    ..setHeroAbilities(commaList(ABILITY_4, ABILITY_5, ABILITY_6, 'A0KJ', ABILITY_7))
    
    ..setPrimaryAttribute("Strength")
    ..setStatsBase(22, 14, 15)
    ..setStatsPerLvl(2.90, 1.30, 1.80)
    
    ..setSelectionScale(2.00)

    ..setMeleeAttack()
    ..setAttack1Range(128)
    ..setAttack1CooldownTime(2.20)
    ..setAttack1DamageSidesperDie(6)
    ..setAttack1AnimationBackswingPoint(0.700)
    ..setAttack1AnimationDamagePoint(0.300)
    
    ..setTurnRate(0.40)
    ..setRequirements(commaList(HERO_BEASTMASTER_PICKED))
    
    ..setName("Beastmaster")
    ..setTooltipBasic("|c00F7EC46Beastmaster|r")
    ..setTooltipExtended("|c00F7EC46Beastmaster|r\n"
    + "Roles: " + defender + "/" + farmer + "/" + stacker + "/" + summoner + "\n\n"
    + "|c00EE0404Physical Damage|r: 5/5\n"
    + "|c0076ECF9Magical Damage|r: 0/5\n"
    + "|c00B0B0B0Defense|r: 3/5\n"
    + "|c00663300Utility|r: 0/5\n"
    + "|c0066FF66Healing|r: 0/5\n"
    + "Difficulty: 3/5\n")