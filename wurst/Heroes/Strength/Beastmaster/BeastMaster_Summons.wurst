package BeastMaster_Summons

import MyUnitIds
import StandardTextTags
import ClosureEvents
import MyAbilityIds
import Global_Variables
import UnitStats
import ArmorWeaponTypes
import BeastMaster_Abilities

public int spirits = 0
texttag spiritText

public function quilBeast()
    EventListener.add(EVENT_PLAYER_UNIT_DEATH) ->
        let u = GetDyingUnit()
        let uid = u.getTypeId()
        if uid == MISHABEAR or uid == QUILBEAST or uid == HAWK
            let beastmaster = playerHero.get(u.getOwner())

            let lvl = beastmaster.getAbilityLevel(BEASTMASTER_ABILITY_5)
            beastmaster.addStr(beastmaster_abi5_Str[lvl]) // Do not write lvl-1. Array has 5 elements.

            spirits = spirits + 1
            if spirits % 5 == 0
                spiritText = createLumberBountyTextTag(beastmaster, spirits)
                spiritText.setColor(colorA(93, 247, 55, 255))
                spiritText.setText("Spirits: "+I2S(spirits))

    EventListener.add(EVENT_PLAYER_UNIT_SUMMON) ->
        let summoner = GetSummoningUnit()
        if(summoner.getTypeId() == HERO_BEASTMASTER)
            let summon = GetSummonedUnit()..registerStats()
            let str = summoner.getStr(true)

            
            if summon.getTypeId() == MISHABEAR
                let lvl = summoner.getAbilityLevel(BEASTMASTER_ABILITY_1)
                let armorPen = beastmaster_abi1_ArmorPen[lvl-1]*summoner.getStats().getPen(penType.Physical)
                summon.setMaxHP(((0.45*summoner.getMaxHP()) + lvl * 250).toInt(), true)
                summon.setArmor(0.4 * summoner.getArmor() + lvl * 8)
                summon.setBaseDamage((0.15 * str + lvl * 10).toInt(), 0)
                summon.getStats().setBasePen(penType.Physical, armorPen)
                if lvl == 8
                    BlzSetUnitWeaponIntegerField(summon, UNIT_WEAPON_IF_ATTACK_ATTACK_TYPE, 0, 5)
                if lvl == 9
                    BlzSetUnitWeaponIntegerField(summon, UNIT_WEAPON_IF_ATTACK_ATTACK_TYPE, 0, WEAPON_TYPE_BLOOD)
                    summon.setField(UNIT_IF_DEFENSE_TYPE, ARMOR_TYPE_HERO)
            
            if summon.getTypeId() == QUILBEAST
                let lvl = summoner.getAbilityLevel(BEASTMASTER_ABILITY_2)
                let armorPen = beastmaster_abi2_ArmorPen[lvl-1]*summoner.getStats().getPen(penType.Physical)
                summon.setMaxHP(((0.03*summoner.getMaxHP()) + lvl * 150).toInt(), true)
                summon.setArmor(0.15 * summoner.getArmor() + lvl * 4)
                summon.setBaseDamage((0.4 * str).toInt() + lvl * 25, 0)
                summon.getStats().setBasePen(penType.Physical, armorPen)
                if lvl > 5
                    BlzSetUnitWeaponIntegerField(summon, UNIT_WEAPON_IF_ATTACK_ATTACK_TYPE, 0, 5)
                if lvl == 9
                    BlzSetUnitWeaponIntegerField(summon, UNIT_WEAPON_IF_ATTACK_ATTACK_TYPE, 0, WEAPON_TYPE_BLOOD)
                    summon.setField(UNIT_IF_DEFENSE_TYPE, ARMOR_TYPE_HERO)

            if summon.getTypeId() == HAWK
                let lvl = summoner.getAbilityLevel(BEASTMASTER_ABILITY_3)
                let armorPen = beastmaster_abi3_ArmorPen[lvl-1]*summoner.getStats().getPen(penType.Physical)
                summon.setMaxHP(((0.05*summoner.getMaxHP()) + lvl * 70).toInt(), true)
                summon.setArmor(0.1 * summoner.getArmor() + lvl * 2)
                summon.setBaseDamage((0.75 * str).toInt() + lvl * 20, 0)
                summon.getStats().setBasePen(penType.Physical, armorPen)
                if lvl > 5
                    BlzSetUnitWeaponIntegerField(summon, UNIT_WEAPON_IF_ATTACK_ATTACK_TYPE, 0, 5)
                if lvl == 9
                    BlzSetUnitWeaponIntegerField(summon, UNIT_WEAPON_IF_ATTACK_ATTACK_TYPE, 0, WEAPON_TYPE_BLOOD)
                    summon.setField(UNIT_IF_DEFENSE_TYPE, ARMOR_TYPE_HERO)