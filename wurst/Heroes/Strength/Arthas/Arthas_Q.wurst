package Arthas_Q
import ClosureEvents
import ClosureTimers
import ClosureForGroups
import DummyCaster
import OrderIds
import Abilities
import MyAbilityIds
import DamageTarget

public function dragonClaw()
    EventListener.onTargetCast(ARTHAS_ABILITY_1) (unit caster, unit target) ->
        let lvl = caster.getAbilityLevel(ARTHAS_ABILITY_1)
        let dmg = (caster.getStr(true)*(lvl*2.)) + 50*lvl
        doAfter(0.3) -> 
            caster.setAnimation("slam")
            flashEffect(Abilities.thunderclapTarget, target.getPos(), 2)
            forUnitsInRange(target.getPos(), 350, true) (unit u) ->
                if caster.isEnemyOf(u) and u.isAlive()
                    caster.damageTargetCode(dmg, u, null, -1, customDamageType.PhysicalMelee)
                    new DummyCaster()
                    ..owner(GetOwningPlayer(caster))
                    ..origin(caster.getPos())
                    ..castTarget(ABILITY_DUMMY_STUN_5_SEC, 1, OrderIds.thunderbolt, u)