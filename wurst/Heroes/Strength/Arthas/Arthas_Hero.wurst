package Arthas_Hero

import UnitIds
import ObjectIds
import MyUnitIds
import MyAbilityIds
import AbilityObjEditing
import MyUpgradesIds
import CommonDescriptions
import MyHeroDefinition

// ----------------------------------------------------------------------------

@compiletime function defineHero()
    new MyHeroDefinition(HERO_ARTHAS, UnitIds.arthaswithfrostmourne)
    
    ..setHeroAbilities(commaList(ARTHAS_ABILITY_1, ARTHAS_ABILITY_2, ARTHAS_ABILITY_3, ARTHAS_ABILITY_4, ARTHAS_ABILITY_5))
    
    ..setPrimaryAttribute("Strength")
    ..setStatsBase(22, 13, 17)
    ..setStatsPerLvl(2.70, 1.50, 1.80)
    
    ..setScalingValue(1.10)
    ..setSelectionScale(1.10)

    ..setMeleeAttack1()
    ..setAttack1CooldownTime(1.70)
    ..setAttack1DamageSidesperDie(6)
    ..setAttack1AnimationBackswingPoint(0.567)
    ..setAttack1AnimationDamagePoint(0.433)
    ..setAttack1AttackType(AttackType.Chaos)
    
    ..setDefenseBase(2)
    ..setManaInitialAmount(200)
    
    ..setTurnRate(0.60)
    ..setRequirements(commaList(HERO_ARTHAS_PICKED))
    
    ..setTooltipExtended(
    rolesList(roleFarmer),
    PhysDamage.v4,
    MagicDamage.v0,
    Defense.v2,
    Utility.v1,
    Healing.v1,
    Difficulty.v3)
    
// ----------------------------------------------------------------------------

    new MyHeroDefinition(HERO_ARTHAS_FORM, UnitIds.arthaswithfrostmourne)
    ..setHeroAbilities(commaList(ARTHAS_ABILITY_1, ARTHAS_ABILITY_2, ARTHAS_ABILITY_3, ARTHAS_ABILITY_4, ARTHAS_ABILITY_5))
    
    ..setPrimaryAttribute("Strength")
    ..setStatsBase(52, 35, 24)
    ..setStatsPerLvl(4.80, 2.20, 2.30)
    
    ..setModelFile("Units\\Arthas Frostmourne\\KingArthas.mdl")
    ..setScalingValue(1.10)
    ..setSelectionScale(1.10)

    ..setMeleeAttack1()
    ..setAttack1CooldownTime(0.5)
    ..setAttack1DamageSidesperDie(6)
    ..setAttack1AnimationBackswingPoint(0.467)
    ..setAttack1AnimationDamagePoint(0.333)
    ..setBloodAttackType()
    
    ..setDefenseBase(2)
    ..setManaInitialAmount(300)
    
    ..setTurnRate(0.60)
    ..setRequirements("")
    
    ..setTooltipExtended(
    rolesList(roleFarmer),
    PhysDamage.v4,
    MagicDamage.v0,
    Defense.v2,
    Utility.v1,
    Healing.v1,
    Difficulty.v3)
    
// ----------------------------------------------------------------------------