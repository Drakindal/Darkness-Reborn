package Arthas_Hero

import UnitIds
import ObjectIds
import MyUnitIds
import MyAbilityIds
import AbilityObjEditing
import MyUpgradesIds
import CommonDescriptions
import MyHeroDefinition

// ----------------------------------------------------------------------------

@compiletime function defineHero()
    new MyHeroDefinition(HERO_ARTHAS, UnitIds.arthaswithfrostmourne)// Arthas (H00B)
    
    ..setHeroAbilities(commaList('A00A', 'A00B', 'A00H', ARTHAS_ABILITY_5, 'A00S'))
    
    ..setPrimaryAttribute("Strength")
    ..setStatsBase(22, 13, 17)
    ..setStatsPerLvl(2.70, 1.50, 1.80)
    
    ..setScalingValue(1.10)
    ..setSelectionScale(1.10)

    ..setMeleeAttack()
    ..setAttack1CooldownTime(1.70)
    ..setAttack1DamageSidesperDie(6)
    ..setAttack1AnimationBackswingPoint(0.567)
    ..setAttack1AnimationDamagePoint(0.433)
    ..setAttack1AttackType(AttackType.Chaos)
    
    ..setDefenseBase(2)
    ..setManaInitialAmount(200)
    
    ..setTurnRate(0.60)
    ..setRequirements(commaList(HERO_ARTHAS_PICKED))
    
    ..setName("Arthas")
    ..setTooltipBasic("|c00F7EC46Arthas|r")
    ..setTooltipExtended("|c00F7EC46Arthas|r\n"
    + "Roles: " + farmer + "\n\n"
    + "|c00EE0404Physical Damage|r: 4/5\n"
    + "|c0076ECF9Magical Damage|r: 0/5\n"
    + "|c00B0B0B0Defense|r: 2/5\n"
    + "|c00663300Utility|r: 1/5\n"
    + "|c0066FF66Healing|r: 1/5\n"
    + "Difficulty: 3/5\n")
    
// ----------------------------------------------------------------------------

    new MyHeroDefinition(HERO_ARTHAS_FORM, UnitIds.arthaswithfrostmourne)// Arthas (H00B)
    ..setHeroAbilities(commaList('A00A', 'A00B', 'A00H', ARTHAS_ABILITY_5, 'A00S'))
    
    ..setPrimaryAttribute("Strength")
    ..setStatsBase(22, 13, 17)
    
    ..setModelFile("Units\\Arthas Frostmourne\\KingArthas.mdl")
    ..setScalingValue(1.10)
    ..setSelectionScale(1.10)

    ..setMeleeAttack()
    ..setAttack1CooldownTime(0.5)
    ..setAttack1DamageSidesperDie(6)
    ..setAttack1AnimationBackswingPoint(0.567)
    ..setAttack1AnimationDamagePoint(0.433)
    ..setAttack1AttackType(AttackType.Magic)
    
    ..setDefenseBase(2)
    ..setManaInitialAmount(200)
    
    ..setTurnRate(0.60)
    ..setRequirements("")
    
    ..setName("Arthas")
    ..setTooltipBasic("|c00F7EC46Arthas|r")
    ..setTooltipExtended("|c00F7EC46Arthas|r\n"
    + "Roles: " + farmer + "\n\n"
    + "|c00EE0404Physical Damage|r: 4/5\n"
    + "|c0076ECF9Magical Damage|r: 0/5\n"
    + "|c00B0B0B0Defense|r: 2/5\n"
    + "|c00663300Utility|r: 1/5\n"
    + "|c0066FF66Healing|r: 1/5\n"
    + "Difficulty: 3/5\n")
    
// ----------------------------------------------------------------------------