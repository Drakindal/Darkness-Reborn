package WolfmanFinal_Abilities

import MyAbilityIds
import MyHeroAbilityDefinition
import MyUnitIds
import AbilityObjEditing
import MyBuffIds
import ObjectIds
import Icons
import MyColors

// ----------------------------------------------------------------------------

@compiletime function wolfmanAbils()
    new AbilityDefinitionCripple(WOLF_FINAL_ABILITY_1)
    ..setPosition(AbilityPosition.Q)
    ..setLevels(1)
    ..setCooldown(1, 5)
    ..setManaCost(1, 0)
    ..setCastRange(1, 180)
    ..setTargetsAllowed(1, getTargets(AbilityTargets.EnemiesAll))
    ..setDuration(1, 0.01)
    ..setBuffs(1, commaList(""))
    ..setRequirements("")
    ..setIcon(Icons.bTNCannibalize)
    ..register(HERO_WOLFMAN_FINAL, "Tearing Claws".setColor(colAbilitiesWolfman), 
    "Bites the enemy dealing 37 x Str + 2250 damage. Cd 5 sec.\n" +
    "Wolfman becomes so powerful that he can even tear of the metal parts of structures and mechanical units.")

// ----------------------------------------------------------------------------

    new AbilityDefinitionWarStompcreep(WOLF_FINAL_ABILITY_2_DUMMY_1)
    ..setLevels(1)
    ..setDamage(1, 0)
    ..setCooldown(1, 0)
    ..setCastRange(1, 93083)
    ..setManaCost(1, 0)
    ..setAreaofEffect(1, 400)
    ..setDuration(1, 3.5)
    ..setBuffs(1, commaList(WOLF_BUFF_2))
    ..setEffects(1, "")
    ..setTerrainDeformationDurationms(1, 0)
    ..setTerrainDeformationAmplitude(1, 0)
    ..setArtSpecial("")
    ..setArtEffect("")
    ..setTargetsAllowed(1, getTargets(AbilityTargets.EnemiesNonStructuresMechUnits))

    new AbilityDefinitionCripplecreep(WOLF_FINAL_ABILITY_2_DUMMY_2)
    ..setLevels(9)
    ..setMovementSpeedReduction(1, 0.90)
    ..setAttackSpeedReduction(1, 0.45)
    ..setDamageReduction(1, 0.25)
    ..setBuffs(1, commaList(WOLF_BUFF_3))
    ..setCooldown(1, 0)
    ..setCastRange(1, 93083)
    ..setManaCost(1, 0)
    ..setAreaofEffect(1, 400)
    ..setDuration(1, 2)
    ..setTargetsAllowed(1, getTargets(AbilityTargets.EnemiesNonStructuresMechUnits))

    new AbilityDefinitionBerserk(WOLF_FINAL_ABILITY_2)
    ..setPosition(AbilityPosition.W)
    ..setLevels(1)
    ..setDuration(1, 14)
    ..presetDamageTakenIncrease(lvl -> 0.0)
    ..presetAttackSpeedIncrease(lvl -> 0.0)
    ..presetMovementSpeedIncrease(lvl -> 0.0)
    ..setIcon(Icons.bTNBattleRoar)
    ..setCooldown(1, 6.)
    ..setManaCost(1, 0)
    ..register(HERO_WOLFMAN_FINAL, "Howl".setColor(colAbilitiesWolfman),
    "Howls to the sky. Stuns enemies for 3.5 sec. Reduces movement and attack speed and damage of enemies in 800 AoE for 14 sec.\n" +
    "-25% damage, -45% attack speed, -90% move speed. Cd 6 sec.")

// ----------------------------------------------------------------------------

    new AbilityDefinitionBerserk(WOLF_FINAL_ABILITY_3)
    ..setPosition(AbilityPosition.E)
    ..setLevels(1)
    ..presetDuration(lvl -> 7)
    ..presetCooldown(lvl -> 10)
    ..presetManaCost(lvl -> 0)
    ..presetDamageTakenIncrease(lvl -> 0)
    ..presetAttackSpeedIncrease(lvl -> 3)
    ..presetMovementSpeedIncrease(lvl -> 2.5)
    ..setIcon(Icons.bTNBerserk)
    ..presetBuffs(lvl -> commaList(WOLF_BUFF_1))
    ..register(HERO_WOLFMAN_FINAL, "Bloodlust".setColor(colAbilitiesWolfman), 
    "Blood hunger increases Wolfman's attack speed by 300% and movement speed by 250% for 7 sec. Cd 10 sec.")
    
// ----------------------------------------------------------------------------

    new AbilityDefinitionFarseerSpiritWolf(WOLFMAN_FINAL_SUMMON_ABILITY)
    ..setPosition(AbilityPosition.Q)
    ..setLevels(1)
    ..setSummonedUnit(1, commaList(WOLFMAN_INITIATE_SUMMON))
    ..setNumberofSummonedUnits(1, 4)
    ..setManaCost(1, 0)
    ..setDuration(1, 0)
    ..register(HERO_WOLFMAN_FINAL, "Call Pack".setColor(colAbilitiesWolfman), 
    "Calls \"Pack\".\n"+
    "Health: 0.65 x Spirit Wolf's max HP.\n" + 
    // "Armor: 0.5 x armor\n" + 
    "Damage: 0.5 x Spirit Wolf's base damage.\n" +
    "Armor Penetration: 50% of Spirit Wolf's Armor Pen.")

    // WIP armor.
    new AbilityDefinitionFarseerSpiritWolf(WOLF_FINAL_ABILITY_4)
    ..setPosition(AbilityPosition.R)
    ..setLevels(1)
    ..presetSummonedUnit(lvl -> commaList(WOLFMAN_FINAL_SUMMON))
    ..presetNumberofSummonedUnits(lvl -> 1)
    ..setIconNormal(Icons.bTNDireWolf)
    ..setIconResearch(Icons.bTNDireWolf)
    ..presetDuration(lvl -> 0)
    ..setCooldown(1, 20)
    ..register(HERO_WOLFMAN_FINAL, "Wolfman's Best Friend".setColor(colAbilitiesWolfman), 
    "Summon \"Spirit Wolf\".\n"+
    "Ability: Call Pack.\n" + 
    "Health: 0.35 x max HP + 3500.\n" + 
    "Damage: 0.4 x Str + 700.\n" + 
    "Armor Penetration: 50% of Wolfman's Armor Pen.\n" +
    "Duration: Infinite.\n" +
    "Cooldown: 20s.")

// ----------------------------------------------------------------------------

    new AbilityDefinitionBladeMasterCriticalStrike(WOLF_FINAL_ABILITY_5)
    ..setPosition(AbilityPosition.T)
    ..setLevels(1)
    ..setChancetoCriticalStrike(1, 9)
    ..setDamageMultiplier(1, 50)
    ..register(HERO_WOLFMAN_FINAL, "Frenzy".setColor(colAbilitiesWolfman), 
    "Gives 9% chance to deal 50x critical damage.\n\n" + 
    "Also, Wolfman gets Str for every killed enemy:\n" +
    "+1 Str if enemy's lvl < 30.\n" +
    "from +3 to +7 Str (randomly) if enemy's lvl < 45.\n" +
    "from +6 to +20 Str (randomly) if enemy's lvl >= 45.")

// ----------------------------------------------------------------------------