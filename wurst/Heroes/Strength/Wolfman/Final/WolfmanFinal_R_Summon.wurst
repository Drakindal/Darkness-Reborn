package WolfmanFinal_R_Summon

import MyUnitIds
import ClosureEvents
import UnitStats

public function manwolfDog()

    EventListener.add(EVENT_PLAYER_UNIT_SUMMON) ->
        let summoner = GetSummoningUnit()
        if(summoner.getTypeId() == HERO_WOLFMAN_FINAL)
            let summon = GetSummonedUnit()..registerStats()
            let str = summoner.getStr(true)
            
            if summon.getTypeId() == WOLFMAN_FINAL_SUMMON
                summon.setMaxHP(((0.35*summoner.getMaxHP()) + 3500).toInt(), true)
                //summon.setArmor(0.5 * summoner.getArmor() + 40)
                summon.setBaseDamage((0.4 * str + 700).toInt(), 0)
                
                let armorPen = 0.5*summoner.getStats().getPen(penType.Physical)
                summon.getStats().setBasePen(penType.Physical, armorPen)

        else if(summoner.getTypeId() == WOLFMAN_FINAL_SUMMON)
            let summon = GetSummonedUnit()
            summon.setMaxHP(((0.65*summoner.getMaxHP())).toInt(), true)
            summon.setArmor(0.5 * summoner.getArmor())
            summon.setBaseDamage((0.5 * summoner.getBaseDamage(0)).toInt(), 0)
            
            let armorPen = 0.5*summoner.getStats().getPen(penType.Physical)
            summon.getStats().setBasePen(penType.Physical, armorPen)