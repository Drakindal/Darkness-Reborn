package WolfmanFinal_Hero

import UnitIds
import ObjectIds
import MyUnitIds
import MyAbilityIds
import MyHeroAbilityDefinition
import MyUnitIds
import AbilityObjEditing
import CommonDescriptions
import Icons
import MyHeroDefinition
import HeroNames

@compiletime function defineHero()
    new MyHeroDefinition(HERO_WOLFMAN_FINAL, UnitIds.blademaster)// Wolfman (O007)
    ..setHeroAbilities(commaList(WOLF_FINAL_ABILITY_1,WOLF_FINAL_ABILITY_2,WOLF_FINAL_ABILITY_3,WOLF_FINAL_ABILITY_4,WOLF_FINAL_ABILITY_5))
    
    ..setPrimaryAttribute("Strength")
    ..setStatsBase(18, 22, 16)
    ..setStatsPerLvl(2.00, 1.75, 2.25)
    
    ..setSelectionScale(1.25)
    ..setModelFile("Units\\Werewolf\\Wolf.mdx")
    ..setIconGameInterface(Icons.bTNSpiritWolf)
    ..setIconScoreScreen(Icons.bTNSpiritWolf)

    ..setMeleeAttack()
    ..setAttack1CooldownTime(2.00)
    ..setAttack1DamageSidesperDie(9)
    ..setAttack1AnimationBackswingPoint(0.840)
    ..setAttack1AnimationDamagePoint(0.330)
    
    ..setHitPointsMaximumBase(50)
    ..setManaInitialAmount(0)
    
    ..setTurnRate(0.60)
    ..setRequirements("")

    ..setTooltipExtended(HERO_WOLFMAN_FINAL,
    rolesList(roleDefender, roleFarmer, roleStacker, roleAscendant),
    PhysDamage.v4,
    MagicDamage.v0,
    Defense.v3,
    Utility.v2,
    Healing.v3,
    Difficulty.v2)