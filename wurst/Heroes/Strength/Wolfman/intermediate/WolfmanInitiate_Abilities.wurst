package WolfmanInitiate_Abilities

import MyAbilityIds
import MyHeroAbilityDefinition
import MyUnitIds
import AbilityObjEditing
import MyBuffIds
import ObjectIds
import Icons
import MyColors
import UnitIds

// ----------------------------------------------------------------------------

@compiletime function wolfmanAbils()
    new AbilityDefinitionCripple(WOLF_INITIATE_ABILITY_1)
    ..setGeneralAbility(AbilityPosition.Q)
    ..presetCooldown(lvl -> 5)
    ..presetManaCost(lvl -> 0)
    ..presetCastRange(lvl -> 180)
    ..presetTargetsAllowed(lvl -> getTargets(AbilityTargets.EnemiesNonStructuresMechUnits))
    ..presetDuration(lvl -> 0.01)
    ..presetBuffs(lvl -> commaList(""))
    ..setRequirements("")
    ..setIcon(Icons.bTNCannibalize)
    ..register(HERO_WOLFMAN_INITIATE, "Bite".setColor(colAbilitiesWolfman), 
    "Bites the enemy. Cd 5 sec. Mana cost 0. Cannot damage structures and mechanical units.",
    (int lvl) -> "Deals {0} x Str damage".format(
        (3*lvl).toString()
    ))

// ----------------------------------------------------------------------------

    new AbilityDefinitionWarStompcreep(WOLF_INITIATE_ABILITY_2_DUMMY_1)
    ..setLevels(9)
    ..presetDamage(lvl -> 0)
    ..presetCooldown(lvl -> 0)
    ..presetCastRange(lvl -> 93083)
    ..presetManaCost(lvl -> 0)
    ..presetAreaofEffect(lvl -> 400)
    ..presetDuration(lvl -> 2)
    ..presetBuffs(lvl -> commaList(WOLF_BUFF_2))
    ..presetEffects(lvl -> "")
    ..presetTerrainDeformationDurationms(lvl -> 0)
    ..presetTerrainDeformationAmplitude(lvl -> 0)
    ..setArtSpecial("")
    ..setArtEffect("")
    ..presetTargetsAllowed(lvl -> getTargets(AbilityTargets.EnemiesNonStructuresMechUnits))

    new AbilityDefinitionCripplecreep(WOLF_INITIATE_ABILITY_2_DUMMY_2)
    ..setLevels(9)
    ..presetMovementSpeedReduction(lvl -> 0.08*lvl)
    ..presetAttackSpeedReduction(lvl -> 0.03*lvl)
    ..presetDamageReduction(lvl -> 0.02*lvl)
    ..presetBuffs(lvl -> commaList(WOLF_BUFF_3))
    ..presetCooldown(lvl -> 0)
    ..presetCastRange(lvl -> 93083)
    ..presetManaCost(lvl -> 0)
    ..presetAreaofEffect(lvl -> 400)
    ..presetDuration(lvl -> 2)
    ..presetTargetsAllowed(lvl -> getTargets(AbilityTargets.EnemiesNonStructuresMechUnits))

    // WIP. armor reduction.
    new AbilityDefinitionBerserk(WOLF_INITIATE_ABILITY_2)
    ..setGeneralAbility(AbilityPosition.W)
    ..presetDuration(lvl -> 10)
    ..presetDamageTakenIncrease(lvl -> 0.0)
    ..presetAttackSpeedIncrease(lvl -> 0.0)
    ..presetMovementSpeedIncrease(lvl -> 0.0)
    ..setIcon(Icons.bTNBattleRoar)
    ..presetCooldown(lvl -> 12.-lvl)
    ..presetManaCost(lvl -> 0)
    ..register(HERO_WOLFMAN_INITIATE, "Howl".setColor(colAbilitiesWolfman), 
    "Howls to the sky. Stuns enemies for 2 sec. Reduces movement and attack speed and damage of enemies in 800 AoE for 10 sec.",
    (int lvl) -> "-{0}% damage, -{1}% attack speed, -{2}% move speed. Cd {3} sec".format(
        (2*lvl).toString(),
        (3*lvl).toString(),
        (8*lvl).toString(),
        (12-lvl).toString()
    ))

// ----------------------------------------------------------------------------

    new AbilityDefinitionBerserk(WOLF_INITIATE_ABILITY_3)
    ..setGeneralAbility(AbilityPosition.E)
    ..presetDuration(lvl -> 5)
    ..presetCooldown(lvl -> 18.-lvl)
    ..presetManaCost(lvl -> 0)
    ..presetAttackSpeedIncrease(lvl -> 0.2*lvl)
    ..presetMovementSpeedIncrease(lvl -> 0.15*lvl)
    ..presetDamageTakenIncrease(lvl -> 0)
    ..setIcon(Icons.bTNBerserk)
    ..presetBuffs(lvl -> commaList(WOLF_BUFF_1))
    ..register(HERO_WOLFMAN_INITIATE, "Bloodlust".setColor(colAbilitiesWolfman), 
    "Blood hunger makes Wolfman attacks and moves faster for 5 sec.",
    (int lvl) -> "+{0}% Attack Speed, +{1}% Movement speed. Cd {2} sec.".format(
        (20*lvl).toString(),
        (15*lvl).toString(),
        (18-lvl).toString()
    ))

// ----------------------------------------------------------------------------

    new UnitDefinition(WOLFMAN_INITIATE_SUMMON, UnitIds.direwolf)
    ..setNormalAbilities("")
    ..setAttack1CooldownTime(1)
    ..setName("Wolf")
    
    // WIP armor.
    new AbilityDefinitionFarseerSpiritWolf(WOLF_INITIATE_ABILITY_4)
    ..setGeneralAbility(AbilityPosition.R)
    ..presetSummonedUnit(lvl -> commaList(WOLFMAN_INITIATE_SUMMON))
    ..presetNumberofSummonedUnits(lvl -> 1)
    ..setIcon(Icons.bTNDireWolf)
    ..presetDuration(lvl -> 0)
    ..presetCooldown(lvl -> 35)
    ..register(HERO_WOLFMAN_INITIATE, "Dogman's Best Friend".setColor(colAbilitiesWolfman), 
    "Summons \"Alpha Wolf\".\n" +
    "Health: 0.15 x max HP + {0}.\n" + 
    //"Armor: 0.2 * armor + 2 * lvl\n" + 
    "Damage: 0.2 x Str + {1}.\n" + 
    "Duration: Infinite.\n" +
    "Cooldown: 35s.",
    (string format) -> format.format(
        "190 x Lvl",
        "40 x Lvl"
    ),
    (string format, int lvl) -> format.format(
        (190*lvl).toString(),
        (40*lvl).toString()
    ))
// ----------------------------------------------------------------------------