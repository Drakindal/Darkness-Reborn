package WolfmanInitiate_Hero

import UnitIds
import ObjectIds
import MyUnitIds
import MyAbilityIds
import AbilityObjEditing
import CommonDescriptions
import Icons
import Units
import MyHeroDefinition

@compiletime function defineHero()
    new MyHeroDefinition(HERO_WOLFMAN_INITIATE, UnitIds.blademaster)// Wolfman (O007)
    
    ..setHeroAbilities(commaList(WOLF_INITIATE_ABILITY_1,WOLF_INITIATE_ABILITY_2,WOLF_INITIATE_ABILITY_3,WOLF_INITIATE_ABILITY_4))
    
    ..setPrimaryAttribute("Strength")
    ..setStatsBase(18, 22, 16)
    ..setStatsPerLvl(2.00, 1.75, 2.25)
    
    ..setSelectionScale(1.25)
    ..setModelFile(Units.direWolf1)
    ..setIconGameInterface(Icons.bTNSpiritWolf)
    ..setIconScoreScreen(Icons.bTNSpiritWolf)
    
    ..setMeleeAttack()
    ..setAttack1CooldownTime(2.00)
    ..setAttack1DamageSidesperDie(9)
    ..setAttack1AnimationBackswingPoint(0.840)
    ..setAttack1AnimationDamagePoint(0.330)
    
    ..setHitPointsMaximumBase(50)
    ..setManaInitialAmount(0)
    
    ..setTurnRate(0.60)
    ..setRequirements("")
    
    ..setProperNames("Dogman")
    ..setName("Dogman")
    ..setTooltipBasic("|c00F7EC46Wolfman|r")
    ..setTooltipExtended("|c00F7EC46Wolfman|r\n"
    + "Roles: " + defender + "/" + farmer + "/" + stacker + "\n\n"
    + "|c00EE0404Physical Damage|r: 3/5\n"
    + "|c0076ECF9Magical Damage|r: 2/5\n"
    + "|c00B0B0B0Defense|r: 4/5\n"
    + "|c00663300Utility|r: 2/5\n"
    + "|c0066FF66Healing|r: 3/5\n"
    + "Difficulty: 2/5\n")