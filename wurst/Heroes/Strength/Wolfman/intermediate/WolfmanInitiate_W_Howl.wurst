package WolfmanInitiate_W_Howl

import ClosureEvents
import MyAbilityIds
import DummyCaster
import OrderIds

public function doghowl()
    EventListener.onCast(WOLF_INITIATE_ABILITY_2) (unit caster) ->
        let lvl = caster.getAbilityLevel(WOLF_INITIATE_ABILITY_2)
        new DummyCaster()
        ..origin(caster.getPos())
        ..owner(caster.getOwner())
        ..castImmediate(WOLF_INITIATE_ABILITY_2_DUMMY, 
        lvl, 
        OrderIds.stomp)