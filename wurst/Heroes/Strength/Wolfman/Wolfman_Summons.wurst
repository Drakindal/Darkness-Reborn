package Wolfman_Summons

import UnitObjEditing
import MyUnitIds
import UnitIds
import ObjectIds
import MyAbilityIds

@compiletime function defineSummons()


    new UnitDefinition(WOLFMAN_FINAL_SUMMON, UnitIds.direwolf)
    ..setNormalAbilities(commaList(WOLFMAN_FINAL_SUMMON_ABILITY))
    ..setAttack1CooldownTime(1)
    ..setName("Alpha Wolf")
