package WolfmanInitial_Hero

import UnitIds
import ObjectIds
import MyUnitIds
import MyAbilityIds
import AbilityObjEditing
import MyUpgradesIds
import CommonDescriptions
import Icons
import Units
import MyHeroDefinition

// ----------------------------------------------------------------------------

@compiletime function defineHero()
    new MyHeroDefinition(HERO_WOLFMAN_INITIAL, UnitIds.blademaster)
    ..setHeroAbilities(commaList(MAN_ABILITY_1,MAN_ABILITY_2,MAN_ABILITY_3))
    
    ..setPrimaryAttribute("Strength")
    ..setStatsBase(18, 22, 16)
    ..setStatsPerLvl(2.00, 1.75, 2.25)
    
    ..setSelectionScale(1.25)
    ..setModelFile(Units.villagerMan1)
    ..setIconGameInterface(Icons.bTNSpiritWolf)
    ..setIconScoreScreen(Icons.bTNSpiritWolf)
    
    ..setMeleeAttack()
    ..setAttack1CooldownTime(2.00)
    ..setAttack1DamageSidesperDie(9)
    ..setAttack1AnimationBackswingPoint(0.840)
    ..setAttack1AnimationDamagePoint(0.330)
    
    ..setHitPointsMaximumBase(50)
    ..setManaInitialAmount(0)
    
    ..setTurnRate(0.60)
    ..setRequirements(commaList(HERO_WOLFMAN_INITIAL_PICKED))
    
    ..setTooltipExtended(HERO_WOLFMAN_FINAL,
    rolesList(roleDefender, roleFarmer, roleStacker, roleAscendant),
    PhysDamage.v4,
    MagicDamage.v0,
    Defense.v3,
    Utility.v2,
    Healing.v3,
    Difficulty.v2)
    
// ----------------------------------------------------------------------------