package Uther_R_Redemption

import DamageTarget
import ClosureEvents
import MyAbilityIds
import MyBuffIds
import Abilities
import DamageEvent
import RandomGen
import Uther_Abilities
import ClosureTimers
import Uther_Hero
import HashMap
import StandardTextTags

// ----------------------------------------------------------------------------

public var holyPower = 0
let holyAllies = new HashMap<int, int>

// ----------------------------------------------------------------------------

// Uther ability handler.
public function redemptionHoly()
    DamageEvent.addListener(2) ->
        let src = DamageEvent.getSource()
        if src.isIllusion()
            skip
        else
            if (DamageEvent.getType() == ATTACK)
                let lvl = src.getAbilityLevel(UTHER_ABILITY_4)
                if (lvl > 0 and checkChanceI(5 * lvl))
                    let targ = DamageEvent.getTarget()
                    let str = src.getStr(true)
                    let amount = (str * 0.5 + 75) * lvl
                    let heal = 50*lvl + lvl * 1.2 * str

                    src.damageTargetCode(amount, targ, null, -1, customDamageType.Magical)

                    src.addHP(heal)
                    addHolyPower((lvl*0.25).ceil())

// ----------------------------------------------------------------------------

public function addHolyPower(int addHoly)
    holyPower = holyPower + addHoly
    if holyPower > 150
        holyPower = 150
    updateHolyPower()

public function removeHolyPower(int removeHoly)
    holyPower = holyPower - removeHoly
    updateHolyPower()

public function setHolyPower(int setHoly)
    holyPower = setHoly
    updateHolyPower()

function updateHolyPower()
    var lvl = utherHero.getAbilityLevel(UTHER_ABILITY_4)
    while lvl <= 9
        setAbilityExtendedTooltip(UTHER_ABILITY_4, uther_abi4_formatDescr(lvl, holyPower), lvl-1)
        lvl += 1

// ----------------------------------------------------------------------------

function printNumberOfBlessed()
    printTimedToPlayer("Current number of blessed allies: {0} / 3.".format(
        holyAllies.size().toString()
    ), 5, utherHero.getOwner())

// ----------------------------------------------------------------------------

function redemptionAddAlly(unit target)
    if (not target.hasAbility(UTHER_BUFF_4))
        let lvl = utherHero.getAbilityLevel(UTHER_ABILITY_4)

        holyAllies.put(target.getTypeId(), lvl)
        printNumberOfBlessed()
        doAfter(14.0 + 2 * (lvl-1)) ->
            redemptionRemoveAlly(target)
    else
        printTimedToPlayer("Ally is already blessed!", 5, utherHero.getOwner())

function redemptionRemoveAlly(unit target)
    if holyAllies.has(target.getTypeId())
        holyAllies.remove(target.getTypeId())
        printNumberOfBlessed()

// ----------------------------------------------------------------------------

public function redemptionAlly()
    EventListener.onTargetCast(UTHER_ABILITY_4) (unit caster, unit target) ->
        if holyAllies.size() >= 3
            printTimedToPlayer("You have a maximum number of blessed allies!", 5, caster.getOwner())
            target.removeAbility(UTHER_BUFF_4)
        else
            redemptionAddAlly(target)

    EventListener.add(EVENT_PLAYER_UNIT_DEATH) ->
        redemptionRemoveAlly(GetDyingUnit())

    // Ally handler.
    EventListener.add(EVENT_PLAYER_UNIT_SPELL_CAST) -> 
        let u = GetTriggerUnit()
        let uid = u.getTypeId()
        if holyAllies.has(uid)
            let lvl = holyAllies.get(uid)
            let addHolyPower = (lvl*0.2).ceil()
            addHolyPower(addHolyPower)
            
            createLumberBountyTextTag(u, 1)
            ..setColor(colorA(236, 240, 97, 255))
            ..setText("+{0} Holy Power".format(addHolyPower.toString()))
            
            let heal = lvl * 0.1 * utherHero.getStr(true)
            flashEffect(Abilities.holyBoltSpecialArt, u.getPos())
            u.addHP(heal)

// ----------------------------------------------------------------------------