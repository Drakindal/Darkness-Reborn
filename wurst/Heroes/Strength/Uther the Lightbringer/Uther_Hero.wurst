package Uther_Hero

import UnitIds
import ObjectIds
import MyUnitIds
import MyAbilityIds
import AbilityObjEditing
import MyUpgradesIds
import CommonDescriptions
import MyHeroDefinition

// ----------------------------------------------------------------------------

@compiletime function defineHero()
    new MyHeroDefinition(HERO_UTHER, UnitIds.uther)
    ..setModelFile("Units\\Uther\\Uther HOTS\\Uther.mdx")
    ..setHeroAbilities(commaList(UTHER_ABILITY_1, UTHER_ABILITY_2, UTHER_ABILITY_3, UTHER_ABILITY_4, UTHER_ABILITY_5))
    
    ..setPrimaryAttribute("Strength")
    ..setStatsBase(22, 13, 17)
    ..setStatsPerLvl(2.70, 1.50, 1.80)

    ..setScalingValue(1.10)
    ..setSelectionScale(1.10)
    
    ..setMeleeAttack()
    ..setAttack1CooldownTime(1.70)
    ..setAttack1DamageSidesperDie(6)
    ..setAttack1AnimationBackswingPoint(0.567)
    ..setAttack1AnimationDamagePoint(0.433)
    
    ..setDefenseBase(2)
    ..setManaInitialAmount(200)
    
    ..setTurnRate(0.60)
    ..setRequirements(commaList(HERO_UTHER_PICKED))

    ..setTooltipExtended(
    rolesList(roleDefender, roleFarmer),
    PhysDamage.v3,
    MagicDamage.v3,
    Defense.v3,
    Utility.v2,
    Healing.v2,
    Difficulty.v1)
    
// ----------------------------------------------------------------------------