package Uther_T_LightsWrath

import Uther_R_Redemption
import ClosureEvents
import ClosureForGroups
import DamageTarget
import MyAbilityIds
import Abilities

public function lightsWrath()
    EventListener.onTargetCast(UTHER_ABILITY_5) (unit caster, unit target) ->
        let lvl = caster.getAbilityLevel(UTHER_ABILITY_5)
        let dmg = caster.getStr(true) * holyPower * lvl * 0.25
        setHolyPower(0)
        flashEffect("Units\\Uther\\Sacred Storm\\Sacred Storm.mdx", target.getPos())

        caster.addHP( caster.getMaxHP() * (0.20 + 0.10*(lvl-1)) )
        caster.damageTargetCode(dmg, target, null, -1, customDamageType.Magical)

        forUnitsInRange(caster.getPos(), 1200) (unit u) ->
            if u.isAllyOf(caster) and u.isAlive()
                u.addHP(dmg / 2)
                flashEffect(Abilities.resurrectcaster, u.getPos())
