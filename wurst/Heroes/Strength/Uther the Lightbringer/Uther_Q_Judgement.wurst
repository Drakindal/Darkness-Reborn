package Uther_Q_Judgement

import ClosureTimers
import ClosureEvents
import ClosureForGroups
import MyAbilityIds
import DamageTarget
import DummyCaster
import OrderIds
import Uther_R_Redemption
import StandardTextTags

function printBoost(unit caster, string value)
    createLumberBountyTextTag(caster, 1)
    ..setColor(colorA(236, 240, 97, 255))
    ..setText(value)

public function judgement()
    EventListener.onPointCast(UTHER_ABILITY_1) (unit caster, vec2 target) ->
        flashEffect("Units\\Uther\\Judgement NoHive\\Judgement NoHive.mdx", target)
        let lvl = caster.getAbilityLevel(UTHER_ABILITY_1)
        doAfter(0.82) ->
            var dmg = (2.4 * caster.getStr(true) + 150) * lvl

            if(holyPower >= 24)
                printBoost(caster, "Judgement x4.5")
                removeHolyPower(24)
                dmg = dmg * 4.5
            else if(holyPower >= 12)
                printBoost(caster, "Judgement x3.4")
                removeHolyPower(12)
                dmg = dmg * 3.4
            else if(holyPower >= 6)
                printBoost(caster, "Judgement x2.3")
                removeHolyPower(6)
                dmg = dmg * 2.3
            else if(holyPower >= 3)
                printBoost(caster, "Judgement x1.5")
                removeHolyPower(3)
                dmg = dmg * 1.5
            else if(holyPower >= 2)
                printBoost(caster, "Judgement x1.4")
                removeHolyPower(2)
                dmg = dmg * 1.4
            else if(holyPower >= 1)
                printBoost(caster, "Judgement x1.3")
                removeHolyPower(1)
                dmg = dmg * 1.3

            forUnitsInRange(target, 400) (unit u) ->
                if u.isEnemyOf(caster) and u.isAlive()
                    caster.damageTargetCode(dmg, u, null, -1, customDamageType.Magical)
                    
                    new DummyCaster()
                    ..origin(target)
                    ..owner(caster.getOwner())
                    ..castTarget(UTHER_DUMMY_1, lvl, OrderIds.thunderbolt, u)