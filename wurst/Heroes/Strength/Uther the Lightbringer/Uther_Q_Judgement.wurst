package Uther_Q_Judgement

import ClosureTimers
import ClosureEvents
import ClosureForGroups
import MyAbilityIds
import DamageTarget
import DummyCaster
import OrderIds
import Uther_R_Redemption


public function judgement()
    EventListener.onPointCast(UTHER_ABILITY_1) (unit caster, vec2 target) ->
        flashEffect("Units\\Uther\\Judgement NoHive\\Judgement NoHive.mdx", target)
        let lvl = caster.getAbilityLevel(UTHER_ABILITY_1)
        doAfter(0.82) ->
            var dmg = (2.4 * caster.getStr(true) + 150) * lvl
            if(holyPower >= 6)
                removeHolyPower(6)
                dmg = dmg * 2
            forUnitsInRange(target, 400) (unit u) ->
                if u.isEnemyOf(caster)
                    caster.damageTargetCode(dmg, u, null, -1, customDamageType.Magical)
                    new DummyCaster()
                    ..origin(target)
                    ..owner(caster.getOwner())
                    ..castTarget(UTHER_DUMMY_1, lvl, OrderIds.thunderbolt, u)