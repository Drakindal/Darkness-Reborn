package DeathKnight_E

import DamageCustomEvent
import MyAbilityIds
import DeathKnight_Abilities
import MyUnitTypes
import RandomGen
import DummyCaster
import Orders

public function curseOfDarkness()
    DamageCustomEvent.addListener(1) ->
        if (DamageCustomEvent.getType() == ATTACK)
            let damtyp = DamageCustomEvent.getDamageType()
            if (damtyp == DAMAGE_TYPE_NORMAL or damtyp == DAMAGE_TYPE_MAGIC)
                let src  = DamageCustomEvent.getSource()
                let targ = DamageCustomEvent.getTarget()
                let lvl = targ.getAbilityLevel(DEATH_KNIGHT_ABILITY_3)
                
                if  lvl > 0
                and not src.checkType(MyUnitType.StructureMechUnit)
                and checkChanceI(lvl * 3)
                    
                    let dmg = deathKnight_abi3_Hp[lvl-1]
                    targ.addHP(dmg)
                    src.addHP(-dmg)
                    
                    new DummyCaster()
                    ..owner(targ.getOwner())
                    ..origin(src.getPos())
                    ..castTarget(DEATH_KNIGHT_ABILITY_3_DUMMY, 1, OrderIds.chainlightning, targ)