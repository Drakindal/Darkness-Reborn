package DeathKnight_Abilities

import MyAbilityIds
import MyHeroAbilityDefinition
import MyUnitIds
import AbilityObjEditing
import MyBuffIds
import ObjectIds
import Icons
import BuffIds
import BuffObjEditing
import MyColors
import CommonDescriptions
import DebugVar
import Abilities

// ----------------------------------------------------------------------------

public constant real array[9] abi1_Cd = [
    20.0,
    18.0,
    16.0,
    14.0,
    12.0,
     9.0,
     6.0,
     3.0,
     1.0
]

public constant int array[9] abi1_Targets = [
    1,
    1,
    1,
    2,
    2,
    3,
    3,
    4,
    4
]

@compiletime function defineAbilities()
    if (BUILD_STR_HEROES)
        new AbilityDefinitionSeaWitchForkedLightning(DEATH_KNIGHT_ABILITY_1)
        ..setGeneralAbility(AbilityPosition.Q)
        ..presetAreaofEffect(lvl -> 350.0 + 35*lvl)
        ..presetFinalArea(lvl -> 350.0 + 35*lvl)
        ..presetDistance(lvl -> 250.0 + 30*lvl)
        ..presetCooldown(lvl -> abi1_Cd[lvl-1])
        ..setManaCost(1, 100)
        ..setManaCost(2, 130)
        ..setManaCost(3, 160)
        ..setManaCost(4, 190)
        ..setManaCost(5, 240)
        ..setManaCost(6, 290)
        ..setManaCost(7, 330)
        ..setManaCost(8, 370)
        ..setManaCost(9, 420)
        ..presetDamageperTarget(lvl -> 0.0)
        ..presetNumberofTargetsHit(lvl -> abi1_Targets[lvl-1])
        ..presetCastRange(lvl -> 300.0+30*lvl)
        ..setIcon("ReplaceableTextures\\CommandButtons\\BTNDeathCoil2.blp")
        ..setArtCaster("")
        ..setCasterAttachmentPoint("weapon")
        ..setCasterAttachmentPoint1("hand,left")
        ..setCasterAttachments(2)

        ..setLightningEffects("DRAL") // Life Drain

        ..setArtSpecial("Abilities\\Weapons\\IllidanMissile\\IllidanMissile.mdl")
        ..setMissileArt("Abilities\\Weapons\\IllidanMissile\\IllidanMissile.mdl")

        ..presetTargetsAllowed(lvl -> getTargets(AbilityTargets.EnemiesAll))
        ..setArtTarget("Abilities\\Spells\\Undead\\DeathCoil\\DeathCoilSpecialArt.mdl")
        ..register(HERO_DEATH_KNIGHT, "Unholy Execution".setColor(colAbilitiesDeathKnight), 
        "The Death Knight executes an enemy, devouring his Soul and using it to heal himself.",
        (int lvl) -> "Deals {0} x [2 x Str + Souls] damage to {1} enemies. Cd {2} sec.".format(
            (lvl).toString(),
            abi1_Targets[lvl-1].toString(),
            abi1_Cd[lvl-1].toString()
        ))

// ----------------------------------------------------------------------------
        
        new AbilityDefinitionMountainKingThunderBolt(DEATH_KNIGHT_ABILITY_2_DUMMY)
        ..setCastingTime(1, 0)
        ..setBuffs(1, "")
        ..setDamage(1, 0)
        ..setCastRange(1, 9999)
        ..setMissileArt(Abilities.chimaeraAcidMissile)
        ..setCooldown(1, 0)
        ..setManaCost(1, 0)
        ..setDuration(1, 0.0)
        ..setArtTarget("")
        ..setMissileSpeed(500)
        ..setTargetsAllowed(1, getTargets(AbilityTargets.EnemiesAll))

        new AbilityDefinitionBerserk(DEATH_KNIGHT_ABILITY_2)
        ..setGeneralAbility(AbilityPosition.W)
        ..presetBuffs(lvl -> BuffIds.antiMagicShell.toRawCode())
        ..presetCooldown(lvl -> 21.0 - lvl)
        ..setManaCost(1, 100)
        ..setManaCost(2, 120)
        ..setManaCost(3, 140)
        ..setManaCost(4, 170)
        ..setManaCost(5, 200)
        ..setManaCost(6, 230)
        ..setManaCost(7, 270)
        ..setManaCost(8, 310)
        ..setManaCost(9, 350)
        ..presetMovementSpeedIncrease(lvl -> 0.0)
        ..presetAttackSpeedIncrease(lvl -> 0.0)
        ..presetDamageTakenIncrease(lvl -> 0.0)
        ..presetDamageTakenIncrease(lvl -> 0.0)
        ..presetDuration(lvl -> 0.01)
        ..setAnimationNames("spell,slam")
        ..setIcon("ReplaceableTextures\\CommandButtons\\BTNDeathCoil.blp")
        ..register(HERO_DEATH_KNIGHT, "Taste of Death".setColor(colAbilitiesDeathKnight), 
        "The Death Knight unleashes a flurry of souls around him, dealing damage based on how many Souls he has collected.",
        (int lvl) -> "Deals {0} + {1} x Souls damage. Cd {2} sec.".format(
            (25*lvl).toString(),
            (10*lvl).toString(),
            (21 - lvl).toString()
        ))
        
// ----------------------------------------------------------------------------

public constant real array[9] deathKnight_abi3_Hp = [
    25,
    50,
    75,
    100,
    130,
    170,
    220,
    300,
    450
]

@compiletime function defineAbilities3()
    if (BUILD_STR_HEROES)
        new BuffDefinition(DEATH_KNIGHT_BUFF_3, BuffIds.roar)
        ..setIcon("ReplaceableTextures\\CommandButtons\\PASNecromastery.blp")
        ..setArtTarget("")
        ..setTargetAttachmentPoint0("weapon")
        ..setTargetAttachmentPoint1("weapon")
        ..register("Curse of the Death".setColor(colAbilitiesDeathKnight),
        "Death Knight restores HP when attacked.")

        new AbilityDefinitionChainLightningcreep(DEATH_KNIGHT_ABILITY_3_DUMMY)
        ..setCastingTime(1, 0)
        ..setCooldown(1, 0)
        ..setManaCost(1, 0)
        ..setDuration(1, 0.0)
        ..setDamageperTarget(1, 0)
        ..setNumberofTargetsHit(1, 1)
        ..setDamageReductionperTarget(1, 0)
        
        ..setLightningEffects("DRAL") // Life Drain
        
        ..setAnimationNames("spell")
        ..setArtTarget(Abilities.curseTarget)
        ..setMissileSpeed(500)
        ..setBuffs(1, "")
        ..setCastRange(1, 9999)
        ..setTargetsAllowed(1, getTargets(AbilityTargets.EnemiesNonStructuresMechUnits))

        new AbilityDefinitionTaurenChieftainEnduranceAura(DEATH_KNIGHT_ABILITY_3)
        ..setGeneralAbility(AbilityPosition.E)
        ..presetAreaofEffect(lvl -> 0.0)
        ..presetBuffs(lvl -> DEATH_KNIGHT_BUFF_3.toRawCode())
        ..presetMovementSpeedIncrease(lvl -> 0.0)
        ..presetAttackSpeedIncrease(lvl -> 0.0)
        ..setIcon("ReplaceableTextures\\CommandButtons\\PASNecromastery.blp")
        ..setArtTarget("")
        ..setTargetAttachmentPoint("")
        ..setLevelSkipRequirement(2)
        ..presetTargetsAllowed(lvl -> getTargets(AbilityTargets.Self))
        ..register(HERO_DEATH_KNIGHT, "Curse of the Death".setColor(colAbilitiesDeathKnight), 
        "The Death Knight has a chance to absorb the life force of the attacking enemy.",
        (int lvl) -> "{0}% chance to leach {1} HP.".format(
            (3*lvl).toString(),
            deathKnight_abi3_Hp[lvl-1].toString()
        ))

// ----------------------------------------------------------------------------
    
public constant int array[9] deathKnight_abi4_Targets = [
    1,
    1,
    2,
    2,
    3,
    3,
    4,
    4,
    5
]

@compiletime function defineAbilities4()
    if (BUILD_STR_HEROES)
        new BuffDefinition(DEATH_KNIGHT_BUFF_4, BuffIds.enduranceAura)
        ..setIcon("ReplaceableTextures\\CommandButtons\\BTNSkullSpirits.blp")
        ..setArtTarget("")
        ..register("Unholy Link".setColor(colAbilitiesDeathKnight),
        "The Death Knight shares his power with you, but in return he harvest souls of your defeated enemies.")

        new AbilityDefinitionSpiritLink(DEATH_KNIGHT_ABILITY_4)
        ..setGeneralAbility(AbilityPosition.R)
        ..presetAreaofEffect(lvl -> 32000.0)
        ..presetCastRange(lvl -> 32000.0)
        ..presetBuffs(lvl -> DEATH_KNIGHT_BUFF_4.toRawCode())
        ..presetCooldown(lvl -> 40.0 - 2 * (lvl-1))
        ..presetDuration(lvl -> 10.0 + 3 * (lvl-1))
        ..setManaCost(2, 85)
        ..setManaCost(3, 95)
        ..setManaCost(4, 115)
        ..setManaCost(5, 125)
        ..setManaCost(6, 135)
        ..setManaCost(7, 145)
        ..setManaCost(8, 155)
        ..setManaCost(9, 165)
        ..presetDistributedDamageFactor(lvl -> 0.0)
        ..presetMaximumNumberofTargets(lvl -> deathKnight_abi4_Targets[lvl-1])
        ..presetTargetsAllowed(lvl -> getTargets(AbilityTargets.AlliesNotSelf))
        ..setIcon("ReplaceableTextures\\CommandButtons\\BTNSkullSpirits.blp")
        ..register(HERO_DEATH_KNIGHT, "Unholy Link".setColor(colAbilitiesDeathKnight), 
        "The Death Knight unseals and shares his power with his allies. Unholy Link reduces incoming damage and allows the Death Knight with 33% chance to harvest souls of enemies killed by his allies. Also, Unholy Link will transfer part of the damage that an ally would receive to the Death Knight. Thus, reducing the damage received by an ally. However, if the Death Knight becomes weak (has less than 20% hp) Unholy Link will be broken. The Death Knight will spend 5 souls to recover his unholy power.\n" +
        wordNote + "Ability has the entire map cast range and area of effect.\n" + 
        "Damage reduction {0}%. Damage share with the Death Knight {1}%. Number of targets {0}. Duration {1} sec. Cd {2} sec.",
        (string format) ->  format.format(
            "(Lvl + 1)",
            "(25 + 5 x Lvl)",
            "increases with level",
            "(10 + 5 x (Lvl - 1))",
            "(40 - 4 x (Lvl - 1))"
        ),
        (string format, int lvl) -> format.format(
            (lvl + 1).toString(),
            (25 + 5 * lvl).toString(),
            deathKnight_abi4_Targets[lvl-1].toString(),
            (10 + 3 * (lvl-1)).toString(),
            (40 - 2 * (lvl-1)).toString()
        ))

