public constant real array[4] deathKnight_abi5_Factor = [
    12,
    10,
    14,
    16
]

public constant real array[4] deathKnight_abi5_Duration = [
    15,
    20,
    25,
    30
]

constant real array[4] abi5_Cd = [
    150,
    120,
     90,
     60
]

@compiletime function defineAbilities5()
    if (BUILD_STR_HEROES)
        new BuffDefinition(DEATH_KNIGHT_BUFF_5, BuffIds.battleRoar)
        ..setIconNormal(1, Icons.bTNHeroDeathKnight)
        ..setArtTarget("")
        ..register("Manifestation of Souls".setColor(colAbilitiesDeathKnight),
        "The Death Knight shares his power with you, but in return he harvest souls of your defeated enemies.")

        new AbilityDefinitionBattleRoar(DEATH_KNIGHT_ABILITY_5)
        ..setUltimateAbility()
        ..setEffectSound("")
        ..presetEffects(lvl -> "")
        ..setArtCaster("")
        ..setArtEffect("")
        ..setArtSpecial("")
        ..setArtTarget("")
        ..presetBuffs(lvl -> DEATH_KNIGHT_BUFF_5.toRawCode())
        ..presetDuration(lvl -> deathKnight_abi5_Duration[lvl-1])
        ..presetCooldown(lvl -> abi5_Cd[lvl-1])
        ..setIcon(Icons.bTNHeroDeathKnight)
        ..presetDefenseIncrease(lvl -> 0)
        ..presetLifeRegenerationRate(lvl -> 0)
        ..presetDamageIncrease(lvl -> 0)
        ..setManaCost(1, 200)
        ..setManaCost(2, 250)
        ..setManaCost(3, 300)
        ..setManaCost(4, 350)
        ..presetTargetsAllowed(lvl -> getTargets(AbilityTargets.Self))
        ..register(HERO_DEATH_KNIGHT, "Dark Soul".setColor(colAbilitiesDeathKnight), 
        "Death Knight infuses himself with all the souls he has harvested, gaining great power for a short time.",
        (int lvl) -> "+{0} x Souls Str for {1} sec. Cd {2} sec.".format(
            deathKnight_abi5_Factor[lvl-1].toString(),
            deathKnight_abi5_Duration[lvl-1].toString(0),
            abi5_Cd[lvl-1].toString(0)
        ))
        
