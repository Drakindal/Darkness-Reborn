package DeathKnight_Q

import ClosureEvents
import ClosureTimers
import DamageTarget
import DeathKnight_CollectSouls
import MyAbilityIds

public function soulCollector()
    EventListener.onTargetCast(DEATH_KNIGHT_ABILITY_1) (unit caster, unit target) ->
        let lvl = GetUnitAbilityLevel(caster, DEATH_KNIGHT_ABILITY_1)
        let dmg = ((caster.getStr(true) * 2.) + souls) * lvl
        doAfter(0.2) -> 
            caster.damageTargetCode(dmg, target, null, -1, customDamageType.PhysicalRanged)
            caster.addHP(dmg)
            doAfter(0.2) -> 
                caster.issueImmediateOrder("stop")