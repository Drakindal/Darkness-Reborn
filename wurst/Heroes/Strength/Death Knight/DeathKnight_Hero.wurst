package DeathKnight_Hero

import UnitIds
import ObjectIds
import MyUnitIds
import MyAbilityIds
import AbilityObjEditing
import MyUpgradesIds
import CommonDescriptions
import Icons
import Units
import Soundsets
import MyHeroDefinition

@compiletime function defineHero()
    new MyHeroDefinition(HERO_DEATH_KNIGHT, UnitIds.paladin)// Death Knight (U000)
    ..setHeroAbilities(commaList('A00L', 'A00N', 'A088', 'A0AE', ABILITY_8))
    
    ..setPrimaryAttribute("Strength")
    ..setStatsBase(23, 12, 17)
    ..setStatsPerLvl(2.70, 1.50, 1.80)
    
    ..setSelectionScale(1.85)

    ..setModelFile(Units.heroDeathKnight)
    ..setIconGameInterface(Icons.bTNHeroDeathKnight)
    ..setIconScoreScreen(Icons.bTNHeroDeathKnight)
    ..setUnitSoundSet(Soundsets.heroDeathKnight)
    
    ..setMeleeAttack()
    ..setAttack1CooldownTime(2.00)
    ..setAttack1DamageSidesperDie(6)
    ..setAttack1AnimationBackswingPoint(0.410)
    ..setAttack1AnimationDamagePoint(0.560)

    ..setHitPointsRegenerationType("blight")
    ..setHitPointsRegenerationRate(2.00)
    ..setDefenseBase(1)
    
    ..setRequirements(commaList(HERO_DEATH_KNIGHT_PICKED))
    
    ..setName("Death Knight")
    ..setTooltipBasic("|c00F7EC46Death Knight|r")
    ..setTooltipExtended("|c00F7EC46Death Knight|r\n"
    + "Roles: " + defender + "/" + farmer + "/" + stacker + "\n\n"
    + "|c00EE0404Physical Damage|r: 4/5\n"
    + "|c0076ECF9Magical Damage|r: 3/5\n"
    + "|c00B0B0B0Defense|r: 3/5\n"
    + "|c00663300Utility|r: 2/5\n"
    + "|c0066FF66Healing|r: 3/5\n"
    + "Difficulty: 4/5\n")
    