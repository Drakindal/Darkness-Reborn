package DeathKnight_T
import ClosureEvents
import ClosureTimers
import DeathKnight_Q
import MyAbilityIds

public function soulsKing()
    EventListener.onCast(DEATH_KNIGHT_ABILITY_5) (unit caster) ->
        let boost = souls * 10
        caster.addStr(boost)       
        doAfter(caster.getAbility(DEATH_KNIGHT_ABILITY_5).getField(ABILITY_RLF_DURATION_HERO, caster.getAbilityLevel(DEATH_KNIGHT_ABILITY_5)-1)) -> 
            caster.setStr(caster.getStr(false)-boost)