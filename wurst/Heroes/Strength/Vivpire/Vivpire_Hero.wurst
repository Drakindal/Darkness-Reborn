package Vivpire_Hero

import UnitIds
import ObjectIds
import MyUnitIds
import MyAbilityIds
import AbilityObjEditing
import MyUpgradesIds
import CommonDescriptions
import MyHeroDefinition

@compiletime function defineHero()
    new MyHeroDefinition(HERO_VIVPIRE, UnitIds.dreadlord)// Dreadlord (U00X)
    ..setHeroAbilities(commaList(VIVPIRE_ABILITY_1, VIVPIRE_ABILITY_2, VIVPIRE_ABILITY_3, VIVPIRE_ABILITY_4, VIVPIRE_ABILITY_5))
    
    ..setPrimaryAttribute("Strength")
    ..setStatsBase(20, 16, 18)
    ..setStatsPerLvl(2.5, 1.00, 2.5)
    
    ..setMeleeAttack()
    ..setAttack1CooldownTime(1.2)
    ..setAttack1DamageSidesperDie(12)
    ..setAttack1AnimationBackswingPoint(0.350)
    ..setAttack1AnimationDamagePoint(0.350)
    
    ..setHitPointsRegenerationType("blight")
    ..setHitPointsRegenerationRate(2.00)
    
    ..setRequirements(commaList(HERO_VIVPIRE_PICKED))
    
    ..setName("Vivpire")
    ..setProperNames("Vament")
    ..setTooltipBasic("|c00F7EC46Vivpire|r")
    ..setTooltipExtended("|c00F7EC46Vivpire|r\n"
    + "Roles: " + defender + "/" + farmer + "\n\n"
    + "|c00EE0404Physical Damage|r: 3/5\n"
    + "|c0076ECF9Magical Damage|r: 1/5\n"
    + "|c00B0B0B0Defense|r: 4/5\n"
    + "|c00663300Utility|r: 2/5\n"
    + "|c0066FF66Healing|r: 3/5\n"
    + "Difficulty: 3/5\n")