package Vivpire_E

import DamageCustomEvent
import MyBuffIds
import Vivpire_Abilities

public function vivpireAura()
    DamageCustomEvent.addListener(0) -> 
        let src = DamageCustomEvent.getSource()
        if src.hasAbility(VIVPIRE_BUFF_3)
            switch DamageCustomEvent.getType()
                case ATTACK
                    let lvl = src.getAbilityLevel(VIVPIRE_BUFF_3)
                    src.addHP(DamageCustomEvent.getAmount() * vivpire_abi3_Aura[lvl-1])
                    
                case CODE
                    if DamageCustomEvent.getDamageType() == DAMAGE_TYPE_MAGIC
                        skip
                    else
                        let lvl = src.getAbilityLevel(VIVPIRE_BUFF_3)
                        src.addHP(DamageCustomEvent.getAmount() * vivpire_abi3_Aura[lvl-1])
                default