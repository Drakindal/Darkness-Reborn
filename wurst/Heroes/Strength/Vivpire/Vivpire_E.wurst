package Vivpire_E

import DamageEvent
import MyBuffIds
import Vivpire_Abilities

public function vivpireAura()
    DamageEvent.addListener(0) -> 
        let src = DamageEvent.getSource()
        if src.hasAbility(VIVPIRE_BUFF_3)
            switch DamageEvent.getType()
                case ATTACK
                    let lvl = src.getAbilityLevel(VIVPIRE_BUFF_3)
                    src.addHP(DamageEvent.getAmount() * vivpire_abi3_Aura[lvl-1])
                    
                case CODE
                    if DamageEvent.getDamageType() == DAMAGE_TYPE_MAGIC
                        skip
                    else
                        let lvl = src.getAbilityLevel(VIVPIRE_BUFF_3)
                        src.addHP(DamageEvent.getAmount() * vivpire_abi3_Aura[lvl-1])
                default