public constant int array[9] vivpire_abi4_Str = [
    1,
    1,
    2,
    2,
    2,
    3,
    3,
    3,
    4
]

@compiletime function defineAbilities4()
    if (BUILD_STR_HEROES)
        new BuffDefinition(VIVPIRE_BUFF_4, BuffIds.berserk)
        ..setIcon("Units\\Vivpire\\Vampire bite\\BTNvampirebite.blp")
        ..setArtTarget("Units\\Vivpire\\Affliction\\Affliction040.mdx")
        ..setTargetAttachmentPoint0("chest")
        ..register("Prey".setColor(colAbilitiesVivpire),
        "This is the prey of the Vivpire, grants blood upon death.")
        
        new AbilityDefinitionCurse(VIVPIRE_DUMMY_ABILITY_4)
        ..setLevels(1)
        ..setChancetoMiss(1, 0)
        ..setDummyAbility()
        ..setDurationHero(1, 10)
        ..setDurationNormal(1, 10)
        ..presetBuffs(lvl -> commaList(VIVPIRE_BUFF_4))

        new AbilityDefinitionPurge(VIVPIRE_ABILITY_4)
        ..setGeneralAbility(AbilityPosition.R)
        ..presetBuffs(lvl -> commaList(VIVPIRE_BUFF_4))
        ..setMissileArt("")
        ..setIcon("Units\\Vivpire\\Vampire bite\\BTNvampirebite.blp")
        ..presetDurationHero(lvl -> 10)
        ..presetDurationNormal(lvl -> 10)
        ..presetAttackUpdateFrequency(lvl -> 0)
        ..presetHeroPauseDuration(lvl-> 0)
        ..presetMovementUpdateFrequency(lvl -> 0)
        ..presetSummonedUnitDamage(lvl -> 0)
        ..presetCastRange(lvl -> 280)
        ..presetCooldown(lvl -> 45.5 - lvl * 2.5)
        ..presetTargetsAllowed(lvl -> getTargets(AbilityTargets.EnemiesNonStructuresMechUnits))
        ..setArtTarget("Units\\Vivpire\\Affliction\\Affliction040.mdx")
        ..setArtSpecial("")
        ..presetUnitPauseDuration(lvl -> 0)
        ..register(HERO_VIVPIRE, "Prey Marked".setColor(colAbilitiesVivpire), 
        "Marks the target as a Prey, making them able to be cursed by Vampiric Bite. Also, Vivpire drains blood from the killed Prey and permanently gets Strength. Vivpire marks as a Prey not only the single target but also 2 x Lvl random units in 400 range.\n" +
        wordNote + "Type '-blood' to see your current Blood amount.",
        (int lvl) -> "+{0} Str on kill. {1} preys in range limit. Duration {2} sec.".format(
            vivpire_abi4_Str[lvl-1].toString(),
            (2*lvl).toString(),
            (10 + 2*(lvl-1)).toString()
        ))

// ----------------------------------------------------------------------------

public constant int array[4] vivpire_abi5_Damage = [
     100,
     300,
     600,
    1000
]

@compiletime function defineAbilities5()
    if (BUILD_STR_HEROES)
        new BuffDefinition(VIVPIRE_BUFF_5, BuffIds.vampiricPotion)
        ..setIcon("Units\\Vivpire\\BTNVarimathrasClaw\\BTNVarimathrasClaw.blp")
        ..register("Vivpire's True Form".setColor(colAbilitiesVivpire),
        "The Vivpire has returned to their ancestral form, receiving power from their foes.")

        // WIP armor.
        new AbilityDefinitionBerserk(VIVPIRE_ABILITY_5)
        ..setUltimateAbility()
        ..setIcon("Units\\Vivpire\\BTNVarimathrasClaw\\BTNVarimathrasClaw.blp")
        ..presetDurationHero(lvl -> 10. + lvl * 5)
        ..presetCooldown(lvl -> 175. - 15 * (lvl-1))
        ..presetBuffs(lvl -> commaList(VIVPIRE_BUFF_5))
        ..register(HERO_VIVPIRE, "Vampire-Lord Unleashed".setColor(colAbilitiesVivpire), 
        "Vivpire unleashes their true form dramatically increasing their power. Gets additional damage and HP based on the ability level and the Blood amount. Increases all stats in 4 times.",
        (int lvl) -> "+{0} + 8 x Blood damage. +{1} + 12 x Blood HP. Duration {2} sec. Cd {3} sec.".format(
            vivpire_abi5_Damage[lvl-1].toString(),
            (1000 * Pow(2, lvl - 1.)).toString(0),
            (10 + lvl * 5).toString(),
            (175 - 15 * (lvl-1)).toString()
        ))

