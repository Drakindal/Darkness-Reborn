package Vivpire_Abilities

import MyAbilityIds
import MyHeroAbilityDefinition
import MyUnitIds
import AbilityObjEditing
import MyBuffIds
import ObjectIds
import BuffIds
import BuffObjEditing
import MyColors
import CommonDescriptions
import DebugVar
import Icons

// ----------------------------------------------------------------------------

@compiletime function vivpireAbils()
    if (BUILD_STR_HEROES)
        new BuffDefinition(VIVPIRE_BUFF_1A, BuffIds.curse)
        ..register("This unit has been afflicted by Blood Hunter.".setColor(colAbilitiesVivpire),
        "This unit recieves additional damage by Vivpire.")

        new BuffDefinition(VIVPIRE_BUFF_1B, BuffIds.curse)
        ..setIcon("Units\\Vivpire\\BTNBloodyBite\\BTNBloodyBite.blp")
        ..register("Vampiric Bite".setColor(colAbilitiesVivpire),
        "This unit has been bitten by Vivpire.")
        
        new AbilityDefinitionCripplecreep(VIVPIRE_ABILITY_1_DUMMY_1)
        ..setLevels(1)
        ..setAttackSpeedReduction(1, 0.75)
        ..setMovementSpeedReduction(1, 0.75)
        ..setDamageReduction(1, 0.75)
        ..setDurationHero(1, 10)
        ..setDurationNormal(1, 10)
        ..setManaCost(1, 0)
        ..setBuffs(1, commaList(VIVPIRE_BUFF_1B))
        ..setCastRange(1, 99999)

        new AbilityDefinitionCursecreep(VIVPIRE_ABILITY_1_DUMMY_2)
        ..setLevels(1)
        ..setChancetoMiss(1, 0.75)
        ..setManaCost(1, 0)
        ..setDurationHero(1, 10)
        ..setDurationNormal(1, 10)
        ..setCastRange(1, 99999)
        
        new AbilityDefinitionCripple(VIVPIRE_ABILITY_1)
        ..setGeneralAbility(AbilityPosition.Q)
        ..setIcon("Units\\Vivpire\\BTNBloodyBite\\BTNBloodyBite.blp")
        ..setMissileArt("")
        ..setArtTarget("")
        ..presetBuffs(lvl -> commaList(""))
        ..setRequirements("")
        ..presetCooldown(lvl -> 21. - lvl)
        ..presetManaCost(lvl -> 75 + 20 * lvl + 10 * (lvl-2))
        ..presetCastRange(lvl -> 180)
        ..presetTargetsAllowed(lvl -> commaList(TargetsAllowed.enemies))
        ..presetDurationHero(lvl -> 0.01)
        ..presetDurationNormal(lvl -> 0.01)
        ..register(HERO_VIVPIRE, "Vampiric Bite".setColor(colAbilitiesVivpire), 
        "Bites the victim dealing 3 x Str x Lvl physical damage. Vivpire cripples a target marked with 'Prey' reducing attack speed and movement speed by 75% and adding 75% chance to miss.",
        (int lvl) -> "Deals {0} + {1} x Str damage".format(
            (50*lvl).toString(),
            (3*lvl).toString()
        ))

// ----------------------------------------------------------------------------

public constant int array[9] vivpire_abi2_Limit = [
     2,
     4,
     6,
     8,
    10,
    12,
    14,
    16,
    18
]

@compiletime function defineAbilities2()
    if (BUILD_STR_HEROES)
        new AbilityDefinitionBladeMasterCriticalStrike(VIVPIRE_ABILITY_2)
        ..setGeneralAbility(AbilityPosition.W)
        ..setIcon("Units\\Vivpire\\Red Orb\\PASRed orb.blp")
        ..presetTooltipNormalExtended(lvl -> "As you continue fighting hordes of enemies, your claws start hungering for more and more blood. Increasing damage done by 0.1xstr every attack. Damage increase Limit is lvl " + (lvl *2).toString() + " str physical damage. Lasts for 5 sec from last attack.")
        ..presetChancetoCriticalStrike(lvl -> 0)
        ..register(HERO_VIVPIRE, "Blood Hunter".setColor(colAbilitiesVivpire), 
        "As Vivpire continues fighting hordes of enemies, their claws starts hungering for more and more blood. Increases physical damage dealt by 0.1 x Str every attack. Damage increases up to a limit of lvl x 2 x Str. Lasts for 5 sec from the last attack.",
        (int lvl) -> "Limit {0} x Str additional damage with each attack.".format(
            vivpire_abi2_Limit[lvl-1].toString()
        ))

// ----------------------------------------------------------------------------

public constant real array[9] vivpire_abi3_Aura = [
    0.075,
    0.150,
    0.225,
    0.300,
    0.375,
    0.450,
    0.525,
    0.600,
    0.675
]

@compiletime function defineAbilities3()
    if (BUILD_STR_HEROES)
        new BuffDefinition(VIVPIRE_BUFF_3, BuffIds.vampiricAura)
        ..setIcon(Icons.bTNVampiricAura)
        ..register("Vampiric Aura".setColor(colAbilitiesVivpire),
        "This unit will receive healing from physical attacks.")

        new AbilityDefinitionDreadlordVampiricAura(VIVPIRE_ABILITY_3)
        ..setGeneralAbility(AbilityPosition.E)
        ..presetAttackDamageStolen(lvl -> 0)
        ..presetAreaofEffect(lvl -> 1100.0 + 100*(lvl-1))
        ..presetBuffs(lvl -> commaList(VIVPIRE_BUFF_3))
        ..register(HERO_VIVPIRE, "Vampiric Aura".setColor(colAbilitiesVivpire), 
        "Gives life steal aura to nearby allies.",
        (int lvl) -> "{0}% Life Steal Aura in {1} range.".format(
            (100*vivpire_abi3_Aura[lvl-1]).toString(1),
            (1100+100*(lvl-1)).toString()
        ))

