package Pitlord_E

import DamageTarget
import MyAbilityIds

public function pitLordDemonSkin(unit holder, unit attacker, real amount)
    let lvl = holder.getAbilityLevel(PITLORD_ABILITY_3) 
    let dam = amount * (0.3 + lvl * 0.1) + 0.03 * lvl * holder.getMaxHP()
    holder.damageTargetCode(dam, attacker, null, -1, customDamageType.PhysicalRanged)