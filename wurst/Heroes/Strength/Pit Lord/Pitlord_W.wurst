package Pitlord_W

import ClosureEvents
import ClosureTimers
import DummyCaster
import Abilities
import MyAbilityIds
import OrderIds
import DamageTarget

public function strikeSlam()
    EventListener.onTargetCast(PITLORD_ABILITY_2) (unit caster, unit target) ->
        let lvl = caster.getAbilityLevel(PITLORD_ABILITY_2)
        let dmg = caster.getStr(true)*lvl*4.5
        caster.setAnimation("slam")
        doAfter(0.3) -> 
            flashEffect(Abilities.warStompCaster, target.getPos(), 0.8)
            caster.damageTargetCode(dmg, target, null, -1, customDamageType.PhysicalMelee)
            new DummyCaster()
            ..owner(GetOwningPlayer(caster))
            ..origin(caster.getPos())
            ..castTarget(PITLORD_ABILITY_2_DUMMY, lvl, OrderIds.thunderbolt, target)