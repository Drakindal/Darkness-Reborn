package Pitlord_Hero

import UnitIds
import ObjectIds
import MyUnitIds
import MyAbilityIds
import AbilityObjEditing
import MyUpgradesIds
import CommonDescriptions
import MyHeroDefinition

@compiletime function defineHero()
    new MyHeroDefinition(HERO_PITLORD, UnitIds.pitlord)// Pit Lord (N04F)
    ..setHeroAbilities(commaList(PITLORD_ABILITY_1, 'A0RS', 'A0RL', 'A0RI', 'A0R8'))
    
    ..setPrimaryAttribute("Strength")
    ..setStatsBase(26, 16, 14)
    ..setStatsPerLvl(3.20, 1.30, 1.50)
    
    ..setSelectionScale(2.50)

    ..setMeleeAttack()
    ..setAttack1CooldownTime(2.05)
    ..setAttack1DamageSidesperDie(6)
    ..setAttack1AnimationBackswingPoint(0.700)
    ..setAttack1AnimationDamagePoint(0.800)
    
    ..setHitPointsRegenerationType("blight")
    ..setHitPointsRegenerationRate(2.00)
    
    ..setTurnRate(0.40)
    ..setRequirements(commaList(HERO_PITLORD_PICKED))
    
    ..setName("Pit Lord")
    ..setTooltipBasic("|c00F7EC46Pit Lord|r")
    ..setTooltipExtended("|c00F7EC46Pit Lord|r\n"
    + "Roles: " + defender + "/" + stacker + "\n\n"
    + "|c00EE0404Physical Damage|r: 1/5\n"
    + "|c0076ECF9Magical Damage|r: 2/5\n"
    + "|c00B0B0B0Defense|r: 5/5\n"
    + "|c00663300Utility|r: 3/5\n"
    + "|c0066FF66Healing|r: 0/5\n"
    + "Difficulty: 1/5\n")