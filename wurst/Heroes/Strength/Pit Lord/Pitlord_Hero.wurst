package Pitlord_Hero

import UnitIds
import ObjectIds
import MyUnitIds
import MyAbilityIds
import AbilityObjEditing
import MyUpgradesIds
import CommonDescriptions
import MyHeroDefinition

// ----------------------------------------------------------------------------

@compiletime function defineHero()
    new MyHeroDefinition(HERO_PITLORD, UnitIds.pitlord)
    ..setHeroAbilities(commaList(PITLORD_ABILITY_1, PITLORD_ABILITY_2, PITLORD_ABILITY_3, PITLORD_ABILITY_4, PITLORD_ABILITY_5))
    
    ..setPrimaryAttribute("Strength")
    ..setStatsBase(26, 16, 14)
    ..setStatsPerLvl(3.20, 1.30, 1.50)
    
    ..setSelectionScale(2.50)

    ..setMeleeAttack()
    ..setAttack1CooldownTime(2.05)
    ..setAttack1DamageSidesperDie(6)
    ..setAttack1AnimationBackswingPoint(0.700)
    ..setAttack1AnimationDamagePoint(0.800)
    
    ..setHitPointsRegenerationType("blight")
    ..setHitPointsRegenerationRate(2.00)
    
    ..setTurnRate(0.40)
    ..setRequirements(commaList(HERO_PITLORD_PICKED))
    
    ..setTooltipExtended(
    rolesList(roleDefender, roleStacker),
    PhysDamage.v1,
    MagicDamage.v2,
    Defense.v5,
    Utility.v3,
    Healing.v0,
    Difficulty.v2)
    
// ----------------------------------------------------------------------------