package MountainKing_W

import ClosureForGroups
import ClosureEvents
import ClosureTimers
import DamageTarget
import MyAbilityIds
import Abilities

function handleSlam(unit caster, real dmg)
    flashEffect(Abilities.thunderclapCaster, caster.getPos())
    forUnitsInRange(caster.getPos(), 400, true) (unit u) ->
        if caster.isEnemyOf(u)
            caster.damageTargetCode(dmg, u, null, -1, customDamageType.PhysicalRanged)

public function thunderClap()
    EventListener.onCast(MOUNTAIN_KING_ABILITY_2) (unit caster) ->
        let lvl = caster.getAbilityLevel(MOUNTAIN_KING_ABILITY_2)
        let dmg = ((caster.getStr(true)*0.5+50)*lvl)
        
        handleSlam(caster, dmg)
        
        doPeriodicallyCounted(0.5, 2) (CallbackCounted cb) ->
            handleSlam(caster, dmg)