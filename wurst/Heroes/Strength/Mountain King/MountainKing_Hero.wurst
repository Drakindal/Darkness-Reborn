package MountainKing_Hero

import UnitIds
import ObjectIds
import MyUnitIds
import MyAbilityIds
import AbilityObjEditing
import MyUpgradesIds
import CommonDescriptions
import MyHeroDefinition

@compiletime function defineHero()
    new MyHeroDefinition(HERO_MOUNTAIN_KING, UnitIds.mountainking)// Mountain King (H003)
    ..setHeroAbilities(commaList(ABILITY_9, 'A0DV', 'A0DW', 'A0DX', 'A0DZ'))
    
    ..setPrimaryAttribute("Strength")
    ..setStatsBase(24, 11, 15)
    ..setStatsPerLvl(3.00, 1.50, 1.50)
    
    ..setSelectionScale(1.25)
    ..setScalingValue(2)

    ..setMeleeAttack()
    ..setAttack1CooldownTime(2.22)
    ..setAttack1DamageSidesperDie(6)
    ..setAttack1AnimationBackswingPoint(0.650)
    ..setAttack1AnimationDamagePoint(0.350)
    
    ..setDefenseBase(1)
    
    ..setTurnRate(0.60)
    ..setRequirements(commaList(HERO_MOUNTAIN_KING_PICKED))
    
    ..setProperNames(commaList("Aggronor the Mighty"))
    ..setName("Mountain King")
    ..setTooltipBasic("|c00F7EC46Mountain King|r")
    ..setTooltipExtended("|c00F7EC46Mountain King|r\n"
    + "Roles: " + defender + "/" + farmer + "/" + stacker + "\n\n"
    + "|c00EE0404Physical Damage|r: 1/5\n"
    + "|c0076ECF9Magical Damage|r: 4/5\n"
    + "|c00B0B0B0Defense|r: 5/5\n"
    + "|c00663300Utility|r: 3/5\n"
    + "|c0066FF66Healing|r: 0/5\n"
    + "Difficulty: 1/5\n")