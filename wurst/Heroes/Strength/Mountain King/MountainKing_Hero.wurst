package MountainKing_Hero

import UnitIds
import ObjectIds
import MyUnitIds
import MyAbilityIds
import AbilityObjEditing
import MyUpgradesIds
import CommonDescriptions
import MyHeroDefinition

// ----------------------------------------------------------------------------

@compiletime function defineHero()
    new MyHeroDefinition(HERO_MOUNTAIN_KING, UnitIds.mountainking)
    ..setHeroAbilities(commaList(MOUNTAIN_KING_ABILITY_1, MOUNTAIN_KING_ABILITY_2, MOUNTAIN_KING_ABILITY_3, MOUNTAIN_KING_ABILITY_4, MOUNTAIN_KING_ABILITY_5))
    
    ..setPrimaryAttribute("Strength")
    ..setStatsBase(24, 11, 15)
    ..setStatsPerLvl(3.00, 1.50, 1.50)
    
    ..setSelectionScale(1.25)
    ..setScalingValue(2)

    ..setMeleeAttack()
    ..setAttack1CooldownTime(2.22)
    ..setAttack1DamageSidesperDie(6)
    ..setAttack1AnimationBackswingPoint(0.650)
    ..setAttack1AnimationDamagePoint(0.350)
    
    ..setDefenseBase(1)
    
    ..setTurnRate(0.60)
    ..setRequirements(commaList(HERO_MOUNTAIN_KING_PICKED))
    
    ..setProperNames("Aggronor the Mighty")
    ..setTooltipExtended(
    rolesList(roleFarmer, roleDefender, roleStacker),
    PhysDamage.v1,
    MagicDamage.v4,
    Defense.v5,
    Utility.v3,
    Healing.v0,
    Difficulty.v1)
    
// ----------------------------------------------------------------------------