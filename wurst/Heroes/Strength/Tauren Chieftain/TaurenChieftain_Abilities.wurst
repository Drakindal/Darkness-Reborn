package TaurenChieftain_Abilities

import MyAbilityIds
import MyHeroAbilityDefinition
import MyUnitIds
import Orders
import ChannelAbilityPreset
import MyColors
import BuffIds
import MyBuffIds
import BuffObjEditing
import DebugVar
import MyOrderIds

// ----------------------------------------------------------------------------

@compiletime function defineAbilities()
    if (BUILD_STR_HEROES)
        new ChannelAbilityPreset(TAUREN_CHIEFTAIN_ABILITY_1, 9, true)
        ..setGeneralAbility(AbilityPosition.Q)
        ..presetAreaofEffect(lvl -> 500.0)
        ..presetCooldown(lvl -> 21.0 - lvl)
        ..setManaCost(1, 50)
        ..setManaCost(2, 80)
        ..setManaCost(3, 110)
        ..setManaCost(4, 150)
        ..setManaCost(5, 190)
        ..setManaCost(6, 230)
        ..setManaCost(7, 280)
        ..setManaCost(8, 320)
        ..setManaCost(9, 370)
        ..presetFollowThroughTime(lvl -> 0.5)
        ..presetTargetTypes(Targettype.POINT)
        ..presetOption(Option.TARGETIMAGE, true)
        ..presetArtDuration(lvl -> 0.5)
        ..presetBaseOrderID(lvl -> MyOrderIds.aoeBlizzard)
        ..setOrderStringUseTurnOn(MyOrderIds.aoeBlizzard)
        ..presetCastRange(lvl -> 1000.0)
        ..setAnimationNames("attack,slam")
        ..setIcon("ReplaceableTextures\\CommandButtons\\BTNEarthquake.blp")
        ..setArtCaster("")
        ..setCasterAttachmentPoint("")
        ..setArtEffect("")
        ..setArtTarget("")
        ..setTargetAttachmentPoint("")
        ..register(HERO_TAUREN_CHIEFTAIN, "Shock Explosion".setColor(colAbilitiesTaurenChieftain), 
        "Tauren the Chieftain hits the ground with his mighty force causing an earthquake in 1000 AoE area.",
        (int lvl) -> "Deals {0} + {1} x Str dps. Duration {2} sec.".format(
            (50*lvl).toString(),
            (0.8*lvl).toString(1),
            (5.0 + 1.5*lvl).toString(1)
        ))

// ----------------------------------------------------------------------------
        
        new BuffDefinition(TAUREN_BUFF_2, BuffIds.controlMagic)
        ..setArtTarget(1, "")
        ..setArtSpecial(1, "")
        ..setIconNormal(1, Icons.bTNControlMagic)
        ..register("Hit by Blessed Hammer".setColor(colAbilitiesTaurenChieftain),
        "Hit by Tauren's Blessed Hammer")

        new AbilityDefinitionCripple(TAUREN_CHIEFTAIN_ABILITY_2_DUMMY)
        ..setLevels(1)
        ..setDuration(1, 2)
        ..setManaCost(1, 0)
        ..setAttackSpeedReduction(1, 0)
        ..setMovementSpeedReduction(1, 0)
        ..setDamageReduction(1, 0)
        ..setCastRange(1, 9999)
        ..setCastingTime(1, 0)
        ..setCooldown(1, 0)
        ..setRequiredLevel(0)
        ..setRequirements("")
        ..setArtTarget("")
        ..setArtSpecial("")
        ..setArtEffect("")
        ..setArtCaster("")
        ..setMissileArt("")
        ..setBuffs(1, TAUREN_BUFF_2.toRawCode())

        new AbilityDefinitionDreadlordCarrionSwarm(TAUREN_CHIEFTAIN_ABILITY_2)
        ..setGeneralAbility(AbilityPosition.W)
        ..presetAreaofEffect(lvl -> 1.0)
        ..presetCooldown(lvl -> 21.0 - lvl)
        ..setManaCost(1, 120)
        ..setManaCost(2, 140)
        ..setManaCost(3, 160)
        ..setManaCost(4, 185)
        ..setManaCost(5, 200)
        ..setManaCost(6, 215)
        ..setManaCost(7, 230)
        ..setManaCost(8, 245)
        ..setManaCost(9, 265)
        ..presetDamage(lvl -> 0.0)
        ..presetMaxDamage(lvl -> 0.0)
        ..presetDistance(lvl -> 950.0)
        ..presetFinalArea(lvl -> 1.0)
        ..presetCastRange(lvl -> 950.0)
        ..presetBuffs(lvl -> "")
        ..setAnimationNames("attack,two")
        ..setIcon("ReplaceableTextures\\CommandButtons\\BTNThunderclap.blp")
        ..setMissileArt("")
        ..setArtSpecial("")
        ..register(HERO_TAUREN_CHIEFTAIN, "Blessed Hammer".setColor(colAbilitiesTaurenChieftain), 
        "Tauren the Chieftain sends a shockwave dealing damage to all enemies in a straight line.",
        (int lvl) -> "Deals {0} x Str damage.".format(
            (2.2*lvl + 0.18*lvl*lvl).toString()
        ))
    
// ----------------------------------------------------------------------------

public constant int array[9] tauren_abi3_Chance = [
    26,
    29,
    32,
    35,
    38,
    41,
    44,
    47,
    50
]

@compiletime function defineAbilities3()
    if (BUILD_STR_HEROES)
        new AbilityDefinitionPulverize(TAUREN_CHIEFTAIN_ABILITY_3)
        ..setGeneralAbility(AbilityPosition.E)
        ..setIcon("ReplaceableTextures\\CommandButtons\\PASAxeslam2.blp")
        ..presetChancetoStomp(lvl -> 0.0)
        ..presetTargetsAllowed(lvl -> getTargets(AbilityTargets.EnemiesNonStructuresMechUnits))
        ..register(HERO_TAUREN_CHIEFTAIN, "Pulverize Strength".setColor(colAbilitiesTaurenChieftain), 
        "Tauren the Chieftain's hits are so strong that he has a chance to pulverize bones of a target and push them far away. Also deals half of the damage to nearby enemies.\n" +
        "Permanently gets 3 Str on Pulverize.".setColor(colAbilitiesTaurenChieftain),
        (int lvl) -> "{0}% chance to pulverize for {1} x max Hp + {2} x Str damage. Totally, {3}% chance to get 3 Str.".format(
            tauren_abi3_Chance[lvl-1].toString(),
            (0.4*lvl).toString(1),
            (1.5*lvl).toString(1),
            (tauren_abi3_Chance[lvl-1]*0.6).toString(0)
        ))

// ----------------------------------------------------------------------------

        new AbilityDefinitionTaurenChieftainEnduranceAura(TAUREN_CHIEFTAIN_ABILITY_4)
        ..setGeneralAbility(AbilityPosition.R)
        ..presetMovementSpeedIncrease(lvl -> 0.3 + 0.15*(lvl-1))
        ..presetAttackSpeedIncrease(lvl -> 0.1 + 0.1*lvl)
        ..presetAreaofEffect(lvl -> 99999.0)
        ..presetTargetsAllowed(lvl -> getTargets(AbilityTargets.AlliesAllOrganic))
        ..register(HERO_TAUREN_CHIEFTAIN, "Endurance Aura".setColor(colAbilitiesTaurenChieftain), 
        "Tauren the Chieftain's Endurance Aura increases attack speed and movement speed of all allies on the entire map.",
        (int lvl) -> "+{0}% Attack Speed. +{1} Movement speed.".format(
            (100*(0.1 + 0.1*lvl)).toString(0),
            (100*(0.3 + 0.15*(lvl-1))).toString(0)
        ))

// ----------------------------------------------------------------------------
    
        new ChannelAbilityPreset(TAUREN_CHIEFTAIN_ABILITY_5, 4, true)
        ..setUltimateAbility()
        ..presetCooldown(lvl -> 140.0 - 20*lvl)
        ..presetManaCost(lvl -> 500*lvl)
        ..presetFollowThroughTime(lvl -> 0.5)
        ..presetArtDuration(lvl -> 0.01)
        ..presetBaseOrderID(lvl -> MyOrderIds.castStomp)
        ..setOrderStringUseTurnOn(MyOrderIds.castStomp)
        ..presetCastRange(lvl -> 700.0)
        ..presetDuration(lvl -> 10.0)
        ..presetBuffs(lvl -> BuffIds.stunned.toRawCode())
        ..presetAreaofEffect(lvl -> 99999.0)
        ..setAnimationNames("attack,slam")
        ..setIcon("ReplaceableTextures\\CommandButtons\\BTNEarthquake.blp")
        ..setArtCaster("")
        ..setCasterAttachmentPoint("")
        ..setTargetAttachmentPoint("")
        ..setArtEffect("")
        ..setArtTarget("")
        ..register(HERO_TAUREN_CHIEFTAIN, "War Stomp".setColor(colAbilitiesTaurenChieftain), 
        "Tauren the Chieftain slams the ground stunning all enemies for 10 sec on the entire map.\n" +
        "Permanently gets 500 HP and 40 Str with each cast.".setColor(colAbilitiesTaurenChieftain),
        (int lvl) -> "Deals {0} + {1} x Str + {2} x max HP damage.".format(
            (5.5*lvl).toString(1),
            (1500*lvl).toString(),
            (2.5*lvl).toString(1)
        ))
        
// ----------------------------------------------------------------------------