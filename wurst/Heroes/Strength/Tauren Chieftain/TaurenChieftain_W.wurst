package TaurenChieftain_W

import ClosureForGroups
import DummyCaster
import OrderIds
import MyAbilityIds
import DamageTarget
import PointTransitProjectile
import ActiveAbilityDef

public function blessedHammer()
    registerOnPointCast(TAUREN_CHIEFTAIN_ABILITY_2) (unit caster, vec2 target) ->
        let lvl = caster.getAbilityLevel(TAUREN_CHIEFTAIN_ABILITY_2)
        let dmg = (2.5*lvl + 0.5*lvl*lvl) * caster.getStr(true)
        let sfx = addEffect("BladeBeamFinal.mdl", caster.getPos())
        let angle = sfx.getPos().angleTo(target)
        flashEffect("DustWindFaster3.mdl", caster.getPos(), 1, angle)
        sfx.setYaw(angle.radians())
        sfx.setScale(1.5)
        let tickRate = 0.03
        let time = 1.
        let range = 900.
        let transitProjectile = new PointTransitProjectile(target, sfx, tickRate)
        transitProjectile.timedMoveForward(range, time) (vec2 target, boolean inTransit) ->
            if inTransit
                forUnitsInRange(target, 150) (unit u) ->
                    if caster.isEnemyOf(u)
                        new DummyCaster()
                        ..owner(GetOwningPlayer(caster))
                        ..castTarget(ABILITY_DUMMY_6, 1, OrderIds.cripple, u)
                        ..origin(caster.getPos())
                        caster.damageTargetCode(dmg, u, null, -1, customDamageType.PhysicalRanged)