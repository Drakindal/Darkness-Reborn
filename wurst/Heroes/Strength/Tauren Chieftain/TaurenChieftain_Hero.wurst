package TaurenChieftain_Hero

import UnitIds
import ObjectIds
import MyUnitIds
import MyAbilityIds
import MyHeroAbilityDefinition
import MyUnitIds
import AbilityObjEditing
import MyUpgradesIds
import CommonDescriptions
import MyHeroDefinition

@compiletime function defineHero()
    new MyHeroDefinition(HERO_TAUREN_CHIEFTAIN, UnitIds.taurenchieftain)// Tauren Chieftain (O00T)
    
    ..setHeroAbilities(commaList('A0Z0', 'A0CI', TAUREN_CHIEFTAIN_ABILITY_3, 'A01E', 'A01A'))

    ..setPrimaryAttribute("Strength")
    ..setStatsBase(25, 10, 15)
    ..setStatsPerLvl(3.70, 1.50, 1.30)

    ..setScalingValue(1.10)
    ..setSelectionScale(2.00)

    ..setMeleeAttack()
    ..setAttack1Range(128)
    ..setAttack1CooldownTime(2.05)
    ..setAttack1DamageSidesperDie(6)
    ..setAttack1AnimationBackswingPoint(0.970)
    ..setAttack1AnimationDamagePoint(0.360)

    ..setTurnRate(0.40)
    ..setRequirements(commaList(HERO_TAUREN_CHIEFTAIN_PICKED))
    
    ..setDefenseBase(1)
  
    ..setTooltipExtended(
    rolesList(roleDefender, roleFarmer),
    PhysDamage.v2,
    MagicDamage.v2,
    Defense.v3,
    Utility.v5,
    Healing.v0,
    Difficulty.v5)