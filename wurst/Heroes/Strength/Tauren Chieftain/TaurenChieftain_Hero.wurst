package TaurenChieftain_Hero

import UnitIds
import ObjectIds
import MyUnitIds
import MyAbilityIds
import AbilityObjEditing
import MyUpgradesIds
import CommonDescriptions
import MyHeroDefinition

// ----------------------------------------------------------------------------

@compiletime function defineHero()
    new MyHeroDefinition(HERO_TAUREN_CHIEFTAIN, UnitIds.taurenchieftain)
    
    ..setHeroAbilities(commaList(TAUREN_CHIEFTAIN_ABILITY_1, TAUREN_CHIEFTAIN_ABILITY_2, TAUREN_CHIEFTAIN_ABILITY_3, TAUREN_CHIEFTAIN_ABILITY_4, TAUREN_CHIEFTAIN_ABILITY_5))

    ..setPrimaryAttribute("Strength")
    ..setStatsBase(35, 8, 15)
    ..setStatsPerLvl(5.70, 1.20, 1.70)

    ..setScalingValue(1.10)
    ..setSelectionScale(2.00)

    ..setMeleeAttack1()
    ..setAttack1Range(128)
    ..setAttack1CooldownTime(2.05)
    ..setAttack1DamageSidesperDie(6)
    ..setAttack1AnimationBackswingPoint(0.970)
    ..setAttack1AnimationDamagePoint(0.360)

    ..setTurnRate(0.40)
    ..setRequirements(commaList(HERO_TAUREN_CHIEFTAIN_PICKED))
    
    ..setDefenseBase(1)
  
    ..setTooltipExtended(
    rolesList(roleDefender, roleFarmer),
    PhysDamage.v2,
    MagicDamage.v2,
    Defense.v3,
    Utility.v5,
    Healing.v0,
    Difficulty.v5)
    
// ----------------------------------------------------------------------------