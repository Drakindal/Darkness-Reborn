package TaurenChieftain_Q

import ClosureEvents
import ClosureTimers
import ClosureForGroups
import Objects
import Abilities
import DamageTarget
import PointTransitProjectile
import TerrainUtils
import MyAbilityIds

public function shockExplosion()
    EventListener.onPointCast(TAUREN_CHIEFTAIN_ABILITY_1) (unit caster, vec2 target) ->
        doAfter(0.25) ->
            let sfx = addEffect(Objects.impaleTargetDust, caster.getPos())
            let lvl = caster.getAbilityLevel(TAUREN_CHIEFTAIN_ABILITY_1)
            let dmg = (0.8*caster.getStr(true) + 50) * lvl
            let period = 0.1
            let duration = 5.0 + 1.5*lvl
            let dps = dmg * period

            flashEffect("WindWeak2.mdl", caster.getPos(), 4)
            let pathable = addEffect(".mdl", caster.getPos())
            let tickRate = 0.06
            let velocity = 1.4
            let transitProjectile = new PointTransitProjectile(target, sfx, tickRate)
            transitProjectile.moveForward(velocity) (vec2 target, boolean inTransit) ->
                if(inTransit)
                    let pos = sfx.getPos()
                    pathable.setPos(pos)
                    if pathable.getPos().isTerrainWalkable()
                        forUnitsInRange(pos, 300) (unit u) ->
                            if caster.isEnemyOf(u)
                                u.setPos(pos)                      
                else
                    flashEffect(Abilities.volcanoDeath, target)
                    doAfter(0.1) ->
                        flashEffect("NewMassiveEX.mdl", target, 3)

                        doPeriodicallyTimed(period, duration) (CallbackCounted cb) ->
                            forUnitsInRange(target, 500, true) (unit u) ->
                                if caster.isEnemyOf(u)
                                    caster.damageTargetCode(dps, u, null, -1, customDamageType.PhysicalRanged)