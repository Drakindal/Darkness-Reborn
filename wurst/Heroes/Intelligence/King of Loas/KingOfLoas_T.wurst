package KingOfLoas_T

import ClosureForGroups
import ClosureTimers
import DummyCaster
import OrderIds
import ClosureEvents
import MyAbilityIds
import DamageTarget
import KingOfLoas_Abilities

// Aura of Bwonsamdi
public function kingOfloasTinit()
    EventListener.add(EVENT_PLAYER_HERO_SKILL) ->
        let caster = GetTriggerUnit()
        if GetLearnedSkill() == KING_OF_LOAS_ABILITY_5 and caster.getUserData() != 1
            caster.setUserData(1)
            doPeriodically(2) (CallbackPeriodic cb) ->
                let lvl = caster.getAbilityLevel(KING_OF_LOAS_ABILITY_5)
                let dmg = caster.getInt(true) * (2 + lvl * 0.5)

                forUnitsInRange(caster.getPos(), loas_abi5_Range[lvl-1], true) (unit u) ->
                    if caster.isEnemyOf(u) and u.isAlive()
                        new DummyCaster()
                        ..owner(GetOwningPlayer(caster))
                        ..origin(caster.getPos())
                        ..castTarget(KING_OF_LOAS_ABILITY_5_DUMMY, lvl, OrderIds.slow, u)
                        ..delay(1)
                        caster.damageTargetCode(dmg, u, null, -1, customDamageType.Magical)