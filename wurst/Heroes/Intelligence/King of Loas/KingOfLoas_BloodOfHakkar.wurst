package KingOfLoas_BloodOfHakkar

import DamageCustomEvent
import MyBuffIds
import MyAbilityIds
import KingOfLoas_Abilities

public function hakkarBlood()
    DamageCustomEvent.addListener(1) -> 
        let src = DamageCustomEvent.getSource()
        switch DamageCustomEvent.getType()
            case ATTACK
                if src.hasAbility(KING_OF_LOAS_BUFF_4)
                    let lvl = src.getAbilityLevel(KING_OF_LOAS_ABILITY_4)
                    src.addHP(DamageCustomEvent.getAmount()*loas_abi4_Heal[lvl-1])
                else if src.hasAbility(KING_OF_LOAS_BUFF_ASC_4)
                    src.addHP(DamageCustomEvent.getAmount()*0.8)
            case SPELL
                // Improved Hakkar Buff
                if src.hasAbility(KING_OF_LOAS_BUFF_ASC_4)
                    src.addHP(DamageCustomEvent.getAmount()*0.8)
                
            case CODE               
                // Ordinary Hakkar Buff or Improved Hakkar Buff
                if src.hasAbility(KING_OF_LOAS_BUFF_4)
                    let lvl = src.getAbilityLevel(KING_OF_LOAS_ABILITY_4)
                    src.addHP(DamageCustomEvent.getAmount()*loas_abi4_Heal[lvl-1])
                else if src.hasAbility(KING_OF_LOAS_BUFF_ASC_4)
                    src.addHP(DamageCustomEvent.getAmount()*0.8)
            default