package KingOfLoas_E

import MyAbilityIds
import Abilities
import OrderIds
import DamageTarget
import DamageCustomEvent

public function thunderOfAkunda()
    DamageCustomEvent.addListener(2) ->
        let src = DamageCustomEvent.getSource()
        if src.isIllusion()
            skip
        else
            if DamageCustomEvent.getType() == ATTACK
                let lvl = src.getAbilityLevel(KING_OF_LOAS_ABILITY_3)
                if lvl > 0
                    if GetRandomInt(1, 100) <= lvl*3
                        let target = DamageCustomEvent.getTarget()
                        let dmg = (lvl*1.50)*src.getInt(true)
                        flashEffect(Abilities.chimaeraLightningMissile, target.getPos())
                        src.damageTargetCode(dmg, target, null, -1, customDamageType.Magical)
                        if(target.isAlive() == false)
                            src.issueImmediateOrderById(OrderIds.stop)