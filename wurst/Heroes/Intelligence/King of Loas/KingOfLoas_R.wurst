package KingOfLoas_R

import DummyCaster
import OrderIds
import ClosureEvents
import ClosureTimers
import MyAbilityIds
// Blood of Hakkar

public function kingOfloasRact()
    EventListener.onCast(KING_OF_LOAS_ABILITY_4) (unit caster) ->
        new DummyCaster()
        ..owner(caster.getOwner())
        ..origin(caster.getPos())
        ..castTarget(KING_OF_LOAS_ABILITY_4_DUMMY, 1, OrderIds.innerfire, caster)
        
        doAfter(0.2) ->      
            caster
            ..issueImmediateOrderById(OrderIds.stop)
            ..startAbilityCooldown(KING_OF_LOAS_ABILITY_4)