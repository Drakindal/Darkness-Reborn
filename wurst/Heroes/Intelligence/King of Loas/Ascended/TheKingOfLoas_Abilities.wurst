package TheKingOfLoas_Abilities

import MyAbilityIds
import AbilityObjEditing
import MyBuffIds
import ObjectIds
import Icons
import MyHeroAbilityDefinition
import MyUnitIds
import MyColors
import BuffObjEditing
import BuffIds
import Abilities

// ----------------------------------------------------------------------------

@compiletime function ascendedloasCrown()
    new BuffDefinition(KING_OF_LOAS_ASC_BUFF_1, BuffIds.innerFire)
    ..setArtTarget("")
    ..setArtSpecial(1, "")
    ..setIcon(Icons.pASBTNPoisonSting)
    ..register("Shadra's Poison".setColor(colAbilitiesKingOfLoas),
    "Movement and attack speed and armor of this unit are decreased.")

    new AbilityDefinitionSlow(KING_OF_LOAS_ASC_ABILITY_1_DUMMY_1) // on dummy
    ..setName("slow")
    ..setOrderStringActivate("slow")
    ..setOrderStringUseTurnOn("slow")
    ..setLevels(1)
    ..setAttackSpeedFactor(1, 0)
    ..setMovementSpeedFactor(1, 0.75)
    ..setCastRange(1, 5000)
    ..setCastingTime(1, 0)
    ..setCooldown(1, 0)
    ..setDuration(1, 5)
    ..setManaCost(1, 0)
    ..setIconNormal(Icons.bTNSlow)
    ..setEffectSound("")
    ..setArtCaster("")
    ..setBuffs(1, KING_OF_LOAS_BUFF_1.toRawCode())
    
    new AbilityDefinitionInnerFire(KING_OF_LOAS_ASC_ABILITY_1_DUMMY_2)
    ..setName("Dummy neg armor")
    ..setOrderStringActivate("innerfireon")
    ..setOrderStringUseTurnOn("innerfire")
    ..setLevels(1)
    ..setManaCost(1, 0)
    ..setCastRange(1, 5000)
    ..setDamageIncrease(1, 0)
    ..setDefenseIncrease(1, -80)
    ..setDurationHero(1, 0)
    ..setDurationNormal(1, 0)
    ..setBuffs(1, KING_OF_LOAS_ASC_BUFF_1.toRawCode())
    ..setCooldown(1, 0)
    ..setTargetsAllowed(1, commaList("Enemy", "Ground", "Air"))
    ..setRequirements("")
    ..setRequiredLevel(1)
    
    // WIP armor reduction.
    new AbilityDefinition(KING_OF_LOAS_ASC_ABILITY_1, AbilityIds.silence)
    ..setLevels(1)
    ..setPosition(AbilityPosition.Q)
    ..setAreaofEffect(1, 450)
    ..setCastRange(1, 600)
    ..setCooldown(1, 0)
    ..setManaCost(1, 350)
    ..setArtEffect("")
    ..setBuffs(1, KING_OF_LOAS_ASC_BUFF_1.toRawCode())
    ..setCooldown(1, 16)
    ..register(HERO_KING_OF_LOAS_ASCENDED, "Deadly Venom of Shadra".setColor(colAbilitiesKingOfLoas),
    "The King of Loas spit out some of Shadra's poison over his foes temporarily slowing them down by 75% and dealing 23x damage every second for 5 seconds in 450 range." //  Reduces Armor by 80.
    )

// ----------------------------------------------------------------------------

    new BuffDefinition(KING_OF_LOAS_BUFF_ASC_2_1, BuffIds.innerFire)
    ..setArtTarget("")
    ..setIcon(Icons.bTNBerserk)
    ..setTargetAttachmentPoint0(1, "origin")
    ..setTargetAttachments(1, 1)
    ..setArtTarget("Loas Assets\\L_order.mdx")
    ..register("Embodiment of Gral Bleed".setColor(colAbilitiesKingOfLoas),
    "This unit is taking DoT damage.")
    
    new BuffDefinition(KING_OF_LOAS_BUFF_ASC_2_2, BuffIds.bloodlust)
    ..setArtTarget("")
    ..setIcon(Icons.bTNBerserk)
    ..register("Embodiment of Gral".setColor(colAbilitiesKingOfLoas),
    "King of loas is enraged, he is attacking faster.")

    new AbilityDefinitionBloodlust(KING_OF_LOAS_ASC_ABILITY_2_DUMMY_1) // on dummy
    ..setLevels(1)
    ..setAttackSpeedIncrease(1, 2.5)
    ..setMovementSpeedIncrease(1, 0)
    ..setScalingFactor(1, 0.75)
    ..setCastRange(1, 2000)
    ..setCooldown(1, 0)
    ..setDuration(1, 10)
    ..setManaCost(1, 0)
    ..setBuffs(1, KING_OF_LOAS_BUFF_ASC_2_2.toRawCode())
    ..setOrderStringActivate("bloodlust")
    ..setOrderStringUseTurnOn("bloodlust")
    ..setRequirements("")
    ..setTargetsAllowed(1, getTargets(AbilityTargets.EnemiesAll))

    new AbilityDefinitionInnerFire(KING_OF_LOAS_ASC_ABILITY_2_DUMMY_2)
    ..setName("Embodiment of Gral Bleed")
    ..setCooldown(1, 0)
    ..setManaCost(1, 0)
    ..setLevels(1)
    ..setCastRange(1, 9999)
    ..setDamageIncrease(1, 0)
    ..setDefenseIncrease(1, 0)
    ..setDuration(1, 5)
    ..setPriorityforSpellSteal(0)
    ..setCheckDependencies(false)
    ..setRequirements("")
    ..setBuffs(1, KING_OF_LOAS_BUFF_ASC_2_1.toRawCode())
    ..setTargetsAllowed(1, getTargets(AbilityTargets.EnemiesAll))

    new AbilityDefinitionBladeMasterCriticalStrike(KING_OF_LOAS_ASC_ABILITY_2)
    ..setLevels(1)
    ..setPosition(AbilityPosition.W)
    ..setIconNormal(Icons.bTNBerserk)
    ..setIconResearch(Icons.bTNBerserk)
    ..setChancetoCriticalStrike(1, 0)
    ..register(HERO_KING_OF_LOAS_ASCENDED, "Embodiment of Gral".setColor(colAbilitiesKingOfLoas),
    "Every attack the King of Loas has a 15% to enrage increasing attack speed by 250% and adds a bleed effect dealing 5x int every second over 5 seconds"
    )

// ----------------------------------------------------------------------------

    new AbilityDefinitionSeaWitchForkedLightning(KING_OF_LOAS_ASC_ABILITY_3_DUMMY)
    ..setLevels(1)
    ..setOrderStringActivate("forkedlightning")
    ..setOrderStringUseTurnOn("forkedlightning")
    ..setDamageperTarget(1, 1)
    ..setDistance(1, 1000)
    ..setFinalArea(1, 500)
    ..setNumberofTargetsHit(1, 1)
    ..setAreaofEffect(1, 300)
    ..setCastRange(1, 9999)
    ..setMissileSpeed(9999)
    ..setCooldown(1, 0)
    ..setCastingTime(1, 0)
    ..setManaCost(1, 0)
    ..setTargetsAllowed(1, getTargets(AbilityTargets.EnemiesAll))

    new AbilityDefinitionBladeMasterCriticalStrike(KING_OF_LOAS_ASC_ABILITY_3)
    ..setLevels(1)
    ..setPosition(AbilityPosition.E)
    ..setIcon(Icons.bTNWandSkull)
    ..setCheckDependencies(false)
    ..setRequirements("")
    ..setChancetoCriticalStrike(1, 0)
    ..setTargetsAllowed(1, getTargets(AbilityTargets.EnemiesAll))
    ..register(HERO_KING_OF_LOAS_ASCENDED, "Storm of Akunda".setColor(colAbilitiesKingOfLoas),
    "Every attack of the King of Loas is imbued with Akunda's power giving a 30% chance on attack to create a forked lightning dealing 27x int to 10 enemies."
    )

// ----------------------------------------------------------------------------

    new BuffDefinition(KING_OF_LOAS_BUFF_ASC_4, BuffIds.innerFire)
    ..setArtTarget("")
    ..setIcon(Icons.bTNBerserk)
    ..setTargetAttachmentPoint0(1, "origin")
    ..setTargetAttachments(1, 1)
    ..setArtTarget(Abilities.doomTarget)
    ..register("Cursed Blood of Hakkar".setColor(colAbilitiesKingOfLoas),
    "King of loas has inbued you with the Cursed Blood of Hakkar.")

    new AbilityDefinitionInnerFire(KING_OF_LOAS_ASC_ABILITY_4_DUMMY)
    ..setName("Cursed Blood of Hakkar")
    ..setCooldown(1, 0)
    ..setManaCost(1, 0)
    ..setLevels(1)
    ..setCastRange(1, 9999)
    ..setDamageIncrease(1, 0)
    ..setDefenseIncrease(1, 0)
    ..setDurationHero(1, 10)
    ..setDurationNormal(1, 10)
    ..setPriorityforSpellSteal(0)
    ..setTargetsAllowed(1, getTargets(AbilityTargets.AlliesAllOrganic))
    ..setCheckDependencies(false)
    ..setRequirements("")
    ..setBuffs(1, KING_OF_LOAS_BUFF_ASC_4.toRawCode())

    new AbilityDefinitionRoar(KING_OF_LOAS_ASC_ABILITY_4)
    ..setLevels(1)
    ..setPosition(AbilityPosition.R)
    ..setIcon(Icons.bTNAmulet)
    ..setDamageIncrease(1, 0)
    ..setAreaofEffect(1, 0)
    ..setBuffs(1, KING_OF_LOAS_BUFF_ASC_4.toRawCode())
    ..setDuration(1, 10)
    ..setTargetsAllowed(1, getTargets(AbilityTargets.AlliesAllOrganic))
    ..setArtCaster("Loas Assets\\az_ts_v2.mdx")
    ..setArtSpecial("Loas Assets\\az_ts_v2.mdx")
    ..setAreaEffect("Loas Assets\\az_ts_v2.mdx")
    ..setCooldown(1, 12)
    ..register(HERO_KING_OF_LOAS_ASCENDED, "Cursed Blood of Hakkar".setColor(colAbilitiesKingOfLoas),
    "Curses nearby allies with the blood of the loa Hakkar, causing them to heal for 80% of damage dealt for 10 seconds."
    )

// ----------------------------------------------------------------------------

    new AbilityDefinitionBladeMasterCriticalStrike(KING_OF_LOAS_ASC_ABILITY_5)
    ..setLevels(1)
    ..setPosition(AbilityPosition.T)
    ..setTooltipNormal(1, "Avatar of Bwonsamdi")
    ..setIcon(Icons.bTNWandSkull)
    ..setCheckDependencies(false)
    ..setRequirements("")
    ..setChancetoCriticalStrike(1, 0)
    ..setTargetsAllowed(1, commaList("Air", "Ground", "Enemy"))
    ..register(HERO_KING_OF_LOAS_ASCENDED, "Avatar of Bwonsamdi".setColor(colAbilitiesKingOfLoas),
    "The King of loas becomes an Avatar of Bwonsamdi, passively causing enemies to take 4x int every 2 seconds as well as slowing them by 50%."
    )

// ----------------------------------------------------------------------------

    new AbilityDefinitionPillage(KING_OF_LOAS_ASC_ABILITY_6)
    ..setPosition(AbilityPosition.LearnableHidden1)
    ..setLevels(1)
    ..setTargetsAllowed(1, commaList("Enemy"))
    ..setCheckDependencies(false)
    ..setIcon(Icons.bTNTrueShot)
    ..setRequirements("")
    ..setSalvageCostRatio(1, 0)
    ..register(HERO_KING_OF_LOAS_ASCENDED, "Crown of Rezan".setColor(colAbilitiesKingOfLoas),
    "Transforms all your abilities to stronger versions, also gives you +2 int per kill."
    )
    
