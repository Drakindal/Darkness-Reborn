package TheKingOfLoas_W

import DummyCaster
import OrderIds
import ClosureTimers
import MyAbilityIds
import MyUnitIds
import MyBuffIds
import KingOfLoas_W
import DamageCustomEvent
import DamageTarget

// Embodiment of Gral

public function embodimentOfGral()
    DamageCustomEvent.addListener(2) ->
        let src = DamageCustomEvent.getSource()
        if src.getTypeId() != HERO_KING_OF_LOAS_ASCENDED
            skip
        else
            if src.isIllusion()
                skip
            else
                if DamageCustomEvent.getType() == ATTACK
                    let lvl = src.getAbilityLevel(KING_OF_LOAS_ASC_ABILITY_2)
                    if GetRandomInt(1, 100) <= 15 and not src.hasAbility(KING_OF_LOAS_BUFF_2) and lvl > 0
                        let targ = DamageCustomEvent.getTarget()

                        new DummyCaster()
                        ..owner(src.getOwner())
                        ..origin(src.getPos())
                        ..castTarget(KING_OF_LOAS_ASC_ABILITY_2_DUMMY_1, 1, OrderIds.bloodlust, src)
                        
                        if not targ.hasAbility(KING_OF_LOAS_BUFF_ASC_2_1)
                            let shark = createUnit(src.getOwner(), DUMMY_UNIT_5, src.getPos(), src.getPos().angleTo(targ.getPos()))
                            new DummyCaster()
                            ..owner(targ.getOwner())
                            ..castTarget(KING_OF_LOAS_ASC_ABILITY_2_DUMMY_2, 1, OrderIds.innerfire, targ)

                            doPeriodicallyTimed(1, 5) (CallbackCounted cb) ->
                                src.damageTargetCode(src.getInt(true) * 5., targ, null, -1, customDamageType.PhysicalRanged)

                            doAfter(0.01) ->
                                shark.setAnimation(0)
                                gralBite.playOnPoint(targ.getPos3Real())
                                doAfter(0.5) ->
                                    shark.setAnimation(1)
                                    doAfter(0.8) -> 
                                        shark.remove()