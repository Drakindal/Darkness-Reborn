package TheKingOfLoas_T

import ClosureTimers
import ClosureForGroups
import DummyCaster
import OrderIds
import ClosureEvents
import MyAbilityIds
import DamageTarget
// Avatar of Bwonsamdi

public function avatarOfBwonsamdi()
    EventListener.add(EVENT_PLAYER_HERO_SKILL) -> 
        let caster = GetTriggerUnit()
        if GetLearnedSkill() == KING_OF_LOAS_ASC_ABILITY_5 and caster.getUserData() != 1
            caster.setUserData(1)
            doPeriodically(2) (CallbackPeriodic cb) ->
                forUnitsInRange(caster.getPos(), 800) (unit u) ->
                    if caster.isEnemyOf(u) and u.isAlive()
                        new DummyCaster()
                        ..owner(caster.getOwner())
                        ..origin(caster.getPos())
                        ..castTarget(KING_OF_LOAS_ABILITY_1_DUMMY, 1, OrderIds.slow, u)
                        caster.damageTargetCode(caster.getInt(true) * 4., u, null, -1, customDamageType.Magical)