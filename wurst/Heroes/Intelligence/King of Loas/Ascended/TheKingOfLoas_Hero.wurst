package TheKingOfLoas_Hero

import UnitIds
import ObjectIds
import MyUnitIds
import MyAbilityIds
import AbilityObjEditing
import CommonDescriptions
import Icons
import MyHeroDefinition

@compiletime function defineHero()
    new MyHeroDefinition(HERO_KING_OF_LOAS_ASCENDED, UnitIds.paladin)
    ..setHeroAbilities(commaList(ABILITY_46, ABILITY_47, ABILITY_50, ABILITY_51, ABILITY_54))
    ..setNormalAbilities(commaList(ABILITY_HERO_TP, ABILITY_44, AbilityIds.inventory))
    
    ..setPrimaryAttribute("Intelligence")
    ..setStatsBase(27, 21, 41)
    ..setStatsPerLvl(2.70, 1.50, 1.80)

    ..setModelFile("Loas Assets\\Improved Loas Model\\Bwonsamdi.mdx")
    ..setScalingValue(1.3)

    ..setMeleeAttack()
    ..setAttack1CooldownTime(0.7)
    ..setAttack1DamageSidesperDie(4)
    ..setAttack1WeaponType(WeaponType.Missile)
    ..setAttack1AnimationBackswingPoint(0.400)
    ..setAttack1AnimationDamagePoint(0.550)
    
    ..setManaInitialAmount(200)
    
    ..setRequirements("")

    ..setUnitSoundSet("")
    ..setName("|cff5f48dfThe King of Loas|r")
    ..setProperNames("Loas")
    ..setTooltipBasic("|c00F7EC46King of Loas|r")
    ..setTooltipExtended("|c00F7EC46King of Loas|r\n"
    + "Roles: " + farmer + "/" + stacker + "/" + ascendant + "/" + defender + "\n\n"
    + "|c00EE0404Physical Damage|r: 2/5\n"
    + "|c0076ECF9Magical Damage|r: 4/5\n"
    + "|c00B0B0B0Defense|r: 2/5\n"
    + "|c00663300Utility|r: 3/5\n"
    + "|c0066FF66Healing|r: 3/5\n"
    + "Difficulty: 1/5\n")
    ..setIconGameInterface(Icons.bTNIceTrollShaman)
    ..setIconScoreScreen(Icons.bTNIceTrollShaman)