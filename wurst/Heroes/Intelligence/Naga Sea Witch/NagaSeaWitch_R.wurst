package NagaSeaWitch_R

import ClosureEvents
import MyAbilityIds
import NagaSeaWitch_Abilities

public function blueSea()
    EventListener.add(EVENT_PLAYER_UNIT_DEATH) ->
        let u = GetKillingUnit()
        let lvl = u.getAbilityLevel(NAGA_WITCH_ABILITY_4)
        if lvl > 0
            if GetRandomInt(1, 100) < lvl*4
                u.setMaxMana(u.getMaxMana().toInt() + nagaWitch_abi4_Mana[lvl-1])