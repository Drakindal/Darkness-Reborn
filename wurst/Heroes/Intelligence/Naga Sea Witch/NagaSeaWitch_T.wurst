package NagaSeaWitch_T

import ClosureEvents
import Abilities
import ClosureForGroups
import DamageTarget
import PointTransitProjectile
import TerrainUtils
import MyAbilityIds

public function tornado()
    EventListener.onPointCast(NAGA_WITCH_ABILITY_5) (unit caster, vec2 target) ->
        let lvl = caster.getAbilityLevel(NAGA_WITCH_ABILITY_5)
        let sfx = addEffect(Abilities.tornado, caster.getPos())..setScale(4)
        let dist = caster.getPos().distanceTo(target)
        let tickRate = 0.05
        let transitProjectile = new PointTransitProjectile(target, sfx, tickRate)
        let time = 6.
        let range = 250.0+50*lvl
        transitProjectile.timedMoveForward(dist, time) (vec2 target, boolean inTransit) ->
            let dmg = caster.getMaxMana() * lvl * 0.90/(1/tickRate)
            if inTransit
                forUnitsInRange(target, range, true) (unit u) ->
                    if u.isEnemyOf(caster) and u.isAlive()
                        caster.damageTargetCode(dmg, u, null, -1, customDamageType.Magical)
                        if sfx.getPos().isTerrainWalkable()
                            u.setPos(sfx.getPos())
            else
                sfx.destr()
                flashEffect("Effects\\Vashj\\WaterBlast.mdl", sfx.getPos(), 8)
                forUnitsInRange(sfx.getPos(), range, true) (unit u) ->
                    if u.isEnemyOf(caster) and u.isAlive()
                        caster.damageTargetCode(dmg, u, null, -1, customDamageType.Magical)
                        if sfx.getPos().isTerrainWalkable()
                            u.setPos(sfx.getPos())