package NagaSeaWitch_Hero

import UnitIds
import ObjectIds
import MyUnitIds
import MyAbilityIds
import AbilityObjEditing
import MyUpgradesIds
import CommonDescriptions
import MyHeroDefinition

@compiletime function defineHero()
    new MyHeroDefinition(HERO_NAGA_SEA_WITCH, UnitIds.seawitch)// Naga Sea Witch (H000)
    ..setHeroAbilities(commaList(NAGA_WITCH_ABILITY_1, NAGAWITCH_ABILITY_2, NAGAWITCH_ABILITY_3, NAGAWITCH_ABILITY_4, NAGAWITCH_ABILITY_5))
    
    ..setPrimaryAttribute("Intelligence")
    ..setStatsBase(15, 14, 20)
    ..setStatsPerLvl(2.00, 1.00, 3.00)

    ..setRangedAttack(600)
    ..setAttack1CooldownTime(1.90)
    ..setAttack1DamageSidesperDie(4)
    ..setAttack1ProjectileArc(0.08)
    ..setAttack1ProjectileArt("Abilities\\Weapons\\NagaArrowMissile\\NagaArrowMissile.mdl")
    ..setAttack1AnimationBackswingPoint(0.540)
    ..setAttack1AnimationDamagePoint(0.730)

    ..setTurnRate(0.60)
    ..setMovementType(MovementType.Amphipic)
    ..setRequirements(commaList(HERO_NAGA_SEA_WITCH_PICKED))
    
    ..setName("Naga Sea Witch")
    ..setTooltipBasic("|c00F7EC46Naga Sea Witch|r")
    ..setTooltipExtended("|c00F7EC46Naga Sea Witch|r\n"
    + "Roles: " + farmer + "/" + stacker + "\n\n"
    + "|c00EE0404Physical Damage|r: 1/5\n"
    + "|c0076ECF9Magical Damage|r: 3/5\n"
    + "|c00B0B0B0Defense|r: 3/5\n"
    + "|c00663300Utility|r: 2/5\n"
    + "|c0066FF66Healing|r: 0/5\n"
    + "Difficulty: 2/5\n")