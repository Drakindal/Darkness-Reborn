package Firelord_Hero

import UnitIds
import ObjectIds
import MyUnitIds
import MyAbilityIds
import AbilityObjEditing
import MyUpgradesIds
import CommonDescriptions
import MyHeroDefinition

@compiletime function defineHero()
    new MyHeroDefinition(HERO_FIRELORD, UnitIds.firelord)// Firelord (N005)
    ..setHeroAbilities(commaList('A01P', 'A01T', 'A01U', 'A01S'))
    ..setNormalAbilities(commaList('A01O', ABILITY_HERO_TP, AbilityIds.inventory))
    
    ..setPrimaryAttribute("Intelligence")
    ..setStatsBase(15, 20, 18)
    ..setStatsPerLvl(2.20, 1.80, 3.20)
    
    ..setScalingValue(1.15)
    ..setSelectionScale(2.00)

    ..setRangedAttack(550)
    ..setAttack1CooldownTime(1.80)
    ..setAttack1DamageSidesperDie(4)
    ..setAttack1ProjectileArc(0.08)
    ..setAttack1ProjectileArt("Abilities\\Weapons\\LordofFlameMissile\\LordofFlameMissile.mdl")
    ..setAttack1AnimationBackswingPoint(0.540)
    ..setAttack1AnimationDamagePoint(0.500)

    ..setTurnRate(0.60)
    ..setRequirements(commaList(HERO_FIRELORD_PICKED))
    
    ..setName("Firelord")
    ..setTooltipBasic("|c00F7EC46Firelord|r")
    ..setTooltipExtended("|c00F7EC46Firelord|r\n"
    + "Roles: " + farmer + "/" + caster + "/" + support + "\n\n"
    + "|c00EE0404Physical Damage|r: 1/5\n"
    + "|c0076ECF9Magical Damage|r: 5/5\n"
    + "|c00B0B0B0Defense|r: 1/5\n"
    + "|c00663300Utility|r: 5/5\n"
    + "|c0066FF66Healing|r: 0/5\n"
    + "Difficulty: 2/5\n")