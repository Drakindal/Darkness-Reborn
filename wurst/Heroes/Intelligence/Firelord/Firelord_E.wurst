package Firelord_E

import ClosureEvents
import ClosureForGroups
import OrderIds
import MyAbilityIds
import MyBuffIds
import Abilities
import DummyCaster
import Global_Variables
import DamageTarget
import Firelord_Blaze

public function conflagration()
    EventListener.onTargetCast(FIRELORD_ABILITY_3) (unit caster, unit target) ->
        let lvl = caster.getAbilityLevel(FIRELORD_ABILITY_3)
        let dmg = caster.getInt(true)*(lvl*1.8)+lvl*550
        if target.hasAbility(FIRELORD_BUFF_BLAZE)
            forUnitsInRange(target.getPos(), 300, true) (unit u) ->
                if caster.isEnemyOf(u)
                    blaze(caster, u)
                    flashEffect(Abilities.fireLordDeathExplode, target.getPos())
                    caster.damageTargetCode(dmg, u, DAMAGE_ELEMENT_FIRE, 'blaz', customDamageType.Magical)
                    new DummyCaster()..owner(caster.getOwner())..origin(caster.getPos())..castTarget(FIRELORD_ABILITY_BLAZE_DUMMY, 1, OrderIds.cripple, u)
        else
            flashEffect(Abilities.fireLordDeathExplode, target.getPos())
            caster.damageTargetCode(dmg, target, DAMAGE_ELEMENT_FIRE, 'blaz', customDamageType.Magical)
            blaze(caster, target)
            new DummyCaster()..owner(caster.getOwner())..origin(caster.getPos())..castTarget(FIRELORD_ABILITY_BLAZE_DUMMY, 1, OrderIds.cripple, target)