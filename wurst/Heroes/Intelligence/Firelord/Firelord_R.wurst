package Firelord_R

import Abilities
import ClosureEvents
import MyBuffIds
import Global_Variables
import DummyCaster
import MyAbilityIds
import OrderIds
import DamageTarget
import BouncingProjectiles
import Firelord_Blaze
import Firelord_Abilities


public function fireballCast()
    EventListener.onTargetCast(FIRELORD_ABILITY_4) (unit caster, unit target) ->
        let sfx = addEffect(Abilities.fireBallMissile, caster.getPos())..setZ(caster.getLocalZ() + 20)..setScale(1.5)
        let level = caster.getAbilityLevel(FIRELORD_ABILITY_4)
        let bounceRange = 400. + 30*level
        let closestEnemy = true
        let buffBias = FIRELORD_BUFF_BLAZE
        let bouncingProjectile = new BouncingProjectiles(sfx, caster, target, bounceRange, closestEnemy, firelord_abi4_BounceAmount[level-1], buffBias)
        bouncingProjectile.moveForward(false) (boolean explicitCheck, effect detectionUnit, unit target) ->
            let damage = firelord_abi4_Damage[level-1] + level * 0.8 * caster.getInt(true)
            blaze(caster, target)
            new DummyCaster()
            ..owner(caster.getOwner())
            ..origin(sfx.getPos())
            ..castTarget(FIRELORD_ABILITY_BLAZE_DUMMY, 1, OrderIds.cripple, target)
            flashEffect(Abilities.fireLordDeathExplode, target.getPos())
            caster.damageTargetCode(damage, target, DAMAGE_ELEMENT_FIRE, 'blaz', customDamageType.Magical)
