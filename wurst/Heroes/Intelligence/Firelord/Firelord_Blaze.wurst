package Firelord_Blaze

import ClosureTimers
import DamageTarget

public function blaze(unit source, unit target)
    doPeriodicallyCounted(1, 4) (CallbackCounted cb) ->
        let pureDamage = 30.0 * source.getLevel() + target.getMaxHP() * 0.01
        source.damageTargetCode(pureDamage, target, null, -1, customDamageType.Pure)

        let magicDamage = source.getInt(true).toReal()
        source.damageTargetCode(magicDamage, target, null, -1, customDamageType.Magical)