package GuardianOfLight_Abilities

import MyAbilityIds
import MyHeroAbilityDefinition
import MyUnitIds
import MyColors
import BuffIds
import ChannelAbilityPreset
import Orders

// ----------------------------------------------------------------------------

 constant int array[9] abi1_ManaCost = [
     160,
     240,
     360,
     820,
     940,
    1260,
    1480,
    1620,
    1940
]

public constant int array[9] guardianOfLight_abi1_Hp = [
     50,
    100,
    160,
    220,
    360,
    400,
    440,
    480,
    520
]

@compiletime function defineAbilities()

    new ChannelAbilityPreset(ARCHMAGE_ABILITY_5, 4, true)
    ..presetManaCost(lvl -> 200 + lvl * 100)
    ..presetDurationHero(lvl -> 140.0 - 20.0 * lvl)
    ..setRequirements("")
    ..setOrderStringUseTurnOn(OrderIds.chainlightning.toRawCode())
    ..setIcon("ReplaceableTextures\\CommandButtons\\BTNL2.blp")
    ..presetTargetsAllowed(lvl -> getTargets(AbilityTargets.EnemiesAll))

    new ChannelAbilityPreset(GUARDIAN_OF_LIGHT_ABILITY_1, 9, true)
    ..presetBuffs(lvl -> "")
    ..presetCastRange(lvl -> 1600.0)
    ..presetDuration(lvl -> 3.0)
    ..setGeneralAbility(AbilityPosition.Q)
    ..presetCooldown(lvl -> 15.0 - lvl)
    ..presetManaCost(lvl -> abi1_ManaCost[lvl-1])
    ..presetArtDuration(lvl -> 1)
    ..presetFollowThroughTime(lvl -> 0.1)
    ..presetTargetTypes(Targettype.UNIT)
    ..presetOption(Option.UNIVERSALSPELL, true)
    ..presetCastingTime(lvl -> 1)
    ..presetBaseOrderID(lvl -> OrderIds.chainlightning.toRawCode())
    ..presetTargetsAllowed(lvl -> getTargets(AbilityTargets.All))
    ..register(HERO_GUARDIAN_OF_LIGHT, "Holy Light".setColor(colAbilitiesGuardianOfLight), 
    "Holy Light heals allies or damages enemy by half amount. Also permanently adds HP and MP to ally.",
    (int lvl) -> "Heal amount {0} + {1} x Int. Permanently: +{2} HP and MP. Cd {3} sec. Mana cost {4}.".format(
        (800*lvl).toString(),
        (3*lvl).toString(),
        guardianOfLight_abi1_Hp[lvl-1].toString(),
        (15 - lvl).toString(),
        abi1_ManaCost[lvl-1].toString()
    ))
    
// ----------------------------------------------------------------------------

    new AbilityDefinitionPaladinDivineShield(GUARDIAN_OF_LIGHT_ABILITY_2)
    ..setGeneralAbility(AbilityPosition.W)
    ..presetCooldown(lvl -> 20.0 - lvl)
    ..setManaCost(1, 100)
    ..setManaCost(2, 130)
    ..setManaCost(3, 169)
    ..setManaCost(4, 219)
    ..setManaCost(5, 255)
    ..setManaCost(6, 285)
    ..setManaCost(7, 320)
    ..setManaCost(8, 367)
    ..setManaCost(9, 420)
    ..presetCanDeactivate(lvl -> true)
    ..presetDuration(lvl -> 3.0 + lvl)
    ..setIcon("ReplaceableTextures\\CommandButtons\\BTNAnkhOfRebirth.BLP")
    ..setIconTurnOff("ReplaceableTextures\\CommandButtonsDisabled\\DISBTNAnkhOfRebirth.BLP")
    ..register(HERO_GUARDIAN_OF_LIGHT, "Divine Shield".setColor(colAbilitiesGuardianOfLight), 
    "The Guardian temporarily casts a Divine Shield on himself, protecting him from all damage.",
    (int lvl) -> "Duration {0} seconds.".format(
        (3+lvl).toString()
    ))
    
// ----------------------------------------------------------------------------

constant real array[9] abi3_Damage = [
    3.00,
    3.40,
    3.80,
    4.20,
    4.60,
    4.80,
    5.40,
    5.80,
    6.50
]

constant real array[9] abi3_HpReg = [
      15.0,
      50.0,
     120.0,
     210.0,
     320.0,
     640.0,
     960.0,
    1400.0,
    2600.0
]

constant int array[9] abi3_Mana = [
     120,
     180,
     240,
     650,
     980,
    1520,
    1940,
    2650,
    3200
]

@compiletime function defineAbilities3()
    new AbilityDefinitionInnerFireCreep(GUARDIAN_OF_LIGHT_ABILITY_3)
    ..setGeneralAbility(AbilityPosition.E)
    ..presetBuffs(lvl -> BuffIds.innerFire.toRawCode())
    ..presetCooldown(lvl -> 15.0 - lvl)
    ..presetDuration(lvl -> 6.0 + lvl)
    ..presetManaCost(lvl -> abi3_Mana[lvl-1])
    ..presetDamageIncrease(lvl -> abi3_Damage[lvl-1])
    ..presetDefenseIncrease(lvl -> 0)
    ..presetAutocastRange(lvl -> 1600.0)
    ..presetCastRange(lvl -> 1600.0)
    ..presetLifeRegenRate(lvl -> abi3_HpReg[lvl-1])
    ..presetDuration(lvl -> 6.5 + 0.5*lvl)
    ..presetCastRange(lvl -> 1200.0)
    ..presetTargetsAllowed(lvl -> getTargets(AbilityTargets.AlliesAll))
    ..setIcon("ReplaceableTextures\\CommandButtons\\BTNSpiritMagic.blp")
    ..register(HERO_GUARDIAN_OF_LIGHT, "Inner Fire".setColor(colAbilitiesGuardianOfLight),
    "The Guardian supports the chosen ally temporally increasing their damage dealt and HP regeneration.",
    (int lvl) -> "+{0}% damage, +{1}% HP/s. Duration {2} seconds. Cd {3} seconds. Mana cost {4}.".format(
        (100*abi3_Damage[lvl-1]).toString(),
        abi3_HpReg[lvl-1].toString(),
        (6 + lvl).toString(),
        (15 - lvl).toString(),
        abi3_Mana[lvl-1].toString()
    ))
    
// ----------------------------------------------------------------------------

public constant int array[9] guardianOfLight_abi4_Stats = [
     1,
     2,
     4,
     6,
     8,
     9,
    10,
    11,
    15
]
constant int array[9] abi4_Mana = [
     240,
     550,
     980,
    1320,
    1940,
    2650,
    3200,
    4900,
    6500
]

@compiletime function defineAbilities4()
    new ChannelAbilityPreset(GUARDIAN_OF_LIGHT_ABILITY_4, 9, true)
    ..setGeneralAbility(AbilityPosition.R)
    ..presetAreaofEffect(lvl -> 500.0 + 50*lvl)
    ..presetCooldown(lvl -> 26.0 - lvl)
    ..presetManaCost(lvl -> abi4_Mana[lvl-1])
    ..presetFollowThroughTime(lvl -> 0.5)
    ..presetTargetTypes(Targettype.POINT)
    ..presetOption(Option.TARGETIMAGE, true)
    ..presetArtDuration(lvl -> 1)
    ..presetCastingTime(lvl -> 1)
    ..presetBaseOrderID(lvl -> OrderIds.blizzard.toRawCode())
    ..presetCastRange(lvl -> 1200.0)
    ..setIcon("ReplaceableTextures\\CommandButtons\\BTNSpell_Holy_HolySmite.blp")
    ..setArtCaster("")
    ..setArtEffect("")
    ..setArtTarget("")
    ..setTargetAttachmentPoint("")
    ..presetTargetsAllowed(lvl -> getTargets(AbilityTargets.All))
    ..register(HERO_GUARDIAN_OF_LIGHT, "Holy Wrath".setColor(colAbilitiesGuardianOfLight), 
    "A burst of light is sent at the target location dealing damage to enemies and healing allies. Also permanently increases random stats of all allies heroes in the area.",
    (int lvl) -> "Deals {0} + {1} x Intelligence damage in {2} range. +{3} to random stats. Cd {4} sec. Mana cost {5}.".format(
        (300*lvl).toString(),
        (1.5*lvl).toString(),
        (500 + 50*lvl).toString(),
        guardianOfLight_abi4_Stats[lvl-1].toString(),
        (26 - lvl).toString(),
        abi4_Mana[lvl-1].toString()
    ))
    
// ----------------------------------------------------------------------------
    
constant int array[4] abi5_Mana = [
     450,
    1500,
    2600,
    4800
]

@compiletime function defineAbilities5()
    new AbilityDefinitionBerserk(GUARDIAN_OF_LIGHT_ABILITY_5)
    ..setUltimateAbility()
    ..presetBuffs(lvl -> "")
    ..presetDamageTakenIncrease(lvl -> 0.0)
    ..presetMovementSpeedIncrease(lvl -> 0.0)
    ..presetAttackSpeedIncrease(lvl -> 0.0)
    ..presetDuration(lvl -> 0.01)
    ..presetAreaofEffect(lvl -> 0.0)
    ..presetCooldown(lvl -> 130.0 - 30*(lvl-1))
    ..presetManaCost(lvl -> abi5_Mana[lvl-1])
    ..presetDuration(lvl -> 0.01)
    ..setIcon("ReplaceableTextures\\CommandButtons\\BTNSpell_Holy_HolyNova.BLP")
    ..setArtCaster("Abilities\\Spells\\Human\\Resurrect\\ResurrectTarget.mdl")
    ..setIcon("ReplaceableTextures\\CommandButtons\\BTNSpell_Holy_HolyNova.BLP")
    ..setArtTarget("")
    ..register(HERO_GUARDIAN_OF_LIGHT, "Gods Blessing".setColor(colAbilitiesGuardianOfLight), 
    "The Guardian of Light calls for the blessing of the god Aelion to fully restore the health of all allied units and increase their max HP.",
    (int lvl) -> "Fully restores heal of all allied units and increases their max HP by {0}".format((500*lvl).toString()))
    
