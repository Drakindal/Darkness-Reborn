package GuardianOfLight_T

import ClosureEvents
import ClosureForGroups
import Abilities
import MyAbilityIds

public function godsBlessing()
    EventListener.onCast(GUARDIAN_OF_LIGHT_ABILITY_5) (unit caster) ->
        let lvl = GetUnitAbilityLevel(caster, GUARDIAN_OF_LIGHT_ABILITY_5)
        let hpAdd = 500*lvl

        forUnitsInRange(caster.getPos(), 99999) (unit u) ->
            if caster.isAllyOf(u) and u.isAlive()
                flashEffect(Abilities.resurrecttarget, u.getPos())
                flashEffect(Abilities.divineShieldTarget, u.getPos())

                u..addHP(u.getMaxHP())
                ..setMaxHP(u.getMaxHP().toInt() + hpAdd)