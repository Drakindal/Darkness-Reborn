package GuardianOfLight_Hero

import UnitIds
import ObjectIds
import MyUnitIds
import AbilityObjEditing
import MyUpgradesIds
import CommonDescriptions
import Icons
import Units
import MyHeroDefinition

@compiletime function defineHero()
    new MyHeroDefinition(HERO_GUARDIAN_OF_LIGHT, UnitIds.keeperofthegrove)// Guadian of Light (E017)
    ..setHeroAbilities(commaList('A00D', 'A00F', 'A00E', 'A00K', 'A0CY'))
    
    
    ..setPrimaryAttribute("Intelligence")
    ..setStatsBase(16, 15, 18)
    ..setStatsPerLvl(2.00, 1.70, 3.00)
    
    ..setSelectionScale(2.25)
    ..setModelFile(Units.kelthuzadGhost)
    ..setIconGameInterface(Icons.bTNGhostOfKelThuzad)
    ..setIconScoreScreen(Icons.bTNGhostOfKelThuzad)

    ..setRangedAttack(600)
    ..setAttack1CooldownTime(2.18)
    ..setAttack1DamageSidesperDie(4)
    ..setAttack1ProjectileArc(0.10)
    ..setAttack1ProjectileArt("Abilities\\Weapons\\KeeperGroveMissile\\KeeperGroveMissile.mdl")
    ..setAttack1AnimationBackswingPoint(0.770)
    ..setAttack1AnimationDamagePoint(0.400)
    
    ..setHitPointsMaximumBase(150)
    ..setHitPointsRegenerationRate(0.50)
    ..setHitPointsRegenerationType("night")
    
    ..setManaMaximum(100)
    
    ..setSpeedBase(290)
    ..setTurnRate(0.40)
    ..setRequirements(commaList(HERO_GUARDIAN_OF_LIGHT_PICKED))
    
    ..setName("Guadian of Light")
    ..setTooltipBasic("|c00F7EC46Guardian of Light|r")
    ..setTooltipExtended("|c00F7EC46Guardian of Light|r\n"
    + "Roles: " + support + "\n\n"
    + "|c00EE0404Physical Damage|r: 1/5\n"
    + "|c0076ECF9Magical Damage|r: 2/5\n"
    + "|c00B0B0B0Defense|r: 2/5\n"
    + "|c00663300Utility|r: 5/5\n"
    + "|c0066FF66Healing|r: 5/5\n"
    + "Difficulty: 2/5\n")