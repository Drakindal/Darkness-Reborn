package GuardianOfLight_R

import ClosureEvents
import ClosureForGroups
import Abilities
import DamageTarget
import MyAbilityIds
import GuardianOfLight_Abilities

public function holyWrath()
    EventListener.onPointCast(GUARDIAN_OF_LIGHT_ABILITY_4) (unit caster, vec2 target) ->
        let lvl = GetUnitAbilityLevel(caster, GUARDIAN_OF_LIGHT_ABILITY_4)
        let range = 500.0 + 50*lvl
        let dmg = 300*lvl + 1.5*lvl*caster.getInt(true)
        let stats = guardianOfLight_abi4_Stats[lvl-1]

        flashEffect(Abilities.massTeleportCaster, caster.getPos())

        forUnitsInRange(target, range, true) (unit u) ->
            if u.isAlive()
                if (u.isAllyOf(caster.getOwner()))
                    flashEffect(Abilities.holyBoltMissile, u.getPos())
                    // Heal
                    u.addHP(dmg)
                    // Add stats
                    if (IsHeroUnitId(u.getTypeId()))
                        string msg
                        let rnd = GetRandomInt(1, 1000)
                        if (rnd <= 333)
                            u.addStr(stats)
                            msg = "Strength"
                        else if (rnd <= 666)
                            u.addAgi(stats)
                            msg = "Agility"
                        else
                            u.addInt(stats)
                            msg = "Intelligence"
                        printTimedToPlayer("Guardian of Light blessing: +{0} {1}!".format(stats.toString(), msg), 5, u.getOwner())
                else // enemy
                    flashEffect(Abilities.orbCorruptionMissile, u.getPos())
                    caster.damageTargetCode(dmg, u, null, -1, customDamageType.Magical)