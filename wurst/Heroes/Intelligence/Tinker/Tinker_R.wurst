package Tinker_R

import ClosureEvents
import ClosureTimers
import MyAbilityIds
import Orders
import ClosureForGroups
import Tinker_Hero
import Tinker_Abilities
import Abilities
import MyUnitIds
import MyUnitTypes
import Global_Variables

CallbackPeriodic tinkerRepairCB

function checkRepairCallback()
    let heroID = playerHero.get(EventData.getTriggerPlayer()).getTypeId()
    if((heroID == HERO_TINKER or heroID == HERO_TINKER_ROBOT))
        if(EventData.getIssuedOrderId() != OrderIds.chainlightning and tinkerRepairCB != null)
            destroy tinkerRepairCB
            tinkerRepairCB = null
        else
            print("Callback is null", 1)

public function repair()
    EventListener.add(EVENT_PLAYER_HERO_SKILL) -> 
        let skill = GetLearnedSkill()
        if (skill == TINKER_ABILITY_4)
            let hero = GetLearningUnit()
            let lvl = hero.getAbilityLevel(TINKER_ABILITY_4)
            hero..setAbilityLevel(TINKER_ABILITY_4_AURA, lvl)
    
    EventListener.onTargetCast(TINKER_ABILITY_4) (unit caster, unit target) ->
        if(tinkerRepairCB == null)
            // HERO_TINKER is organic, so cannot target himself due to settings in presetTargetsAllowed.
            // if (target.getTypeId() == HERO_TINKER)
            //     printTimedToPlayer("Tinker cannot repair himself, because he is organic creature, but he can repair Robo-Goblin.", 6, caster.getOwner())
            let lvl = caster.getAbilityLevel(TINKER_ABILITY_4)
            let period = 0.1
            let manaCost = 10.0*lvl * period
            let hp = tinker_abi4_hp[lvl-1] * period

            tinkerRepairCB = doPeriodically(period) (CallbackPeriodic cb) ->
                if caster.getMana() >= manaCost
                    target.addHP(hp)
                    caster.setAnimation("work")
                    caster.addMana(-manaCost)
                else
                    destroy cb

    EventListener.add(EVENT_PLAYER_UNIT_ISSUED_ORDER) ->
        checkRepairCallback()
    EventListener.add(EVENT_PLAYER_UNIT_ISSUED_POINT_ORDER) -> 
        checkRepairCallback()
    EventListener.add(EVENT_PLAYER_UNIT_ISSUED_TARGET_ORDER) -> 
        checkRepairCallback()
    EventListener.add(EVENT_PLAYER_UNIT_ISSUED_UNIT_ORDER) -> 
        checkRepairCallback()

    doPeriodically(1) (CallbackPeriodic cb) ->
        if (tinkerHero != null)
            let lvl = tinkerHero.getAbilityLevel(TINKER_ABILITY_4)
            if (lvl > 0)
                forUnitsInRange(tinkerHero.getPos(), tinker_abi4_aura_range[lvl-1]) (unit u) ->
                    if (u.getTypeId() == HERO_TINKER_ROBOT or u.checkType(MyUnitType.StructureMechUnit))
                    and not  u.isInvulnerable()
                    and      u.isAlive()
                    and not (u.getHPRatio() > 0.9999)

                        u.addHP(tinker_abi4_aura_hp[lvl-1])
                        flashEffect(Abilities.replenishHealthCasterOverhead, u.getPos())