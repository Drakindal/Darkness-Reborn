package Lich_Q

import ClosureEvents
import ClosureForGroups
import DamageTarget
import MyAbilityIds

public function frostNova()
    EventListener.onTargetCast(LICH_ABILITY_1) (unit caster, unit target) ->
        let dmg = caster.getInt(true) * (caster.getAbilityLevel(LICH_ABILITY_1) * 2.00)
        let range = 800.0
        forUnitsInRange(target.getPos(), range, true) (unit u) ->
            if u.isEnemyOf(caster.getOwner()) and u.isAlive()
                caster.damageTargetCode(dmg, u, null, -1, customDamageType.Magical)