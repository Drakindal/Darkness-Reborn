package Lich_Hero

import UnitIds
import ObjectIds
import MyUnitIds
import AbilityObjEditing
import MyUpgradesIds
import CommonDescriptions
import MyHeroDefinition

@compiletime function defineHero()
    new MyHeroDefinition(HERO_LICH, UnitIds.lich)// Lich (U001)
    ..setHeroAbilities(commaList('A01Q', 'A0SG', 'A01H', 'A0SI', 'A0SF'))
    
    ..setPrimaryAttribute("Intelligence")
    ..setStatsBase(15, 14, 20)
    ..setStatsPerLvl(2.00, 1.00, 3.50)
    
    ..setSelectionScale(1.25)

    ..setRangedAttack(600)
    ..setAttack1CooldownTime(1.90)
    ..setAttack1DamageSidesperDie(4)
    ..setAttack1Range(600)
    ..setAttack1ProjectileArc(0.00)
    ..setAttack1ProjectileArt("Abilities\\Weapons\\LichMissile\\LichMissile.mdl")
    ..setAttack1AnimationBackswingPoint(0.540)
    ..setAttack1AnimationDamagePoint(0.460)
    
    ..setHitPointsRegenerationType("blight")
    ..setHitPointsRegenerationRate(2.00)
    
    ..setMovementHeight(30.00)
    ..setMovementType(MovementType.Hover)

    ..setRequirements(commaList(HERO_LICH_PICKED))
    
    ..setName("Lich")
    ..setTooltipBasic("|c00F7EC46Lich|r")
    ..setTooltipExtended("|c00F7EC46Lich|r\n"
    + "Roles: " + farmer + "/" + caster + "\n\n"
    + "|c00EE0404Physical Damage|r: 1/5\n"
    + "|c0076ECF9Magical Damage|r: 3/5\n"
    + "|c00B0B0B0Defense|r: 1/5\n"
    + "|c00663300Utility|r: 3/5\n"
    + "|c0066FF66Healing|r: 0/5\n"
    + "Difficulty: 2/5\n")