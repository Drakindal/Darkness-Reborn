package Lich_E

import Abilities
import ClosureEvents
import DummyCaster
import MyAbilityIds
import OrderIds
import DamageTarget
import BouncingProjectiles
            
public function chainTest()
    EventListener.onTargetCast(LICH_ABILITY_3) (unit caster, unit target) ->
        let lvl = caster.getAbilityLevel(LICH_ABILITY_3)
        let sfx = addEffect(Abilities.frostBoltMissile, caster.getPos())..setZ(caster.getLocalZ() + 10)..setScale(1.5)
        let bounceRange = 400. + 40*(lvl-1)
        let closestEnemy = true
        let maxBounceCount = lvl+3
        let bouncingProjectiles = new BouncingProjectiles(sfx, caster, target, bounceRange, closestEnemy, maxBounceCount)
        bouncingProjectiles.moveForward(false) (bool explicitCheck, effect detectionUnit, unit target) ->
            let damage = lvl * 1.5 * caster.getInt(true)
            new DummyCaster()
            ..owner(caster.getOwner())
            ..origin(detectionUnit.getPos())
            ..castTarget(FIRELORD_ABILITY_BLAZE_DUMMY, 1, OrderIds.cripple, target)
            new DummyCaster()
            ..owner(caster.getOwner())
            ..origin(detectionUnit.getPos())
            ..castTarget(ABILITY_DUMMY_4, 1, OrderIds.thunderbolt, target)
            flashEffect(Abilities.frostArmorDamage, target.getPos())
            caster.damageTargetCode(damage, target, null, -1, customDamageType.Magical)