package Lich_R

import ClosureEvents
import MyUnitIds
import MyAbilityIds
import Lich_Abilities

public function frostRise()
    EventListener.add(EVENT_PLAYER_UNIT_DEATH) -> 
        if GetKillingUnit().getTypeId() == HERO_LICH and GetKillingUnit().getAbilityLevel(LICH_ABILITY_4) > 0
            let lich = GetKillingUnit()
            let lvl = lich.getAbilityLevel(LICH_ABILITY_4)
            lich.addInt(lich_abi4_Int[lvl-1])