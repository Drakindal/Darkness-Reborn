package TimeWizard_W

import ClosureEvents
import HashMap
import DamageTarget
import MyAbilityIds
import TimeWizard_Abilities

constant punishMap = new IterableMap<unit,int>

public function punishTimeAct(unit u)
    EventListener.add(u, EVENT_PLAYER_UNIT_DEATH) ->
        punishMap.forEach() (unit key, integer value) ->
            u.damageTargetCode(10000. * value, key, null, -1, customDamageType.Magical)
            
public function punishTimeInit()
    EventListener.onTargetCast(TIME_WIZARD_ABILITY_2) (unit caster, unit target) ->
        let lvl = caster.getAbilityLevel(TIME_WIZARD_ABILITY_2)
        target
        ..addStr(timeWizard_abi2_Stats[lvl-1])
        ..addAgi(timeWizard_abi2_Stats[lvl-1])
        ..addInt(timeWizard_abi2_Stats[lvl-1])
        punishMap.put(target, punishMap.get(target) + 1)