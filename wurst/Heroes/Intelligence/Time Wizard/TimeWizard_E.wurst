package TimeWizard_E

import ClosureEvents
import ClosureForGroups
import PauseAllocation
import MyAbilityIds

public function timeStop()
    EventListener.onCast(TIME_WIZARD_ABILITY_3) (unit caster) ->
        forUnitsAll() (unit u) ->
            if(u.isEnemyOf(caster))
                u.pauseTimed(10)