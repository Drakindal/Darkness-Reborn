package TimeWizard_Hero

import UnitIds
import ObjectIds
import MyUnitIds
import AbilityObjEditing
import MyUpgradesIds
import CommonDescriptions
import MyHeroDefinition

@compiletime function defineHero()
    new MyHeroDefinition(HERO_TIME_WIZARD, UnitIds.jaina)// Time Wizard (H009)
    ..setHeroAbilities(commaList('A0K6', 'A0NC', 'A0K5', 'A0ND', 'A0N4'))
    
    ..setPrimaryAttribute("Intelligence")
    ..setStatsBase(15, 17, 19)
    ..setStatsPerLvl(1.80, 1.00, 3.20)

    ..setRangedAttack(600)    
    ..setAttack1CooldownTime(2.13)
    ..setAttack1DamageSidesperDie(4)
    ..setAttack1ProjectileArc(0.15)
    ..setAttack1ProjectileArt("Abilities\\Weapons\\FireBallMissile\\FireBallMissile.mdl")
    ..setAttack1AnimationBackswingPoint(0.400)
    ..setAttack1AnimationDamagePoint(0.550)
    
    ..setManaInitialAmount(200)
    
    ..setRequirements(commaList(HERO_TIME_WIZARD_PICKED))
    
    ..setTooltipExtended(
    rolesList(roleSupport, roleStacker),
    PhysDamage.v1,
    MagicDamage.v4,
    Defense.v1,
    Utility.v5,
    Healing.v4,
    Difficulty.v5)