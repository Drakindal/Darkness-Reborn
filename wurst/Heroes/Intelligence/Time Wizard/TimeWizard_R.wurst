package TimeWizard_R

import ClosureEvents
import ClosureTimers
import StandardTextTags
import ClosureForGroups
import DamageTarget
import MyAbilityIds

texttag hourglass
integer count
bool boom = false

public function hourglass()
    EventListener.onCast(TIME_WIZARD_ABILITY_4) (unit caster) ->
        count = 0
        caster..removeAbility(ABILITY_HERO_TP)..addAbility(TIME_WIZARD_ABILITY_4_DUMMY)
        doPeriodically(1) (CallbackPeriodic cb) ->
            if boom
                boom = false
                destroy cb
            count += 1
            hourglass = createShadowStrikeTextTag(caster, count, false)
            hourglass.setColor(colorA(79, 211, 252, 255))
            hourglass.setText(count.toString())
            caster.startAbilityCooldown(TIME_WIZARD_ABILITY_4)

    EventListener.onCast(TIME_WIZARD_ABILITY_4_DUMMY) (unit caster) ->
        let lvl = GetUnitAbilityLevel(caster, TIME_WIZARD_ABILITY_4)
        let dmg = (count * caster.getInt(true) * lvl).toReal()
        boom = true
        hourglass.destr()
        caster..removeAbility(TIME_WIZARD_ABILITY_4_DUMMY)..addAbility(ABILITY_HERO_TP)
        forUnitsInRange(caster.getPos(), 99999, true) (unit u) ->
            if u.isAlive()
                if caster.isEnemyOf(u)
                    caster.damageTargetCode(dmg, u, null, -1, customDamageType.Magical)
                else
                    if u.getOwner() != Player(10)
                        u.addHP(dmg)