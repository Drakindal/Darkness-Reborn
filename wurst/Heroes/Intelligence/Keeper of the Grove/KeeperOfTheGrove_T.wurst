package KeeperOfTheGrove_T

import Abilities
import ClosureEvents
import MyUnitIds
import Global_Variables
import MyAbilityIds
import UnitStats

// WIP. Refactor summons definition.
public function spiritGuardian()
    EventListener.add(EVENT_PLAYER_UNIT_SUMMON) ->
        let summoner = GetSummoningUnit()
        if(summoner.getTypeId() == HERO_KEEPER_OF_THE_GROVE or summoner.getTypeId() == KEEPER_SUMMON_MAIN_SPIRIT)
            let summon = GetSummonedUnit()
            
            let hero = playerHero.get(summon.getOwner())
            let lvl = hero.getAbilityLevel(KEEPER_OF_THE_GROVE_ABILITY_5)
            let heroInt = hero.getInt(true)
            
            let armorPen = 0.2*lvl*hero.getStats().getPen(penType.Physical)

            if summon.getTypeId() == KEEPER_SUMMON_MAIN_SPIRIT
                summon.setMaxHP(((0.19*heroInt + 340) * lvl + 2600).toInt(), true)
                //summon.setArmor(0.4 * summoner.getArmor() + lvl * 8)
                summon.setBaseDamage(((1.9 * heroInt + 121) * lvl + 256).toInt(), 0)
                summon.getStats().setBasePen(penType.Physical, 1.5 * armorPen)
            if summon.getTypeId() == KEEPER_SUMMON_MINI_SPIRIT
                summon.setMaxHP(((0.1 * heroInt + 125) * lvl + 420).toInt(), true)
                //summon.setArmor(0.4 * summoner.getArmor() + lvl * 8)
                summon.setBaseDamage(((0.8 * heroInt + 37)*lvl + 56).toInt(), 0)
                summon.getStats().setBasePen(penType.Physical, armorPen)