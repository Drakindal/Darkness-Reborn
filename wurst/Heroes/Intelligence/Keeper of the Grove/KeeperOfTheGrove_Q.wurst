package KeeperOfTheGrove_Q

import ClosureEvents
import ClosureForGroups
import Abilities
import ClosureTimers
import DamageTarget
import DummyCaster
import OrderIds
import MyAbilityIds
import KeeperOfTheGrove_Abilities

public function entanglingRoots()
    EventListener.onPointCast(KEEPER_OF_THE_GROVE_ABILITY_1) (unit caster, vec2 target) ->
        let lvl = caster.getAbilityLevel(KEEPER_OF_THE_GROVE_ABILITY_1)
        let dmg = 2.00 * lvl * caster.getInt(true) + keeperOfTheGrove_abi1_Damage[lvl-1]
        let range = (450.0 + 40*(lvl-1))/2
        forUnitsInRange(target, range, true) (unit u) ->
            if caster.isEnemyOf(u) and u.isAlive()
                new DummyCaster()
                ..owner(caster.getOwner())
                ..origin(caster.getPos())
                ..castTarget(KEEPER_OF_THE_GROVE_ABILITY_1_2_DUMMY, 1, OrderIds.entanglingroots, u)
                ..delay(0)
                flashEffect(Abilities.roots1, u, "overhead")
                doPeriodicallyTimed(1.00, 5.00) (CallbackCounted cb) ->
                    caster.damageTargetCode(dmg, u, null, -1, customDamageType.Magical)