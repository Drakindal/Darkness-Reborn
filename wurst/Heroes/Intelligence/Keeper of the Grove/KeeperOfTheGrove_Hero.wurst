package KeeperOfTheGrove_Hero

import UnitIds
import ObjectIds
import MyUnitIds
import AbilityObjEditing
import MyUpgradesIds
import CommonDescriptions
import MyHeroDefinition

@compiletime function defineHero()
    new MyHeroDefinition(HERO_KEEPER_OF_THE_GROVE, UnitIds.keeperofthegrove)// Keeper of the Grove (E000)
    ..setHeroAbilities(commaList('A0TS', 'A0TU', 'A0U1', 'A0TZ', 'A0U2'))
    
    ..setPrimaryAttribute("Intelligence")
    ..setStatsBase(16, 15, 18)
    ..setStatsPerLvl(2.00, 1.70, 3.00)
    
    ..setSelectionScale(2.25)

    ..setRangedAttack(600)
    ..setAttack1CooldownTime(2.18)
    ..setAttack1DamageSidesperDie(4)
    ..setAttack1ProjectileArc(0.10)
    ..setAttack1ProjectileArt("Abilities\\Weapons\\KeeperGroveMissile\\KeeperGroveMissile.mdl")
    ..setAttack1AnimationBackswingPoint(0.770)
    ..setAttack1AnimationDamagePoint(0.400)

    ..setHitPointsRegenerationType("night")
    ..setHitPointsRegenerationRate(0.50)
    
    ..setTurnRate(0.40)
    ..setMovementType(MovementType.Horse)

    ..setRequirements(commaList(HERO_KEEPER_OF_THE_GROVE_PICKED))
    
    ..setName("Keeper of the Grove")
    ..setTooltipBasic("|c00F7EC46Keeper of the Grove|r")
    ..setTooltipExtended("|c00F7EC46Keeper of the Grove|r\n"
    + "Roles: " + farmer + "/" + support + "/" + summoner + "\n\n"
    + "|c00EE0404Physical Damage|r: 1/5\n"
    + "|c0076ECF9Magical Damage|r: 4/5\n"
    + "|c00B0B0B0Defense|r: 1/5\n"
    + "|c00663300Utility|r: 4/5\n"
    + "|c0066FF66Healing|r: 0/5\n"
    + "Difficulty: 2/5\n")