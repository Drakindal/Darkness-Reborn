package HeraldOfLightning_Q

import LinkedList
import ClosureEvents
import ClosureTimers
import ClosureForGroups
import MyAbilityIds
import MyUnitIds
import DamageTarget
import OrderIds

public function orbofLightning()
    EventListener.onCast(HERALD_ABILITY_1) (unit caster) ->
        let temp = new LinkedList<unit>
        let sfxtemp = new LinkedList<unit>
        for int i = 0 to 2
            let posCaster = caster.getPos()
            let angle = (60. + 120 * i).asAngleDegrees()
            let pos = posCaster.polarOffset(angle, 75).withZ(150)
            let sfx = createUnit(PLAYER_ALLY_BASE, HERO_HERALD_OF_LIGHTNING_DUMMY_2)..setPosFly(pos)
            sfxtemp.add(sfx)
        doPeriodicallyTimed(0.03, 10) (CallbackCounted cb) ->
            for int i = 0 to 2
                let sfx = sfxtemp.get(i)
                let pos = caster.getPos()
                let angle = (60. + 120 * i).asAngleDegrees() + (2.2*cb.getCount()).asAngleDegrees()
                let newpos = pos.polarOffset(angle, 75).withZ(150)
                sfx..setPosFly(newpos)
        doPeriodicallyTimed(0.5, 10) (CallbackCounted cb) ->
            let lvl = caster.getAbilityLevel(HERALD_ABILITY_1)
            let dmg = 0.8 * caster.getInt(true) * lvl
            forUnitsInRange(caster.getPos(), 500) (unit u) ->
                if u.isEnemyOf(caster) and u.isAlive()
                    temp.add(u)
            let damaged_unit = temp.getRandomElement()
            let damage_orb = sfxtemp.getRandomElement()
            let temp_unit = createUnit(PLAYER_ALLY_BASE, HERO_HERALD_OF_LIGHTNING_DUMMY, damage_orb.getPos3Fly(), damage_orb.getPos().angleTo(damaged_unit.getPos()))
            temp_unit.addAbility(HERALD_ABILITY_DUMMY)
            temp_unit.issueTargetOrderById(Orders.chainlightning, damaged_unit)
            doAfter(0.1) ->
                temp_unit.remove()
            caster.damageTargetCode(dmg, damaged_unit, null, 'HEAB', customDamageType.Magical)
            temp.clear()
            if cb.isLast()
                sfxtemp.forEach() (unit t) ->
                    t.remove()
                sfxtemp.clear()
                destroy sfxtemp
                destroy temp