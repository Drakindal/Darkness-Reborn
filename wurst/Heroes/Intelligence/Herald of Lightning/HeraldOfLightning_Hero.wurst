package HeraldOfLightning_Hero

import UnitIds
import ObjectIds
import MyUnitIds
import MyAbilityIds
import AbilityObjEditing
import MyUpgradesIds
import CommonDescriptions
import Icons
import MyHeroDefinition

@compiletime function defineHero()
    new UnitDefinition(HERO_HERALD_OF_LIGHTNING_DUMMY, UnitIds.wisp)
    ..setModelFile("")
    ..setUnitClassification("_")
    ..setNormalAbilities(commaList(AbilityIds.invulnerable, AbilityIds.locust))

    new UnitDefinition(HERO_HERALD_OF_LIGHTNING_DUMMY_2, UnitIds.wisp)
    ..setModelFile("Units\\Far seer(Zues)\\OrbLightningX.mdx")
    ..setScalingValue(0.4)
    ..setUnitClassification("_")
    ..setNormalAbilities(commaList(AbilityIds.invulnerable, AbilityIds.locust))

    new MyHeroDefinition(HERO_HERALD_OF_LIGHTNING, UnitIds.farseer)// herald of Lightning (O00S)
    ..setHeroAbilities(commaList(HERALD_ABILITY_Q, HERALD_ABILITY_W, HERALD_ABILITY_E, HERALD_ABILITY_R, HERALD_ABILITY_T))
    
    ..setPrimaryAttribute("Intelligence")
    ..setStatsBase(15, 18, 19)
    ..setStatsPerLvl(2.00, 1.00, 3.00)

    ..setIconGameInterface(Icons.bTNAvatar)
    ..setModelFile("Units\\Far seer(Zues)\\Zeus.mdx")
    
    ..setSelectionScale(2.00)

    ..setRangedAttack(600)
    ..setAttack1CooldownTime(2.28)
    ..setAttack1DamageSidesperDie(4)
    ..setAttack1ProjectileArc(0.15)
    ..setAttack1ProjectileArt("Units\\Far seer(Zues)\\ZeusMissile.mdx")
    ..setAttack1AnimationBackswingPoint(0.500)
    ..setAttack1AnimationDamagePoint(0.300)
    
    ..setTurnRate(0.40)
    ..setMovementType(MovementType.Horse)
    ..setRequirements(commaList(HERO_HERALD_OF_LIGHTNING_PICKED))
    
    ..setProperNames("Crackle")
    ..setName("Herald of Lightning")
    ..setTooltipBasic("|c00F7EC46Herald of Lightning|r")
    ..setTooltipExtended("|c00F7EC46Herald of Lightning|r\n"
    + "Roles: " + farmer + "\n\n"
    + "|c00EE0404Physical Damage|r: 2/5\n"
    + "|c0076ECF9Magical Damage|r: 3/5\n"
    + "|c00B0B0B0Defense|r: 1/5\n"
    + "|c00663300Utility|r: 2/5\n"
    + "|c0066FF66Healing|r: 0/5\n"
    + "Difficulty: 2/5\n")