package HeraldOfLightning_R

import DamageTarget
import DamageEvent
import MyAbilityIds
import RandomGen
import ClosureTimers

function heraldAutoAttack()
    let src = DamageEvent.getSource()
    let lvl = src.getAbilityLevel(HERALD_ABILITY_4)
    let targ = DamageEvent.getTarget()
    let intellect = src.getInt(true)
    let dmg = intellect * (lvl * 2.00)
    src.damageTargetCode(dmg, targ, null, 'MRIP', customDamageType.Magical)
    let temp = addEffect("Abilities\\Spells\\Orc\\Purge\\PurgeBuffTarget.mdl", targ.getPos())
    doAfter(0.4) -> 
        temp.destr()
    giveInt(src)

function heraldUlt(unit src)
    let lvl = src.getAbilityLevel(HERALD_ABILITY_4)
    DamageEvent.setAmount(DamageEvent.getAmount() * (1+0.2*lvl))
    giveInt(src)

function heraldQ_W(unit src)
    let lvl = src.getAbilityLevel(HERALD_ABILITY_4)
    DamageEvent.setAmount(DamageEvent.getAmount() * (1+0.2*lvl))
    giveInt(src)

function giveInt(unit src)
    let lvl = src.getAbilityLevel(HERALD_ABILITY_4)
    src.addInt((0.01+0.25*(lvl-1)).ceil())

public function mindRipper()
    DamageEvent.addListener(0) ->
        let src = DamageEvent.getSource()
        let lvl = src.getAbilityLevel(HERALD_ABILITY_4)
        let addChance = src.getAbilityLevel(HERALD_ABILITY_3)
        if (lvl > 0)
            switch DamageEvent.getType()
                case ATTACK
                    if (checkChanceI(lvl * 5 + addChance))
                        heraldAutoAttack()
                case CODE
                    let id = DamageEvent.getId()
                    switch id
                        // Damage from ultimate.
                        case 'HTIM'
                            heraldUlt(src)
                        // Damage from Q and W.
                        case 'HEAB'
                            if checkChanceI(lvl * 5 + addChance)
                                heraldQ_W(src)
                        default
                default