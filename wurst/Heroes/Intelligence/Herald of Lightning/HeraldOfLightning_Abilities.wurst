package HeraldOfLightning_Abilities

import MyAbilityIds
import MyHeroAbilityDefinition
import MyUnitIds
import AbilityObjEditing
import MyBuffIds
import ObjectIds
import BuffIds
import BuffObjEditing
import MyColors
import CommonDescriptions

// ----------------------------------------------------------------------------

@compiletime function defineAbilities()
    new AbilityDefinitionChainLightningcreep(HERALD_ABILITY_DUMMY)
    ..setLevels(1)
    ..setDummyAbility()
    ..setNumberofTargetsHit(1, 1)
    ..setDamageperTarget(1, 0)
    ..setCastingTime(1, 0)
    ..setTargetsAllowed(1, getTargets(AbilityTargets.EnemiesAll))

    new AbilityDefinitionBerserk(HERALD_ABILITY_1)
    ..setGeneralAbility(AbilityPosition.Q)
    ..setIcon("ReplaceableTextures\\CommandButtons\\BTNZuesQ.blp")
    ..presetDuration(lvl -> 0)
    ..presetCooldown(lvl -> 20)
    ..presetBuffs(lvl -> "")
    ..presetDamageTakenIncrease(lvl-> 0)
    ..presetAttackSpeedIncrease(lvl-> 0)
    ..register(HERO_HERALD_OF_LIGHTNING, "Orbs of Lightning".setColor(colAbilitiesHeraldOfLightning), 
    "The Herald of Lightning calls a few orbs of lightning which deal damage to an random enemy every 0.5 sec within 10 sec in 500 range.",
    (int lvl) -> "Deals {0} x Intelligence damage.".format(
        (0.8*lvl).toString(1)
    ))

// ----------------------------------------------------------------------------

    new BuffDefinition(HERALD_BUFF_W, BuffIds.stunned)
    ..setArtTarget("")
    ..register("Lightning Nova".setColor(colAbilitiesHeraldOfLightning),
    "Hit by the Nova from the Herald of Lightning, momentarily stunned.")

    new AbilityDefinitionTaurenChieftainWarStomp(HERALD_ABILITY_2)
    ..setGeneralAbility(AbilityPosition.W)
    ..setIcon("ReplaceableTextures\\CommandButtons\\BTNZuesW.blp")
    ..setArtCaster("Units\\Far seer(Zues)\\LightningNova.mdx")
    ..presetDuration(lvl -> 1 + 0.15*(lvl-1))
    ..presetCooldown(lvl -> 25)
    ..presetAreaofEffect(lvl -> 600)
    ..presetBuffs(lvl -> commaList(HERALD_BUFF_W))
    ..presetManaCost(lvl -> (80*lvl))
    ..register(HERO_HERALD_OF_LIGHTNING, "Lightning Nova".setColor(colAbilitiesHeraldOfLightning), 
    "Herald unleashes a Lightning Nova that damages and immobilizes every enemy around him. Hits 5 times in range that linearly decreases from 500 to 0.",
    (int lvl) -> "Deals {0} x Int damage every 0.2 sec. Immobilizes for {1} sec.".format(
        (3*lvl).toString(),
        (1 + 0.15*(lvl-1)).toString(2)
    ))

// ----------------------------------------------------------------------------

    new BuffDefinition(HERALD_BUFF_E, BuffIds.berserk)
    ..setName("Lightning Empowerment")
    ..setTooltipNormal("")
    ..setTooltipNormalExtended("Herald is empowered by the gods, granting his lightning more ferocity.")
    ..setArtTarget("")
    
    new AbilityDefinitionFrenzy(HERALD_ABILITY_3)
    ..setGeneralAbility(AbilityPosition.E)
    ..setIcon("ReplaceableTextures\\CommandButtons\\BTNZuesE.blp")
    ..setIconTurnOff("ReplaceableTextures\\CommandButtonsDisabled\\DISBTNZuesE.blp")
    ..presetDurationHero(lvl -> 15)
    ..presetDurationNormal(lvl -> 15)
    ..presetCooldown(lvl -> 25)
    ..presetBuffs(lvl -> commaList(HERALD_BUFF_E))
    ..presetMovementSpeedIncrease(lvl-> 0.)
    ..presetAttackSpeedIncrease(lvl-> 0.3*lvl)
    ..register(HERO_HERALD_OF_LIGHTNING, "Lightning Empowerment".setColor(colAbilitiesHeraldOfLightning), 
    "The Herald coats himself in lightning, increasing his Attack Speed and the chance for Static Charge to occur on attack. Duration 15 seconds.\nCooldown 25 second.",
    (int lvl) -> "+{0}% Attack Speed, +{1}% Static Charge chance.".format(
        (30*lvl).toString(),
        (lvl).toString()
    ))
    
// ----------------------------------------------------------------------------

    new AbilityDefinitionCriticalStrikecreep(HERALD_ABILITY_4)
    ..setGeneralAbility(AbilityPosition.R)
    ..setIcon("ReplaceableTextures\\CommandButtons\\BTNZuesR.blp")
    ..presetDamageMultiplier(lvl -> 0.)
    ..presetChancetoEvade(lvl -> 0.)
    ..presetChancetoCriticalStrike(lvl -> 0.)
    ..register(HERO_HERALD_OF_LIGHTNING, "Static Charge".setColor(colAbilitiesHeraldOfLightning),
    wordPassive + "Herald's abilities and attacks have a chance to deal critical damage.\n" +
    "1. Auto-attacks have a 5% x LVL chance to deal 2 x LVL x Int magic damage.\n" +
    "2. Abilities Q and W have 5% x LVL chance to deal 20% x LVL increased damage.\n" +
    "3. Ultimate ability always deals increased damage.\n" +
    "4. Whenever Static Charge occurs the Herald permanently gets Intelligence.",
    (int lvl) -> "{0}% chance to occur. Auto-attack +{1} x Int damage. Spells deal +{2}% damage. +{3} Int on occur.".format(
        (5*lvl).toString(),
        (2*lvl).toString(),
        (20*lvl).toString(),
        (0.01+0.25*(lvl-1)).ceil().toString()
    ))

// ----------------------------------------------------------------------------

    new AbilityDefinitionThunderBoltCreep(HERALD_ABILITY_5)
    ..setUltimateAbility()
    ..setIcon("ReplaceableTextures\\CommandButtons\\BTNZuesT.blp")
    ..setMissileSpeed(0)
    ..setMissileHomingEnabled(false)
    ..setMissileArt("")
    ..presetBuffs(lvl -> "")
    ..presetDamage(lvl -> 0)
    ..presetCastRange(lvl -> 600)
    ..presetAreaofEffect(lvl -> 500.0 + 100*(lvl-1))
    ..presetCooldown(lvl -> 140-20.*lvl)
    ..presetDurationHero(lvl -> 0.010)
    ..presetDurationNormal(lvl -> 0.010)
    ..presetManaCost(lvl -> 450*lvl)
    ..presetTargetsAllowed(lvl -> getTargets(AbilityTargets.EnemiesAll))
    ..register(HERO_HERALD_OF_LIGHTNING, "Disintegrating Lightning Strike".setColor(colAbilitiesHeraldOfLightning),
    "Herald calls down a massive bolts of lightning onto all enemies in range. Always triggers Static Charge.",
    (int lvl) -> "Deals [{0} x Int + 100% max Mana] damage in {1} range.".format(
        (5*lvl).toString(),
        (500 + 100*(lvl-1)).toString()
    ))

// ----------------------------------------------------------------------------