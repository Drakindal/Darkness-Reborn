package Firemage_EternalFlame

import DamageTarget
import Global_Variables
import DamageCustomEvent
import MyAbilityIds
import MyUnitIds
import ClosureEvents
import ClosureTimers
import PauseAllocation

function eternalFlameDamage(unit src, unit target)
    let fireMage = playerHero.get(src.getOwner())
    let lvl2 = fireMage.getAbilityLevel(FIREMAGE_ABILITY_2)
    let lvl5 = fireMage.getAbilityLevel(FIREMAGE_ABILITY_5)
    let amount = (lvl2*0.1 + lvl5*0.4 + 0.1) * fireMage.getInt(true) 
    src.damageTargetCode(amount, target, null, -1, customDamageType.Magical)

public function eternalFlame()
    DamageCustomEvent.addListener(2) -> 
        let src  = DamageCustomEvent.getSource()
        let targ = DamageCustomEvent.getTarget()
        switch DamageCustomEvent.getType()
            case SPELL
                //Firemage
                if src.getTypeId() == HERO_FIRE_MAGE
                    eternalFlameDamage(src, targ)
            case CODE
                if DamageCustomEvent.getId() == 'phoe'
                    eternalFlameDamage(src, targ)
            default
                skip

    EventListener.add(EVENT_PLAYER_HERO_SKILL) -> 
        let u = GetTriggerUnit()
        if u.getTypeId() == HERO_FIRE_MAGE
            u.hideAbility(FIREMAGE_ABILITY_PASSIVE, true)