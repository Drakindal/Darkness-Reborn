package Firemage_Hero

import UnitIds
import ObjectIds
import MyUnitIds
import MyAbilityIds
import AbilityObjEditing
import MyUpgradesIds
import CommonDescriptions
import MyHeroDefinition

@compiletime function defineHero()
    new MyHeroDefinition(HERO_FIRE_MAGE, UnitIds.bloodmage)// Fire Mage (H03R)
    ..setHeroAbilities(commaList('A0N0', 'A004', 'A0E7', 'A0C1', 'A0MN'))
    ..setNormalAbilities(commaList(ABILITY_HERO_TP, AbilityIds.inventory, 'A901'))
    
    ..setPrimaryAttribute("Intelligence")
    ..setStatsBase(18, 14, 19)
    ..setStatsPerLvl(2.00, 1.00, 3.00)
    
    ..setRangedAttack(600)
    ..setAttack1CooldownTime(1.64)
    ..setAttack1DamageSidesperDie(4)
    ..setAttack1ProjectileArc(0.15)
    ..setAttack1ProjectileArt("Abilities\\Weapons\\BloodElfMissile\\BloodElfMissile.mdl")
    ..setAttack1AnimationBackswingPoint(0.850)
    ..setAttack1AnimationDamagePoint(0.550)

    ..setRequirements(commaList(HERO_FIRE_MAGE_PICKED))
    
    ..setName("Fire Mage")
    ..setTooltipBasic("|c00F7EC46Firemage|r")
    ..setTooltipExtended("|c00F7EC46Firemage|r\n"
    + "Roles: " + farmer + "/" + caster + "/" + defender + "\n\n"
    + "|c00EE0404Physical Damage|r: 1/5\n"
    + "|c0076ECF9Magical Damage|r: 4/5\n"
    + "|c00B0B0B0Defense|r: 3/5\n"
    + "|c00663300Utility|r: 2/5\n"
    + "|c0066FF66Healing|r: 0/5\n"
    + "Difficulty: 3/5\n")