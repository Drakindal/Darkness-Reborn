package Firemage_E

import DamageTarget
import DamageCustomEvent
import Firemage_Abilities
import MyBuffIds
import MyAbilityIds

public function fireShield()
    DamageCustomEvent.addListener(2) ->
        if (DamageCustomEvent.getType() == ATTACK)
            let damtyp = DamageCustomEvent.getDamageType()
            if (damtyp == DAMAGE_TYPE_NORMAL or damtyp == DAMAGE_TYPE_MAGIC)
                let targ = DamageCustomEvent.getTarget()
                if targ.getAbilityLevel(FIREMAGE_BUFF_3) > 0
                    let lvl = targ.getAbilityLevel(FIREMAGE_ABILITY_3)
                    let dmg = targ.getInt(true)*firemage_abi3_IntScale[lvl-1]
                    let src = DamageCustomEvent.getSource()
                    targ.damageTargetCode(dmg, src, null, 'phoe', customDamageType.Magical)