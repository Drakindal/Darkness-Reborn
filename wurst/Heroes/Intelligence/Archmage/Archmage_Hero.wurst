package Archmage_Hero

import UnitIds
import ObjectIds
import MyUnitIds
import MyAbilityIds
import AbilityObjEditing
import MyUpgradesIds
import CommonDescriptions
import MyHeroDefinition

@compiletime function defineHero()
    new MyHeroDefinition(HERO_ARCHMAGE, UnitIds.archmage)// Archmage (H002)
    ..setHeroAbilities(commaList('A0CZ', 'A0CX', ARCHMAGE_ABILITY_E, 'A0D3', ARCHMAGE_ABILITY_T))
    
    
    ..setPrimaryAttribute("Intelligence")
    ..setStatsBase(14, 17, 19)
    ..setStatsPerLvl(1.80, 1.00, 3.20)
    
    ..setRangedAttack(600)
    ..setAttack1CooldownTime(2.13)
    ..setAttack1DamageSidesperDie(4)
    ..setAttack1ProjectileArc(0.15)
    ..setAttack1ProjectileArt("Abilities\\Weapons\\FireBallMissile\\FireBallMissile.mdl")
    ..setAttack1AnimationBackswingPoint(0.850)
    ..setAttack1AnimationDamagePoint(0.550)
    
    ..setRequirements(commaList(HERO_ARCHMAGE_PICKED))
    
    ..setName("Archmage")
    ..setTooltipBasic("|c00F7EC46Archmage|r")
    ..setTooltipExtended("|c00F7EC46Archmage|r\n"
    + "Roles: " + farmer + "/" + caster + "\n\n"
    + "|c00EE0404Physical Damage|r: 1/5\n"
    + "|c0076ECF9Magical Damage|r: 4/5\n"
    + "|c00B0B0B0Defense|r: 1/5\n"
    + "|c00663300Utility|r: 2/5\n"
    + "|c0066FF66Healing|r: 0/5\n"
    + "Difficulty: 3/5\n")