package Archmage_Abilities

import MyAbilityIds
import MyHeroAbilityDefinition
import MyUnitIds
import ChannelAbilityPreset
import MyColors
import BuffObjEditing
import MyBuffIds
import BuffIds
import Abilities
import DebugVar
import MyOrderIds

// ----------------------------------------------------------------------------

let wordAbilityDoubleDamage = "Any magical buff not from this spell will double the damage. Also, not Archmage's buffs and buffs from items are accounted for.\n".setColor(colAbilitiesArchmage)

@compiletime function archmageAbilities()
    if (BUILD_INT_HEROES)
        new BuffDefinition(ARCHMAGE_BUFF_1, BuffIds.curse)
        ..setArtTarget(Abilities.curseTarget)
        ..setIcon(Icons.bTNCurse)
        ..register("Eclipse".setColor(colAbilitiesArchmage),
        "This unit has been hit by Eclipse")
        
        new AbilityDefinitionCurse(ARCHMAGE_ABILITY_1_DUMMY)
        ..setLevels(1)
        ..setCooldown(1, 0)
        ..setManaCost(1, 0)
        ..setChancetoMiss(1, 85)
        ..setDurationHero(1, 15)
        ..setDurationNormal(1, 15)
        ..setCastingTime(1, 0)
        ..setCastRange(1, 99999)
        ..setRequirements("")
        ..setArtTarget(".mdl")
        ..setArtSpecial(".mdl")
        ..setArtEffect(".mdl")
        ..setArtCaster(".mdl")
        ..setMissileArt(".mdl")
        ..setBuffs(1, ARCHMAGE_BUFF_1.toRawCode())

        new ChannelAbilityPreset(ARCHMAGE_ABILITY_1, 9, true)
        ..setGeneralAbility(AbilityPosition.Q)
        ..presetAreaofEffect(lvl -> 500.0)
        ..presetCooldown(lvl -> 21.0 - lvl)
        ..presetManaCost(lvl -> 50 + 25*lvl)
        ..presetFollowThroughTime(lvl -> 0.1)
        ..presetTargetTypes(Targettype.POINT)
        ..presetOption(Option.TARGETIMAGE, true)
        ..presetArtDuration(lvl -> 1.0)
        ..presetBaseOrderID(lvl -> MyOrderIds.aoeBlizzard)
        ..setOrderStringUseTurnOn(MyOrderIds.aoeBlizzard)
        ..presetCastRange(lvl -> 900.0)
        ..setIcon("ReplaceableTextures\\CommandButtons\\BTNEclipse.blp")
        ..setArtCaster("")
        ..setCasterAttachmentPoint("")
        ..setArtEffect("")
        ..setArtTarget("")
        ..setTargetAttachmentPoint("")
        ..presetTargetsAllowed(lvl -> getTargets(AbilityTargets.EnemiesAll))
        ..register(HERO_ARCHMAGE, "Eclipse".setColor(colAbilitiesArchmage), 
        "Power from the eclipse falls upon your enemies in 500 range causing 1.25 x (Skill Level) x Intelligence damage and applying the Eclipse buff (88% miss)\n\n" +
        wordAbilityDoubleDamage,
        (int lvl) -> "Deals {0} x Intelligence damage. Mana cost {1}.".format(
            (1.25*lvl).toString(2),
            (50 + 25*lvl).toString()
        ))
    
// ----------------------------------------------------------------------------
    
        new BuffDefinition(ARCHMAGE_BUFF_2, BuffIds.faerieFire)
        ..setArtTarget(Abilities.faerieFireTarget)
        ..setIcon(Icons.bTNFaerieFire)
        ..register("Falling Light".setColor(colAbilitiesArchmage),
        "This unit has been hit by Falling Light")
        
        new AbilityDefinitionFaerieFire(ARCHMAGE_ABILITY_2_DUMMY)
        ..setLevels(1)
        ..setDurationHero(1, 15)
        ..setDurationNormal(1, 15)
        ..setDefenseReduction(1, 10)
        ..setCooldown(1, 0)
        ..setManaCost(1, 0)
        ..setCastingTime(1, 0)
        ..setCastRange(1, 99999)
        ..setRequirements("")
        ..setArtTarget(".mdl")
        ..setArtSpecial(".mdl")
        ..setArtEffect(".mdl")
        ..setArtCaster(".mdl")
        ..setMissileArt(".mdl")
        ..setBuffs(1, ARCHMAGE_BUFF_2.toRawCode())

        // WIP Armor reduction.
        new ChannelAbilityPreset(ARCHMAGE_ABILITY_2, 9, true)
        ..setGeneralAbility(AbilityPosition.W)
        ..presetAreaofEffect(lvl -> 500.0)
        ..presetCooldown(lvl -> 21.0 - lvl)
        ..presetManaCost(lvl -> 50 + 25*lvl)
        ..presetFollowThroughTime(lvl -> 0.01)
        ..presetTargetTypes(Targettype.POINT)
        ..presetOption(Option.TARGETIMAGE, true)
        ..presetBaseOrderID(lvl -> MyOrderIds.aoeClusterRockets)
        ..setOrderStringUseTurnOn(MyOrderIds.aoeClusterRockets)
        ..presetCastRange(lvl -> 800.0)
        ..setIcon("ReplaceableTextures\\CommandButtons\\BTNF1.blp")
        ..setArtCaster("")
        ..setCasterAttachmentPoint("")
        ..setArtEffect("")
        ..setArtTarget("")
        ..setTargetAttachmentPoint("")
        ..presetTargetsAllowed(lvl -> getTargets(AbilityTargets.EnemiesAll))
        ..register(HERO_ARCHMAGE, "Falling Light".setColor(colAbilitiesArchmage), 
        "Create a circle of light, damaging enemies in 500 range every 1 second for 2 seconds dealing 0.45 x (Skill Level) x Intelligence damage. Each hit applies Falling Light reducing armor of enemies by 10 for 15 seconds.\n\n" +
        wordAbilityDoubleDamage,
        (int lvl) -> "Deals {0} x Intelligence damage. Mana cost {1}.".format(
            (0.45*lvl).toString(2),
            (50 + 25*lvl).toString()
        ))
        
// ----------------------------------------------------------------------------

        new BuffDefinition(ARCHMAGE_BUFF_3, BuffIds.cripple)
        ..setArtTarget(Abilities.crippleTarget)
        ..setIcon(Icons.bTNCripple)
        ..register("Ultima".setColor(colAbilitiesArchmage),
        "This unit has been hit by Ultima")

        new AbilityDefinitionCripple(ARCHMAGE_ABILITY_3_DUMMY)
        ..setLevels(1)
        ..setDurationHero(1, 15)
        ..setDurationNormal(1, 15)
        ..setAttackSpeedReduction(1, 0)
        ..setDamageReduction(1, 0.5)
        ..setCooldown(1, 0)
        ..setManaCost(1, 0)
        ..setCastingTime(1, 0)
        ..setCastRange(1, 99999)
        ..setRequirements("")
        ..setArtTarget(".mdl")
        ..setArtSpecial(".mdl")
        ..setArtEffect(".mdl")
        ..setArtCaster(".mdl")
        ..setMissileArt(".mdl")
        ..setBuffs(1, ARCHMAGE_BUFF_3.toRawCode())

        new ChannelAbilityPreset(ARCHMAGE_ABILITY_3, 9, true)
        ..setGeneralAbility(AbilityPosition.E)
        ..presetAreaofEffect(lvl -> 500.0)
        ..presetCooldown(lvl -> 21.0 - lvl)
        ..presetManaCost(lvl -> 50 + 25 * lvl)
        ..presetOption(Option.TARGETIMAGE, true)
        ..presetTargetTypes(Targettype.POINT)
        ..presetArtDuration(lvl -> 1)
        ..presetFollowThroughTime(lvl -> 4)
        ..presetBaseOrderID(lvl -> MyOrderIds.aoeFlameStrike)
        ..setOrderStringUseTurnOn(MyOrderIds.aoeFlameStrike)
        ..presetCastRange(lvl -> 800)
        ..presetCastingTime(lvl -> 0)
        ..setIcon("ReplaceableTextures\\CommandButtons\\BTNUltima.blp")
        ..presetTargetsAllowed(lvl -> getTargets(AbilityTargets.EnemiesAll))
        ..register(HERO_ARCHMAGE, "Ultima".setColor(colAbilitiesArchmage), 
        "Create a black hole in target area, each second damage enemies in 500 range by 0.15 (Skill Level) x Intelligence and applying Ultima reducing damage for 15 seconds.\n\n" +
        wordAbilityDoubleDamage,
        (int lvl) -> "Deals {0} x Intelligence damage. Mana cost {1}.".format(
            (0.15*lvl).toString(2),
            (50 + 25*lvl).toString()
        ))
    
// ----------------------------------------------------------------------------

        new ChannelAbilityPreset(ARCHMAGE_ABILITY_4, 9, true)
        ..setGeneralAbility(AbilityPosition.R)
        ..presetAreaofEffect(lvl -> 500.0)
        ..presetCooldown(lvl -> 21.0 - lvl)
        ..presetManaCost(lvl -> 50 + 25*lvl)
        ..presetFollowThroughTime(lvl -> 4.0)
        ..presetTargetTypes(Targettype.POINT)
        ..presetOption(Option.TARGETIMAGE, true)
        ..presetArtDuration(lvl -> 1.0)
        ..presetBaseOrderID(lvl -> MyOrderIds.aoeRainOfFire)
        ..setOrderStringUseTurnOn(MyOrderIds.aoeRainOfFire)
        ..presetCastRange(lvl -> 800.0)
        ..setIcon("ReplaceableTextures\\CommandButtons\\BTNL1.blp")
        ..setArtCaster("")
        ..setCasterAttachmentPoint("")
        ..setArtEffect("")
        ..setArtTarget("")
        ..setTargetAttachmentPoint("")
        ..presetTargetsAllowed(lvl -> getTargets(AbilityTargets.EnemiesAll))
        ..register(HERO_ARCHMAGE, "Lightning Shock".setColor(colAbilitiesArchmage), 
        "Electrify target area damaging every enemy in 500 range for 0.01 x (Skill Level) x Intelligence every 0.05 seconds.\n\n" +
        wordAbilityDoubleDamage,
        (int lvl) -> "Deals {0} x Intelligence damage every 0.05 sec. Mana cost {1}.".format(
            (0.01*lvl).toString(2),
            (50 + 25*lvl).toString()
        ))
    
// ----------------------------------------------------------------------------

        new ChannelAbilityPreset(ARCHMAGE_ABILITY_5, 4, true)
        ..setUltimateAbility()
        ..presetCastRange(lvl -> 800)
        ..presetBuffs(lvl -> "")
        ..presetManaCost(lvl -> 200 + lvl * 100)
        ..presetArtDuration(lvl -> 1)
        ..presetFollowThroughTime(lvl -> 0.1)
        ..presetTargetTypes(Targettype.UNIT)
        ..presetOption(Option.UNIVERSALSPELL, true)
        ..presetCastingTime(lvl -> 1)
        ..presetBaseOrderID(lvl -> MyOrderIds.targetChainLightning)
        ..setOrderStringUseTurnOn(MyOrderIds.targetChainLightning)
        ..presetDurationHero(lvl -> 140.0 - 20.0 * lvl)
        ..setRequirements("")
        ..setIcon("ReplaceableTextures\\CommandButtons\\BTNL2.blp")
        ..presetTargetsAllowed(lvl -> getTargets(AbilityTargets.EnemiesAll))
        ..register(HERO_ARCHMAGE, "Light Removal".setColor(colAbilitiesArchmage), 
        "Pull out the light from targeted enemy dealing 3 x (Skill Level) x Intelligence damage.\n\n" +
        wordAbilityDoubleDamage,
        (int lvl) -> "Deals {0} x Intelligence damage. Mana cost {1}.".format(
            (3*lvl).toString(),
            (200 + lvl * 100).toString()
        ))
    
// ----------------------------------------------------------------------------