package Archmage_W

import ClosureEvents
import ClosureForGroups
import ClosureTimers
import DummyCaster
import OrderIds
import MyAbilityIds
import DamageTarget

public function fallingLight()
    EventListener.onPointCast(ARCHMAGE_ABILITY_2) (unit caster, vec2 target) ->
        let lvl = GetUnitAbilityLevel(caster, ARCHMAGE_ABILITY_2)
        let dmg = (caster.getInt(true) * 0.45)*lvl
        flashEffect("Effects\\Archmage\\Falling Light.mdl", target)
        forUnitsInRange(target, 500, true) (unit u) ->
            doPeriodicallyCounted(1, 2) (CallbackCounted cb) ->
                if caster.isEnemyOf(u) and u.isAlive()
                    let buffs = UnitCountBuffsEx(u, false, false, true, false, false, false, false) - 1.
                    if buffs > 0
                        caster.damageTargetCode(dmg * Pow(2, buffs), u, null, -1, customDamageType.Magical)
                    else
                        caster.damageTargetCode(dmg, u, null, -1, customDamageType.Magical)
                    new DummyCaster()
                    ..owner(GetOwningPlayer(caster))
                    ..origin(caster.getPos())
                    ..castTarget(ARCHMAGE_ABILITY_2_DUMMY, 1, OrderIds.faeriefire, u)