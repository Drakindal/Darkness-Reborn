package Archmage_Q

import ClosureEvents
import ClosureForGroups
import DummyCaster
import OrderIds
import MyAbilityIds
import DamageTarget

public function eclipse()
    EventListener.onPointCast(ARCHMAGE_ABILITY_1) (unit caster, vec2 target) ->
        let lvl = caster.getAbilityLevel(ARCHMAGE_ABILITY_1)
        let dmg = (caster.getInt(true) * 1.25) * lvl
        flashEffect("Effects\\Archmage\\ShadowSlam(Normal Size).mdl", target)
        forUnitsInRange(target, 500) (unit u) ->
            if caster.isEnemyOf(u) and u.isAlive()
                let buffs = UnitCountBuffsEx(u, false, false, true, false, false, false, false) - 1.
                if buffs > 0
                    caster.damageTargetCode(dmg * Pow(2, buffs), u, null, -1, customDamageType.Magical)
                else
                    caster.damageTargetCode(dmg, u, null, -1, customDamageType.Magical)
                new DummyCaster()
                ..owner(GetOwningPlayer(caster))
                ..origin(caster.getPos())
                ..castTarget(ARCHMAGE_ABILITY_1_DUMMY, 1, OrderIds.curse, u)