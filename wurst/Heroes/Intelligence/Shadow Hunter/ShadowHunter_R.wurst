package ShadowHunter_R

import DummyCaster
import MyAbilityIds
import OrderIds
import DamageCustomEvent
import DamageTarget
import MyBuffIds

public function craggyHex()
    DamageCustomEvent.addListener(2) ->
        if (DamageCustomEvent.getType() == ATTACK)
            let damtyp = DamageCustomEvent.getDamageType()
            if (damtyp == DAMAGE_TYPE_NORMAL or damtyp == DAMAGE_TYPE_MAGIC)
                let targ = DamageCustomEvent.getTarget()
                if targ.hasAbility(SHADOW_HUNTER_BUFF_4)
                    let lvl = targ.getAbilityLevel(SHADOW_HUNTER_ABILITY_4)
                    let dmg = targ.getMaxHP()*(lvl*0.05) + 0.5*lvl*targ.getInt(true)
                    if GetRandomInt(1, 100) < lvl*2
                        let src = DamageCustomEvent.getSource()
                        new DummyCaster()
                        ..owner(targ.getOwner())
                        ..origin(targ.getPos())
                        ..castTarget(SHADOW_HUNTER_ABILITY_4_DUMMY, lvl, OrderIds.hex, src)
                        targ.damageTargetCode(dmg, src, null, -1, customDamageType.Magical)