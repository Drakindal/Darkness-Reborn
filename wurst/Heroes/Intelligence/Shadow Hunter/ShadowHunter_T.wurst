package ShadowHunter_T

import MyAbilityIds
import ClosureEvents
import ClosureForGroups
import ShadowHunter_Abilities
import ClosureTimers

public function shadowHunter_T_healingWard()
    EventListener.onPointCast(SHADOW_HUNTER_ABILITY_5) (unit caster, vec2 target) ->
        let lvl = caster.getAbilityLevel(SHADOW_HUNTER_ABILITY_5)
        let range = (700.0 + 50*lvl)/2
        let duration = 20.0 + 10*(lvl-1)
        let period = 0.05

        let heal = shadowHunter_abi5_Heal[lvl-1] * period
        let mana = shadowHunter_abi5_Mana[lvl-1] * period

        doPeriodicallyTimed(period, duration) (CallbackCounted cb) ->
            forUnitsInRange(target, range, true) (unit u) ->
                if caster.isAllyOf(u)
                    u..addHP(heal)..addMana(mana)                    