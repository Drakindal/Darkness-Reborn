package ShadowHunter_Hero

import UnitIds
import ObjectIds
import MyUnitIds
import MyAbilityIds
import AbilityObjEditing
import MyUpgradesIds
import CommonDescriptions
import MyHeroDefinition

@compiletime function defineHero()
    new MyHeroDefinition(HERO_SHADOW_HUNTER, UnitIds.shadowhunter)// Shadow Hunter (O00U)
    ..setHeroAbilities(commaList(SHADOWHUNTER_ABILITY_1, 'A019', 'A0M9', 'A0M3', 'A0MI'))
    
    ..setPrimaryAttribute("Intelligence")
    ..setStatsBase(15, 20, 17)
    ..setStatsPerLvl(2.00, 1.50, 2.50)
    
    ..setSelectionScale(1.20)

    ..setRangedAttack(600)
    ..setAttack1CooldownTime(2.28)
    ..setAttack1DamageSidesperDie(4)
    ..setAttack1ProjectileArc(0.15)
    ..setAttack1ProjectileArt("Abilities\\Weapons\\ShadowHunterMissile\\ShadowHunterMissile.mdl")
    ..setAttack1AnimationBackswingPoint(0.500)
    ..setAttack1AnimationDamagePoint(0.300)

    ..setTurnRate(0.40)
    ..setRequirements(commaList(HERO_SHADOW_HUNTER_PICKED))

    ..setName("Shadow Hunter")
    ..setTooltipBasic("|c00F7EC46Shadow Hunter|r")
    ..setTooltipExtended("|c00F7EC46Shadow Hunter|r\n"
    + "Roles: " + farmer + "/" + summoner + "/" + support + "\n\n"
    + "|c00EE0404Physical Damage|r: 2/5\n"
    + "|c0076ECF9Magical Damage|r: 2/5\n"
    + "|c00B0B0B0Defense|r: 1/5\n"
    + "|c00663300Utility|r: 4/5\n"
    + "|c0066FF66Healing|r: 2/5\n"
    + "Difficulty: 3/5\n")