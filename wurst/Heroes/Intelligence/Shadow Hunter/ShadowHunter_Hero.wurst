package ShadowHunter_Hero

import UnitIds
import ObjectIds
import MyUnitIds
import MyAbilityIds
import AbilityObjEditing
import MyUpgradesIds
import CommonDescriptions
import MyHeroDefinition

// ----------------------------------------------------------------------------

@compiletime function defineHero()
    new MyHeroDefinition(HERO_SHADOW_HUNTER, UnitIds.shadowhunter)
    ..setHeroAbilities(commaList(SHADOW_HUNTER_ABILITY_1, SHADOW_HUNTER_ABILITY_2, SHADOW_HUNTER_ABILITY_3, SHADOW_HUNTER_ABILITY_4, SHADOW_HUNTER_ABILITY_5))
    
    ..setPrimaryAttribute("Intelligence")
    ..setStatsBase(15, 20, 17)
    ..setStatsPerLvl(2.00, 1.50, 2.50)
    
    ..setSelectionScale(1.20)

    ..setRangedAttack(600)
    ..setAttack1CooldownTime(2.28)
    ..setAttack1DamageSidesperDie(4)
    ..setAttack1ProjectileArc(0.15)
    ..setAttack1ProjectileArt("Abilities\\Weapons\\ShadowHunterMissile\\ShadowHunterMissile.mdl")
    ..setAttack1AnimationBackswingPoint(0.500)
    ..setAttack1AnimationDamagePoint(0.300)

    ..setTurnRate(0.40)
    ..setRequirements(commaList(HERO_SHADOW_HUNTER_PICKED))

    ..setTooltipExtended(
    rolesList(roleFarmer, roleSummoner, roleSupport),
    PhysDamage.v2,
    MagicDamage.v2,
    Defense.v1,
    Utility.v4,
    Healing.v2,
    Difficulty.v3)
    
// ----------------------------------------------------------------------------