package onStart

import ClosureTimers
import WaveSetup
import RespawnCreeps
import CodeDialog
import TeleportToMobs
import MultiboardTimer
import Debug
import Quests_Tab_F9
import ModeSelectionDialog
import HeroSelectionSystem
import AddTaverns
import AddShops
import AddBase

// ----------------------------------------------------------------------------

init
    startModeSelectionDialog()

    doAfter(0.01) ->
        questSetup()
        for i = 0 to 9
            gg_cam_CameraHeroPick.apply(true, players[i], 0.3)
            CreateFogModifierRectBJ( true, players[i], FOG_OF_WAR_VISIBLE, GetPlayableMapRect() )

public function onGameModeSelected()
    preWaveSetup()
    createSetup()

    eliteSideCreepsSetup()
    bossCreepSetup()
    overdryaSetup()
    codeDialog()
    setRegions()

    initDebug()


function createSetup()
    createMulti()

    SetPlayerState(players[11], PLAYER_STATE_GIVES_BOUNTY, 1)
    SetPlayerState(players[12], PLAYER_STATE_GIVES_BOUNTY, 1)
    SetPlayerState(players[13], PLAYER_STATE_GIVES_BOUNTY, 1)

    initHeroShops()
    addTaverns()
    addShops()
    addBase()
 
// ----------------------------------------------------------------------------