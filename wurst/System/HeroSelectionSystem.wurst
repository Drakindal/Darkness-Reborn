// ----------------------------------------------------------------------------

public enum RepickRandomMode
    Prohibited
    Limited
    WholeGame

class UpgradeHeroBool
    int upgradeID
    bool active

    construct(int upgradeID)
        this.upgradeID = upgradeID
        active = false

// ----------------------------------------------------------------------------

boolean isRandomRepickActive = true

let heroPickedUpgradeHash = new HashMap<int, UpgradeHeroBool>

public let heroPickedUpgrades = compiletime(new LinkedList<int>)

// ----------------------------------------------------------------------------
// ----------------------------------------------------------------------------
// -repick, -random
// ----------------------------------------------------------------------------
// ----------------------------------------------------------------------------

public function setRepickMode(RepickRandomMode mode, real duration)
    if (mode == RepickRandomMode.WholeGame)
        print("The commands '-repick' and '-random' " +
              "will be available during the whole game!".setColor(colGreen))
    else if (mode == RepickRandomMode.Prohibited)
        print("The commands '-repick' and '-random' " +
              "are prohibited!".setColor(colRed))
        isRandomRepickActive = false
    else
        print("The commands '-repick' and '-random' " +
                "will be available during {0} minutes.".format(
                    (duration/60).toString(0)
                ).setColor(colYellow))
        doAfter(duration) ->
            print("The commands '-repick' and '-random' " +
                  "are no longer available!".setColor(colRed))
            isRandomRepickActive = false

// ----------------------------------------------------------------------------

public function handleRepickCommand()
    let trigP = EventData.getTriggerPlayer()
    if (not isRandomRepickActive)
        printTimedToPlayer("The '-repick' command is no longer available!".setColor(colRed), 5, trigP)
    else
        let currH = playerHero.get(trigP)

        // Drop all items on the ground.
        for i = 0 to 5
            currH.removeItem(currH.itemInSlot(i))

        // After picking hero food limit is set to 0, increase it in order to repick
        // Naga, thief and js also take food limit in Debug mode.
        if DEBUG
            trigP.setState(PLAYER_STATE_RESOURCE_FOOD_CAP, 200)

        if(currH.getTypeId() == HERO_PICKER)
            skip
        else
            currH
            ..repickHero()
            ..setPlayersResearch(true)
            ..remove()
            
            createWisp(trigP)
            gg_cam_CameraHeroPick.apply(true, trigP, 0.3)

// ----------------------------------------------------------------------------

public function handleRandomCommand()
    let trigP = EventData.getTriggerPlayer()
    if (not isRandomRepickActive)
        printTimedToPlayer("The '-random' command is no longer available!".setColor(colRed), 5, trigP)
    else
        let currH = playerHero.get(trigP)
        
        if currH.getTypeId() == HERO_PICKER
            currH
            ..repickHero()
            ..remove()

            var uid = getRandomHero()
            while heroPickedUpgradeHash.get(uid).active
                uid = getRandomHero()

            let randomedHero = createUnit(trigP, uid, gg_rct_Base.getCenter())

            playerHero.put(trigP, randomedHero)

            randomedHero
            ..registerHero()
            ..setPlayersResearch(false)

            taverns.forEach() (unit t) ->
                t.removeUnitFromStock(uid)
        else
            printTimedToPlayer("You can only use -random command when you have no hero. Type -repick first.", 5, trigP)

// ----------------------------------------------------------------------------
// ----------------------------------------------------------------------------
// Hero pick
// ----------------------------------------------------------------------------
// ----------------------------------------------------------------------------

public function onBuyHero(unit u)
    EventListener.add(u, EVENT_PLAYER_UNIT_SELL) ->
        let soldUnit = GetSoldUnit()
        let p = soldUnit.getOwner()
        let currH = playerHero.get(p)

        if currH.getTypeId() == HERO_PICKER
            GetBuyingUnit().remove()

            playerHero.put(p, soldUnit)

            soldUnit
            ..registerHero()
            ..setPlayersResearch(false)
            ..setPos(gg_rct_Base.getCenter())

            gg_cam_CameraHeroPicked.apply(true, p, 0.5)
            p.setState(PLAYER_STATE_RESOURCE_FOOD_CAP, 0)

            if (DEBUG)
                soldUnit.addItemToSlot(ITEM_BLINK_MAP, 0)
                soldUnit.setLevel(20, false)

        else
            soldUnit.remove()
            printTimedToPlayer("Your hero was killed by the newly recruited one as it left.", 10, p)
            currH.kill()

public function initHeroShops()
    for i = 0 to 9
        createWisp(players[i])
        players[i]..addState(PLAYER_STATE_RESOURCE_FOOD_CAP, 5)..addState(PLAYER_STATE_RESOURCE_GOLD, 800)
        heroPickedUpgrades.forEach() (integer t) ->
            SetPlayerTechResearched(players[i], t, 1)

// ----------------------------------------------------------------------------

function unit.setPlayersResearch(boolean active)
    let toSet = active ? 1 : 0
    let uid = this.getTypeId()
    heroPickedUpgradeHash.get(uid).active = active
    for i = 0 to 9
        SetPlayerTechResearched(players[i], heroPickedUpgradeHash.get(uid).upgradeID, toSet)

function createWisp(player p)
    playerHero.put(p, createUnit(p, HERO_PICKER, gg_rct_HeroPicker.getCenter()))

// ----------------------------------------------------------------------------
// ----------------------------------------------------------------------------

function int.heroPickedBlocker()
    new UpgradeDefinition(this, 1)
    ..setName(1, "Picked")
    heroPickedUpgrades.add(this)

@compiletime function blockPlayableHeroes()
    new UpgradeDefinition(heroPickBlocker, 1)
    ..setName(1, "Hero in construction")

    new BuildingDefinition(HERO_PICKER, UnitIds.circleofpower)
    ..setName("Hero Picker")
    ..setNormalAbilities(commaList("AInv", "Avul"))
    ..setGoldCost(0)
    ..setLumberCost(0)
    ..setStockMaximum(0)
    ..setStockStartDelay(0)
    ..setSpeedBase(0)
    ..setSpeedMinimum(0)
    ..setSpeedMaximum(0)
    ..setFoodCost(0)
    ..setScalingValue(0.01)
    ..setModelFile(".mdl")
    ..setSelectionScale(-1)
    ..setHideMinimapDisplay(true)
    ..setSelectionCircleOnWater(false)
    ..setSelectionCircleHeight(0.01)
    ..setAttack1ShowUI(false)
    ..setAttack2ShowUI(false)
    ..setUnitClassification("")
    ..setHasWaterShadow(false)
    ..setShadowImageCenterX(0)
    ..setShadowImageCenterY(0)
    ..setShadowImageHeight(0)
    ..setShadowImageWidth(0)
    ..setAttacksEnabled(0)
    ..setDefenseBase(0)
    ..setTargetedAs("Ground")
    ..setShadowImageUnit("")
    ..setShadowTextureBuilding("")
    
    HERO_PRIESTESS_OF_THE_MOON_PICKED.heroPickedBlocker()
