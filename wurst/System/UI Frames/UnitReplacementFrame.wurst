package UnitReplacementFrame
import FramehandleNames
import ClosureEvents
import DamageTypes
import UnitStats
import HashMap
import Format

let armorValue = getFrame(FramehandleDefaultNames.infoPanelIconValue, 2)
let armorName = getFrame(FramehandleDefaultNames.infoPanelIconLabel, 2)
let playerSelections = new HashMap<player, unit>()

public function updateResistance(player p, unit u)
    let stats = u.getStats()

    if (playerSelections.get(p) != u)
        return

    if(u.isInvulnerable())
        armorName.setText("Invulnerable\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n")
    else if(stats != null)
        armorName.setText(p, (
            "Resistances\n" +
            "Physical: |cffad2222{0}%|r\n" +
            "Magical: |cff1c2bc9{1}%|r\n" +
            "Universal: |cff81830d{2}%|r\n" +
            "Damage reduction: |cff6d6d6d{3}|r\n" +
            "\n\n\n\n\n\n\n\n\n\n\n\n\n\n").format(
                stats.getRes(resType.Physical).percentToString(), 
                stats.getRes(resType.Magical).percentToString(),
                stats.getRes(resType.Universal).percentToString(),
                stats.getDamageBlock(blockType.PostResistances).toString(0)
            )
        )
    else
        armorName.setText(p, "Resistances\nPhysical: |cffad22220|r\nMagical: |cff1c2bc90|r\nUniversal: |cff81830d0|r\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n")


init
    armorName.setScale(0.8)
    EventListener.add(EVENT_PLAYER_UNIT_SELECTED) ->
        playerSelections.put(EventData.getTriggerPlayer(), EventData.getTriggerUnit())
        if (localPlayer == EventData.getTriggerPlayer())
            let u = EventData.getTriggerUnit()
            updateResistance(EventData.getTriggerPlayer(), u)