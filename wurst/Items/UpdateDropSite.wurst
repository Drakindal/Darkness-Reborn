package UpdateDropSite

import ClosureEvents
import HashMap
import HashSet
import MyItemIds
import Global_Variables
import LinkedList

// ----------------------------------------------------------------------------

let itemDropsInTavern   = new HashMap<int,int> //Item ID linked to amount of item
let itemDropsEnumerator = new HashSet<int> //List of dropped Item Ids to enumerate over
var page = 0

function addItemToTheDropSite(int itemId, int amount)
    itemDropsInTavern.put(itemId, itemDropsInTavern.get(itemId) + amount)
    itemDropsEnumerator.add(itemId)
    updateItemPool()

public function addItemToTheDropSite(int itemId)
    addItemToTheDropSite(itemId, 1)

public function updateItemPool()
    itemDropsEnumerator.forEach() (integer t) -> // Remove all items from drop site.
        RemoveItemFromStock(dropSite, t)
    if(page > 0) // Add previous page and next page based on amount of items available in drop site and what page we're on.
        AddItemToStock(dropSite, PREVPAGE, 1, 1)
    if(itemDropsEnumerator.size() > 8 + page * 8)
        AddItemToStock(dropSite, NEXTPAGE, 1, 1)
    
    let itemToAdd = new HashSet<int>

    for int i = 0 to 8 // Loop through all drop site item entries
        for int j = 0 to itemDropsEnumerator.size() // Go through all items available to be sold
            let temp = itemDropsEnumerator.get(page * 8 + i + j)
            if itemToAdd.has(temp) == false // If we haven't already added the item continue
                let stock = itemDropsInTavern.get(temp)
                if stock > 0 // If item has more than 0 stock break loop and go to next drop site item entry
                    itemToAdd.add(temp)
                    break
                else
                    DoNothing()

    itemToAdd.forEach() (integer t) -> // as with previous loop, will always fall within the desired range thus using forEach rather than checking again.
        let stock = itemDropsInTavern.get(t)
        BlzSetItemIntegerField(CreateItem(t,0,0)..remove(), ConvertItemIntegerField('ista'), stock) // Add all items to drop site
        AddItemToStock(dropSite, t, stock, stock)

    /*for int i = 0 to 8
        let temp = itemDropsEnumerator.get(page * 8 + i)
        let stock = itemDropsInTavern.get(temp)
        BlzSetItemIntegerField(CreateItem(temp,0,0)..remove(), ConvertItemIntegerField('ista'), stock)
        if(stock > 0)
            AddItemToStock(dropSite, temp, stock, stock)*/

// ----------------------------------------------------------------------------

let compileTimeDebugItemsList = compiletime(new LinkedList<int>)

public function addItemToTheDropSiteCompileTime(int itemId)
    compileTimeDebugItemsList.add(itemId)

// ----------------------------------------------------------------------------

public function initDropSite()
    EventListener.add(EVENT_PLAYER_UNIT_SELL_ITEM) ->
        if EventData.getSellingUnit() == dropSite
            let ite = EventData.getSoldItem()
            let iteId = ite.getTypeId()
            if(iteId == NEXTPAGE)
                page++
                RemoveItemFromStock(dropSite, NEXTPAGE)
                ite.remove()
            else if (iteId == PREVPAGE)
                page--
                RemoveItemFromStock(dropSite, PREVPAGE)
                ite.remove()
            else if itemDropsEnumerator.has(iteId)
                itemDropsInTavern.put(iteId, itemDropsInTavern.get(iteId) - 1)
            updateItemPool()
    
    for itemId in compileTimeDebugItemsList
        itemDropsInTavern.put(itemId, 30)
        itemDropsEnumerator.add(itemId)
    updateItemPool()
    compileTimeDebugItemsList.clear()
    destroy compileTimeDebugItemsList
            
// ----------------------------------------------------------------------------