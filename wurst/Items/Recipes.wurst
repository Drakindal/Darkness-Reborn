package Recipes

import LinkedList
import MyItemIds
import UnitInventory
import RandomGen
import ItemsNames
import BitSet

// ----------------------------------------------------------------------------
// ----------------------------------------------------------------------------

public class Recipe
    private let items = new LinkedList<int>
    private int completedItem

    ondestroy
        destroy items

    private construct()

    function getRecipeItem(int index) returns int
        return items.get(index)

    function getCompletedItem() returns int
        return completedItem

    function size() returns int
        return items.size()

    static function createRecipe(vararg int recipeItems) returns Recipe
        let newRecipe = new Recipe()
        let itemLinkedList = new LinkedList<int>()
        for items in recipeItems
            itemLinkedList.add(items)

        itemLinkedList.forEach() (integer t) ->
            if not itemLinkedList.staticItr().hasNext()
                newRecipe.completedItem = t
            else
                newRecipe.items.add(t)

        return newRecipe

    static function createRecipe(LinkedList<int> recipeItems) returns Recipe
        let newRecipe = new Recipe()
        for items in recipeItems
            newRecipe.items.add(items)
        newRecipe.completedItem = newRecipe.items.pop()
        return newRecipe

    function checkRecipe(LinkedList<item> uInv) returns bool
        let item_already_picked = bitset(0)
        for rItem in items // For every item in recipe
            int invIdx = 0
            bool itemFound = false
            // Check it against every item in unit's inventory
            for uItem in uInv
                if (rItem == uItem.getTypeId() and not item_already_picked.get(invIdx))
                    // If item ids are equal and item hasn't been already picked
                    itemFound = true
                    break
                invIdx++

            if (itemFound)
                // Not used item was found.
                // Mark it picked.
                item_already_picked.set(invIdx)
            else
                // All items with id = rItem are already picked or not found. Recipe cannot be completed.
                return false
        return true

    function consumeComponents(LinkedList<item> uInv)
        for rItem in items // All the items in the recipe loop through
            bool itemFound = false
            for uItem in uInv // Loop through the inventory
                if (rItem == uItem.getTypeId()) // If found item to remove, remove item and go to next recipe item
                    uItem.remove()
                    uInv.remove(uItem)
                    itemFound = true
                    break
            if (not itemFound)
                printTimed("RECIPE \"{0}\" ERROR: item {1} not found!".format(
                    completedItem.getItemName(),
                    rItem.toString()
                ), 5)

// ----------------------------------------------------------------------------
// ----------------------------------------------------------------------------

interface RecipeListIteratorBase
    function hasNext() returns bool

    function next() returns Recipe

    function close()

// ----------------------------------------------------------------------------
abstract class RecipeListBase
    abstract function size() returns int

    function getRecipePosition(LinkedList<item> uInv, RecipeListIteratorBase iter) returns int
        int idx = 0
        while iter.hasNext() // March through all recipes to match
            let recipe = iter.next()
            if (recipe.checkRecipe(uInv))
                iter.close()
                return idx
            idx += 1
        iter.close()
        return -1

// ----------------------------------------------------------------------------
// ----------------------------------------------------------------------------

class RecipeListIterator implements RecipeListIteratorBase
    LLIterator<Recipe> iter

    ondestroy
        // Already destroyed in iter.close()
        // destroy iter

    construct(LinkedList<Recipe> recipeList)
        iter = recipeList.iterator()

    override function hasNext() returns bool
        return iter.hasNext()

    override function next() returns Recipe
        return iter.next()

    override function close()
        iter.close()

// ----------------------------------------------------------------------------

public class RecipeList extends RecipeListBase
    protected let recipeList = new LinkedList<Recipe>()

    function addRecipe(Recipe recipe)
        recipeList.add(recipe)

    function getRecipe(int idx) returns Recipe
        return recipeList.get(idx)

    override function size() returns int
        return recipeList.size()

    function iterator() returns RecipeListIterator
        return new RecipeListIterator(recipeList)
    
    // Checks for all recipes in the list, do the first available recipe 
    function checkAndDoRecipe(unit u)
        let uInv = getUnitInventory(u)
        
        let recipeIdx = getRecipePosition(uInv)
        if (recipeIdx != -1)
            let foundRecipe = getRecipe(recipeIdx)
            foundRecipe.consumeComponents(uInv)
            u.addItemById(foundRecipe.getCompletedItem())
        destroy uInv
    
    function getRecipePosition(LinkedList<item> unitInventory) returns int
        return super.getRecipePosition(unitInventory, iterator())

// ----------------------------------------------------------------------------
// ----------------------------------------------------------------------------

class ChanceRecipe
    Recipe recipe
    real chance
    int consumable

    ondestroy
        destroy recipe

    construct(Recipe recipe, real chance)
        this.recipe = recipe
        this.chance = chance
        this.consumable = ITEM_BULION

// ----------------------------------------------------------------------------

class ChanceRecipeListIterator implements RecipeListIteratorBase
    LLIterator<ChanceRecipe> iter

    ondestroy
        // Already destroyed in iter.close()
        // destroy iter

    construct(LinkedList<ChanceRecipe> recipeList)
        iter = recipeList.iterator()

    override function hasNext() returns bool
        return iter.hasNext()

    override function next() returns Recipe
        return iter.next().recipe

    override function close()
        iter.close()

// ----------------------------------------------------------------------------

public class ChanceRecipeList extends RecipeListBase
    protected let recipeList = new LinkedList<ChanceRecipe>()
    
    function addRecipe(Recipe recipe, real chance)
        recipeList.add(new ChanceRecipe(recipe, chance))
    
    function getRecipe(int idx) returns ChanceRecipe
        return recipeList.get(idx)

    override function size() returns int
        return recipeList.size()

    function iterator() returns ChanceRecipeListIterator
        return new ChanceRecipeListIterator(recipeList)
    
    // Checks for all recipes in the list, do the first available recipe 
    function checkAndDoRecipe(unit u) returns int
        int resultItemId = -1
        let unitInventory = getUnitInventory(u)

        let recipeIdx = getRecipePosition(unitInventory, iterator())
        if (recipeIdx != -1)
            let foundRecipe = getRecipe(recipeIdx)

            if (checkChance(foundRecipe.chance))
                foundRecipe.recipe.consumeComponents(unitInventory)
                u.addItemById(foundRecipe.recipe.getCompletedItem())
                resultItemId = foundRecipe.recipe.getCompletedItem()
            else
                u.getItemById(foundRecipe.consumable).remove()
        
        destroy unitInventory
        return resultItemId

// ----------------------------------------------------------------------------
// ----------------------------------------------------------------------------

public function unit.checkRecipe(RecipeList recipeList)
    if recipeList != null
        recipeList.checkAndDoRecipe(this)
    
