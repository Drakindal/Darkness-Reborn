package ItemDrops
import MyUnitIds
import MyItemIds
import HashList
import HashMap
import ClosureTimers
import UpdateDropSite
import ItemPickups
import LinkedList
import ItemsNames
import CommonDescriptions

let dropItemsToStore = new LinkedList<item>

// key = unitId, value = DropTable
let newDropHash = new HashMap<int, ItemDropTableBase>
let newDropTablesInitList = new LinkedList<InitEntryDropTable>

class InitEntryDropTable
    int unitId
    ItemDropTableBase dropTable

    construct(int unitId, ItemDropTableBase dropTable)
        this.unitId = unitId
        this.dropTable = dropTable

init
    for entry in newDropTablesInitList
        newDropHash.put(entry.unitId, entry.dropTable)
        destroy entry
    newDropTablesInitList.clear()
    destroy newDropTablesInitList

public function int.addDropTable(ItemDropTableBase dropTable)
    newDropTablesInitList.add(new InitEntryDropTable(this, dropTable))

// ----------------------------------------------------------------------------

public abstract class ItemDropTableBase
    abstract function getDescription() returns string
    
    abstract function dropItem(vec2 pos)

// ----------------------------------------------------------------------------

// Drops `amount` random items from the table.
public class ItemDropTable extends ItemDropTableBase
    protected LinkedList<int> items
    protected int amount

    construct()
        this.amount = 1
        items = new LinkedList<int>

    construct(int amount)
        this.amount = amount
        items = new LinkedList<int>

    function populate(vararg int items)
        for itemId in items
            this.items.add(itemId)

    override function dropItem(vec2 pos)
        for idx = 1 to amount
            dropOneItem(pos)

    protected function dropOneItem(vec2 pos)
        dropItemsToStore.add(createItem(this.items.getRandomElement(), pos))

    override function getDescription() returns string
        string descr = wordDropTable
        if (amount != 1)
            descr = wordDropTableN.format(amount.toString())
        for itemId in items
            descr += "\n\t" + itemId.getItemName()
        return descr

    function getOneLineDescription() returns string
        return "[x{0}] ".format(amount.toString()) +
            items.joinBy((int itemId) -> itemId.getItemName(), ", ")

// ----------------------------------------------------------------------------

// Chance to drop random item from the table.
// If amount > 1, then checks the chance `amount` times.
// For example, let amount = 3, chance = 50%. Possible situations:
// Y = item was dropped, N = item wasn't dropped (no luck).
// 1. NNN
// 2. NNY
// 3. NYN
// 4. YNN
// 5. YYN
// 6. YNY
// 7. NYY
// 8. YYY
// 0.5 * 0.5 * 0.5 = 0.125.
// 12,5% to drop 3 random items from the table.
// 12,5% not to drop any item.
// 37,5% to drop 2 random items from the table.
// 37,5% to drop 1 random item from the table.
// 0.125*3 + 0.375*2 + 0.375*1 = 1.5 = the average number of dropped items.
public class ItemDropTableChance extends ItemDropTable
    private int chance

    construct(int dropChance)
        super()
        this.chance = dropChance

    construct(int dropChance, int amount)
        super(amount)
        this.chance = dropChance

    override function dropItem(vec2 pos)
        for idx = 1 to amount
            if GetRandomInt(1, 100) <= this.chance
                dropOneItem(pos)
    
    override function getDescription() returns string
        string descr
        if (amount == 1)
            descr = wordDropTableChance.format(chance.toString())
        else
            descr = wordDropTableChanceN.format(chance.toString(), amount.toString())
        for itemId in items
            descr += "\n\t" + itemId.getItemName()
        return descr

    override function getOneLineDescription() returns string
        return  "[x{0}] ".format(amount.toString()) +
            "[{0}% chance] ".format(chance.toString()) +
            items.joinBy((int itemId) -> itemId.getItemName(), ", ")

// ----------------------------------------------------------------------------

// Drops random items from each table.
// Each table can be ItemDropTable or ItemDropTableChance.
public class ItemDropTableMultiple extends ItemDropTableBase
    LinkedList<ItemDropTable> tables

    construct()
        this.tables = new LinkedList<ItemDropTable>

    // Add new drop table.        
    function addDropTable(ItemDropTable dropTable)
        this.tables.add(dropTable)
    
    override function dropItem(vec2 pos)
        for table in tables
            table.dropItem(pos)

    override function getDescription() returns string
        string descr = wordDropTableMultiple
        int tableNum = 1
        for table in tables
            descr += "\n" + tableNum.toString() + ". " + table.getOneLineDescription()
            tableNum++
        return descr

// ----------------------------------------------------------------------------

init
    doPeriodically(30) (CallbackPeriodic cb) ->
        dropItemsToStore.forEach() (item t) ->
            if(itemPickedup.has(t))
                dropItemsToStore.remove(t)
            else
                addItemToTheDropSite(t.getTypeId())
                dropItemsToStore.remove(t)
                t.remove()

public function unit.giveQuestItem(int targetUnit)
    if newDropHash.has(targetUnit)
        newDropHash.get(targetUnit).dropItem(this.getPos())

public function unit.dropItems()
    let uid = this.getTypeId()

    if newDropHash.has(uid)
        newDropHash.get(uid).dropItem(this.getPos())

public function dropMyItemsMinibosses(unit u)
