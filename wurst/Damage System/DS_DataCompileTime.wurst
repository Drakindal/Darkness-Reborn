package DS_DataCompileTime

import DamageTypes
import LinkedList
import EntityStats
import HashMap
import initlater DS_DataPrivate

// ----------------------------------------------------------------------------

class StatsBase
    int  id
    // true => item. false => unit
    bool isUnit
    real value

    construct (int id, bool isUnit, real value)
        this.id     = id
        this.isUnit = isUnit
        this.value  = value

class PenStats extends StatsBase
    penType penType
    
    construct(int id, bool isUnit, real value, penType penType)
        super(id, isUnit, value)
        this.penType = penType

class ResStats extends StatsBase
    resType resType
    
    construct(int id, bool isUnit, real value, resType resType)
        super(id, isUnit, value)
        this.resType = resType

class BlockStats extends StatsBase
    blockType blockType
    
    construct(int id, bool isUnit, real value, blockType blockType)
        super(id, isUnit, value)
        this.blockType = blockType

// ----------------------------------------------------------------------------

// Used in compile-time
let penList   = compiletime(new LinkedList<PenStats>())
let resList   = compiletime(new LinkedList<ResStats>())
let blockList = compiletime(new LinkedList<BlockStats>())

// Used in run-time
let unitTypeMap = new HashMap<int, EntityStats>
let itemTypeMap = new HashMap<int, EntityStats>

// ----------------------------------------------------------------------------
// Set up run-time data using compile-time data
// ----------------------------------------------------------------------------

init
    for stats in penList
        if (stats.isUnit)
            stats.id.private_modifyUnitBaseStats(es -> es.setPen(stats.penType, stats.value))
        else
            stats.id.private_modifyItemBaseStats(es -> es.setPen(stats.penType, stats.value))
        destroy stats

    penList.clear()
    destroy penList

    for stats in resList
        if (stats.isUnit)
            stats.id.private_modifyUnitBaseStats(es -> es.setRes(stats.resType, stats.value))
        else
            stats.id.private_modifyItemBaseStats(es -> es.setRes(stats.resType, stats.value))
        destroy stats

    resList.clear()
    destroy resList
    
    for stats in blockList
        if (stats.isUnit)
            stats.id.private_modifyUnitBaseStats(es -> es.setDamageBlock(stats.blockType, stats.value))
        else
            stats.id.private_modifyItemBaseStats(es -> es.setDamageBlock(stats.blockType, stats.value))
        destroy stats

    blockList.clear()
    destroy blockList

// ----------------------------------------------------------------------------
// Set up compile-time data
// ----------------------------------------------------------------------------

public function int.addItemBasePen(penType penType, real value)
    penList.add(new PenStats(this, false, value, penType))

public function int.addItemBaseRes(resType resType, real value)
    resList.add(new ResStats(this, false, value, resType))

public function int.addItemBaseDamageBlock(blockType blockType, real value)
    blockList.add(new BlockStats(this, false, value, blockType))

// ----------------------------------------------------------------------------

public function int.addUnitBasePen(penType penType, real value)
    penList.add(new PenStats(this, true, value, penType))

public function int.addUnitBaseRes(resType resType, real value)
    resList.add(new ResStats(this, true, value, resType))

public function int.addUnitBaseDamageBlock(blockType blockType, real value)
    blockList.add(new BlockStats(this, true, value, blockType))

// ----------------------------------------------------------------------------
// Get compile-time stats data.
// ----------------------------------------------------------------------------

function getResInList(int id, bool isUnit, resType resType) returns real
    for stats in resList
        if (stats.id == id and stats.isUnit == isUnit and stats.resType == resType)
            return stats.value
    return 0

function getPenInList(int id, bool isUnit, penType penType) returns real
    for stats in penList
        if (stats.id == id and stats.isUnit == isUnit and stats.penType == penType)
            return stats.value
    return 0

public function int.getCompileTimeItemPen(penType penType) returns real
    return getPenInList(this, false, penType)

public function int.getCompileTimeItemRes(resType resType) returns real
    return getResInList(this, false, resType)

public function int.getCompileTimeUnitPen(penType penType) returns real
    return getPenInList(this, true, penType)

public function int.getCompileTimeUnitRes(resType resType) returns real
    return getResInList(this, true, resType)

// ----------------------------------------------------------------------------
// ----------------------------------------------------------------------------
//                               PRIVATE FUNCTIONS
//                   Do not use them outside Damage System code.
// ----------------------------------------------------------------------------
// ----------------------------------------------------------------------------

public function private_getUnitBaseStatsMap() returns HashMap<int, EntityStats>
    return unitTypeMap

public function private_getItemBaseStatsMap() returns HashMap<int, EntityStats>
    return itemTypeMap

// ----------------------------------------------------------------------------
