package DamageTypes

// ----------------------------------------------------------------------------

/** Each damage instance has a DamageType associated to it.
    ATTACK and SPELL are detected by the system.
    CODE **must** be declared by the user using DamageEvent.setNextDamageFromCode() before dealing damage  */
public enum WC3InternalDetectionDamageTypes
    ATTACK  // From units' attacks or native abilities if DETECT_NATIVE_ABILITIES is false (PHYSICAL)
    SPELL   // From native abilities (NATIVE_ABILITY)
    CODE    // From user code
    NULLED  // For backward compatibility -> has no utility
    UNKNOWN

public enum customDamageType
    Pure
    PhysicalMelee
    PhysicalRanged
    Magical

public enum penType
    Magical
    Physical

public enum resType
    Universal
    Physical
    Magical

public enum blockType
    PreResistances
    PostResistances

// ----------------------------------------------------------------------------

public function customDamageType.toString() returns string
    switch this
        case customDamageType.Magical
            return "Magic Damage"
        case customDamageType.PhysicalMelee
            return "Physical Melee Damage"
        case customDamageType.PhysicalRanged
            return "Physical Ranged Damage"
        case customDamageType.Pure
            return "Pure Damage"

public function penType.toString() returns string
    switch this
        case penType.Magical
            return "Magic Pen"
        case penType.Physical
            return "Phys Pen"

public function resType.toString() returns string
    switch this
        case resType.Universal
            return "Universal Res"
        case resType.Magical
            return "Magic Res"
        case resType.Physical
            return "Phys Res"

public function blockType.toString() returns string
    switch this
        case blockType.PreResistances
            return "Damage Reduction (Before Resistances)"
        case blockType.PostResistances
            return "Damage Reduction (After Resistances)"

// ----------------------------------------------------------------------------

public function unit.isRanged() returns boolean
    return this.getFieldWeapon(UNIT_WEAPON_RF_ATTACK_RANGE, 0) > 230

// ----------------------------------------------------------------------------