package onDamage

import MyUnitIds
// import DamageDetection
import DamageCustomEvent
import MyAbilityIds
import MyBuffIds
import WaveHeroSetup
import DragonTurtle
import Turtle
import ThornsAuraWave
import Global_Variables
import AbilitiesList
import Pitlord_R
import Pitlord_E
import UnitStats

@configurable constant DETECT_NATIVE_ABILITIES = true

let difficultyDamageIncrease = [0.5, 0.75, 1., 1.5, 2.]

texttag justaposeCrit

function getReducedDamage() returns real

    return DamageCustomEvent.getUnreducedAmount() - DamageCustomEvent.getAmount()

 // SPELL ATTACK FUNCTIONS //
function anySpell(unit src, unit targ)
    DamageCustomEvent.setAmount(targ.getStats().calcDamage(customDamageType.Magical, DamageCustomEvent.getUnreducedAmount()))
    enemyAttacks(src)

 // MAGICAL ATTACK FUNCTIONS //

function magicalAttacks(unit src, unit targ)
    magicDamageChecks(src, targ)

 // ATTACK FUNCTIONS // 

function modifyAmountArmorType(unit src, unit targ)
    src.getFieldWeapon(UNIT_WEAPON_IF_ATTACK_ATTACK_TYPE, 0)
    DamageCustomEvent.setAmount(DamageCustomEvent.getAmount())

function anyAttack(unit src, unit targ)
    let dt = src.isRanged() ? customDamageType.PhysicalRanged : customDamageType.PhysicalMelee
    let damageAmount = targ.getStats().calcDamage(dt, DamageCustomEvent.getUnreducedAmount())
    DamageCustomEvent.setAmount(damageAmount)
    modifyAmountArmorType(src, targ)

    enemyAttacks(src)

    if dt == customDamageType.PhysicalMelee
        physicalMeleeAttacks(src, targ)
    else
        physicalRangedAttacks(src, targ)

    // Warden T ability.
    if src.hasAbility('B003')
        DamageCustomEvent.setAmount(DamageCustomEvent.getAmount() * 2)
        src.removeAbility('B003')

 // PHYSICAL MELEE ATTACK FUNCTIONS //

function physicalMeleeAttacks(unit src, unit targ)
    meleeReflectionChecks(src, targ)
    universalReflectionChecks(src, targ)
    physicalDamageChecks(src, targ)

 // PHYSICAL RANGED ATTACK FUNCTIONS // 

function physicalRangedAttacks(unit src, unit targ)
    universalReflectionChecks(src, targ)
    physicalDamageChecks(src, targ)

 // PURE ATTACK FUNCTIONS //

function pureAttacks(unit src, unit targ)
    universalReflectionChecks(src, targ)

 // CODE ATTACK FUNCTIONS // 

function anyCodeAttack(unit src, unit targ)
    // Calculate damage based on pen stats and res stats
    DamageCustomEvent.setAmount(targ.getStats().calcDamage(DamageCustomEvent.getCustomDamageType(), DamageCustomEvent.getUnreducedAmount()))
    magicalAttacks(src, targ)
    enemyAttacks(src)
    
    // Checks for reflections and any modifiers to damage amount
    switch DamageCustomEvent.getCustomDamageType()
        case customDamageType.Magical
            magicalAttacks(src, targ)
        case customDamageType.PhysicalMelee
            physicalMeleeAttacks(src, targ)
        case customDamageType.PhysicalRanged
            physicalRangedAttacks(src, targ)
        case customDamageType.Pure
            pureAttacks(src, targ)

// ENEMY DIFFICULTY INCREASE // 

function enemyAttacks(unit src)
    // Change damage dealt by enemies to players due to game difficulty

    // WIP. We increase only DamageAmount, but also should change DamageUnreducedAmount.
    // But there are no function to change it.
    if(src.isEnemyOf(PLAYER_ALLY_BASE))
        DamageCustomEvent.setAmount(DamageCustomEvent.getAmount() * difficultyDamageIncrease[gameMode])


 // Damage Switcher to flatten structure

function damageSwitcher(unit src, unit targ)
    switch DamageCustomEvent.getType()
        case ATTACK
            anyAttack(src, targ)

        case SPELL
            anySpell(src,targ)

        case CODE
            anyCodeAttack(src, targ)

        default

 // Damage Event Listeners
init
    // Main damage listener, handles the custom damage system amount of damage taken.
    DamageCustomEvent.addListener(0) -> 
        let src  = DamageCustomEvent.getSource()
        let targ = DamageCustomEvent.getTarget()
        src.wasAttacked()
        
        damageSwitcher(src, targ)

    // On take damage listener, has lower prio than reflection abilities to prevent infinite loops.
    // Invoke reactions here, but, do not change amount of damage.

    DamageCustomEvent.addListener(1) ->
        let src = DamageCustomEvent.getSource()
        let targ = DamageCustomEvent.getTarget()
        if (DamageCustomEvent.getType() == ATTACK)
            for abilityInfo in abilitiesListOnDamageTaken
                if (targ.hasItemById(abilityInfo.itemId))
                    abilityInfo.runHandler(src, targ)
                

    // On damage dealt listener, has lower prio than listener and on take damage listener to prevent infinite loops. 
    // Invoke reactions here, but, do not change amount of damage.

    DamageCustomEvent.addListener(2) ->
        let src = DamageCustomEvent.getSource()
        let targ = DamageCustomEvent.getTarget()
        if (DamageCustomEvent.getType() == ATTACK)
            if src.isIllusion()
                skip
            else
                for abilityInfo in abilitiesListOnDamageDealt
                    if (src.hasItemById(abilityInfo.itemId))
                        abilityInfo.runHandler(src, targ)

 // ABILITY CHECKS FOR DIFFERENT ATTACKS

 // MAGIC DAMAGE CHECKS

function magicDamageChecks(unit src, unit targ)
    // Uther Damage reduction
    if(targ.getAbilityLevel(UTHER_ABILITY_3) > 0)
        DamageCustomEvent.setAmount(DamageCustomEvent.getAmount() * (1-0.02*targ.getAbilityLevel(UTHER_ABILITY_3)))

 // PHYSICAL DAMAGE CHECKS

function physicalDamageChecks(unit src, unit targ)
    // Uther Damage reduction
    if(targ.getAbilityLevel(UTHER_ABILITY_3) > 0)
        DamageCustomEvent.setAmount(DamageCustomEvent.getAmount() * (1-0.02*targ.getAbilityLevel(UTHER_ABILITY_3)))
    // Wolfman attack
    if src.hasAbility(WOLF_BUFF_1)
        src.addHP(DamageCustomEvent.getAmount() * 0.25)

 // PHYSICAL CHECKS

function universalReflectionChecks(unit src, unit targ)

function meleeReflectionChecks(unit src, unit targ)
    let dam = DamageCustomEvent.getAmount()
    let targuID = targ.getTypeId()

    for abilityInfo in abilitiesListReflections
        if (targ.hasItemById(abilityInfo.itemId))
            abilityInfo.runHandler(src, targ)

    if(targuID == WAVE_MOB_18)
        turtle(targ, src, dam)
    if(targuID == WAVE_BOSS_95)
        dragonTurtle(targ, src, dam)
    if(targ.getAbilityLevel('A0RI') > 0)
        pitLordThorn(targ, src)
    if(targ.getAbilityLevel('a0RL') > 0)
        pitLordDemonSkin(targ, src, dam)
    if(targ.hasAbility('BEah'))
        thornsAuraWave(targ, src, dam)