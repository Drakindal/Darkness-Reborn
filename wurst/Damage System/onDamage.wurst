package onDamage

// import DamageDetection
import DamageCustomEvent
import WaveHeroSetup
import AbilitiesList
import UnitStats
import onDamageChecks
import onDamageDifficulty

// ----------------------------------------------------------------------------

@configurable constant DETECT_NATIVE_ABILITIES = true

// ----------------------------------------------------------------------------

function modifyAmountArmorType(unit src, unit targ)
    src.getFieldWeapon(UNIT_WEAPON_IF_ATTACK_ATTACK_TYPE, 0)
    DamageCustomEvent.setAmount(DamageCustomEvent.getAmount())

// ----------------------------------------------------------------------------
// Damage Switcher to flatten structure
// ----------------------------------------------------------------------------

function damageSwitcher(unit src, unit targ)
    switch DamageCustomEvent.getType()
        case ATTACK
            anyAttack(src, targ)

        case SPELL
            anySpell(src,targ)

        case CODE
            anyCodeAttack(src, targ)

        default

// ----------------------------------------------------------------------------
// ATTACK FUNCTIONS // 
// ----------------------------------------------------------------------------

// Process general attacks (both melee and ranged)
function anyAttack(unit src, unit targ)
    let dt = src.isRanged() ? customDamageType.PhysicalRanged : customDamageType.PhysicalMelee
    let damageAmount = targ.getStats().calcDamage(dt, DamageCustomEvent.getUnreducedAmount())
    DamageCustomEvent.setAmount(damageAmount)
    modifyAmountArmorType(src, targ)

    increaseEnemyDamageForDifficulty(src)
    increaseEnemyResistanceForDifficulty(targ)

    if dt == customDamageType.PhysicalMelee
        handlePhysicalMeleeAttackChecks(src, targ)
    else
        handlePhysicalRangedAttackChecks(src, targ)

    autoAttackChecks(src, targ)

// Process any coded damage
function anyCodeAttack(unit src, unit targ)
    // Calculate damage based on pen stats and res stats
    DamageCustomEvent.setAmount(targ.getStats().calcDamage(DamageCustomEvent.getCustomDamageType(), DamageCustomEvent.getUnreducedAmount()))

    increaseEnemyDamageForDifficulty(src)
    increaseEnemyResistanceForDifficulty(targ)
    
    // Checks for reflections and any modifiers to damage amount
    switch DamageCustomEvent.getCustomDamageType()
        case customDamageType.Magical
            handleMagicalAttackChecks(src, targ)
        case customDamageType.PhysicalMelee
            handlePhysicalMeleeAttackChecks(src, targ)
        case customDamageType.PhysicalRanged
            handlePhysicalRangedAttackChecks(src, targ)
        case customDamageType.Pure
            handlePureAttackChecks(src, targ)

// Process any ability damage
function anySpell(unit src, unit targ)
    DamageCustomEvent.setAmount(targ.getStats().calcDamage(customDamageType.Magical, DamageCustomEvent.getUnreducedAmount()))

    increaseEnemyDamageForDifficulty(src)
    increaseEnemyResistanceForDifficulty(targ)

// ----------------------------------------------------------------------------
// Special unit/item abilities checks for each customDamageType
// ----------------------------------------------------------------------------

function handlePureAttackChecks(unit src, unit targ)
    universalReflectionChecks(src, targ)

function handlePhysicalMeleeAttackChecks(unit src, unit targ)
    meleeReflectionChecks(src, targ)
    universalReflectionChecks(src, targ)
    physicalDamageChecks(src, targ)

function handlePhysicalRangedAttackChecks(unit src, unit targ)
    universalReflectionChecks(src, targ)
    physicalDamageChecks(src, targ)

function handleMagicalAttackChecks(unit src, unit targ)
    universalReflectionChecks(src, targ)
    magicDamageChecks(src, targ)

// ----------------------------------------------------------------------------
// Damage Event Listeners
// ----------------------------------------------------------------------------

init
    // Main damage listener, handles the custom damage system amount of damage taken.
    DamageCustomEvent.addListener(0) -> 
        let src  = DamageCustomEvent.getSource()
        let targ = DamageCustomEvent.getTarget()
        src.wasAttacked()
        
        damageSwitcher(src, targ)

    // On take damage listener, has lower prio than reflection abilities to prevent infinite loops.
    // Invoke reactions here, but, do not change amount of damage.

    DamageCustomEvent.addListener(1) ->
        let src = DamageCustomEvent.getSource()
        let targ = DamageCustomEvent.getTarget()
        if (DamageCustomEvent.getType() == ATTACK)
            for abilityInfo in abilitiesListOnDamageTaken
                if (targ.hasItemById(abilityInfo.itemId))
                    abilityInfo.runHandler(src, targ)
                
    // On damage dealt listener, has lower prio than listener and on take damage
    // listener to prevent infinite loops. 
    // Invoke reactions here, but, do not change amount of damage.

    DamageCustomEvent.addListener(2) ->
        let src = DamageCustomEvent.getSource()
        let targ = DamageCustomEvent.getTarget()
        if (DamageCustomEvent.getType() == ATTACK)
            if src.isIllusion()
                skip
            else
                for abilityInfo in abilitiesListOnDamageDealt
                    if (src.hasItemById(abilityInfo.itemId))
                        abilityInfo.runHandler(src, targ)

// ----------------------------------------------------------------------------