package DS_DataRunTime

import EntityStats
import DS_DataCompileTime
import DamageTypes
import HashMap

// ----------------------------------------------------------------------------

let itemTypeMap = private_getItemBaseStatsMap()
let unitTypeMap = private_getItemBaseStatsMap()

public interface RealDataHandler
    function run(EntityStats stats) returns real

// ----------------------------------------------------------------------------
// Public stats getters
// ----------------------------------------------------------------------------

function HashMap<int, EntityStats>.getRealData(int id, RealDataHandler handler) returns real
    let stats = this.get(id)
    if (stats == null)
        return 0
    return handler.run(stats)

// ----------------------------------------------------------------------------

public function int.getItemBaseRes(resType resType) returns real
    return itemTypeMap.getRealData(this, es -> es.getRes(resType))

public function int.getItemBasePen(penType penType) returns real
    return itemTypeMap.getRealData(this, es -> es.getPen(penType))

public function int.getItemBaseBlock(blockType blockType) returns real
    return itemTypeMap.getRealData(this, es -> es.getDamageBlock(blockType))

// ----------------------------------------------------------------------------

public function int.getUnitBaseRes(resType resType) returns real
    return unitTypeMap.getRealData(this, es -> es.getRes(resType))

public function int.getUnitBasePen(penType penType) returns real
    return unitTypeMap.getRealData(this, es -> es.getPen(penType))

public function int.getUnitBaseBlock(blockType blockType) returns real
    return unitTypeMap.getRealData(this, es -> es.getDamageBlock(blockType))

// ----------------------------------------------------------------------------